// Library import you can check: what a documented export file carries over
// before anything is written, then the counts before and after, what did
// not transfer, and undo.

import { Theme } from "tokens.slint";
import { HLine } from "lines.slint";
import { Caps, PlateButton, KeyFocus, TooltipState } from "controls.slint";

// One count: in the preview `after` is what the file brings, in the result
// the library before and after.
export struct ImportCountRow {
    label: string,
    before: string,
    after: string,
    // The count changed (the result marks it).
    changed: bool,
}

// One item that does not carry over, with the reason.
export struct ImportLeftOutRow {
    item: string,
    reason: string,
}

export global ImportReview {
    // "" closed, "preview", "running", "done", "undone".
    in property <string> stage;
    // The file's name (no folder) and its format ("LIBRARY XML", ...).
    in property <string> file;
    in property <string> format;
    in property <[ImportCountRow]> counts;
    in property <[ImportLeftOutRow]> left-out;
    // Items not listed (the list shows the first ones).
    in property <int> left-out-more;
    // A line under the counts ("3 tracks are already in your library ...").
    in property <string> note;
    in property <string> error;
    callback run();
    callback cancel();
    callback undo();
    callback close();
}

export component ImportReviewDialog inherits Rectangle {
    background: #00000099;
    TouchArea { }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(620px, parent.width - 40px);
        height: min(lay.preferred-height, parent.height - 40px);
        background: Theme.plate;
        border-width: 1px;
        border-color: Theme.rule;
        lay := VerticalLayout {
            padding: Theme.s5;
            spacing: Theme.s3;
            Caps {
                accessible-role: text; accessible-id: "app.import-review.title"; accessible-value: self.text;
                text: ImportReview.stage == "preview" ? @tr("BEFORE YOU IMPORT — NOTHING IS WRITTEN YET")
                    : ImportReview.stage == "running" ? @tr("IMPORTING…")
                    : ImportReview.stage == "undone" ? @tr("IMPORT UNDONE")
                    : @tr("IMPORT DONE");
            }
            HorizontalLayout {
                spacing: Theme.s3;
                Text {
                    accessible-role: text; accessible-id: "app.import-review.file"; accessible-value: self.text;
                    horizontal-stretch: 1;
                    text: ImportReview.file;
                    overflow: elide;
                    font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi; color: Theme.bone;
                }
                Caps { text: ImportReview.format; vertical-alignment: center; }
            }
            HLine { tone: Theme.rule; }
            // Counts: what carries over (preview), or the library before and after.
            HorizontalLayout {
                height: 18px;
                Caps { horizontal-stretch: 1; text: ImportReview.stage == "preview" ? @tr("WHAT CARRIES OVER") : @tr("YOUR LIBRARY"); }
                if ImportReview.stage != "preview": Caps { width: 90px; horizontal-alignment: right; text: @tr("BEFORE"); }
                Caps { width: 90px; horizontal-alignment: right; text: ImportReview.stage == "preview" ? @tr("FROM THE FILE") : ImportReview.stage == "undone" ? @tr("NOW") : @tr("AFTER"); }
            }
            for c in ImportReview.counts: HorizontalLayout {
                accessible-role: text;
                accessible-id: "app.import-review.count";
                accessible-value: c.label + " " + c.before + " " + c.after;
                height: 22px;
                Text { horizontal-stretch: 1; text: c.label; vertical-alignment: center; font-family: Theme.family; font-size: Theme.body; color: Theme.bone-2; }
                if ImportReview.stage != "preview": Text { width: 90px; text: c.before; horizontal-alignment: right; vertical-alignment: center; font-family: Theme.family; font-size: Theme.body; color: Theme.bone-3; }
                Text { width: 90px; text: c.after; horizontal-alignment: right; vertical-alignment: center; font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi; color: c.changed ? Theme.live : Theme.bone; }
            }
            if ImportReview.note != "": Text {
                accessible-role: text; accessible-id: "app.import-review.note"; accessible-value: self.text;
                text: ImportReview.note; wrap: word-wrap;
                font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3;
            }
            // What does not carry over, with the reason.
            if ImportReview.stage != "undone": HorizontalLayout {
                height: 18px;
                Caps {
                    accessible-role: text; accessible-id: "app.import-review.left-out-title"; accessible-value: self.text;
                    text: ImportReview.left-out.length == 0 ? @tr("EVERYTHING IN THE FILE CARRIES OVER")
                        : ImportReview.stage == "preview" ? @tr("WILL NOT CARRY OVER ({})", ImportReview.left-out.length + ImportReview.left-out-more)
                        : @tr("DID NOT TRANSFER ({})", ImportReview.left-out.length + ImportReview.left-out-more);
                    color: ImportReview.left-out.length == 0 ? Theme.bone-3 : Theme.attention;
                }
            }
            if ImportReview.stage != "undone" && ImportReview.left-out.length > 0: Rectangle {
                min-height: 60px;
                preferred-height: min(200px, ImportReview.left-out.length * 26px);
                vertical-stretch: 1;
                background: Theme.ground-band;
                border-radius: Theme.r-control;
                Flickable {
                    VerticalLayout {
                        alignment: start;
                        padding-left: Theme.s2; padding-right: Theme.s2;
                        for r in ImportReview.left-out: HorizontalLayout {
                            accessible-role: text;
                            accessible-id: "app.import-review.left-out";
                            accessible-value: r.item + " — " + r.reason;
                            height: 26px; spacing: Theme.s3;
                            Text { horizontal-stretch: 1; text: r.item; overflow: elide; vertical-alignment: center; font-family: Theme.family; font-size: Theme.control; color: Theme.bone; }
                            Text { horizontal-stretch: 1; text: r.reason; overflow: elide; vertical-alignment: center; horizontal-alignment: right; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3; }
                        }
                        if ImportReview.left-out-more > 0: Text {
                            height: 26px; vertical-alignment: center;
                            text: @tr("… and {} more", ImportReview.left-out-more);
                            font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3;
                        }
                    }
                }
            }
            if ImportReview.error != "": Text {
                accessible-role: text; accessible-id: "app.import-review.error"; accessible-value: self.text;
                text: ImportReview.error; wrap: word-wrap;
                font-family: Theme.family; font-size: Theme.control; color: Theme.fault;
            }
            HorizontalLayout {
                spacing: Theme.s2;
                alignment: end;
                if ImportReview.stage == "preview": PlateButton { accessible-id: "app.import-review.cancel"; accessible-role: button; compact: true; label: @tr("CANCEL"); clicked => { ImportReview.cancel(); } }
                if ImportReview.stage == "preview": PlateButton { accessible-id: "app.import-review.run"; accessible-role: button; compact: true; label: @tr("IMPORT"); tone: Theme.live; tooltip: @tr("Import what is listed above. Undo stays possible afterwards."); clicked => { ImportReview.run(); } }
                if ImportReview.stage == "done": PlateButton { accessible-id: "app.import-review.undo"; accessible-role: button; compact: true; label: @tr("UNDO IMPORT"); tooltip: @tr("Put the library back exactly as it was before this import"); clicked => { ImportReview.undo(); } }
                if ImportReview.stage == "done" || ImportReview.stage == "undone": PlateButton { accessible-id: "app.import-review.close"; accessible-role: button; compact: true; label: @tr("DONE"); tone: Theme.live; clicked => { ImportReview.close(); } }
            }
        }
    }
}
