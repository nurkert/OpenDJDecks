// Recording (SPEC §11): the recording level, the meter of what goes into the
// file, elapsed time, file size and the tracklist as it grows. `RecStrip`
// is the compact row for the global bar (source, level, meter); `RecPanel`
// is the full panel (Recordings section). Both read the `Rec` global, which
// `recorder.rs` keeps up to date every frame.

import { Theme } from "tokens.slint";
import { VLine, HLine } from "lines.slint";
import { Caps, PlateButton, KeyFocus, TooltipState, Field } from "controls.slint";

export struct RecTrack {
    // 1-based position in the recording.
    index: int,
    // Offset from the start, "00:12:34".
    time: string,
    title: string,
    artist: string,
}

export global Rec {
    in property <bool> recording;
    // Automatic start is armed (Preferences > Recording).
    in property <bool> armed;
    // Meter position 0..=1 (−48 … 0 dBFS) of the recorded signal.
    in property <float> level;
    in property <bool> clip;
    // "" while not recording.
    in property <string> elapsed;
    in property <string> size;
    in property <string> file;
    in property <[RecTrack]> tracks;
    // Recording level steps ("−6 dB" …) and the selected one.
    in property <[string]> gain-options;
    in property <int> gain;
    // [27] Loudness of what is recorded so far: integrated and short-term
    // ("−14.2 LUFS"), the true peak ("−0.8 dBTP"; over −1 dBTP it is
    // called out) and the clips (runs at full scale).
    in property <string> integrated;
    in property <string> short-term;
    in property <string> true-peak;
    in property <bool> peak-over;
    in property <int> clips;
    // The voice track being written beside the mix ("" = none).
    in property <string> voice-file;
    // Chapter markers set so far.
    in property <int> markers;
    callback toggle();
    // A chapter marker at the current time.
    callback mark();
    callback set-gain(int);
    // −1 / +1: one step down / up.
    callback step-gain(int);
}

// The level meter: a hairline track with the level as a solid line, red at
// clip.
component Meter inherits Rectangle {
    in property <float> level;
    in property <bool> clipping;
    height: 10px;
    HLine { y: (parent.height - self.height) / 2; width: parent.width; tone: Theme.rule-strong; form: "dashed"; }
    Rectangle {
        x: 0; y: (parent.height - 4px) / 2; height: 4px;
        width: parent.width * clamp(root.level, 0, 1);
        background: root.clipping ? Theme.fault : root.level > 0.875 ? Theme.attention : Theme.live;
    }
    // 0 dB mark.
    VLine { x: parent.width - 1px; height: parent.height; tone: Theme.rule-strong; }
}

// The recording level: click the left half for one step down, the right half
// for one step up; the wheel steps too.
component Level inherits Rectangle {
    accessible-label: TooltipState.name-for(self.accessible-id, @tr("INPUT LEVEL"), "");
    in property <bool> tall;
    accessible-role: spinbox;
    accessible-value: Rec.gain >= 0 && Rec.gain < Rec.gain-options.length ? Rec.gain-options[Rec.gain] : "";
    accessible-action-increment => { Rec.step-gain(1); }
    accessible-action-decrement => { Rec.step-gain(-1); }
    min-width: root.tall ? 56px : 72px;
    height: root.tall ? 44px : 26px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.rule-strong : Theme.rule;
    Text { x: 6px; height: parent.height; text: "−"; font-family: Theme.family; font-size: Theme.body; color: Theme.bone-3; vertical-alignment: center; }
    Text {
        width: parent.width; height: parent.height;
        text: Rec.gain >= 0 && Rec.gain < Rec.gain-options.length ? Rec.gain-options[Rec.gain] : "";
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-medium; color: Theme.bone;
        horizontal-alignment: center; vertical-alignment: center;
    }
    Text { x: parent.width - 14px; height: parent.height; text: "+"; font-family: Theme.family; font-size: Theme.body; color: Theme.bone-3; vertical-alignment: center; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Rec.step-gain(self.mouse-x < self.width / 2 ? -1 : 1); }
        scroll-event(e) => {
            if (e.delta-y > 0) { Rec.step-gain(1); } else if (e.delta-y < 0) { Rec.step-gain(-1); }
            accept
        }
    }
    KeyFocus { arrows: true; step(d) => { Rec.step-gain(d); } }
}

// Compact recording row for the global bar: source, level, meter. The REC
// button and the time stay where they are (rec.toggle, rec.time).
export component RecStrip inherits HorizontalLayout {
    // Kiosk: 44 px touch targets.
    in property <bool> tall;
    in property <bool> compact;
    spacing: Theme.s2;
    alignment: end;
    Caps {
        accessible-role: text; accessible-id: "rec.source"; accessible-value: self.text;
        text: @tr("MASTER"); vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        Level { accessible-id: "rec.level"; tall: root.tall; }
    }
    // Small windows: the elapsed time stays, the meter gives way.
    if !root.compact: VerticalLayout {
        alignment: center;
        Meter { accessible-role: progress-indicator; accessible-id: "rec.meter"; accessible-value: round(Rec.level * 100) + "%"; width: 72px; level: Rec.level; clipping: Rec.clip; }
    }
}

// One reading: a Label caps legend over its value (Control rank, 600).
component Reading inherits VerticalLayout {
    in property <string> test-id;
    in property <string> legend;
    in property <string> value;
    in property <bool> fault;
    alignment: center;
    spacing: 0px;
    Caps { text: root.legend; }
    Text {
        accessible-role: text; accessible-id: root.test-id; accessible-value: self.text;
        text: root.value;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
        color: root.fault ? Theme.fault : Theme.bone;
    }
}

// [27] Loudness, true peak and clips of a recording. Over −1 dBTP the true
// peak turns fault red, and clips get a struck red line beside their count
// (solid live line while there are none).
export component LoudnessRow inherits HorizontalLayout {
    in property <string> integrated;
    in property <string> short-term;
    in property <string> true-peak;
    in property <bool> peak-over;
    in property <int> clips;
    in property <bool> show-short: true;
    spacing: Theme.s4;
    height: 34px;
    Reading { test-id: "rec.loudness"; legend: @tr("LOUDNESS"); value: root.integrated; }
    if root.show-short: Reading { test-id: "rec.short-term"; legend: @tr("SHORT TERM"); value: root.short-term; }
    Reading { test-id: "rec.true-peak"; legend: @tr("TRUE PEAK"); value: root.true-peak; fault: root.peak-over; }
    HorizontalLayout {
        spacing: Theme.s2;
        VerticalLayout {
            padding-top: Theme.s1; padding-bottom: Theme.s1;
            VLine { weight: 2px; tone: root.clips > 0 ? Theme.fault : Theme.live; form: root.clips > 0 ? "struck" : "solid"; }
        }
        Reading { test-id: "rec.clips"; legend: @tr("CLIPS"); value: root.clips; fault: root.clips > 0; }
    }
    Rectangle { horizontal-stretch: 1; }
}

// [27] The tracklist of a finished recording, to edit before release.
export struct RecEditRow {
    index: int,
    // "12:34" or "1:02:03".
    time: string,
    title: string,
    artist: string,
    // A marker set by hand (no track behind it).
    marker: bool,
}

export global RecEdit {
    in property <bool> open;
    // The recording's name and "12 ENTRIES · 1:02:03".
    in property <string> name;
    in property <string> summary;
    in property <[RecEditRow]> rows;
    // A time that could not be read ("" = none).
    in property <string> error;
    // Opens the editor for a recording (its id).
    callback edit(int);
    // Return in the time field.
    callback set-time(int, string);
    // Every key typed in the title / artist fields (saved as typed).
    callback set-title(int, string);
    callback set-artist(int, string);
    callback remove(int);
    // A new entry after row `i` (−1: before the first).
    callback insert(int);
    // "text" or "cue": the file next to the recording, chapters into it.
    callback export(string);
    callback close();
}

export component TracklistEditor inherits VerticalLayout {
    accessible-role: groupbox;
    accessible-id: "rec.edit";
    spacing: Theme.s2;
    HorizontalLayout {
        spacing: Theme.s2;
        height: 32px;
        VerticalLayout {
            horizontal-stretch: 1; alignment: center;
            Text {
                text: RecEdit.name; overflow: elide;
                font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi; color: Theme.bone;
            }
            Caps { text: RecEdit.summary; overflow: elide; }
        }
        VerticalLayout { alignment: center; horizontal-stretch: 0; PlateButton { accessible-id: "rec.edit.export-text"; compact: true; label: @tr("EXPORT TEXT"); tone: Theme.live; tooltip: @tr("Write the tracklist as text (minutes, artist, title) next to the recording"); clicked => { RecEdit.export("text"); } } }
        VerticalLayout { alignment: center; horizontal-stretch: 0; PlateButton { accessible-id: "rec.edit.export-cue"; compact: true; label: @tr("EXPORT CUE"); tone: Theme.live; tooltip: @tr("Write the CUE sheet next to the recording and the chapters into its files"); clicked => { RecEdit.export("cue"); } } }
        VerticalLayout { alignment: center; horizontal-stretch: 0; PlateButton { accessible-id: "rec.edit.close"; compact: true; label: @tr("CLOSE"); tooltip: @tr("Back to the recordings"); clicked => { RecEdit.close(); } } }
    }
    if RecEdit.error != "": Text {
        accessible-role: text; accessible-id: "rec.edit.error"; accessible-value: self.text;
        text: RecEdit.error; overflow: elide;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.fault;
    }
    HorizontalLayout {
        spacing: Theme.s2; height: 18px;
        Rectangle { width: 22px; }
        Caps { width: 76px; text: @tr("TIME"); vertical-alignment: center; }
        Caps { horizontal-stretch: 2; min-width: 0px; text: @tr("TITLE"); vertical-alignment: center; }
        Caps { horizontal-stretch: 1; min-width: 0px; text: @tr("ARTIST"); vertical-alignment: center; }
        Rectangle { width: max(Theme.touch-min, 32px) * 2 + Theme.key-gap; }
    }
    HLine { tone: Theme.rule; }
    Rectangle {
        vertical-stretch: 1;
        min-height: 34px;
        Flickable {
            VerticalLayout {
                alignment: start;
                spacing: Theme.key-gap;
                for r[i] in RecEdit.rows: HorizontalLayout {
                    accessible-role: groupbox; accessible-id: "rec.edit.row\{i}"; accessible-value: r.time + " " + r.title;
                    spacing: Theme.s2;
                    VerticalLayout {
                        alignment: center;
                        Text { width: 22px; text: r.index; font-family: Theme.family; font-size: Theme.control; color: r.marker ? Theme.attention : Theme.bone-3; horizontal-alignment: right; }
                    }
                    Field {
                        accessible-id: "rec.edit.time\{i}";
                        width: 76px;
                        text: r.time;
                        placeholder: @tr("TIME");
                        tone: Theme.w656;
                        accessible-description: @tr("Minutes and seconds such as 12:34; Return moves the entry there");
                        accepted(t) => { RecEdit.set-time(i, t); }
                    }
                    Field {
                        accessible-id: "rec.edit.title\{i}";
                        horizontal-stretch: 2; min-width: 60px;
                        text: r.title;
                        placeholder: r.marker ? @tr("MARKER NAME") : @tr("TITLE");
                        tone: Theme.w656;
                        edited(t) => { RecEdit.set-title(i, t); }
                    }
                    Field {
                        accessible-id: "rec.edit.artist\{i}";
                        horizontal-stretch: 1; min-width: 48px;
                        text: r.artist;
                        placeholder: @tr("ARTIST");
                        tone: Theme.w656;
                        edited(t) => { RecEdit.set-artist(i, t); }
                    }
                    PlateButton {
                        accessible-id: "rec.edit.insert\{i}";
                        horizontal-stretch: 0; glyph: "plus";
                        tooltip: @tr("Insert an entry after this one");
                        clicked => { RecEdit.insert(i); }
                    }
                    PlateButton {
                        accessible-id: "rec.edit.remove\{i}";
                        horizontal-stretch: 0; glyph: "close"; tone: Theme.fault;
                        tooltip: @tr("Remove this entry");
                        clicked => { RecEdit.remove(i); }
                    }
                }
                if RecEdit.rows.length == 0: Text {
                    text: @tr("No entries. Insert one for each track of the mix.");
                    font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3;
                }
                HorizontalLayout {
                    alignment: start;
                    PlateButton {
                        accessible-id: "rec.edit.insert-first";
                        compact: true; glyph: "plus"; label: @tr("INSERT AT START");
                        tooltip: @tr("Insert an entry before the first one");
                        clicked => { RecEdit.insert(-1); }
                    }
                }
            }
        }
    }
}

// The finished recordings: name, date and length, loudness, and their
// actions.
export struct RecordingRow {
    id: int,
    name: string,
    detail: string,
    path: string,
    // [27] "−14.2 LUFS · −0.8 dBTP · 0 CLIPS" ("" before it was measured).
    loudness: string,
    // Clipped or past −1 dBTP: the loudness line in fault red.
    over: bool,
    // A voice track lies beside it.
    voice: bool,
}

export component RecordingList inherits VerticalLayout {
    in property <[RecordingRow]> rows;
    callback reveal(int);
    callback split(int);
    spacing: Theme.s1;
    if root.rows.length == 0: Text {
        text: @tr("No recordings yet. Press RECORD in Perform, or the record button on your controller.");
        wrap: word-wrap; font-family: Theme.family; font-size: Theme.body; color: Theme.bone-3;
    }
    for r[i] in root.rows: row := Rectangle {
        accessible-role: groupbox; accessible-id: "rec.list.row\{i}"; accessible-value: r.name;
        height: 64px;
        VLine { x: 0; y: 8px; height: parent.height - 16px; tone: Theme.w656; }
        property <length> keys-w: keys.preferred-width + Theme.s2;
        Text { x: 16px; y: 6px; width: parent.width - 16px - row.keys-w; text: r.name; overflow: elide; font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi; color: Theme.bone; }
        Caps { x: 16px; y: 27px; width: parent.width - 16px - row.keys-w; overflow: elide; text: r.voice ? @tr("{}  ·  VOICE TRACK", r.detail) : r.detail; }
        Caps {
            accessible-role: text; accessible-id: "rec.list.loudness\{i}"; accessible-value: self.text;
            x: 16px; y: 43px; width: parent.width - 16px - row.keys-w; overflow: elide;
            text: r.loudness; font-weight: Theme.weight-semi;
            color: r.over ? Theme.fault : Theme.bone-2;
        }
        TouchArea { width: parent.width - row.keys-w; clicked => { root.reveal(r.id); } }
        keys := HorizontalLayout {
            x: parent.width - self.width; y: 8px; width: self.preferred-width; height: 26px;
            spacing: Theme.key-gap;
            PlateButton { accessible-id: "rec.list.tracklist\{i}"; compact: true; label: @tr("TRACKLIST"); tone: Theme.w656; tooltip: @tr("Edit the tracklist and export it as text or CUE"); clicked => { RecEdit.edit(r.id); } }
            PlateButton { accessible-id: "rec.list.reveal\{i}"; compact: true; label: @tr("SHOW FILE"); tooltip: @tr("Show the recording in the file manager"); clicked => { root.reveal(r.id); } }
            PlateButton { accessible-id: "rec.list.split\{i}"; compact: true; label: @tr("SPLIT INTO TRACKS"); tone: Theme.w656; tooltip: @tr("Cut the recording into one file per played track"); clicked => { root.split(r.id); } }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

// The recording panel: REC, level, meter, elapsed time, file size and the
// live tracklist.
export component RecPanel inherits VerticalLayout {
    spacing: Theme.s2;
    HorizontalLayout {
        spacing: Theme.s2;
        height: 32px;
        VerticalLayout {
            horizontal-stretch: 0; alignment: center;
            PlateButton {
                accessible-role: button; accessible-id: "rec.panel.toggle";
                accessible-checkable: true; accessible-checked: Rec.recording;
                horizontal-stretch: 0; compact: true;
                label: Rec.recording ? @tr("STOP") : @tr("RECORD");
                active: Rec.recording; tone: Theme.fault;
                tooltip: Rec.recording ? @tr("Stop recording") : @tr("Record the master output");
                command: "record.toggle";
                clicked => { Rec.toggle(); }
            }
        }
        VerticalLayout {
            horizontal-stretch: 0; alignment: center;
            PlateButton {
                accessible-id: "rec.mark";
                horizontal-stretch: 0; compact: true;
                enabled: Rec.recording;
                label: @tr("MARK");
                tooltip: @tr("Set a chapter marker here: it goes into the tracklist and into the file");
                command: "record.mark";
                clicked => { Rec.mark(); }
            }
        }
        VerticalLayout { alignment: center; Level { accessible-id: "rec.panel.level"; } }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Meter { accessible-role: progress-indicator; accessible-id: "rec.panel.meter"; accessible-value: round(Rec.level * 100) + "%"; min-width: 48px; level: Rec.level; clipping: Rec.clip; }
        }
        Text {
            accessible-role: text; accessible-id: "rec.panel.time"; accessible-value: Rec.elapsed;
            min-width: 60px;
            text: Rec.recording ? Rec.elapsed : "--:--:--";
            font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi;
            color: Rec.recording ? Theme.bone : Theme.bone-3;
            vertical-alignment: center; horizontal-alignment: right;
        }
        Text {
            accessible-role: text; accessible-id: "rec.size"; accessible-value: Rec.size;
            min-width: 40px;
            text: Rec.recording ? Rec.size : "";
            font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2;
            vertical-alignment: center; horizontal-alignment: right;
        }
    }
    if Rec.recording || Rec.armed: HorizontalLayout {
        spacing: Theme.s3;
        VLine { weight: 2px; tone: Theme.fault; form: Rec.recording ? "solid" : "dashed"; }
        Text {
            accessible-role: text; accessible-id: "rec.file"; accessible-value: self.text;
            horizontal-stretch: 1;
            text: !Rec.recording ? @tr("Armed: recording starts when the master carries sound")
                : Rec.voice-file != "" ? @tr("{} · voice in {}", Rec.file, Rec.voice-file) : Rec.file;
            font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; overflow: elide;
        }
    }
    // [27] Loudness while recording: integrated, short-term, true peak and
    // clips, each a Label legend over its value.
    if Rec.recording: LoudnessRow {
        integrated: Rec.integrated; short-term: Rec.short-term;
        true-peak: Rec.true-peak; peak-over: Rec.peak-over; clips: Rec.clips;
    }
    HLine { tone: Theme.rule; }
}

// The recording bar of Prepare (shown with the top-bar REC toggle): source,
// level, meter, the record button and the elapsed time on one 30 px row.
export component RecBar inherits Rectangle {
    height: 34px;
    background: Theme.ground-band; border-radius: Theme.r-panel;
    HorizontalLayout {
        padding-left: Theme.s4; padding-right: Theme.s4;
        spacing: Theme.s3;
        RecStrip { }
        Rectangle {
            accessible-role: checkbox; accessible-id: "rec.toggle";
            accessible-label: TooltipState.name-for(self.accessible-id, @tr("RECORD"), "");
            KeyFocus { radius: 12px; activate => { Rec.toggle(); } }
            accessible-checkable: true; accessible-checked: Rec.recording;
            width: 30px;
            Rectangle {
                x: 3px; y: (parent.height - 24px) / 2; width: 24px; height: 24px; border-radius: 12px;
                border-width: 1px; border-color: Rec.recording ? Theme.fault : Theme.rule-strong;
                background: bt.has-hover ? Theme.plate : transparent;
                Rectangle { x: 7px; y: 7px; width: 10px; height: 10px; border-radius: 5px; background: Rec.recording ? Theme.fault : Theme.bone-3; }
            }
            bt := TouchArea { mouse-cursor: pointer; clicked => { Rec.toggle(); } }
        }
        Text {
            accessible-role: text; accessible-id: "rec.time"; accessible-value: self.text;
            text: Rec.recording ? Rec.elapsed : "00:00:00";
            font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
            color: Rec.recording ? Theme.bone : Theme.bone-3; vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

// The tracklist as it grows while recording.
component LiveTracklist inherits VerticalLayout {
    accessible-role: list; accessible-id: "rec.tracklist";
    spacing: Theme.key-gap;
    if Rec.tracks.length == 0: Text {
        text: @tr("The tracklist grows here as tracks become audible.");
        font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3;
    }
    for t in Rec.tracks: HorizontalLayout {
        accessible-role: list-item; accessible-id: "rec.tracklist.row\{t.index}"; accessible-value: t.title;
        spacing: Theme.s3;
        height: 22px;
        Text { width: 22px; text: t.index; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3; horizontal-alignment: right; vertical-alignment: center; }
        Text { width: 64px; text: t.time; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; }
        Text { horizontal-stretch: 1; text: t.artist == "" ? t.title : t.artist + " — " + t.title; font-family: Theme.family; font-size: Theme.control; color: Theme.bone; vertical-alignment: center; overflow: elide; }
    }
}

// [27] The recordings page: the recording panel over the live tracklist
// and the finished mixes (one scroll area), or the tracklist editor of a
// finished mix in their place.
export component RecordingsPage inherits VerticalLayout {
    in property <[RecordingRow]> rows;
    callback reveal(int);
    callback split(int);
    spacing: Theme.s2;
    if !RecEdit.open: RecPanel { vertical-stretch: 0; }
    if !RecEdit.open: Flickable {
        vertical-stretch: 1;
        min-height: 0px;
        VerticalLayout {
            alignment: start;
            spacing: Theme.s2;
            if Rec.recording: LiveTracklist { }
            RecordingList {
                rows: root.rows;
                reveal(id) => { root.reveal(id); }
                split(id) => { root.split(id); }
            }
        }
    }
    if RecEdit.open: TracklistEditor { vertical-stretch: 1; }
}
