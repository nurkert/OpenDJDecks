// CREATE (roadmap [70]): the fourth work mode, for what DJs make before a
// set. MELODY plays the next track's melody from one note, DRUMS is a small
// drum machine, THEORY shows which notes fit. Each view reads left to right,
// then down: its zones, the RESULT bar, and a slim deck strip so the decks
// stay in view (they keep playing; CREATE only changes what is shown).
//
// The shell ([70]): every zone says what comes there and what you will do
// in it. Controls that are not there yet are drawn disabled with their
// later names, never as working keys. State lives in the `Create` global.
// [71] fills MELODY's SOURCE: a note picked on a zoomed waveform, its pitch
// and a correction, and HEAR. [72] puts the note on NOTES' pads at other
// pitches, with an octave switch and a FAR warning on large shifts. [73]
// plays them in a key: the root and scale from the other deck, the next
// track or by hand, on the pads (SNAP TO SCALE) and the keyboard strip.
// [74] ARRANGE puts the notes in order on 32 steps of the master grid:
// played in with REC, or typed; a tapped step moves, changes or goes; PLAY
// plays the strip on the audition voice in time with the master. [75]
// RESULT renders the notes into a new file with a beatgrid and a hot cue
// per note (SINGLE NOTES or MELODY, at the master or the track's tempo),
// saying first what the stick formats take, then READY in green. [76]
// TO PLAYLIST puts the rendered file into a playlist (the browser's own
// list of playlists, or a new one); registered sticks get it through the
// playlists they sync. [78] FITS and THEORY show what fits: the key's
// notes and chords against the deck playing now, a chord's notes on the
// keyboard strip, both decks' keys and the neighbours of the key, a check
// of the strip's melody, and reasons in plain words while HINTS is on.
// [82] The first screen is never empty: SOURCE holds the built-in TONE
// until a note is picked from a track, an empty strip (also in THEORY)
// offers STARTERS and empty drum steps the drum STARTERS; each goes only
// onto an empty strip or empty steps, and reads STARTER while unchanged.

import { Theme } from "tokens.slint";
import { VLine } from "lines.slint";
import { MenuTarget } from "structs.slint";
import { Caps, PlateButton, Stepper, Field, KeyFocus, LineToggle, TipArea, TooltipState, FocusRing, ArmedOutline, Knob } from "controls.slint";

// One deck in the strip (create.rs, from the engine's deck state).
export struct CreateDeck {
    deck: int,
    loaded: bool,
    playing: bool,
    // Tempo as played, "124.0" ("" = no grid or no track).
    bpm: string,
    // The loaded track's key in the chosen notation ("" = none).
    key: string,
    // Position in the track 0..1.
    progress: float,
    // Position in the bar 0..1 (0 without a grid), unsmoothed.
    bar: float,
    // Channel level 0..1 (peak, unsmoothed).
    level: float,
}

// [71] The note picked in SOURCE (create.rs).
export struct CreateNote {
    picked: bool,
    // "deck1", "deck2", "player" or [82] "tone" (the built-in tone).
    source: string,
    // "Title · Artist".
    title: string,
    // Where IN is in the track ("1:10.2") and the note's length ("0.50 s").
    start: string,
    length: string,
    // The zoomed waveform, and IN, OUT and the start of the fade at OUT
    // across it (0..1).
    wave: image,
    in-at: float,
    out-at: float,
    fade-at: float,
    // The pitch in use: "A3" and "+12 ct" ("—" and "" = none).
    note: string,
    cents: string,
    // "detected", "unsure", "set" (by you), "measuring" or [82] "builtin"
    // (the built-in tone: its pitch is known).
    state: string,
    // Why there is no pitch: "short", "silent", "none" ("" = there is one).
    why: string,
    // HEAR plays.
    hearing: bool,
}

// [72] One pad of NOTES: the picked note at another pitch (create.rs).
export struct CreatePad {
    // Off without a picked note with a pitch.
    enabled: bool,
    // The target note, "C4".
    note: string,
    // Semitones from the source note.
    shift: int,
    // More than 7 semitones away: it may not sound natural.
    far: bool,
    // Rendered: plays at once.
    ready: bool,
    // Plays on the audition voice.
    playing: bool,
}

// [73] The key NOTES plays in (create.rs).
export struct CreateKey {
    // A key is chosen or found.
    chosen: bool,
    // The root's name ("A") and the scale ("major", "minor", "dorian" …).
    root: string,
    scale: string,
    // The key in the wheel notation, a small label beside ("" = a mode, or
    // keys are shown as note names anyway).
    wheel: string,
    // Where it comes from: "deck" (the other deck, followed), "next" (the
    // next track), "set" (by you) or [82] "starter" (set by a starter
    // melody while no key was chosen); the deck it follows (0 = none).
    from: string,
    deck: int,
    // The scale's notes and its chords: "A B C D E F G", "Am Bdim C …".
    notes: string,
    chords: string,
}

// [73] One key of the keyboard strip (create.rs).
export struct CreateKeyNote {
    // "A3".
    name: string,
    // "root", "scale" (in it), "out" (out of it), "" (no key).
    kind: string,
    // On a pad.
    pad: bool,
    // Sounds on the audition voice.
    playing: bool,
    // [78] A note of the chosen chord.
    chord: bool,
}

// [78] One note or chord of the key in FITS: whether it fits the key
// playing now ("fits", "out" = not in it, "" = nothing to compare with),
// and the chord chosen (its notes marked on the keyboard strip).
export struct CreateChip {
    name: string,
    fits: string,
    selected: bool,
}

// [78] The key playing now, which FITS compares with (create.rs).
export struct CreateFits {
    // The deck playing now (0 = none), why there is no key: "none" (no
    // deck plays), "no-key" (its key is not known) or "".
    deck: int,
    why: string,
    // Its key: root, scale, wheel notation (as `CreateKey`), and in
    // words ("B major").
    root: string,
    scale: string,
    wheel: string,
    words: string,
    // How many of the chosen key's 7 notes and 7 chords fit it.
    notes: int,
    chords: int,
}

// [78] One deck's key in THEORY (create.rs).
export struct CreateTheoryDeck {
    deck: int,
    loaded: bool,
    playing: bool,
    // The deck FITS compares with.
    now: bool,
    // Its key ("" = none known), as `CreateKey`.
    root: string,
    scale: string,
    wheel: string,
}

// [78] A key next to the chosen one that moves smoothly (create.rs).
export struct CreateNeighbour {
    // "relative" (the same notes), "up" or "down" (a fifth, one note
    // changes).
    how: string,
    root: string,
    scale: string,
    wheel: string,
    // A deck whose track is in this key (0 = none).
    deck: int,
}

// [78] The check of the strip's melody against the chosen key.
export struct CreateCheck {
    // "fits", "out", "empty" (no notes) or "no-key"; the key in words
    // ("E major").
    state: string,
    key: string,
    // Its different notes, and the ones out of the key ("F, C").
    distinct: int,
    outside: string,
}

// [74] One step of the arrange strip (create.rs).
export struct CreateStep {
    // The note that starts here, spelled as the key ("" = none).
    note: string,
    // The note before still sounds here.
    held: bool,
    // The gap before it: 0 inside a beat, 1 a new beat, 2 a new bar.
    gap: int,
    // The bar it starts, from 1 (0 = not a bar's first step).
    bar: int,
    selected: bool,
    // PLAY is on this step.
    playing: bool,
    // REC fills this step next (step by step).
    cursor: bool,
}

// [75] What RENDER would make, and what it made (create.rs).
export struct CreateRender {
    // "single" (one cue per distinct note) or "melody" (one per note in order).
    layout: string,
    // "master" or "track"; both tempos ("124.0"; "" = the track has no
    // grid), and the one in use.
    tempo-from: string,
    master: string,
    track: string,
    bpm: string,
    // The notes in the file, its bars and its hot cues.
    notes: int,
    bars: int,
    cues: int,
    // What the stick formats take: "fits", "over" ("" = nothing to render),
    // and the line that says it.
    fits: string,
    check: string,
    // "rendering", "ready" (the file is in the library) or "".
    state: string,
    // RENDER can run.
    can: bool,
    // [77] SEND TO PERFORM: "sending", "sent" (the MELODY bank holds these
    // notes) or "", and whether there is a note to send.
    send: string,
    can-send: bool,
}

// [79] One pad of DRUMS (create.rs): the pad selected (the knobs set a
// kit pad, the step row shows its steps), sounding (on the audition voice
// or in its sampler slot), and set away from the kit's own settings. [80]
// Pads 9 to 16: the sample's name and whether one is loaded; any pad:
// whether it has steps.
export struct CreateDrumPad {
    selected: bool,
    playing: bool,
    set: bool,
    name: string,
    loaded: bool,
    steps: bool,
}

// [80] One step of the drum machine's row: set for the selected pad, set
// for another pad (a mark at its foot), sounding now.
export struct CreateDrumStep {
    on: bool,
    others: bool,
    playing: bool,
}

// [80] The drum machine as the sampler's sequencer has it: PLAY (and
// whether step 1 waits for the next bar), REC, SWING in percent, HALF
// TIME, whether UNDO has steps to bring back, the steps set on the
// selected pad; for RESULT the steps set
// over all pads, the PATTERN pad it saves to (0: none free), its bars,
// the master tempo, and whether it is saved as it is (and the sampler on
// the DRUMS bank: sent). [81] RENDER LOOP: the loop's bars, whether it
// renders or is READY ("rendering", "ready", ""), whether it can, and what
// the stick formats take of its cues (as CreateRender's).
export struct CreateDrumMachine {
    playing: bool,
    waiting: bool,
    rec: bool,
    swing: int,
    half-time: bool,
    can-undo: bool,
    steps-set: int,
    hits: int,
    pattern: int,
    bars: int,
    bpm: string,
    saved: bool,
    sent: bool,
    loop-bars: int,
    loop-state: string,
    can-loop: bool,
    cues: int,
    fits: string,
    check: string,
}

export global Create {
    // The view: "melody", "drums" or "theory" (remembered, shell.rs).
    in-out property <string> view: "melody";
    in property <[CreateDeck]> decks;
    // [71] SOURCE: the picked note, and whether the player holds a track.
    in property <CreateNote> note;
    in property <bool> player-ready;
    // Picks a note from "deck1", "deck2" or "player" where it stands.
    callback pick(string);
    // IN or OUT ("in", "out") dragged to a share of the waveform, let go,
    // or moved a step by the arrow keys.
    callback drag-handle(string, float);
    callback drag-done();
    callback nudge(string, int);
    // The waveform dragged by a share of its width.
    callback pan(float);
    callback hear();
    // Corrections: semitones, cents, a typed name (false: not a note).
    callback step-note(int);
    callback step-cents(int);
    callback type-note(string) -> bool;
    // [72] The pads, their octave (-2..2), why they are off ("none": no
    // note, "pitch": no pitch, "" = on), and a source note nearer the FAR
    // pads ("" = none is FAR).
    in property <[CreatePad]> pads: [{}, {}, {}, {}, {}, {}, {}, {}];
    in property <int> octave;
    in property <string> pads-why: "none";
    in property <string> pads-nearer;
    callback play-pad(int);
    callback step-octave(int);
    // [73] The key and scale; SNAP TO SCALE; HAPPY and SAD beside MAJOR
    // and MINOR; the modes under MORE shown.
    in property <CreateKey> key;
    in property <bool> snap: true;
    in property <bool> hints: true;
    in-out property <bool> more;
    // What NEXT TRACK takes: "" (a key), "none" (no next track in the
    // queue or the set), "no-key" (its key is not known); its title.
    in property <string> next-why: "none";
    in property <string> next-title;
    // The keyboard strip: 24 keys from a C (MIDI `keyboard-start`), played
    // once a note with a pitch is picked.
    in property <[CreateKeyNote]> keyboard;
    in property <int> keyboard-start: 48;
    in property <bool> keyboard-on;
    callback step-root(int);
    callback choose-scale(string);
    callback key-from-deck();
    callback key-from-next();
    callback set-snap(bool);
    callback set-hints(bool);
    callback play-key(int);
    // [74] The arrange strip: 32 steps, the grid ("1/4", "1/8", "1/16"),
    // the notes and whole bars it holds, the selected step (-1 = none).
    in property <[CreateStep]> steps;
    in property <string> grid: "1/8";
    in property <int> notes;
    in property <int> bars;
    in property <int> selected: -1;
    // REC armed, and where a note goes now: "grid" (the nearest step while
    // PLAY or the master deck plays) or "steps" (from the cursor on).
    in property <bool> rec;
    in property <string> rec-mode: "steps";
    in property <int> rec-cursor;
    // PLAY runs; LOOP; UNDO can bring back what CLEAR or typing replaced.
    in property <bool> playing;
    in property <bool> looped;
    in property <bool> can-undo;
    // What the last typing could not read ("H4, X"), and whether it had
    // more than 32 steps.
    in property <string> typed-bad;
    in property <bool> typed-long;
    // The master tempo ("124.0"); the strip as it could be typed.
    in property <string> tempo: "120.0";
    in property <string> steps-text;
    callback set-grid(string);
    callback toggle-rec();
    callback toggle-play();
    callback set-loop(bool);
    callback clear-steps();
    callback undo-steps();
    callback select-step(int);
    // The selected note a step left or right; a scale step (or with the
    // modifier a semitone) up or down; deleted.
    callback move-step(int);
    callback shift-step(int, bool);
    callback delete-step();
    // Typed note names: they replace the strip from step 1.
    callback type-steps(string);
    // [75] RESULT: the layout, the tempo, RENDER.
    in property <CreateRender> render;
    callback set-layout(string);
    callback set-tempo-from(string);
    callback render-file();
    // [76] TO PLAYLIST: the playlists and sets the browser's row menu offers
    // (the ones added to last, and all), and adding the rendered track to
    // one (its id; 0 = a new playlist). Raising `open-picker` opens the
    // menu (demo screenshots).
    in property <[MenuTarget]> playlists;
    in property <[MenuTarget]> recent;
    callback to-playlist(int);
    in-out property <int> open-picker;
    // [77] SEND TO PERFORM: the notes into the sampler's MELODY bank.
    callback send-to-perform();
    // [78] What fits: the key playing now, the chosen key's notes and
    // chords against it, the chord marked on the strip (-1 = none); the
    // decks' keys, the chosen key's neighbours, the check of the strip's
    // melody; the reasons in plain words (shown with the hints), the
    // first for FITS.
    in property <CreateFits> fit;
    in property <[CreateChip]> fit-notes;
    in property <[CreateChip]> fit-chords;
    in property <int> chord: -1;
    in property <[CreateTheoryDeck]> theory-decks;
    in property <[CreateNeighbour]> neighbours;
    in property <CreateCheck> check;
    in property <[string]> why;
    in property <string> fit-why;
    callback choose-chord(int);
    // [79] DRUMS: the built-in kit ("tight", "warm", "dusty"), its 8 pads,
    // the pad the knobs set and its settings (PITCH in semitones -12..12,
    // DECAY and TONE 0..100; the knobs write them back), the kit's own
    // settings for it (a double-click on a knob brings them back) and how
    // long it sounds ("0.35 s").
    in property <string> kit: "tight";
    in property <[CreateDrumPad]> drum-pads: [{}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}];
    in property <int> drum-selected;
    // [80] The kit pad the knobs show (the last one selected while a
    // sample pad is).
    in property <int> drum-knob-pad;
    in-out property <float> drum-pitch;
    in-out property <float> drum-decay: 50;
    in-out property <float> drum-tone: 50;
    in property <float> kit-pitch;
    in property <float> kit-decay: 50;
    in property <float> kit-tone: 50;
    in property <string> drum-length;
    // A pad pressed (selected and played), a kit chosen, a knob turned
    // ("pitch", "decay", "tone").
    callback play-drum(int);
    callback choose-kit(string);
    callback set-drum(string, float);
    // [80] The step row of the selected pad, the sequencer and RESULT.
    in property <[CreateDrumStep]> drum-steps: [{}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}];
    in property <CreateDrumMachine> drum-machine: { pattern: 1, bars: 1, loop-bars: 4 };
    callback toggle-drum-step(int);
    callback drum-play();
    callback drum-rec();
    callback drum-clear();
    callback drum-undo();
    callback set-swing(int);
    callback set-half-time(bool);
    callback load-sample();
    callback save-pattern();
    callback send-drums();
    // [81] RENDER LOOP, and its bars a step up or down.
    callback render-loop();
    callback step-loop-bars(int);
    // [82] The starter on the strip and on the drum steps while unchanged
    // ("" = none), and putting one there (only onto an empty strip or empty
    // steps).
    in property <string> starter;
    in property <string> drum-starter;
    callback use-starter(string);
    callback use-drum-starter(string);
    // A starter's name in capitals.
    public pure function starter-name(id: string) -> string {
        return id == "rise" ? @tr("RISE") : id == "call" ? @tr("CALL") : id == "steps" ? @tr("STEPS") : id == "pulse" ? @tr("PULSE")
            : id == "straight" ? @tr("STRAIGHT") : id == "broken" ? @tr("BROKEN") : id == "spacious" ? @tr("SPACIOUS") : "";
    }
    // A pad's name: the kit's sound, a sample's name, else its number.
    public pure function drum-pad-name(i: int) -> string {
        return i < 8 ? root.drum-name(i) : i < root.drum-pads.length && root.drum-pads[i].name != "" ? root.drum-pads[i].name : @tr("PAD {}", i + 1);
    }
    // A pad's sound in capitals.
    public pure function drum-name(i: int) -> string {
        return i == 0 ? @tr("KICK") : i == 1 ? @tr("SNARE") : i == 2 ? @tr("HAT") : i == 3 ? @tr("OPEN HAT")
            : i == 4 ? @tr("CLAP") : i == 5 ? @tr("TOM 1") : i == 6 ? @tr("TOM 2") : i == 7 ? @tr("RIDE") : "";
    }
    // A kit's name in capitals.
    public pure function kit-name(id: string) -> string {
        return id == "tight" ? @tr("TIGHT") : id == "warm" ? @tr("WARM") : id == "dusty" ? @tr("DUSTY") : "";
    }
    // PITCH in semitones: "+3 st", "0 st".
    public pure function pitch-text(v: float) -> string {
        return @tr("{} st", (Math.round(v) > 0 ? "+" : "") + Math.round(v));
    }
    // The selected step holds a note.
    public pure function step-has-note() -> bool {
        return root.selected >= 0 && root.selected < root.steps.length && root.steps[root.selected].note != "";
    }
    // A scale's name in capitals.
    public pure function scale-name(id: string) -> string {
        return id == "major" ? @tr("MAJOR") : id == "minor" ? @tr("MINOR") : id == "dorian" ? @tr("DORIAN")
            : id == "phrygian" ? @tr("PHRYGIAN") : id == "lydian" ? @tr("LYDIAN") : id == "mixolydian" ? @tr("MIXOLYDIAN")
            : id == "harmonic_minor" ? @tr("HARMONIC MINOR") : "";
    }
    // The key in words: "A MINOR" ("" = none).
    public pure function key-name() -> string {
        return root.key.chosen ? root.key-of(root.key.root, root.key.scale) : "";
    }
    // Any key in words: "E MAJOR" ("" = none).
    public pure function key-of(r: string, scale: string) -> string {
        return r == "" ? "" : r + " " + root.scale-name(scale);
    }
    // The distance of a pad from the source note: "+3", "-5", "0".
    public pure function shift-text(s: int) -> string {
        return s > 0 ? "+" + s : "" + s;
    }
}

// Prose in a zone: wraps to the width its column gives it.
component Prose inherits Text {
    font-family: Theme.family; font-size: Theme.body; color: Theme.bone-2;
    wrap: word-wrap;
    min-width: 0px; preferred-width: 0px;
}

// One zone of a view: a band-charcoal surface with its name in caps, a
// sentence on what it is for, and the parts that come there.
component Zone inherits Rectangle {
    in property <string> title;
    in property <string> summary;
    accessible-role: groupbox;
    accessible-label: root.title;
    background: Theme.ground-band;
    border-radius: Theme.r-panel;
    VerticalLayout {
        padding: Theme.s3; spacing: Theme.s3;
        Caps { text: root.title; color: Theme.bone-2; font-weight: Theme.weight-semi; }
        if root.summary != "": Prose { text: root.summary; }
        @children
        Rectangle { vertical-stretch: 1; }
    }
}

// [74] A zone whose parts scroll under its name where the window is too
// short for them (the wheel scrolls; a drag stays with the control under
// the pointer), so the RESULT bar and the deck strip stay in view.
component ScrollZone inherits Rectangle {
    in property <string> title;
    accessible-role: groupbox;
    accessible-label: root.title;
    background: Theme.ground-band;
    border-radius: Theme.r-panel;
    VerticalLayout {
        padding: Theme.s3; spacing: Theme.s3;
        padding-bottom: Theme.s1;
        Caps { text: root.title; color: Theme.bone-2; font-weight: Theme.weight-semi; }
        fl := Flickable {
            vertical-stretch: 1;
            min-height: 0px;
            mouse-drag-pan-enabled: false;
            content-width: self.width;
            content-height: max(self.height, body.min-height);
            body := VerticalLayout {
                width: fl.width; height: fl.content-height;
                spacing: Theme.s3;
                @children
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}

// [73] One key of the strip: the root in bone, the scale's notes filled,
// the notes out of it dimmed to the ground with a hairline, so the three
// read by fill against outline and never by hue; sodium while it sounds.
// A short line at its foot marks a key that is on a pad; a dot ([78]) a
// note of the chord chosen in FITS or THEORY (at the top of a white key,
// between the black ones, and at the foot of a black key).
component StripKey inherits Rectangle {
    in property <CreateKeyNote> note;
    in property <int> index;
    in property <bool> black;
    // The keyboard's cursor is here (the strip has the focus).
    in property <bool> cursor;
    callback pressed();
    property <bool> lit: root.note.playing;
    property <bool> filled: root.lit || root.note.kind == "root" || root.note.kind == "scale";
    property <color> ink: root.filled ? Theme.ground : Theme.bone-3;
    accessible-role: text;
    accessible-id: root.visible ? "create.keyboard.key" + root.index : "";
    accessible-label: root.note.name;
    accessible-value: root.note.name + (root.note.kind == "root" ? " " + @tr("root") : root.note.kind == "scale" ? " " + @tr("in the scale")
        : root.note.kind == "out" ? " " + @tr("out of the scale") : "") + (root.note.pad ? " " + @tr("on a pad") : "")
        + (root.note.chord ? " " + @tr("in the chord") : "");
    background: root.lit ? Theme.attention : root.note.kind == "root" ? Theme.bone
        : root.note.kind == "scale" ? (root.black ? Theme.bone-2 : Theme.bone-3)
        : root.note.kind == "out" ? (root.black ? Theme.ground : Theme.ground-band)
        : root.black ? Theme.ground : Theme.plate;
    border-radius: Theme.r-control;
    // Black keys keep a ground edge against the white ones they sit on.
    border-width: root.black || root.note.kind == "out" ? Theme.hair : 0px;
    border-color: root.note.kind == "out" ? Theme.rule-strong : Theme.ground;
    // The note's name on the Cs and on the root (white keys only).
    if !root.black && (Math.mod(root.index, 12) == 0 || root.note.kind == "root"): Caps {
        y: parent.height - self.height - Theme.s2; width: parent.width;
        text: root.note.name; horizontal-alignment: center; overflow: elide;
        color: root.ink; font-weight: root.note.kind == "root" ? Theme.weight-semi : Theme.weight-medium;
    }
    if root.note.pad: Rectangle {
        x: parent.width * 0.25; y: parent.height - 4px; width: parent.width * 0.5; height: 2px;
        background: root.filled ? Theme.ground : Theme.bone-2;
    }
    if root.note.chord: Rectangle {
        x: (parent.width - self.width) / 2; y: root.black ? parent.height - self.height - 6px : 6px;
        width: 8px; height: 8px; border-radius: 4px;
        background: root.filled ? Theme.ground : Theme.bone;
    }
    if root.cursor: Rectangle {
        border-width: Theme.focus-width; border-color: Theme.focus; border-radius: Theme.r-control;
    }
    TouchArea {
        enabled: Create.keyboard-on;
        mouse-cursor: Create.keyboard-on ? pointer : default;
        // A key plays on press, as on an instrument.
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) { root.pressed(); }
        }
    }
}

// [73] The keyboard strip: two octaves from a C over the pads' notes,
// following the octave switch. Drawn quiet until a key is chosen; then the
// root, the scale and the notes out of it show. Once a note with a pitch
// is picked a key plays it on press; with the focus the arrows move along
// the keys and Return or Space plays one.
component KeyStrip inherits Rectangle {
    property <length> key-w: (root.width - 13 * Theme.key-gap) / 14;
    // The white key of each semitone of the octave, and which are black.
    property <[int]> white-of: [0, 0, 1, 1, 2, 3, 3, 4, 4, 5, 5, 6];
    property <[bool]> black: [false, true, false, true, false, false, true, false, true, false, true, false];
    property <int> at: 0;
    property <CreateKeyNote> here: Create.keyboard[root.at];
    property <string> tip: Create.keyboard-on ? @tr("Play a note: press a key, or use the arrow keys and Return")
        : @tr("Pick a note with a pitch in SOURCE to play the keys");
    accessible-role: slider;
    accessible-id: "create.keyboard";
    accessible-label: TooltipState.name-for(self.accessible-id, @tr("Keyboard strip"), root.tip);
    accessible-value: root.here.name;
    accessible-description: root.tip;
    accessible-enabled: Create.keyboard-on;
    accessible-action-default => { Create.play-key(root.at); }
    height: 56px;
    for k[i] in Create.keyboard: StripKey {
        visible: !root.black[Math.mod(i, 12)];
        x: (Math.floor(i / 12) * 7 + root.white-of[Math.mod(i, 12)]) * (root.key-w + Theme.key-gap); y: 0;
        width: root.key-w; height: root.height;
        note: k; index: i; black: false;
        cursor: focus.focused && root.at == i;
        pressed => { root.at = i; Create.play-key(i); }
    }
    // Black keys over the white ones: after C, D, F, G and A.
    for k[i] in Create.keyboard: StripKey {
        visible: root.black[Math.mod(i, 12)];
        x: (Math.floor(i / 12) * 7 + root.white-of[Math.mod(i, 12)] + 1) * (root.key-w + Theme.key-gap) - root.key-w * 0.3 - Theme.key-gap / 2; y: 0;
        width: root.key-w * 0.6; height: root.height * 0.58;
        note: k; index: i; black: true;
        cursor: focus.focused && root.at == i;
        pressed => { root.at = i; Create.play-key(i); }
    }
    focus := KeyFocus {
        enabled: Create.keyboard-on; arrows: true;
        activate => { Create.play-key(root.at); }
        step(d) => { root.at = clamp(root.at + d, 0, Create.keyboard.length - 1); }
    }
}

// [71] Where the note comes from: one segmented control, the current
// source filled. A press picks a new note there, where it stands now.
component SourceChooser inherits HorizontalLayout {
    alignment: center; spacing: Theme.key-gap;
    for s in [{ id: "deck1", label: @tr("DECK 1"), deck: 1 }, { id: "deck2", label: @tr("DECK 2"), deck: 2 }, { id: "player", label: @tr("PLAYER"), deck: 0 }, { id: "tone", label: @tr("TONE"), deck: -1 }]: PlateButton {
        accessible-id: "create.source." + s.id; accessible-role: button;
        compact: true; label: s.label;
        selected: Create.note.picked && Create.note.source == s.id;
        enabled: s.deck < 0 ? true : s.deck == 0 ? Create.player-ready : Create.decks.length >= s.deck && Create.decks[s.deck - 1].loaded;
        tooltip: s.deck < 0 ? @tr("The built-in tone: a plain A3 to start from, without a track")
            : s.deck == 0 ? @tr("Pick a note from the track in the player, at its position")
            : @tr("Pick a note from the track on deck {}, where it plays now", s.deck);
        clicked => { Create.pick(s.id); }
    }
}

// The picked note's track, and where and how long the note is (or why it
// has no pitch). One line: a wrapping text here would be measured at no
// width and stretch the zone.
component NoteLine inherits HorizontalLayout {
    spacing: Theme.s2;
    Text {
        accessible-role: text; accessible-id: "create.source.track"; accessible-value: self.text;
        horizontal-stretch: 1; min-width: 0px;
        text: Create.note.title;
        font-family: Theme.family; font-size: Theme.body; color: Theme.bone-2;
        vertical-alignment: center; overflow: elide;
    }
    Text {
        accessible-role: text; accessible-id: "create.source.length"; accessible-value: self.text;
        horizontal-stretch: 0;
        text: Create.note.start + " · " + Create.note.length
            + (Create.note.why == "short" ? " · " + @tr("too short")
            : Create.note.why == "silent" ? " · " + @tr("silent")
            : Create.note.why == "none" ? " · " + @tr("no clear pitch") : "");
        font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3;
        vertical-alignment: center;
    }
}

// IN or OUT on the waveform: a bone line with its legend, dragged by a
// strip beside it on the note's side (44 px on touch), or moved in steps
// of 10 ms by the arrow keys.
component NoteHandle inherits Rectangle {
    in property <string> which;
    in property <length> line-x;
    in property <length> well-w;
    in property <float> at;
    property <length> hw: Theme.touch-mode ? 44px : 14px;
    property <length> grab;
    property <float> from;
    accessible-role: slider;
    accessible-id: "create.source." + root.which;
    accessible-label: TooltipState.name-for(self.accessible-id, root.which == "in" ? @tr("IN") : @tr("OUT"), "");
    accessible-value: root.which == "in" ? Create.note.start : Create.note.start + " + " + Create.note.length;
    accessible-description: tip.tooltip;
    // IN's strip lies left of its line, OUT's right of it: they never cross.
    x: root.which == "in" ? clamp(root.line-x - root.hw, 0px, root.well-w - root.hw) : clamp(root.line-x, 0px, root.well-w - root.hw);
    width: root.hw;
    background: tip.has-hover || tip.pressed ? Theme.bone.with-alpha(0.12) : transparent;
    Rectangle {
        x: clamp(root.line-x - parent.x - Theme.line / 2, 0px, parent.width - Theme.line);
        width: Theme.line;
        background: Theme.bone;
    }
    tip := TipArea {
        tooltip: root.which == "in" ? @tr("IN: where the note starts; drag it, or use the arrow keys") : @tr("OUT: where the note ends, with a short fade; drag it, or use the arrow keys");
        mouse-cursor: ew-resize;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.from = root.at;
                root.grab = self.absolute-position.x + self.mouse-x;
            }
            if (ev.kind == PointerEventKind.up) { Create.drag-done(); }
        }
        moved => {
            if (self.pressed && root.well-w > 0) {
                Create.drag-handle(root.which, root.from + (self.absolute-position.x + self.mouse-x - root.grab) / root.well-w);
            }
        }
    }
    KeyFocus { arrows: true;
        step(d) => { Create.nudge(root.which, d); }
    }
}

// The zoomed waveform of the note's surroundings: outside IN and OUT
// dimmed, the fade at OUT drawn as a ramp. Dragging the waveform moves the
// view; dragging a handle moves the note's edge.
component NoteWave inherits Rectangle {
    property <length> in-x: clamp(Create.note.in-at, 0, 1) * self.width;
    property <length> out-x: clamp(Create.note.out-at, 0, 1) * self.width;
    property <length> fade-x: clamp(Create.note.fade-at, 0, 1) * self.width;
    accessible-role: image;
    accessible-id: "create.source.wave";
    accessible-label: @tr("Zoomed waveform");
    height: 64px;
    background: Theme.ground;
    clip: true;
    if !Create.note.picked: Caps {
        width: parent.width; height: parent.height;
        text: @tr("NO NOTE PICKED"); horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    if Create.note.picked: Image {
        width: parent.width; height: parent.height;
        source: Create.note.wave; image-fit: fill;
    }
    if Create.note.picked: Rectangle { x: 0; width: root.in-x; background: Theme.ground.with-alpha(0.65); }
    if Create.note.picked: Rectangle { x: root.out-x; width: parent.width - root.out-x; background: Theme.ground.with-alpha(0.65); }
    // The fade: what it takes away dimmed, under a hairline ramp.
    if Create.note.picked && root.out-x > root.fade-x: Path {
        width: parent.width; height: parent.height;
        viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
        fill: Theme.ground.with-alpha(0.5);
        MoveTo { x: root.fade-x / 1px; y: 0; }
        LineTo { x: root.out-x / 1px; y: 0; }
        LineTo { x: root.out-x / 1px; y: root.height / 1px; }
        Close { }
    }
    if Create.note.picked && root.out-x > root.fade-x: Path {
        width: parent.width; height: parent.height;
        viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
        stroke: Theme.bone-2; stroke-width: 1px;
        MoveTo { x: root.fade-x / 1px; y: 0; }
        LineTo { x: root.out-x / 1px; y: root.height / 1px; }
    }
    if Create.note.picked: TouchArea {
        property <length> last;
        mouse-cursor: grab;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) { self.last = self.mouse-x; }
        }
        moved => {
            if (self.pressed && root.width > 0) {
                Create.pan((self.mouse-x - self.last) / root.width);
                self.last = self.mouse-x;
            }
        }
    }
    if Create.note.picked: NoteHandle { which: "in"; at: Create.note.in-at; line-x: root.in-x; well-w: root.width; height: parent.height; }
    if Create.note.picked: NoteHandle { which: "out"; at: Create.note.out-at; line-x: root.out-x; well-w: root.width; height: parent.height; }
}

// How sure the pitch is, in words: DETECTED (raised ash), UNSURE (sodium:
// it needs you) or SET BY YOU (bone, like a selection); [82] BUILT-IN
// (raised ash) for the built-in tone, whose pitch is known.
component NoteBadge inherits Rectangle {
    property <string> state: Create.note.state;
    property <string> word: root.state == "set" ? @tr("SET BY YOU") : root.state == "detected" ? @tr("DETECTED")
        : root.state == "builtin" ? @tr("BUILT-IN") : root.state == "measuring" ? @tr("MEASURING") : @tr("UNSURE");
    accessible-role: text;
    accessible-id: "create.source.badge";
    accessible-label: @tr("How sure the pitch is");
    accessible-value: root.word;
    height: 22px;
    width: t.preferred-width + 16px;
    border-radius: Theme.r-control;
    background: root.state == "set" ? Theme.bone : root.state == "unsure" ? Theme.attention : Theme.plate-raised;
    t := Text {
        x: 8px; height: parent.height;
        text: root.word;
        font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: 1.2px;
        color: root.state == "set" || root.state == "unsure" ? Theme.ground : Theme.bone-2;
        vertical-alignment: center;
    }
}

// The pitch: the note with its octave and the cents, each a stepper that
// corrects it (a semitone, a cent).
component PitchRow inherits Rectangle {
    accessible-role: text;
    accessible-id: "create.source.pitch";
    accessible-label: @tr("Pitch");
    accessible-value: Create.note.note + (Create.note.cents != "" ? " " + Create.note.cents : "");
    HorizontalLayout {
        alignment: center; spacing: Theme.s2;
        Stepper {
            accessible-id: "create.source.note";
            a11y-prev: "create.source.note.down"; a11y-value: "create.source.note.value"; a11y-next: "create.source.note.up";
            tooltip: @tr("Note: a semitone down or up");
            value: Create.note.note; template: "C#-1"; size: 32px;
            font-size: Theme.heading; lit: true;
            step(d) => { Create.step-note(d); }
        }
        Stepper {
            accessible-id: "create.source.cents";
            a11y-prev: "create.source.cents.down"; a11y-value: "create.source.cents.value"; a11y-next: "create.source.cents.up";
            tooltip: @tr("Cents: a cent lower or higher");
            value: Create.note.cents != "" ? Create.note.cents : "—"; template: "+50 ct"; size: 32px;
            lit: true;
            step(d) => { Create.step-cents(d); }
        }
    }
}

// A typed correction ("A3", "F#2", "Bb4 +12").
component TypeRow inherits HorizontalLayout {
    alignment: center;
    Field {
        accessible-id: "create.source.type";
        width: 150px;
        placeholder: @tr("TYPE A NOTE");
        accepted(t) => {
            if (Create.type-note(t)) { self.text = ""; }
        }
    }
}

// [72] The warning mark of a FAR pad: a small triangle (the shape says it
// with the word FAR beside it, never the colour alone).
component FarMark inherits Path {
    in property <color> tone: Theme.attention;
    width: 10px; height: 9px;
    viewbox-width: 10; viewbox-height: 9;
    fill: root.tone;
    commands: "M 5 0 L 10 9 L 0 9 Z";
}

// [72] One pad: the target note over its distance from the source note.
// Played on press (sodium fill while it sounds); a FAR pad carries the
// triangle and the word. Off (a hollow slot with its number) until a note
// with a pitch is picked.
component NotePad inherits Rectangle {
    in property <CreatePad> pad;
    in property <int> index;
    property <bool> lit: root.pad.enabled && root.pad.playing;
    property <string> tip: !root.pad.enabled ? @tr("Pick a note with a pitch in SOURCE to play it here")
        : root.pad.far ? @tr("Play the note as {}: {} semitones from the source note, which may not sound natural. Pick a source note nearer it for a cleaner sound", root.pad.note, Create.shift-text(root.pad.shift))
        : @tr("Play the note as {} ({} semitones from the source note)", root.pad.note, Create.shift-text(root.pad.shift));
    accessible-role: button;
    accessible-id: "create.notes.pad" + (root.index + 1);
    accessible-label: TooltipState.name-for(self.accessible-id, @tr("PAD {}", root.index + 1), root.tip);
    accessible-value: !root.pad.enabled ? "" : root.pad.note + " " + Create.shift-text(root.pad.shift) + (root.pad.far ? " " + @tr("FAR") : "");
    accessible-enabled: root.pad.enabled;
    accessible-description: root.tip;
    accessible-action-default => { Create.play-pad(root.index); }
    min-width: Theme.touch-min;
    height: Theme.touch-mode ? 52px : 44px;
    background: Theme.face(root.pad.enabled, touch.pressed, touch.has-hover, false, root.lit, Theme.attention);
    border-radius: Theme.r-control;
    border-width: root.pad.enabled ? 0px : Theme.hair;
    border-color: Theme.rule-strong;
    property <color> ink: Theme.ink(root.pad.enabled, touch.pressed, touch.has-hover, false, root.lit);
    if !root.pad.enabled: Caps {
        width: parent.width; height: parent.height;
        text: root.index + 1; horizontal-alignment: center; vertical-alignment: center;
    }
    if root.pad.enabled: VerticalLayout {
        padding-left: Theme.s1; padding-right: Theme.s1;
        alignment: center; spacing: 0px;
        Text {
            text: root.pad.note;
            font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
            color: root.ink; horizontal-alignment: center; overflow: elide;
        }
        HorizontalLayout {
            alignment: center; spacing: Theme.s1;
            if root.pad.far: VerticalLayout { alignment: center; FarMark { tone: root.lit ? root.ink : Theme.attention; } }
            Caps {
                text: root.pad.far ? @tr("FAR") + " " + Create.shift-text(root.pad.shift) : Create.shift-text(root.pad.shift);
                color: root.pad.far ? root.ink : root.lit ? root.ink : Theme.bone-3;
                font-weight: root.pad.far ? Theme.weight-semi : Theme.weight-medium;
                overflow: elide;
            }
        }
    }
    // A pad plays on press, as on an instrument.
    touch := TipArea {
        tooltip: root.tip; enabled: root.pad.enabled;
        mouse-cursor: root.pad.enabled ? pointer : default;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) { Create.play-pad(root.index); }
        }
    }
    KeyFocus { enabled: root.pad.enabled; activate => { Create.play-pad(root.index); } }
}

// [72] The pads' heading: PADS, and on the right SNAP TO SCALE ([73]) and
// the octave switch.
component PadsHead inherits HorizontalLayout {
    spacing: Theme.s2;
    Caps { text: @tr("PADS"); vertical-alignment: center; }
    Rectangle { horizontal-stretch: 1; }
    LineToggle {
        accessible-id: "create.notes.snap";
        horizontal-stretch: 0;
        label: @tr("SNAP TO SCALE");
        checked: Create.snap;
        tooltip: @tr("Snap to scale: the pads hold the scale's notes; off, every semitone from the source note");
        toggled(on) => { Create.set-snap(on); }
    }
    Caps { text: @tr("OCTAVE"); vertical-alignment: center; }
    Stepper {
        accessible-id: "create.notes.octave";
        a11y-prev: "create.notes.octave.down"; a11y-value: "create.notes.octave.value"; a11y-next: "create.notes.octave.up";
        tooltip: @tr("Octave: the pads an octave down or up");
        enabled: Create.pads-why == "";
        value: Create.shift-text(Create.octave); template: "+2"; size: 26px;
        lit: Create.octave != 0;
        step(d) => { Create.step-octave(d); }
    }
}

// [72] The 8 pads, a little apart after four; in two rows of four where
// one row would leave a pad too narrow for its note and FAR with the
// distance. Follows the width through a plain property, so it does not
// feed back into the layout.
component PadRow inherits VerticalLayout {
    property <bool> two-rows;
    init => { self.two-rows = self.width < 760px; }
    changed width => { self.two-rows = self.width < 760px; }
    spacing: Theme.key-gap;
    if !root.two-rows: HorizontalLayout {
        spacing: Theme.key-gap;
        for p[i] in Create.pads: HorizontalLayout {
            padding-left: i > 0 && Math.mod(i, 4) == 0 ? Theme.s2 : 0px;
            NotePad { pad: p; index: i; }
        }
    }
    if root.two-rows: HorizontalLayout {
        spacing: Theme.key-gap;
        for i in 4: NotePad { pad: Create.pads[i]; index: i; }
    }
    if root.two-rows: HorizontalLayout {
        spacing: Theme.key-gap;
        for i in 4: NotePad { pad: Create.pads[i + 4]; index: i + 4; }
    }
}

// [72] Under the pads, one line: why they are off, or what FAR means and
// which source note would be nearer. One line, elided: a wrapping text
// here would be measured at no width and stretch the zone.
component PadsLine inherits HorizontalLayout {
    property <bool> far: Create.pads-why == "" && Create.pads-nearer != "";
    spacing: Theme.s2;
    height: 18px;
    if root.far: VerticalLayout { alignment: center; FarMark { } }
    Text {
        accessible-role: text; accessible-id: "create.notes.pads-hint"; accessible-value: self.text;
        horizontal-stretch: 1; min-width: 0px;
        text: Create.pads-why == "none" ? @tr("Pick a note in SOURCE: the pads play it at other pitches.")
            : Create.pads-why == "pitch" ? @tr("No pitch yet: set the note in SOURCE to play it on the pads.")
            : root.far ? @tr("FAR: over 7 semitones away may sound unnatural. A source note near {} sounds cleaner.", Create.pads-nearer)
            : Create.snap && Create.key.chosen ? @tr("The scale's notes from the root at or below the source note. The octave switch moves them.")
            : Create.snap ? @tr("No key yet: the source note and the 7 semitones above it. The octave switch moves them.")
            : @tr("The source note and the 7 semitones above it. The octave switch moves them.");
        font-family: Theme.family; font-size: Theme.control;
        color: root.far ? Theme.bone : Theme.bone-3;
        vertical-alignment: center; overflow: elide;
    }
}

// [73] Where the key comes from, in words: FROM DECK 2, NEXT TRACK, SET
// BY YOU, or why there is none.
component KeyFrom inherits Text {
    accessible-role: text; accessible-id: "create.notes.key-from"; accessible-value: self.text;
    text: Create.key.from == "set" ? @tr("SET BY YOU") : Create.key.from == "next" ? @tr("NEXT TRACK")
        : Create.key.from == "starter" ? @tr("STARTER KEY")
        : Create.key.chosen ? @tr("FROM DECK {}", Create.key.deck)
        : Create.key.deck > 0 ? @tr("NO KEY ON DECK {}", Create.key.deck) : @tr("NO KEY ON A DECK");
    font-family: Theme.family; font-size: Theme.label; letter-spacing: Theme.tracking-index;
    font-weight: Theme.weight-semi;
    color: Create.key.from == "set" ? Theme.bone : Theme.bone-3;
    vertical-alignment: center; overflow: elide;
}

// [73] The key: KEY, the root as a stepper (a semitone down or up, SET BY
// YOU), the wheel notation as a small label beside, where it comes from,
// and the two places it can come from: the other deck (followed) and the
// next track in the queue or the set (taken once).
component KeyRow inherits HorizontalLayout {
    spacing: Theme.s2;
    Caps { text: @tr("KEY"); vertical-alignment: center; }
    Stepper {
        accessible-id: "create.notes.root";
        horizontal-stretch: 0;
        a11y-prev: "create.notes.root.down"; a11y-value: "create.notes.root.value"; a11y-next: "create.notes.root.up";
        tooltip: @tr("Key: the root a semitone down or up");
        value: Create.key.chosen ? Create.key.root : "—"; template: "Db"; size: 26px;
        lit: Create.key.chosen;
        step(d) => { Create.step-root(d); }
    }
    if Create.key.wheel != "": Caps {
        accessible-role: text; accessible-id: "create.notes.wheel"; accessible-value: self.text;
        text: Create.key.wheel; vertical-alignment: center;
    }
    KeyFrom { horizontal-stretch: 1; min-width: 0px; }
    HorizontalLayout {
        horizontal-stretch: 0; spacing: Theme.key-gap;
        PlateButton {
            accessible-id: "create.notes.from-deck"; accessible-role: button;
            compact: true; label: @tr("OTHER DECK");
            selected: Create.key.from == "deck";
            tooltip: @tr("Follow the key of the other deck (for a note from the player, the deck playing)");
            clicked => { Create.key-from-deck(); }
        }
        PlateButton {
            accessible-id: "create.notes.next-track"; accessible-role: button;
            compact: true; label: @tr("NEXT TRACK");
            selected: Create.key.from == "next";
            enabled: Create.next-why == "";
            tooltip: Create.next-why == "none" ? @tr("No next track: add one to the queue or open a set to take its key")
                : Create.next-why == "no-key" ? @tr("The next track, {}, has no key yet: analyse it first", Create.next-title)
                : @tr("Take the key of the next track: {}", Create.next-title);
            clicked => { Create.key-from-next(); }
        }
    }
}

// [73] A scale key: its name, and while the hints are on a small word
// under it (HAPPY, SAD). Off is plate, the scale in use a bone fill.
component ScaleKeyButton inherits Rectangle {
    in property <string> id;
    in property <string> label;
    in property <string> hint;
    in property <bool> selected;
    in property <string> tooltip;
    callback clicked();
    accessible-role: button;
    accessible-id: "create.notes.scale." + root.id;
    accessible-label: TooltipState.name-for(self.accessible-id, root.label, root.tooltip);
    accessible-value: root.hint;
    accessible-description: root.tooltip;
    accessible-action-default => { root.clicked(); }
    min-width: max(Theme.touch-min, max(t.preferred-width, h.preferred-width) + 28px);
    height: Theme.touch-mode ? 44px : 32px;
    background: Theme.face(true, touch.pressed, touch.has-hover, root.selected, false, Theme.setup-on);
    border-radius: Theme.r-control;
    property <color> ink: Theme.ink(true, touch.pressed, touch.has-hover, root.selected, false);
    VerticalLayout {
        alignment: center; spacing: 0px;
        t := Text {
            text: root.label;
            font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-medium; letter-spacing: 1.4px;
            color: root.ink; horizontal-alignment: center;
        }
        h := Text {
            visible: root.hint != "";
            height: root.hint != "" ? self.preferred-height : 0px;
            text: root.hint;
            font-family: Theme.family; font-size: Theme.label; letter-spacing: 1px;
            color: root.selected ? root.ink : Theme.bone-3; horizontal-alignment: center;
        }
    }
    touch := TipArea { tooltip: root.tooltip; mouse-cursor: pointer; clicked => { root.clicked(); } }
    KeyFocus { activate => { root.clicked(); } }
}

// [73] The scale: MAJOR and MINOR (with HAPPY and SAD while the hints are
// on), MORE for the modes, and the hints' switch beside them.
component ScaleRow inherits HorizontalLayout {
    property <bool> mode: Create.key.chosen && Create.key.scale != "major" && Create.key.scale != "minor";
    spacing: Theme.s2;
    Caps { text: @tr("SCALE"); vertical-alignment: center; }
    HorizontalLayout {
        horizontal-stretch: 0; spacing: Theme.key-gap;
        ScaleKeyButton {
            id: "major"; label: @tr("MAJOR"); hint: Create.hints ? @tr("HAPPY") : "";
            selected: Create.key.chosen && Create.key.scale == "major";
            tooltip: @tr("Major: often heard as bright or happy");
            clicked => { Create.more = false; Create.choose-scale("major"); }
        }
        ScaleKeyButton {
            id: "minor"; label: @tr("MINOR"); hint: Create.hints ? @tr("SAD") : "";
            selected: Create.key.chosen && Create.key.scale == "minor";
            tooltip: @tr("Minor: often heard as dark or sad");
            clicked => { Create.more = false; Create.choose-scale("minor"); }
        }
        ScaleKeyButton {
            id: "more"; label: root.mode ? Create.scale-name(Create.key.scale) : @tr("MORE");
            hint: Create.hints && root.mode ? @tr("MODE") : "";
            selected: root.mode;
            tooltip: Create.more ? @tr("Hide the modes") : @tr("Show the modes: dorian, phrygian, lydian, mixolydian and harmonic minor");
            clicked => { Create.more = !Create.more; }
        }
    }
    LineToggle {
        accessible-id: "create.notes.hints";
        horizontal-stretch: 0;
        label: @tr("HINTS");
        checked: Create.hints;
        tooltip: @tr("Hints: HAPPY and SAD under MAJOR and MINOR, and the lines on why notes fit");
        toggled(on) => { Create.set-hints(on); }
    }
    Rectangle { horizontal-stretch: 1; }
}

// [73] One mode under MORE.
component ModeKey inherits PlateButton {
    in property <string> id;
    accessible-id: "create.notes.scale." + root.id; accessible-role: button;
    compact: true;
    selected: Create.key.chosen && Create.key.scale == root.id;
    tooltip: @tr("Play in {}", root.label);
    clicked => { Create.choose-scale(root.id); }
}

// [73] The modes under MORE, from the left like the scale keys above:
// one row, or two where one would not fit.
// Follows the width through a plain property, so it does not feed back
// into the layout.
component ModeRow inherits VerticalLayout {
    property <bool> two-rows;
    init => { self.two-rows = self.width < 600px; }
    changed width => { self.two-rows = self.width < 600px; }
    spacing: Theme.key-gap;
    HorizontalLayout {
        alignment: start; spacing: Theme.key-gap;
        ModeKey { id: "dorian"; label: @tr("DORIAN"); }
        ModeKey { id: "phrygian"; label: @tr("PHRYGIAN"); }
        ModeKey { id: "lydian"; label: @tr("LYDIAN"); }
        if !root.two-rows: ModeKey { id: "mixolydian"; label: @tr("MIXOLYDIAN"); }
        if !root.two-rows: ModeKey { id: "harmonic_minor"; label: @tr("HARMONIC MINOR"); }
    }
    if root.two-rows: HorizontalLayout {
        alignment: start; spacing: Theme.key-gap;
        ModeKey { id: "mixolydian"; label: @tr("MIXOLYDIAN"); }
        ModeKey { id: "harmonic_minor"; label: @tr("HARMONIC MINOR"); }
    }
}

// [78] A note of the key in FITS: a plate where it fits the key playing
// now (or with nothing to compare with), hollow and struck through where
// it is not in it, so the shape says it and the words in FITS name it.
component FitNote inherits Rectangle {
    in property <CreateChip> chip;
    in property <int> index;
    property <bool> out: root.chip.fits == "out";
    accessible-role: text;
    accessible-id: "create.fits.note" + (root.index + 1);
    accessible-label: root.chip.name;
    accessible-value: root.chip.name + (root.chip.fits == "fits" ? " " + @tr("fits") : root.out ? " " + @tr("not in {}", Create.fit.words) : "");
    min-width: 0px;
    height: 26px;
    border-radius: Theme.r-control;
    background: root.out ? transparent : Theme.plate;
    border-width: root.out ? Theme.hair : 0px;
    border-color: Theme.rule-strong;
    Text {
        width: parent.width; height: parent.height;
        text: root.chip.name;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-medium;
        color: root.out ? Theme.bone-3 : Theme.bone;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    if root.out: Rectangle {
        x: 4px; y: (parent.height - self.height) / 2; width: parent.width - 8px; height: 1px;
        background: Theme.bone-3;
    }
}

// [78] A chord of the key (in FITS and THEORY): a key that marks its notes
// on the keyboard strip (bone while chosen); hollow and struck through
// where it is not in the key playing now, like the notes.
component ChordKey inherits Rectangle {
    in property <CreateChip> chip;
    in property <int> index;
    in property <string> where;
    property <bool> out: root.chip.fits == "out";
    property <string> tip: root.chip.selected ? @tr("Clear the marks of {} on the keyboard strip", root.chip.name)
        : @tr("Mark the notes of {} on the keyboard strip", root.chip.name);
    accessible-role: button;
    accessible-id: "create." + root.where + ".chord" + (root.index + 1);
    accessible-label: TooltipState.name-for(self.accessible-id, root.chip.name, root.tip);
    accessible-value: (root.chip.fits == "fits" ? @tr("fits") : root.out ? @tr("not in {}", Create.fit.words) : "")
        + (root.chip.selected ? (root.chip.fits != "" ? " · " : "") + @tr("marked") : "");
    accessible-description: root.tip;
    accessible-action-default => { Create.choose-chord(root.index); }
    min-width: max(Theme.touch-min, 36px);
    horizontal-stretch: 1;
    height: Theme.touch-mode ? 44px : 28px;
    background: root.out && !root.chip.selected ? transparent
        : Theme.face(true, touch.pressed, touch.has-hover, root.chip.selected, false, Theme.setup-on);
    border-radius: Theme.r-control;
    border-width: root.out && !root.chip.selected ? Theme.hair : 0px;
    border-color: Theme.rule-strong;
    property <color> ink: root.out && !root.chip.selected ? Theme.bone-3 : Theme.ink(true, touch.pressed, touch.has-hover, root.chip.selected, false);
    Text {
        x: 4px; width: parent.width - 8px; height: parent.height;
        text: root.chip.name;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-medium;
        color: root.ink; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    if root.out: Rectangle {
        x: 4px; y: (parent.height - self.height) / 2; width: parent.width - 8px; height: 1px;
        background: root.ink;
    }
    touch := TipArea { tooltip: root.tip; mouse-cursor: pointer; clicked => { Create.choose-chord(root.index); } }
    KeyFocus { activate => { Create.choose-chord(root.index); } }
}

// [78] The key's chords: one row of seven where there is room for them
// (THEORY), else four over three, lined up.
// Follows the width through a plain property, so it does not feed back
// into the layout.
component ChordGrid inherits VerticalLayout {
    in property <string> where;
    in property <bool> may-be-one-row;
    property <length> key-min: max(Theme.touch-min, 36px);
    property <bool> one-row;
    init => { self.one-row = self.may-be-one-row && self.width >= 7 * self.key-min + 6 * Theme.key-gap; }
    changed width => { self.one-row = self.may-be-one-row && self.width >= 7 * self.key-min + 6 * Theme.key-gap; }
    spacing: Theme.key-gap;
    HorizontalLayout {
        spacing: Theme.key-gap;
        for i in (root.one-row ? 7 : 4): ChordKey { chip: Create.fit-chords[i]; index: i; where: root.where; }
    }
    if !root.one-row: HorizontalLayout {
        spacing: Theme.key-gap;
        for i in 3: ChordKey { chip: Create.fit-chords[i + 4]; index: i + 4; where: root.where; }
        // The fourth place stays empty, so the two rows line up.
        Rectangle { horizontal-stretch: 1; min-width: root.key-min; }
    }
}

// [78] The deck playing now, which FITS compares with: its key (the wheel
// beside), or why there is nothing to compare with.
component FitsNow inherits HorizontalLayout {
    spacing: Theme.s2;
    Caps {
        accessible-role: text; accessible-id: "create.fits.now"; accessible-value: self.text;
        horizontal-stretch: 1; min-width: 0px;
        text: Create.fit.why == "none" ? @tr("NO DECK PLAYS")
            : Create.fit.why == "no-key" ? @tr("DECK {} PLAYS · KEY NOT KNOWN", Create.fit.deck)
            : @tr("DECK {} PLAYS {}", Create.fit.deck, Create.key-of(Create.fit.root, Create.fit.scale));
        color: Create.fit.why == "" ? Theme.bone : Theme.bone-3;
        font-weight: Theme.weight-semi;
        vertical-alignment: center; overflow: elide;
    }
    if Create.fit.why == "" && Create.fit.wheel != "": Caps { text: Create.fit.wheel; vertical-alignment: center; }
}

// [78] FITS: the chosen key's notes and chords, and which of them fit the
// key of the deck playing now (struck where they do not, and said in
// words); a chord marks its notes on the keyboard strip. With the hints on
// a line in plain words says why.
component KeyFits inherits VerticalLayout {
    // Packed at the top: the zone's filler takes the rest.
    vertical-stretch: 0;
    spacing: Theme.s2;
    HorizontalLayout {
        spacing: Theme.s2;
        Text {
            accessible-role: text; accessible-id: "create.fits.key"; accessible-value: self.text;
            text: Create.key-name();
            font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi; color: Theme.bone;
            vertical-alignment: center; overflow: elide; min-width: 0px; horizontal-stretch: 1;
        }
        if Create.key.wheel != "": Caps { text: Create.key.wheel; vertical-alignment: center; }
    }
    Caps { text: @tr("NOTES"); }
    Rectangle {
        accessible-role: list; accessible-id: "create.fits.notes"; accessible-label: @tr("NOTES"); accessible-value: Create.key.notes;
        height: 26px;
        HorizontalLayout {
            spacing: Theme.key-gap;
            for c[i] in Create.fit-notes: FitNote { chip: c; index: i; horizontal-stretch: 1; }
        }
    }
    Caps { text: @tr("CHORDS"); }
    Rectangle {
        accessible-role: list; accessible-id: "create.fits.chords"; accessible-label: @tr("CHORDS"); accessible-value: Create.key.chords;
        height: (Theme.touch-mode ? 44px : 28px) * 2 + Theme.key-gap;
        ChordGrid { where: "fits"; }
    }
    Rectangle { height: Theme.s1; }
    FitsNow { }
    Prose {
        accessible-role: text; accessible-id: "create.fits.line"; accessible-value: self.text;
        text: Create.fit.why == "none" ? @tr("Nothing to compare with: play a track with a known key on a deck.")
            : Create.fit.why == "no-key" ? @tr("Analyse its track to see which of these fit.")
            : Create.fit.notes == 7 && Create.fit.chords == 7 ? @tr("All 7 notes and all 7 chords fit.")
            : @tr("{} of 7 notes and {} of 7 chords fit. The struck ones are not in {}.", Create.fit.notes, Create.fit.chords, Create.fit.words);
    }
    if Create.hints && Create.fit-why != "": Prose {
        accessible-role: text; accessible-id: "create.fits.why"; accessible-value: self.text;
        text: @tr("Why: {}", Create.fit-why);
        color: Theme.bone-3;
    }
}

// [74] One step of the strip: a hollow slot while empty (a bar's number
// faint on its first step), a plate with the note's name, or a plate with
// a line where the note before still sounds; the selected step in bone,
// the step that sounds in sodium. REC's next step (step by step) carries
// the armed outline in red. A tap selects it.
component ArrangeStep inherits Rectangle {
    in property <CreateStep> step;
    in property <int> index;
    callback tapped();
    property <bool> note: root.step.note != "";
    property <bool> filled: root.note || root.step.held;
    property <bool> lit: root.step.playing;
    property <color> ink: root.lit || root.step.selected ? Theme.ground : Theme.bone;
    property <string> tip: @tr("Select the step; its note plays. The arrow keys move the note, up and down change it, Delete empties it");
    // Read as a cell of the strip: the strip is the Tab stop (as the
    // keyboard strip's keys are).
    accessible-role: text;
    accessible-id: "create.arrange.step" + (root.index + 1);
    accessible-label: TooltipState.name-for(self.accessible-id, @tr("STEP {}", root.index + 1), root.tip);
    accessible-value: (root.note ? root.step.note : root.step.held ? @tr("held") : @tr("empty"))
        + (root.step.selected ? " " + @tr("selected") : "") + (root.lit ? " " + @tr("playing") : "")
        + (root.step.cursor ? " " + @tr("records next") : "");
    accessible-description: root.tip;
    accessible-action-default => { root.tapped(); }
    min-width: Theme.touch-min;
    height: Theme.touch-mode ? 44px : 28px;
    background: root.lit ? Theme.attention : root.step.selected ? Theme.bone
        : touch.has-hover ? Theme.plate-raised : root.filled ? Theme.plate : transparent;
    border-radius: Theme.r-control;
    border-width: root.filled || root.lit || root.step.selected ? 0px : Theme.hair;
    border-color: Theme.rule-strong;
    if root.note: Text {
        x: 2px; width: parent.width - 4px; height: parent.height;
        text: root.step.note;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
        color: root.ink; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    if root.step.held: Rectangle {
        x: 0; y: (parent.height - 2px) / 2; width: parent.width - Theme.s1; height: 2px;
        background: root.lit || root.step.selected ? Theme.ground : Theme.bone-3;
    }
    if !root.filled && root.step.bar > 0: Caps {
        width: parent.width; height: parent.height;
        text: root.step.bar; horizontal-alignment: center; vertical-alignment: center;
        color: root.lit || root.step.selected ? Theme.ground : Theme.bone-3;
    }
    if root.step.cursor: ArmedOutline { width: parent.width; height: parent.height; show: true; tone: Theme.fault; }
    touch := TipArea {
        tooltip: root.tip;
        mouse-cursor: pointer;
        clicked => { root.tapped(); }
    }
}

// [74] `count` steps of the strip from `from`: a little apart at each beat,
// more at each bar.
component ArrangeRow inherits HorizontalLayout {
    in property <int> from;
    in property <int> count;
    callback tapped(int);
    spacing: Theme.key-gap;
    for i in root.count: HorizontalLayout {
        padding-left: i == 0 ? 0px : Create.steps[root.from + i].gap == 2 ? Theme.s2 : Create.steps[root.from + i].gap == 1 ? Theme.s1 : 0px;
        ArrangeStep {
            step: Create.steps[root.from + i]; index: root.from + i;
            tapped => { root.tapped(root.from + i); }
        }
    }
}

// [74] The 32 steps: one row where there is room, else two rows of 16 (four
// of 8 on touch, for 44 px targets). With the focus the arrow keys move the
// selected note (with Shift, or on an empty step, the selection), up and
// down change it a scale step (with Shift a semitone), Delete or Backspace
// empties it, Return plays it. Follows the width through a plain property,
// so it does not feed back into the layout.
component ArrangeSteps inherits Rectangle {
    property <bool> wide;
    property <int> per-row: Theme.touch-mode ? 8 : root.wide ? 32 : 16;
    init => { self.wide = self.width >= 1000px; }
    changed width => { self.wide = self.width >= 1000px; }
    accessible-role: list;
    accessible-id: "create.arrange.steps";
    accessible-label: @tr("Steps");
    accessible-value: Create.steps-text;
    VerticalLayout {
        spacing: Theme.key-gap;
        for r in Math.floor(32 / root.per-row): ArrangeRow {
            from: r * root.per-row; count: root.per-row;
            tapped(i) => { fs.focus(); Create.select-step(i); }
        }
    }
    fs := FocusScope {
        x: 0; y: 0; width: 0; height: 0;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.modifiers.control || e.modifiers.meta || e.modifiers.alt) { return reject; }
            if (e.text == Key.LeftArrow || e.text == Key.RightArrow) {
                if (e.modifiers.shift || !Create.step-has-note()) {
                    Create.select-step(clamp(Create.selected + (e.text == Key.LeftArrow ? -1 : 1), 0, Create.steps.length - 1));
                } else {
                    Create.move-step(e.text == Key.LeftArrow ? -1 : 1);
                }
                return accept;
            }
            if (e.text == Key.UpArrow || e.text == Key.DownArrow) { Create.shift-step(e.text == Key.UpArrow ? 1 : -1, e.modifiers.shift); return accept; }
            if (e.text == Key.Delete || e.text == Key.Backspace) { Create.delete-step(); return accept; }
            if ((e.text == Key.Return || e.text == " ") && Create.selected >= 0) { Create.select-step(Create.selected); return accept; }
            reject
        }
    }
    FocusRing { show: fs.has-focus; }
}

// [74] The strip's head: ARRANGE and what it holds, then REC, PLAY and
// LOOP, then CLEAR and UNDO.
component ArrangeHead inherits HorizontalLayout {
    spacing: Theme.s2;
    Caps { text: @tr("ARRANGE"); vertical-alignment: center; }
    Caps {
        accessible-role: text; accessible-id: "create.arrange.count"; accessible-value: self.text;
        horizontal-stretch: 1; min-width: 0px;
        text: Create.notes == 0 ? @tr("EMPTY")
            : (Create.starter != "" ? @tr("STARTER {}", Create.starter-name(Create.starter)) + " · " : "")
            + (Create.notes == 1 ? @tr("1 NOTE") : @tr("{} NOTES", Create.notes)) + " · " + (Create.bars == 1 ? @tr("1 BAR") : @tr("{} BARS", Create.bars));
        color: Create.notes > 0 ? Theme.bone-2 : Theme.bone-3;
        vertical-alignment: center; overflow: elide;
    }
    HorizontalLayout {
        horizontal-stretch: 0; spacing: Theme.key-gap;
        PlateButton {
            accessible-id: "create.notes.rec"; accessible-role: checkbox;
            accessible-checkable: true; accessible-checked: Create.rec;
            compact: true; label: Create.rec ? @tr("REC ON") : @tr("REC");
            active: Create.rec; tone: Theme.fault;
            tooltip: @tr("Record: play the pads or the keys into the steps, on the master grid while it plays, else step by step; again to stop");
            clicked => { Create.toggle-rec(); }
        }
        PlateButton {
            accessible-id: "create.arrange.play"; accessible-role: button;
            compact: true; label: Create.playing ? @tr("STOP") : @tr("PLAY");
            enabled: Create.notes > 0 || Create.playing;
            active: Create.playing; tone: Theme.attention;
            tooltip: @tr("Play the steps on the master tempo, from the next bar while a deck plays (on the headphones); again to stop");
            clicked => { Create.toggle-play(); }
        }
        PlateButton {
            accessible-id: "create.arrange.loop"; accessible-role: checkbox;
            accessible-checkable: true; accessible-checked: Create.looped;
            compact: true; label: @tr("LOOP");
            selected: Create.looped;
            tooltip: @tr("Loop: PLAY goes round the strip's bars until stopped");
            clicked => { Create.set-loop(!Create.looped); }
        }
    }
    HorizontalLayout {
        horizontal-stretch: 0; spacing: Theme.key-gap;
        PlateButton {
            accessible-id: "create.arrange.clear"; accessible-role: button;
            compact: true; label: @tr("CLEAR"); tone: Theme.fault;
            enabled: Create.notes > 0;
            tooltip: @tr("Empty every step (UNDO brings them back)");
            clicked => { Create.clear-steps(); }
        }
        PlateButton {
            accessible-id: "create.arrange.undo"; accessible-role: button;
            compact: true; label: @tr("UNDO");
            enabled: Create.can-undo;
            tooltip: @tr("Bring back the steps as they were before the last CLEAR or typed notes");
            clicked => { Create.undo-steps(); }
        }
    }
}

// [74] Under the steps: the selected step's keys (move its note, change
// it, empty it), typing, and the grid on the right; where one row would be
// too narrow, typing goes on a row of its own below. Follows the width
// through a plain property, so it does not feed back into the layout.
component EditKeys inherits HorizontalLayout {
    spacing: Theme.s3;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            spacing: Theme.key-gap;
            PlateButton {
                accessible-id: "create.arrange.left"; accessible-role: button;
                compact: true; glyph: "prev"; enabled: Create.step-has-note();
                tooltip: @tr("Move the selected note a step left (Left arrow)");
                clicked => { Create.move-step(-1); }
            }
            PlateButton {
                accessible-id: "create.arrange.right"; accessible-role: button;
                compact: true; glyph: "next"; enabled: Create.step-has-note();
                tooltip: @tr("Move the selected note a step right (Right arrow)");
                clicked => { Create.move-step(1); }
            }
        }
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            spacing: Theme.key-gap;
            PlateButton {
                accessible-id: "create.arrange.down"; accessible-role: button;
                compact: true; glyph: "down"; enabled: Create.step-has-note();
                tooltip: @tr("The selected note a step of the scale down (Down arrow; with Shift a semitone)");
                clicked => { Create.shift-step(-1, false); }
            }
            PlateButton {
                accessible-id: "create.arrange.up"; accessible-role: button;
                compact: true; glyph: "up"; enabled: Create.step-has-note();
                tooltip: @tr("The selected note a step of the scale up (Up arrow; with Shift a semitone)");
                clicked => { Create.shift-step(1, false); }
            }
        }
    }
    VerticalLayout {
        alignment: center;
        PlateButton {
            accessible-id: "create.arrange.delete"; accessible-role: button;
            compact: true; glyph: "close"; tone: Theme.fault;
            enabled: Create.step-has-note();
            tooltip: @tr("Empty the selected step (Delete)");
            clicked => { Create.delete-step(); }
        }
    }
}

component GridKeys inherits VerticalLayout {
    alignment: center;
    HorizontalLayout {
        spacing: Theme.key-gap;
        for g in [{ id: "1/4", a11y: "4" }, { id: "1/8", a11y: "8" }, { id: "1/16", a11y: "16" }]: PlateButton {
            accessible-id: "create.arrange.grid." + g.a11y; accessible-role: button;
            compact: true; label: g.id;
            selected: Create.grid == g.id;
            tooltip: g.id == "1/4" ? @tr("A step is a quarter note: 32 steps make 8 bars")
                : g.id == "1/8" ? @tr("A step is an eighth note: 32 steps make 4 bars")
                : @tr("A step is a sixteenth note: 32 steps make 2 bars");
            clicked => { Create.set-grid(g.id); }
        }
    }
}

// Typing: the field fills from step 1; what it replaces UNDO brings back.
component TypeSteps inherits Field {
    accessible-id: "create.arrange.type";
    placeholder: @tr("TYPE: A3 C4 - E4");
    accepted(t) => { Create.type-steps(t); }
}

component ArrangeEdit inherits VerticalLayout {
    property <bool> two-rows;
    init => { self.two-rows = self.width < 530px; }
    changed width => { self.two-rows = self.width < 530px; }
    spacing: Theme.s1;
    HorizontalLayout {
        spacing: Theme.s3;
        EditKeys { horizontal-stretch: 0; }
        if !root.two-rows: TypeSteps { horizontal-stretch: 1; min-width: 130px; max-width: 360px; }
        Rectangle { horizontal-stretch: 1; }
        GridKeys { horizontal-stretch: 0; }
    }
    if root.two-rows: TypeSteps { }
}

// [74] One line under the row: what typing could not read, or what typing
// and REC do. One line, elided: a wrapping text here would be measured at
// no width and stretch the zone.
component ArrangeLine inherits HorizontalLayout {
    property <bool> wrong: Create.typed-bad != "" || Create.typed-long;
    spacing: Theme.s2;
    height: 16px;
    if root.wrong: VerticalLayout { alignment: center; FarMark { } }
    Text {
        accessible-role: text; accessible-id: "create.arrange.hint"; accessible-value: self.text;
        horizontal-stretch: 1; min-width: 0px;
        text: Create.typed-bad != "" ? @tr("Not read: {}. Each took its step as a rest.", Create.typed-bad)
            : Create.typed-long ? @tr("Only 32 steps fit: the rest was left out.")
            : Create.rec && Create.rec-mode == "grid" ? @tr("REC: each note lands on the nearest step of the master grid.")
            : Create.rec && Create.rec-cursor >= 32 ? @tr("REC: the strip is full. Select a step to record from there.")
            : Create.rec ? @tr("REC: each note fills the next step, now step {}.", Create.rec-cursor + 1)
            : @tr("Typing replaces the strip from step 1: - is a rest, _ holds the note before.");
        font-family: Theme.family; font-size: Theme.control;
        color: root.wrong ? Theme.bone : Theme.bone-3;
        vertical-alignment: center; overflow: elide;
    }
}

// [82] One starter key: its name; the tooltip says what it plays.
component StarterKey inherits PlateButton {
    in property <string> id;
    in property <string> where;
    in property <string> tip;
    in property <bool> drums;
    accessible-id: "create." + root.where + ".starter." + root.id; accessible-role: button;
    horizontal-stretch: 0;
    compact: true; label: Create.starter-name(root.id);
    tooltip: root.tip + ". " + (root.drums ? @tr("A starter pattern for the kit pads while no pad has steps: change it freely")
        : @tr("A starter melody for the empty strip, in the key in use: change it freely"));
    clicked => { if (root.drums) { Create.use-drum-starter(root.id); } else { Create.use-starter(root.id); } }
}

// [82] STARTERS: starter melodies onto the empty strip, in the key in use
// (or their own, from the source note), or ([`drums`]) starter patterns
// onto the kit pads. Shown only while the strip or the steps are empty, so
// a starter never replaces what you made. `where` names the view it is in.
// Where one row is too narrow the keys go under the word, two by two.
// Follows the width through a plain property, so it does not feed back
// into the layout.
component StarterRow inherits VerticalLayout {
    in property <string> where;
    in property <bool> drums;
    // The keys in two halves: one row, or a row each under the word.
    property <[{ id: string, tip: string }]> first: root.drums ? [
        { id: "straight", tip: @tr("Straight: the kick on every beat, the snare on two and four, hats between") },
        { id: "broken", tip: @tr("Broken: the kick off the beat, hats on every eighth") },
    ] : [
        { id: "rise", tip: @tr("Rise: up a broken chord and back") },
        { id: "call", tip: @tr("Call: a short phrase and its answer") },
    ];
    property <[{ id: string, tip: string }]> second: root.drums ? [
        { id: "spacious", tip: @tr("Spacious: kick and snare far apart, an open hat before the bar") },
    ] : [
        { id: "steps", tip: @tr("Steps: three notes up the scale, each time a step higher") },
        { id: "pulse", tip: @tr("Pulse: a repeated root with its octave and fifth") },
    ];
    property <bool> narrow;
    init => { self.narrow = self.width < 440px; }
    changed width => { self.narrow = self.width < 440px; }
    spacing: Theme.key-gap;
    if !root.narrow: HorizontalLayout {
        spacing: Theme.key-gap;
        Caps { text: @tr("STARTERS"); vertical-alignment: center; }
        for s in root.first: StarterKey { id: s.id; tip: s.tip; where: root.where; drums: root.drums; }
        for s in root.second: StarterKey { id: s.id; tip: s.tip; where: root.where; drums: root.drums; }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.narrow: Caps { text: @tr("STARTERS"); }
    if root.narrow: HorizontalLayout {
        spacing: Theme.key-gap; alignment: start;
        for s in root.first: StarterKey { id: s.id; tip: s.tip; where: root.where; drums: root.drums; }
    }
    if root.narrow: HorizontalLayout {
        spacing: Theme.key-gap; alignment: start;
        for s in root.second: StarterKey { id: s.id; tip: s.tip; where: root.where; drums: root.drums; }
    }
}

// [74] ARRANGE under the pads.
component Arrange inherits VerticalLayout {
    spacing: Theme.s1;
    ArrangeHead { }
    ArrangeSteps { }
    if Create.notes == 0: StarterRow { where: "arrange"; }
    ArrangeEdit { }
    ArrangeLine { }
}

// MELODY: SOURCE | NOTES | FITS.
component MelodyView inherits HorizontalLayout {
    in property <bool> narrow;
    spacing: Theme.key-gap;
    Zone {
        accessible-id: "create.melody.source";
        width: root.narrow ? 280px : 320px;
        title: @tr("SOURCE");
        // Once a note is picked its controls say what to do.
        summary: Create.note.picked ? "" : @tr("Pick one note from a track on a deck or in the player. Drag IN and OUT around it, then hear it.");
        SourceChooser { }
        if Create.note.picked: NoteLine { }
        NoteWave { }
        if Create.note.picked: PitchRow { }
        if Create.note.picked: TypeRow { }
        // How sure the pitch is, beside HEAR.
        HorizontalLayout {
            alignment: center; spacing: Theme.s3;
            if Create.note.picked: VerticalLayout { alignment: center; NoteBadge { } }
            PlateButton {
                accessible-id: "create.source.hear"; accessible-role: button;
                compact: true; enabled: Create.note.picked; label: @tr("HEAR");
                active: Create.note.hearing; tone: Theme.attention;
                tooltip: @tr("Play the note from IN to OUT, with its fade (on the headphones while a deck plays)");
                clicked => { Create.hear(); }
            }
        }
    }
    ScrollZone {
        accessible-id: "create.melody.notes";
        horizontal-stretch: 1;
        title: @tr("NOTES");
        // No summary: the key row and the line under the pads say what to do.
        KeyRow { }
        ScaleRow { }
        if Create.more: ModeRow { }
        KeyStrip { }
        PadsHead { }
        PadRow { }
        PadsLine { }
        Arrange { }
    }
    // FITS folds away in a narrow window; THEORY has it too.
    if !root.narrow: Zone {
        accessible-id: "create.melody.fits";
        width: 280px;
        title: @tr("FITS");
        // Once a key is chosen its notes, chords and the deck playing say it.
        summary: Create.key.chosen ? "" : @tr("The notes and chords of the chosen key, and which of them fit the track playing now.");
        if Create.key.chosen: KeyFits { }
        if !Create.key.chosen: Caps { text: @tr("NO KEY CHOSEN YET"); }
    }
}

// [79] The kit: one segmented control, the kit chosen filled bone.
component KitChooser inherits HorizontalLayout {
    vertical-stretch: 0;
    alignment: center; spacing: Theme.key-gap;
    for k in [
        { id: "tight", tip: @tr("Tight: short, bright sounds") },
        { id: "warm", tip: @tr("Warm: lower, rounder sounds that ring longer") },
        { id: "dusty", tip: @tr("Dusty: dark and low, with a driven kick and toms") },
    ]: PlateButton {
        accessible-id: "create.kit." + k.id; accessible-role: button;
        compact: true; label: Create.kit-name(k.id);
        selected: Create.kit == k.id;
        tooltip: k.tip + ". " + @tr("Choosing a kit sets every pad to it");
        clicked => { Create.choose-kit(k.id); }
    }
}

// [79] A knob of the selected pad with its value under it.
component DrumKnob inherits VerticalLayout {
    in property <string> which;
    in property <string> label;
    in property <string> tip;
    in property <string> shown;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> default-value;
    in-out property <float> value;
    vertical-stretch: 0;
    spacing: Theme.s1;
    alignment: start;
    Knob {
        accessible-id: "create.kit." + root.which; accessible-value: root.shown;
        label: root.label; size: 40px;
        minimum: root.minimum; maximum: root.maximum; default-value: root.default-value;
        value <=> root.value;
        readout: root.shown;
        tooltip: root.tip;
        changed(v) => { Create.set-drum(root.which, v); }
    }
    Text {
        accessible-role: text; accessible-id: "create.kit." + root.which + ".value"; accessible-value: self.text;
        text: root.shown;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.bone;
        horizontal-alignment: center; overflow: elide;
    }
}

// [79] PITCH, DECAY and TONE of the selected pad, centred under its name.
component DrumKnobs inherits VerticalLayout {
    vertical-stretch: 0;
    spacing: Theme.s2;
    Text {
        accessible-role: text; accessible-id: "create.kit.pad"; accessible-value: self.text;
        text: Create.drum-name(Create.drum-knob-pad) + " · " + Create.drum-length;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.bone-2;
        letter-spacing: 1.2px;
        horizontal-alignment: center; overflow: elide;
    }
    HorizontalLayout {
        alignment: center; spacing: Theme.s4;
        DrumKnob {
            which: "pitch"; label: @tr("PITCH");
            tip: @tr("Pitch of the selected pad, in semitones");
            shown: Create.pitch-text(Create.drum-pitch);
            minimum: -12; maximum: 12; default-value: Create.kit-pitch;
            value <=> Create.drum-pitch;
        }
        DrumKnob {
            which: "decay"; label: @tr("DECAY");
            tip: @tr("Decay of the selected pad: how long it rings");
            shown: Create.drum-length;
            minimum: 0; maximum: 100; default-value: Create.kit-decay;
            value <=> Create.drum-decay;
        }
        DrumKnob {
            which: "tone"; label: @tr("TONE");
            tip: @tr("Tone of the selected pad, from dark to bright");
            shown: Math.round(Create.drum-tone) + " %";
            minimum: 0; maximum: 100; default-value: Create.kit-tone;
            value <=> Create.drum-tone;
        }
    }
}

// [79] One drum pad: its sound's name, played on press (sodium fill while
// it sounds). The selected pad (the knobs set it, the steps are its) is
// filled bone; one set away from the kit says so under its name. [80]
// Pads 9 to 16 hold samples from the library: an empty one is a hollow
// slot with its number (a press selects it for LOAD SAMPLE). A short line
// at the foot marks a pad with steps.
component DrumPad inherits Rectangle {
    in property <CreateDrumPad> pad;
    in property <int> index;
    property <bool> sample: root.index >= 8;
    property <bool> empty: root.sample && !root.pad.loaded;
    property <string> name: Create.drum-pad-name(root.index);
    property <bool> lit: root.pad.playing;
    property <bool> chosen: root.pad.selected && !root.lit;
    property <string> tip: root.empty ? @tr("Pad {}: empty. Select it, then LOAD SAMPLE puts the track open in Prepare's player on it", root.index + 1)
        : root.sample ? @tr("Play {}; STEPS shows its steps. LOAD SAMPLE replaces it", root.name)
        : @tr("Play {}; the knobs in KIT set it and STEPS shows its steps", root.name);
    accessible-role: button;
    accessible-id: "create.drums.pad" + (root.index + 1);
    accessible-label: TooltipState.name-for(self.accessible-id, root.name, root.tip);
    accessible-value: root.lit ? @tr("PLAYING") : root.pad.selected ? @tr("SELECTED") : root.empty ? @tr("EMPTY") : "";
    accessible-description: root.tip;
    accessible-action-default => { Create.play-drum(root.index); }
    // All alike wide, whatever the name, so the two rows line up.
    min-width: Theme.touch-min;
    preferred-width: Theme.touch-min;
    horizontal-stretch: 1;
    height: Theme.touch-mode ? 52px : 44px;
    background: root.empty ? (root.chosen ? Theme.bone : touch.has-hover ? Theme.plate-raised : transparent)
        : Theme.face(true, touch.pressed, touch.has-hover, root.chosen, root.lit, Theme.attention);
    border-radius: Theme.r-control;
    border-width: root.empty && !root.chosen ? Theme.hair : 0px;
    border-color: Theme.rule-strong;
    property <color> ink: root.empty && !root.chosen ? Theme.bone-3 : Theme.ink(true, touch.pressed, touch.has-hover, root.chosen, root.lit);
    VerticalLayout {
        padding-left: Theme.s1; padding-right: Theme.s1;
        alignment: center; spacing: 0px;
        Text {
            text: root.empty ? root.index + 1 : root.name;
            font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; letter-spacing: root.sample ? 0px : 1.2px;
            color: root.ink; horizontal-alignment: center; overflow: elide;
        }
        if root.pad.set: Caps {
            text: @tr("CHANGED");
            color: root.lit || root.pad.selected ? root.ink : Theme.bone-3;
            horizontal-alignment: center; overflow: elide;
        }
        if root.sample && root.pad.loaded: Caps {
            text: @tr("SAMPLE");
            color: root.lit || root.pad.selected ? root.ink : Theme.bone-3;
            horizontal-alignment: center; overflow: elide;
        }
    }
    if root.pad.steps: Rectangle {
        x: parent.width * 0.3; y: parent.height - 4px; width: parent.width * 0.4; height: 2px;
        background: root.lit || root.chosen ? Theme.ground : Theme.bone-3;
    }
    // A pad plays on press, as on an instrument.
    touch := TipArea {
        tooltip: root.tip;
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) { Create.play-drum(root.index); }
        }
    }
    KeyFocus { activate => { Create.play-drum(root.index); } }
}

// [79] [80] The 16 pads of the DRUMS bank: the kit's 8 over the 8 sample
// pads, a little apart after four; in four rows of four where a row of
// eight would leave a pad too narrow for its name. Follows the width
// through a plain property, so it does not feed back into the layout.
component DrumPads inherits VerticalLayout {
    property <bool> narrow;
    property <int> per-row: root.narrow ? 4 : 8;
    vertical-stretch: 0;
    init => { self.narrow = self.width < 520px; }
    changed width => { self.narrow = self.width < 520px; }
    spacing: Theme.key-gap;
    for r in 16 / root.per-row: HorizontalLayout {
        spacing: Theme.key-gap;
        for i in root.per-row: HorizontalLayout {
            padding-left: i > 0 && Math.mod(i, 4) == 0 ? Theme.s2 : 0px;
            DrumPad { pad: Create.drum-pads[r * root.per-row + i]; index: r * root.per-row + i; }
        }
    }
}

// [80] One step of the row: hollow while unset, bone where the selected
// pad plays, sodium while it sounds (a sodium outline on an unset step); a
// short line at its foot where another pad plays. The keyboard's cursor
// carries the focus ring. A tap sets or clears it.
component DrumStep inherits Rectangle {
    in property <CreateDrumStep> step;
    in property <int> index;
    in property <bool> cursor;
    callback tapped();
    property <bool> lit: root.step.playing;
    property <string> tip: @tr("Set or clear step {} of the selected pad; the arrow keys move along the steps, Return sets one", root.index + 1);
    // Read as a cell of the row: the row is the Tab stop.
    accessible-role: text;
    accessible-id: "create.drums.step" + (root.index + 1);
    accessible-label: TooltipState.name-for(self.accessible-id, @tr("STEP {}", root.index + 1), root.tip);
    accessible-value: (root.step.on ? @tr("set") : @tr("empty")) + (root.lit ? " " + @tr("playing") : "")
        + (root.step.others ? " " + @tr("other pads") : "");
    accessible-description: root.tip;
    accessible-action-default => { root.tapped(); }
    min-width: Theme.touch-min;
    height: Theme.touch-mode ? 44px : 40px;
    background: root.lit && root.step.on ? Theme.attention : root.step.on ? Theme.bone-2
        : touch.has-hover ? Theme.plate-raised : transparent;
    border-radius: Theme.r-control;
    border-width: root.step.on && !root.lit ? 0px : root.lit ? 2px : Theme.hair;
    border-color: root.lit ? Theme.attention : Theme.rule-strong;
    if root.step.others: Rectangle {
        x: parent.width * 0.3; y: parent.height - 5px; width: parent.width * 0.4; height: 2px;
        background: root.step.on ? Theme.ground : Theme.bone-3;
    }
    if root.cursor: Rectangle {
        border-width: Theme.focus-width; border-color: Theme.focus; border-radius: Theme.r-control;
    }
    touch := TipArea {
        tooltip: root.tip;
        mouse-cursor: pointer;
        clicked => { root.tapped(); }
    }
}

// [80] The 16 steps of the selected pad: one row, a little apart at each
// beat; two rows of 8 where one would be too narrow (and on touch, for
// 44 px targets). One Tab stop: the arrow keys move the cursor, Return or
// Space sets or clears its step. Follows the width through a plain
// property, so it does not feed back into the layout.
component DrumSteps inherits Rectangle {
    property <bool> wide;
    property <int> per-row: Theme.touch-mode || !root.wide ? 8 : 16;
    property <int> at: 0;
    init => { self.wide = self.width >= 480px; }
    changed width => { self.wide = self.width >= 480px; }
    property <string> tip: @tr("The steps of the selected pad: a tap or Return sets or clears one, the arrow keys move along them");
    accessible-role: list;
    accessible-id: "create.drums.steps.row";
    accessible-label: TooltipState.name-for(self.accessible-id, @tr("Steps"), root.tip);
    accessible-value: @tr("{} of 16 set", Create.drum-machine.steps-set);
    accessible-description: root.tip;
    vertical-stretch: 0;
    VerticalLayout {
        spacing: Theme.key-gap;
        for r in 16 / root.per-row: HorizontalLayout {
            spacing: Theme.key-gap;
            for i in root.per-row: HorizontalLayout {
                padding-left: i > 0 && Math.mod(i, 4) == 0 ? Theme.s2 : 0px;
                DrumStep {
                    step: Create.drum-steps[r * root.per-row + i]; index: r * root.per-row + i;
                    cursor: focus.focused && root.at == r * root.per-row + i;
                    tapped => { root.at = r * root.per-row + i; Create.toggle-drum-step(r * root.per-row + i); }
                }
            }
        }
    }
    focus := KeyFocus {
        arrows: true;
        activate => { Create.toggle-drum-step(root.at); }
        step(d) => { root.at = clamp(root.at + d, 0, 15); }
    }
}

// [80] SWING and HALF TIME, the sequencer's own (Perform's sequencer
// plays with them too).
component DrumFeel inherits HorizontalLayout {
    spacing: Theme.key-gap;
    alignment: start;
    Caps { text: @tr("SWING"); vertical-alignment: center; }
    Stepper {
        accessible-id: "create.steps.swing";
        a11y-prev: "create.steps.swing.less"; a11y-value: "create.steps.swing.value"; a11y-next: "create.steps.swing.more";
        value: Create.drum-machine.swing + " %"; template: "00 %"; lit: Create.drum-machine.swing > 0;
        size: 26px;
        tooltip: @tr("Swing: every off-beat step that share of a step late (33 % is a triplet shuffle)");
        step(d) => { Create.set-swing(Create.drum-machine.swing + d * 5); }
    }
    PlateButton {
        accessible-id: "create.steps.half"; accessible-role: checkbox;
        accessible-checkable: true; accessible-checked: Create.drum-machine.half-time;
        compact: true; label: @tr("HALF TIME");
        selected: Create.drum-machine.half-time;
        tooltip: @tr("Half time: a step is an eighth note, so the 16 steps take two bars (for material read at half the tempo)");
        clicked => { Create.set-half-time(!Create.drum-machine.half-time); }
    }
}

// [80] PLAY, REC, CLEAR and UNDO of the step row.
component DrumKeys inherits HorizontalLayout {
    spacing: Theme.key-gap;
    PlateButton {
        accessible-id: "create.steps.play"; accessible-role: button;
        compact: true; label: Create.drum-machine.waiting ? @tr("NEXT BAR") : Create.drum-machine.playing ? @tr("STOP") : @tr("PLAY");
        active: Create.drum-machine.playing; tone: Theme.attention;
        tooltip: @tr("Play the steps on the master tempo, from the next bar while a deck plays (through the sampler); again to stop");
        clicked => { Create.drum-play(); }
    }
    PlateButton {
        accessible-id: "create.steps.rec"; accessible-role: checkbox;
        accessible-checkable: true; accessible-checked: Create.drum-machine.rec;
        compact: true; label: Create.drum-machine.rec ? @tr("REC ON") : @tr("REC");
        active: Create.drum-machine.rec; tone: Theme.fault;
        tooltip: @tr("Record: pads pressed while the steps play land on the nearest step; again to stop");
        clicked => { Create.drum-rec(); }
    }
    PlateButton {
        accessible-id: "create.steps.clear"; accessible-role: button;
        compact: true; label: @tr("CLEAR"); tone: Theme.fault;
        enabled: Create.drum-machine.hits > 0;
        tooltip: @tr("Empty every pad's steps (UNDO brings them back)");
        clicked => { Create.drum-clear(); }
    }
    PlateButton {
        accessible-id: "create.steps.undo"; accessible-role: button;
        compact: true; label: @tr("UNDO");
        enabled: Create.drum-machine.can-undo;
        tooltip: @tr("Bring back the steps as they were before the last CLEAR");
        clicked => { Create.drum-undo(); }
    }
}

// [80] STEPS' head: SWING and HALF TIME on the left, the keys on the
// right; on two rows where one would be too narrow. Follows the width
// through a plain property, so it does not feed back into the layout.
component DrumHead inherits VerticalLayout {
    property <bool> wide;
    init => { self.wide = self.width >= 620px; }
    changed width => { self.wide = self.width >= 620px; }
    spacing: Theme.key-gap;
    if root.wide: HorizontalLayout {
        spacing: Theme.s3;
        DrumFeel { horizontal-stretch: 1; }
        DrumKeys { horizontal-stretch: 0; }
    }
    if !root.wide: DrumFeel { }
    if !root.wide: DrumKeys { alignment: start; }
}

// DRUMS: KIT | PADS over STEPS.
component DrumsView inherits HorizontalLayout {
    in property <bool> narrow;
    spacing: Theme.key-gap;
    Zone {
        accessible-id: "create.drums.kit";
        width: root.narrow ? 280px : 320px;
        title: @tr("KIT");
        KitChooser { }
        DrumKnobs { }
        Prose { text: @tr("The knobs set the kit pad selected last. A double-click on a knob brings back the kit's setting. The kits are synthesised, so they sound the same on every computer."); }
        HorizontalLayout {
            alignment: center;
            PlateButton {
                accessible-id: "create.kit.load"; accessible-role: button;
                compact: true; label: @tr("LOAD SAMPLE");
                tooltip: @tr("Put the track open in Prepare's player (or the file selected in a folder) on the selected pad of 9 to 16, else the first empty one");
                clicked => { Create.load-sample(); }
            }
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Theme.key-gap;
        // The pads as tall as they are; the steps take the rest.
        Zone {
            accessible-id: "create.drums.pads";
            vertical-stretch: 0;
            title: @tr("PADS · DRUMS BANK");
            DrumPads { }
            Text {
                accessible-role: text; accessible-id: "create.drums.hint"; accessible-value: self.text;
                min-width: 0px;
                text: @tr("A pad plays and shows its steps below. Pads 9 to 16 take samples from the library: LOAD SAMPLE.");
                font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3;
                overflow: elide;
            }
        }
        Zone {
            accessible-id: "create.drums.steps";
            vertical-stretch: 1;
            title: @tr("STEPS ({})", Create.drum-pad-name(Create.drum-selected));
            DrumHead { }
            DrumSteps { }
            if Create.drum-machine.hits == 0: StarterRow { where: "steps"; drums: true; }
        }
    }
}

// [78] One deck's key in THEORY: the numeral in the deck colour, the key
// as note names with the wheel notation beside, and its state (PLAYING
// NOW on the deck FITS and the chords compare with).
component DeckKey inherits Rectangle {
    in property <CreateTheoryDeck> deck;
    property <string> name: Create.key-of(root.deck.root, root.deck.scale);
    property <string> state: !root.deck.loaded ? @tr("NO TRACK") : root.deck.root == "" ? @tr("NO KEY YET")
        : root.deck.now ? @tr("PLAYING NOW") : root.deck.playing ? @tr("PLAYING") : "";
    accessible-role: text;
    accessible-id: "create.theory.key.deck\{root.deck.deck}";
    accessible-label: @tr("Deck {}", root.deck.deck);
    accessible-value: (root.name != "" ? root.name + (root.deck.wheel != "" ? " " + root.deck.wheel : "") : "—")
        + (root.state != "" ? " " + root.state : "");
    HorizontalLayout {
        spacing: Theme.s2;
        Text {
            width: 18px;
            text: root.deck.deck;
            font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi;
            color: Theme.deck-color(root.deck.deck); vertical-alignment: center;
        }
        Text {
            text: root.name != "" ? root.name : "—";
            font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi;
            color: root.name != "" ? Theme.bone : Theme.bone-3; vertical-alignment: center;
            min-width: 0px; overflow: elide;
        }
        if root.deck.wheel != "": Caps { text: root.deck.wheel; vertical-alignment: center; }
        Caps {
            horizontal-stretch: 1; min-width: 0px;
            text: root.state; horizontal-alignment: right;
            vertical-alignment: center; overflow: elide;
        }
    }
}

// [78] A key next to the chosen one: its name (the wheel beside), how it
// moves (the same notes, a fifth up or down), and a deck already in it.
component NeighbourRow inherits Rectangle {
    in property <CreateNeighbour> n;
    in property <int> index;
    property <string> name: Create.key-of(root.n.root, root.n.scale);
    property <string> how: root.n.how == "relative" ? @tr("SAME NOTES") : root.n.how == "up" ? @tr("A FIFTH UP") : @tr("A FIFTH DOWN");
    accessible-role: text;
    accessible-id: "create.theory.neighbour" + (root.index + 1);
    accessible-label: root.name;
    accessible-value: root.name + (root.n.wheel != "" ? " " + root.n.wheel : "") + " · " + root.how
        + (root.n.deck > 0 ? " · " + @tr("DECK {}", root.n.deck) : "");
    height: 32px;
    background: Theme.plate;
    border-radius: Theme.r-control;
    HorizontalLayout {
        padding-left: Theme.s2; padding-right: Theme.s2; spacing: Theme.s2;
        Text {
            text: root.name;
            font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi; color: Theme.bone;
            vertical-alignment: center; min-width: 0px; overflow: elide;
        }
        if root.n.wheel != "": Caps { text: root.n.wheel; vertical-alignment: center; }
        Caps {
            horizontal-stretch: 1; min-width: 0px;
            text: root.how; horizontal-alignment: right; vertical-alignment: center; overflow: elide;
        }
        if root.n.deck > 0: Caps {
            text: @tr("DECK {}", root.n.deck); color: Theme.bone; font-weight: Theme.weight-semi;
            vertical-alignment: center;
        }
    }
}

// [78] Typing a melody in THEORY: it replaces MELODY's strip, as there.
component TheoryType inherits Field {
    accessible-id: "create.theory.type";
    placeholder: @tr("TYPE A MELODY: A3 C4 E4 D4");
    accepted(t) => { Create.type-steps(t); }
}

// [78] The check of the strip's melody: a solid green line and "All
// notes fit", or a struck red one with the notes out of the key named.
component CheckLine inherits HorizontalLayout {
    property <bool> out: Create.check.state == "out";
    spacing: Theme.s2;
    // The struck line reaches past its own width.
    padding-left: Theme.s1;
    height: 20px;
    if Create.check.state == "fits" || root.out: VerticalLayout {
        alignment: center;
        VLine { height: 14px; form: root.out ? "struck" : "solid"; tone: root.out ? Theme.fault : Theme.live; }
    }
    Text {
        accessible-role: text; accessible-id: "create.theory.result"; accessible-value: self.text;
        horizontal-stretch: 1; min-width: 0px;
        text: Create.check.state == "no-key" ? @tr("No key chosen yet: the check needs one.")
            : Create.check.state == "empty" ? @tr("No melody yet: type one here or play one into ARRANGE.")
            : root.out ? @tr("Not in {}: {}", Create.check.key, Create.check.outside)
            : @tr("All notes fit {}", Create.check.key);
        font-family: Theme.family; font-size: Theme.body; font-weight: root.out ? Theme.weight-semi : Theme.weight-medium;
        color: root.out || Create.check.state == "fits" ? Theme.bone : Theme.bone-3;
        vertical-alignment: center; overflow: elide;
    }
}

// THEORY: KEYS | CHECK | WHY.
component TheoryView inherits HorizontalLayout {
    in property <bool> narrow;
    spacing: Theme.key-gap;
    Zone {
        accessible-id: "create.theory.keys";
        width: root.narrow ? 280px : 320px;
        title: @tr("KEYS");
        summary: @tr("Both decks' keys, and the neighbouring keys that move smoothly.");
        for d in Create.theory-decks: DeckKey { deck: d; }
        Rectangle { height: Theme.s1; }
        Caps {
            accessible-role: text; accessible-id: "create.theory.neighbours"; accessible-value: self.text;
            text: Create.key.chosen ? @tr("NEXT TO {}", Create.key-name()) : @tr("NO KEY CHOSEN YET");
            min-width: 0px; overflow: elide;
        }
        for n[i] in Create.neighbours: NeighbourRow { n: n; index: i; }
    }
    ScrollZone {
        accessible-id: "create.theory.check";
        horizontal-stretch: 1;
        title: @tr("CHECK");
        HorizontalLayout {
            spacing: Theme.s2;
            Caps { text: @tr("KEY"); vertical-alignment: center; }
            Text {
                accessible-role: text; accessible-id: "create.theory.check.key"; accessible-value: self.text;
                text: Create.key.chosen ? Create.key-name() : "—";
                font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi;
                color: Create.key.chosen ? Theme.bone : Theme.bone-3;
                vertical-alignment: center; min-width: 0px; overflow: elide;
            }
            if Create.key.wheel != "": Caps { text: Create.key.wheel; vertical-alignment: center; }
            KeyFrom { horizontal-stretch: 1; min-width: 0px; accessible-id: "create.theory.key-from"; }
        }
        KeyStrip { }
        if Create.key.chosen: ChordGrid { where: "theory"; may-be-one-row: true; }
        Rectangle { height: Theme.s1; }
        HorizontalLayout {
            spacing: Theme.s2;
            Caps { text: @tr("MELODY"); vertical-alignment: center; }
            Text {
                accessible-role: text; accessible-id: "create.theory.melody"; accessible-value: self.text;
                horizontal-stretch: 1; min-width: 0px;
                text: Create.steps-text != "" ? Create.steps-text : "—";
                font-family: Theme.family; font-size: Theme.body; color: Theme.bone;
                vertical-alignment: center; overflow: elide;
            }
        }
        HorizontalLayout {
            TheoryType { horizontal-stretch: 1; min-width: 130px; max-width: 420px; }
            Rectangle { horizontal-stretch: 1; }
        }
        CheckLine { }
        if Create.notes == 0: StarterRow { where: "theory"; }
    }
    Zone {
        accessible-id: "create.theory.why";
        width: root.narrow ? 220px : 280px;
        title: @tr("WHY");
        summary: Create.hints ? @tr("Three short lines in plain words on why the notes fit.") : "";
        HorizontalLayout {
            alignment: start;
            LineToggle {
                accessible-id: "create.theory.hints";
                label: @tr("HINTS");
                checked: Create.hints;
                tooltip: @tr("Hints: the lines on why notes fit, and HAPPY and SAD under MAJOR and MINOR");
                toggled(on) => { Create.set-hints(on); }
            }
        }
        // Straight in the zone's column: wrapping text needs its width.
        for w[i] in Create.hints ? Create.why : []: Prose {
            accessible-role: text; accessible-id: "create.theory.why" + (i + 1); accessible-value: self.text;
            text: w; color: Theme.bone;
        }
        if Create.hints && Create.why.length == 0: Prose {
            accessible-role: text; accessible-id: "create.theory.why-none"; accessible-value: self.text;
            text: @tr("The reasons show once a key is chosen: on a deck, by NEXT TRACK or by you in MELODY.");
        }
        if !Create.hints: Prose {
            accessible-role: text; accessible-id: "create.theory.why-off"; accessible-value: self.text;
            text: @tr("The hints are off: the notes, chords and the check stay. HINTS brings these lines back.");
        }
    }
}

// RESULT: what was made in one line, and what to do with it.
component ResultBar inherits Rectangle {
    accessible-role: groupbox;
    accessible-id: "create.result";
    accessible-label: @tr("RESULT");
    background: Theme.ground-band;
    border-radius: Theme.r-panel;
    property <string> summary: Create.view == "drums"
        ? (Create.drum-machine.hits > 0 ? (Create.drum-starter != "" ? @tr("STARTER {}", Create.starter-name(Create.drum-starter)) + " · " : "") + root.drums
            : @tr("No pattern yet. It shows here with its bars and tempo, ready to send to Perform or render as a loop."))
        : Create.view == "theory" ? @tr("THEORY shows what fits. A melody typed here lands on MELODY's strip.")
        : Create.render.notes > 0 ? (Create.starter != "" ? @tr("STARTER {}", Create.starter-name(Create.starter)) + " · " : "") + root.melody
        : @tr("No melody yet. It shows here with its notes, bars, tempo and cues, and whether the stick formats take it.");
    // [74] [75] What the file holds: "8 notes · 4 bars · 124.0 BPM · 8 cues".
    property <string> melody: (Create.render.notes == 1 ? @tr("1 note") : @tr("{} notes", Create.render.notes))
        + " · " + (Create.render.bars == 1 ? @tr("1 bar") : @tr("{} bars", Create.render.bars))
        + " · " + (Create.render.bpm == "" ? "—" : Create.render.bpm) + " BPM"
        + " · " + (Create.render.cues == 1 ? @tr("1 cue") : @tr("{} cues", Create.render.cues));
    // [80] The drum pattern: "pattern 1 · 16 steps · 1 bar · 124.0 BPM ·
    // swing 20 % · half time".
    property <CreateDrumMachine> dm: Create.drum-machine;
    property <string> drums: (root.dm.pattern > 0 ? @tr("pattern {}", root.dm.pattern) : @tr("every PATTERN pad taken"))
        + " · " + @tr("16 steps")
        + " · " + (root.dm.bars == 1 ? @tr("1 bar") : @tr("{} bars", root.dm.bars))
        + " · " + root.dm.bpm + " BPM"
        + " · " + @tr("swing {} %", root.dm.swing)
        + (root.dm.half-time ? " · " + @tr("half time") : "");
    // [75] [81] What the stick formats take of the file MELODY's RENDER or
    // DRUMS' RENDER LOOP writes.
    property <string> fits: Create.view == "melody" ? Create.render.fits : Create.view == "drums" ? root.dm.fits : "";
    property <string> check: Create.view == "melody" ? Create.render.check : root.dm.check;
    property <bool> ready: Create.render.state == "ready";
    property <bool> rendering: Create.render.state == "rendering";
    property <bool> sent: Create.render.send == "sent";
    property <bool> sending: Create.render.send == "sending";
    // A narrow window drops the tempos from MASTER and TRACK (the line
    // above says the one in use). Follows the width through a plain
    // property, so it does not feed back into the layout.
    property <bool> tight;
    init => { self.tight = self.width < 960px; }
    changed width => { self.tight = self.width < 960px; }
    // Only as tall as its line and its actions; the views take the rest.
    vertical-stretch: 0;
    VerticalLayout {
        padding: Theme.s3; spacing: Theme.s2;
        // One line: a wrapping text here would be measured at no width and
        // stretch the bar. [75] The stick formats' check on the right: a
        // solid green line when the file fits, a struck red one when not.
        HorizontalLayout {
            spacing: Theme.s3;
            Caps { text: @tr("RESULT"); color: Theme.bone-2; font-weight: Theme.weight-semi; vertical-alignment: center; }
            Text {
                accessible-id: "create.result.summary"; accessible-role: text; accessible-value: self.text;
                horizontal-stretch: 1; min-width: 0px;
                text: root.summary;
                font-family: Theme.family; font-size: Theme.body; color: Theme.bone-2;
                vertical-alignment: center; overflow: elide;
            }
            if root.fits != "": HorizontalLayout {
                horizontal-stretch: 0; min-width: 0px; spacing: Theme.s2;
                VerticalLayout {
                    alignment: center;
                    VLine {
                        height: 14px;
                        form: root.fits == "fits" ? "solid" : "struck";
                        tone: root.fits == "fits" ? Theme.live : Theme.fault;
                    }
                }
                Text {
                    accessible-id: "create.result.check"; accessible-role: text; accessible-value: self.text;
                    min-width: 0px;
                    text: root.check;
                    font-family: Theme.family; font-size: Theme.control;
                    color: root.fits == "fits" ? Theme.bone-2 : Theme.bone;
                    vertical-alignment: center; overflow: elide;
                }
            }
        }
        if Create.view == "melody": HorizontalLayout {
            alignment: center; spacing: Theme.s3;
            HorizontalLayout {
                spacing: Theme.key-gap;
                PlateButton {
                    accessible-id: "create.result.single-notes"; accessible-role: tab;
                    compact: true; label: @tr("SINGLE NOTES");
                    selected: Create.render.layout == "single";
                    tooltip: @tr("Render one hot cue per note, each note on its own bar, to play them by hand");
                    clicked => { Create.set-layout("single"); }
                }
                PlateButton {
                    accessible-id: "create.result.melody"; accessible-role: tab;
                    compact: true; label: @tr("MELODY");
                    selected: Create.render.layout == "melody";
                    tooltip: @tr("Render the strip in time, one cue per note in order, ready as a transition");
                    clicked => { Create.set-layout("melody"); }
                }
            }
            HorizontalLayout {
                spacing: Theme.key-gap;
                PlateButton {
                    accessible-id: "create.result.tempo.master"; accessible-role: tab;
                    compact: true; label: root.tight ? @tr("MASTER") : @tr("MASTER") + " " + Create.render.master;
                    selected: Create.render.tempo-from == "master";
                    tooltip: @tr("Render at the master tempo");
                    clicked => { Create.set-tempo-from("master"); }
                }
                PlateButton {
                    accessible-id: "create.result.tempo.track"; accessible-role: tab;
                    compact: true; label: root.tight ? @tr("TRACK") : @tr("TRACK") + " " + (Create.render.track == "" ? "—" : Create.render.track);
                    selected: Create.render.tempo-from == "track";
                    enabled: Create.render.track != "" || Create.render.tempo-from == "track";
                    tooltip: Create.render.track == "" ? @tr("The source track has no beatgrid: analyse it to render at its tempo")
                        : @tr("Render at the tempo of the track the note comes from");
                    clicked => { Create.set-tempo-from("track"); }
                }
            }
            // Rendered: filled green with the word READY.
            PlateButton {
                accessible-id: "create.result.render"; accessible-role: button;
                compact: true;
                label: root.ready ? @tr("READY") : root.rendering ? @tr("RENDERING") : @tr("RENDER");
                enabled: Create.render.can || root.ready || root.rendering;
                active: root.ready || root.rendering;
                tone: root.ready ? Theme.live : Theme.attention;
                tooltip: root.ready ? @tr("Rendered: the file is in the library with its beatgrid and cues")
                    : @tr("Write a new file with its beatgrid and a hot cue per note; the source track stays as it is");
                clicked => { Create.render-file(); }
            }
            // [77] Sent: filled green with the word SENT while the MELODY
            // bank holds these notes.
            PlateButton {
                accessible-id: "create.result.send"; accessible-role: button;
                compact: true;
                label: root.sent ? @tr("SENT") : root.sending ? @tr("SENDING") : @tr("SEND TO PERFORM");
                enabled: Create.render.can-send || root.sent || root.sending;
                active: root.sent || root.sending;
                tone: root.sent ? Theme.live : Theme.attention;
                tooltip: root.sent ? @tr("Sent: the MELODY pad mode in Perform plays these notes from the sampler's MELODY bank")
                    : Create.render.can-send ? @tr("Put the notes on the MELODY pads in Perform and into the sampler's MELODY bank: the strip's notes, else the pads'")
                    : @tr("Pick a note in SOURCE first: then its notes go to the MELODY pads in Perform");
                clicked => { Create.send-to-perform(); }
            }
            // [76] The browser's add-to-playlist menu, for the file READY:
            // the lists added to last, every playlist and set, or a new
            // playlist. Before a render there is nothing to add.
            picker := ContextMenuArea {
                // The demo hook opens it.
                property <int> asked: Create.open-picker;
                changed asked => { self.show({ x: 0, y: self.height }); }
                Menu {
                    for p in Create.recent: MenuItem { title: @tr("Add to “{}”", p.name); activated => { Create.to-playlist(p.id); } }
                    Menu {
                        title: @tr("Add to playlist");
                        for p in Create.playlists: MenuItem { title: p.name; activated => { Create.to-playlist(p.id); } }
                    }
                    MenuItem { title: @tr("Add to a new playlist"); activated => { Create.to-playlist(0); } }
                }
                HorizontalLayout {
                    to-playlist := PlateButton {
                        accessible-id: "create.result.to-playlist"; accessible-role: button;
                        compact: true; enabled: root.ready; label: @tr("TO PLAYLIST");
                        tooltip: root.ready ? @tr("Add the rendered file to a playlist; sticks that sync the playlist get it")
                            : @tr("RENDER first: then the file goes into a playlist");
                        clicked => { picker.show({ x: to-playlist.x, y: to-playlist.y + to-playlist.height }); }
                    }
                }
            }
        }
        // [80] Saved and sent: filled green with the word (SAVED, SENT).
        if Create.view == "drums": HorizontalLayout {
            alignment: center; spacing: Theme.s3;
            PlateButton {
                accessible-id: "create.result.send"; accessible-role: button;
                compact: true;
                label: root.dm.sent ? @tr("SENT") : @tr("SEND TO PERFORM");
                enabled: root.dm.hits > 0 || root.dm.sent;
                active: root.dm.sent; tone: root.dm.sent ? Theme.live : Theme.attention;
                tooltip: root.dm.sent ? @tr("Sent: the PATTERN pads in Perform play this pattern, the sampler's DRUMS bank holds the kit")
                    : @tr("Save the pattern on a PATTERN pad and put the sampler in Perform on the DRUMS bank");
                clicked => { Create.send-drums(); }
            }
            // [81] The loop's bars, then RENDER LOOP: rendered, filled
            // green with the word READY.
            Stepper {
                accessible-id: "create.result.loop-bars";
                a11y-prev: "create.result.loop-bars.less"; a11y-value: "create.result.loop-bars.value"; a11y-next: "create.result.loop-bars.more";
                value: root.dm.loop-bars == 1 ? @tr("1 BAR") : @tr("{} BARS", root.dm.loop-bars); template: @tr("{} BARS", 8);
                size: 26px;
                tooltip: @tr("Bars of the loop file: 1, 2, 4 or 8 (two at least at half time)");
                step(d) => { Create.step-loop-bars(d); }
            }
            PlateButton {
                accessible-id: "create.result.render-loop"; accessible-role: button;
                compact: true;
                label: root.dm.loop-state == "ready" ? @tr("READY") : root.dm.loop-state == "rendering" ? @tr("RENDERING") : @tr("RENDER LOOP");
                enabled: root.dm.can-loop || root.dm.loop-state != "";
                active: root.dm.loop-state != "";
                tone: root.dm.loop-state == "ready" ? Theme.live : Theme.attention;
                tooltip: root.dm.loop-state == "ready" ? @tr("Rendered: the loop is in the library with its beatgrid, a hot cue per sound and a loop over all of it")
                    : root.dm.can-loop ? @tr("Write the pattern as a new file of exactly these bars at the master tempo, with a beatgrid, a hot cue per sound and a loop over all of it")
                    : @tr("Set steps on the pads first: then the pattern can be written as a loop file");
                clicked => { Create.render-loop(); }
            }
            PlateButton {
                accessible-id: "create.result.save-pattern"; accessible-role: button;
                compact: true;
                label: root.dm.saved ? @tr("SAVED") : @tr("SAVE PATTERN");
                enabled: root.dm.hits > 0 || root.dm.saved;
                active: root.dm.saved; tone: root.dm.saved ? Theme.live : Theme.attention;
                tooltip: root.dm.saved ? @tr("Saved: pad S{} of the PATTERN pad mode in Perform plays it", root.dm.pattern)
                    : @tr("Keep the steps, swing and half time in the sampler's store, on a PATTERN pad in Perform");
                clicked => { Create.save-pattern(); }
            }
        }
    }
}

// One deck in the strip: numeral, play state (line and word), and while
// there is room the tempo, where it is in the bar and the track, and the
// level. Nothing here is a control: the decks are played in Perform.
component StripDeck inherits Rectangle {
    in property <CreateDeck> deck;
    in property <bool> slim;
    property <string> state: root.deck.playing ? @tr("PLAYING") : root.deck.loaded ? @tr("PAUSED") : @tr("EMPTY");
    accessible-role: text;
    accessible-id: "create.strip.deck\{root.deck.deck}";
    accessible-label: @tr("Deck {}", root.deck.deck);
    accessible-value: root.deck.bpm != "" ? root.state + " " + root.deck.bpm + " BPM" : root.state;
    HorizontalLayout {
        spacing: Theme.s2;
        Text {
            width: 14px;
            text: root.deck.deck;
            font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi;
            color: Theme.deck-color(root.deck.deck); vertical-alignment: center;
        }
        // The state line: solid green while playing, half strong rule when not.
        VLine { form: root.deck.playing ? "solid" : "half"; tone: root.deck.playing ? Theme.live : Theme.rule-strong; }
        Caps {
            min-width: self.preferred-width;
            text: root.state; font-weight: Theme.weight-semi;
            color: root.deck.playing ? Theme.bone : Theme.bone-3; vertical-alignment: center;
        }
        if !root.slim: Text {
            accessible-id: "create.strip.deck\{root.deck.deck}.bpm"; accessible-role: text; accessible-value: self.text;
            width: 52px; horizontal-alignment: right;
            text: root.deck.bpm != "" ? root.deck.bpm : "—";
            font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
            color: root.deck.bpm != "" ? Theme.bone : Theme.bone-3; vertical-alignment: center;
        }
        // The bar (four beats, the deck's line where it is) over the track
        // (a hairline filled up to the position).
        if !root.slim: Rectangle {
            accessible-id: "create.strip.deck\{root.deck.deck}.phase"; accessible-role: progress-indicator;
            accessible-value: round(root.deck.progress * 100) + " %";
            min-width: 60px; horizontal-stretch: 1;
            for b in 4: Rectangle {
                x: b * parent.width / 4; y: parent.height / 2 - 5px; width: Theme.hair; height: 7px;
                background: Theme.rule-strong;
            }
            Rectangle { x: 0; y: parent.height / 2 - 2px; width: parent.width; height: Theme.hair; background: Theme.rule-strong; }
            if root.deck.loaded: Rectangle {
                x: clamp(root.deck.bar, 0, 1) * (parent.width - Theme.line); y: Theme.s1; width: Theme.line; height: parent.height / 2 - Theme.s1;
                background: Theme.deck-color(root.deck.deck);
            }
            Rectangle {
                x: 0; y: parent.height - Theme.s1 - Theme.line; width: parent.width; height: Theme.line;
                background: Theme.plate;
            }
            Rectangle {
                x: 0; y: parent.height - Theme.s1 - Theme.line; width: parent.width * clamp(root.deck.progress, 0, 1); height: Theme.line;
                background: Theme.bone-3;
            }
        }
        // Level: a filled line, live, attention near the top, fault at clip.
        if !root.slim: Rectangle {
            accessible-id: "create.strip.deck\{root.deck.deck}.level"; accessible-role: progress-indicator;
            accessible-value: round(root.deck.level * 100) + " %";
            width: 40px;
            Rectangle { x: 0; y: parent.height / 2 - 2px; width: parent.width; height: 4px; background: Theme.plate; border-radius: 2px; }
            Rectangle {
                x: 0; y: parent.height / 2 - 2px; width: parent.width * clamp(root.deck.level, 0, 1); height: 4px; border-radius: 2px;
                background: root.deck.level >= 0.99 ? Theme.fault : root.deck.level > 0.8 ? Theme.attention : Theme.live;
            }
        }
    }
}

// The deck strip at the foot of CREATE.
component DeckStrip inherits Rectangle {
    in property <bool> slim;
    accessible-role: groupbox;
    accessible-id: "create.strip";
    accessible-label: @tr("Decks");
    height: Theme.touch-mode ? 44px : 36px;
    background: Theme.ground-band;
    border-radius: Theme.r-panel;
    HorizontalLayout {
        padding-left: Theme.s3; padding-right: Theme.s3;
        spacing: root.slim ? Theme.s4 : Theme.s5;
        Caps { text: @tr("DECKS"); vertical-alignment: center; }
        if Create.decks.length == 0: Text {
            horizontal-stretch: 1;
            text: @tr("The decks show here once audio runs");
            font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3; vertical-alignment: center;
            overflow: elide;
        }
        for d in Create.decks: StripDeck {
            horizontal-stretch: root.slim ? 0 : 1;
            deck: d; slim: root.slim;
        }
        if root.slim: Rectangle { horizontal-stretch: 1; }
    }
}

export component CreateView inherits Rectangle {
    accessible-role: groupbox;
    accessible-id: "create.view";
    accessible-label: @tr("CREATE");
    // A narrow window folds FITS away and gives the side zones less room;
    // below about 1060 px the strip keeps the play states only. Follows the
    // width through plain properties, so it does not feed back into the
    // layout.
    property <bool> narrow;
    property <bool> slim;
    init => { self.narrow = self.width < 1100px; self.slim = self.width < 1060px; }
    changed width => { self.narrow = self.width < 1100px; self.slim = self.width < 1060px; }
    VerticalLayout {
        spacing: Theme.key-gap;
        // The three views: one segmented control, centred.
        Rectangle {
            background: Theme.ground-band;
            border-radius: Theme.r-panel;
            HorizontalLayout {
                alignment: center; spacing: Theme.key-gap;
                padding-top: Theme.s2; padding-bottom: Theme.s2;
                for v in [{ id: "melody", label: @tr("MELODY") }, { id: "drums", label: @tr("DRUMS") }, { id: "theory", label: @tr("THEORY") }]: PlateButton {
                    accessible-id: "create.view." + v.id; accessible-role: tab;
                    width: max(112px, self.min-width);
                    label: v.label; selected: Create.view == v.id;
                    tooltip: v.id == "melody" ? @tr("Melody: play the next track's melody from one note")
                        : v.id == "drums" ? @tr("Drums: a small drum machine with built-in sounds")
                        : @tr("Theory: which notes and keys fit");
                    clicked => { Create.view = v.id; }
                }
            }
        }
        if Create.view == "melody": MelodyView { vertical-stretch: 1; narrow: root.narrow; }
        if Create.view == "drums": DrumsView { vertical-stretch: 1; narrow: root.narrow; }
        if Create.view == "theory": TheoryView { vertical-stretch: 1; narrow: root.narrow; }
        ResultBar { }
        DeckStrip { slim: root.slim; }
    }
}
