// Design tokens of the emission-line world.
//
// Colour appears only as emission lines at fixed wavelengths on a charcoal
// continuum (dark) or on paper (light). State is carried by line form (see
// lines.slint), never by hue alone.

import "../fonts/BarlowSemiCondensed-Regular.ttf";
import "../fonts/BarlowSemiCondensed-Medium.ttf";
import "../fonts/BarlowSemiCondensed-SemiBold.ttf";
import { Palette } from "std-widgets.slint";

export global Theme {
    // Accessibility switches, set from settings.
    in-out property <bool> colorblind-safe: false;
    in-out property <bool> high-contrast: false;
    in-out property <bool> motion: true;
    // Phrase types written on the phrase bars (Preferences > View; off:
    // colour blocks only).
    in-out property <bool> phrase-names: true;
    // Calm waveform (Preferences > View): the playhead is a crisp 1 px line
    // with dark rims; Rust draws faint beat lines and softer colours.
    in-out property <bool> calm-wave: false;

    // Appearance (Preferences > View, the sun / moon in the top bar):
    // "dark", "light" or "system". `system` follows the OS through Slint's
    // colour scheme; `os-light` is the app's own probe for platforms where
    // Slint cannot tell (set from Rust).
    in-out property <string> appearance: "dark";
    in-out property <bool> os-light: false;
    out property <bool> system-known: Palette.color-scheme != ColorScheme.unknown;
    // Light mode: paper ground, ink legends, the same wavelengths darkened.
    out property <bool> light: appearance == "light"
        || (appearance == "system" && (Palette.color-scheme == ColorScheme.light || (Palette.color-scheme == ColorScheme.unknown && os-light)));

    // Every colour token: light ? (light values) : (dark values). The
    // contrast test in tests/theme_contrast.rs evaluates this file.

    // Continuum: charcoal in dark, paper in light.
    out property <color> ground: light ? (high-contrast ? #FAF9F5 : #F3F0E8) : (high-contrast ? #0B0B0B : #151514);
    out property <color> ground-band: light ? (high-contrast ? #F2F0E9 : #E9E5DA) : (high-contrast ? #121212 : #1A1A19);
    out property <color> plate: light ? (high-contrast ? #ECE9E0 : #E4E0D4) : (high-contrast ? #1C1C1B : #262624);
    out property <color> plate-raised: light ? (high-contrast ? #E0DCD0 : #D8D3C5) : #32322F;
    out property <color> rule: light ? (high-contrast ? #8A857A : #CAC5B8) : (high-contrast ? #4B4A46 : #33322F);
    out property <color> rule-strong: light ? (high-contrast ? #6A665E : #A39E91) : #4B4A46;

    // Legends: bone on charcoal, ink on paper (all ≥ 4.5:1 on ground and
    // ground-band; see tests/theme_contrast.rs).
    out property <color> bone: light ? (high-contrast ? #000000 : #1D1C1A) : (high-contrast ? #FFFFFF : #E6E0D2);
    out property <color> bone-2: light ? (high-contrast ? #26241F : #4A4740) : (high-contrast ? #E6E0D2 : #BDB7AA);
    out property <color> bone-3: light ? (high-contrast ? #45423C : #5E5A53) : (high-contrast ? #B7B1A4 : #A29C90);

    // Emission lines (nm); darkened on paper to ≥ 3:1 against ground,
    // ground-band and plate.
    out property <color> w405: light ? (colorblind-safe ? #A8467E : #6A4BD8) : (colorblind-safe ? #CC79A7 : #9B7BFF);
    out property <color> w436: light ? #4F56D6 : #7C83FF;
    out property <color> w486: light ? (colorblind-safe ? #0A6EA8 : #1A72A6) : (colorblind-safe ? #56B4E9 : #4FB8F0);
    out property <color> w546: light ? (colorblind-safe ? #007A57 : #2E7A1F) : (colorblind-safe ? #009E73 : #82D16B);
    out property <color> w589: light ? (colorblind-safe ? #776A00 : #856300) : (colorblind-safe ? #F0E442 : #F5CE4A);
    out property <color> w615: light ? (colorblind-safe ? #935D00 : #A54E0E) : (colorblind-safe ? #E69F00 : #F39047);
    out property <color> w656: light ? (colorblind-safe ? #B34E00 : #C23434) : (colorblind-safe ? #D55E00 : #EF5A5A);

    // Semantic lines: one job per colour (DESIGN.md, State Language).
    // Sodium: now and attention. Green: playing and in sync. Red: recording,
    // clash, danger. Cyan, orange, green and violet also name decks 1-4.
    out property <color> live: w546;
    out property <color> attention: w589;
    out property <color> fault: w656;
    // Neutral fill of a setup control that is on (quantize, stem isolation):
    // filled like any on state, but without a colour of its own.
    out property <color> setup-on: bone-2;
    // Ink on anything filled in a tone.
    out property <color> ink-on: ground;
    // The focus ring: bone, 2px, 2px offset, used for nothing else.
    out property <color> focus: bone;
    out property <length> focus-width: 2px;
    out property <length> focus-offset: 2px;

    // Motion (DESIGN.md, Motion): four named timings and one curve. Every
    // `animate` in the interface uses one of them; with reduced motion
    // (`motion` off) they are all 0 ms. Audio-linked visuals (meters,
    // waveforms, playheads, the phase meter) never animate: they show the
    // value as it is.
    // Press: hover and press fills of keys, plates and tabs.
    out property <duration> t-press: root.motion ? 90ms : 0ms;
    // Toggle: a control changes state (switch thumb, disclosure arrow).
    out property <duration> t-toggle: root.motion ? 140ms : 0ms;
    // Panel: a part opens, a rail tick grows, a progress line fills.
    out property <duration> t-panel: root.motion ? 180ms : 0ms;
    // Mode change: the current work mode moves, a stick finishes syncing.
    out property <duration> t-mode: root.motion ? 240ms : 0ms;
    // The one curve: a quick start that settles without overshoot.
    out property <easing> ease: cubic-bezier(0.2, 0, 0, 1);
    // Periods of things that repeat while they wait (not transitions): the
    // armed pulse and the loading sweep; still when motion is off.
    out property <duration> t-pulse: 900ms;
    // Hover delay before a tooltip opens.
    out property <duration> t-tip: 500ms;

    // Line weights.
    out property <length> hair: high-contrast ? 2px : 1px;
    out property <length> line: 2px;

    // Type (DESIGN.md, Typography): one family, five sizes, two weights; the
    // bundled figures are all one width, so changing numbers never shift.
    // `text-scale` is the text size preference (Preferences > View, the
    // list and the deck); nothing falls below its floor, 12 px for what is
    // read live or touched and in the kiosk, 11 px for legends.
    out property <string> family: "Barlow Semi Condensed";
    in-out property <float> text-scale: 1;
    out property <length> hero: 32px * root.text-scale;
    out property <length> heading: 22px * root.text-scale;
    out property <length> body: max(12px, 15px * root.text-scale);
    out property <length> control: max(12px, 13px * root.text-scale);
    out property <length> label: max(root.touch ? 12px : 11px, 11px * root.text-scale);
    out property <int> weight-medium: 500;
    out property <int> weight-semi: 600;
    out property <length> tracking-index: 1.6px;
    out property <length> tracking-c: 2.2px;

    // Surfaces carry the structure (DESIGN.md, Elevation): the window is
    // `ground`, a panel is `ground-band`, a control is `plate`, and hover and
    // press move to `plate-raised`. Panels sit in the window with
    // `gutter` between them; a border is the exception, not the structure.
    out property <length> r-control: 4px;
    out property <length> r-panel: 8px;
    out property <length> r-overlay: 10px;
    // The space between panels: tighter on the touch screen.
    out property <length> gutter: root.touch ? 0px : 8px;

    // Spacing (4px grid). Layout spacing and padding use only these values;
    // keys inside a group touch at `key-gap`.
    out property <length> key-gap: 2px;
    out property <length> s1: 4px;
    out property <length> s2: 8px;
    out property <length> s3: 12px;
    out property <length> s4: 16px;
    out property <length> s5: 24px;
    out property <length> s6: 32px;

    // Width of the browser's side rails: sources on the left, panels on
    // the right (full words).
    out property <length> rail: 78px;

    // The off-centre rail.
    out property <length> rail-x: 28px;
    // Raised to touch size in kiosk mode.
    in-out property <length> row-height: 28px;
    // Touch layout (kiosk, 800 × 480): every key at least 44 px.
    in-out property <bool> touch;
    out property <length> target: root.touch ? 44px : 24px;
    // The touch layout chosen in Preferences (beyond the kiosk): every
    // control of the decks, mixer, pads, FX, browser and lighting gets at
    // least `touch-min` on both edges.
    in-out property <bool> touch-mode;
    out property <length> touch-min: root.touch-mode ? 44px : 0px;

    // Deck n (1-based) to its emission line.
    public pure function deck-color(deck: int) -> color {
        if (deck == 1) { return w486; }
        if (deck == 2) { return w615; }
        if (deck == 3) { return w546; }
        return w405;
    }

    // A cue's own colour if it has one, else its slot colour.
    public pure function cue-tone(slot: int, tone: color) -> color {
        if (tone.alpha > 0) { return tone; }
        if (slot < 0) { return bone-3; }
        return cue-color(slot);
    }

    // Hot cue slot (0-based) to a line colour; cues also carry their letter.
    public pure function cue-color(slot: int) -> color {
        if (slot == 0) { return w546; }
        if (slot == 1) { return w486; }
        if (slot == 2) { return w615; }
        if (slot == 3) { return w405; }
        if (slot == 4) { return w589; }
        if (slot == 5) { return w436; }
        if (slot == 6) { return w656; }
        return bone-2;
    }

    // ── State language (DESIGN.md, State Language) ──
    // Off, hover and pressed, selected, on, running, disabled, as one table.

    // Surface of a control.
    public pure function face(enabled: bool, pressed: bool, hover: bool, selected: bool, on: bool, tone: color) -> color {
        if (selected) { return bone; }
        if (on) { return tone; }
        if (!enabled) { return ground-band; }
        if (pressed || hover) { return plate-raised; }
        return plate;
    }

    // Ink of a control's legend.
    public pure function ink(enabled: bool, pressed: bool, hover: bool, selected: bool, on: bool) -> color {
        if (selected) { return ground; }
        if (on) { return ink-on; }
        if (!enabled) { return bone-3; }
        if (pressed || hover) { return bone; }
        return bone-2;
    }
}
