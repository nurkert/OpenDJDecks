// Zoomed, smoothly scrolling three-band waveform lane of one deck (Perform
// and the Club mode screen). Rust renders three tiles around the playhead;
// Slint extrapolates the position between frames with the animation clock.

import { Theme } from "tokens.slint";
import { VLine, HLine } from "lines.slint";
import { DeckView, LaneMotion, CueMark, GridEdit, DeckMix } from "structs.slint";
import { DeckEditMenu } from "edit_menu.slint";

// A cue on a zoomed waveform, drawn so it reads on any waveform: a hot cue
// is a line in its colour with a flag at the top carrying its letter (dark
// on the colour), a hot loop also a band to its end; a memory cue is a red
// triangle with a light rim at the bottom and a fine line. Each line has a
// dark rim against bright waveform peaks. `x` is the cue's position; the
// marker is as tall as the lane.
export component CueMarker inherits Rectangle {
    in property <CueMark> cue;
    // The loop's length on screen (hot loops).
    in property <length> loop-w;
    // Vertical lanes: the cue runs across, flag on the left.
    in property <bool> across;
    property <bool> memory: root.cue.slot < 0;
    property <color> tone: root.memory ? Theme.fault : Theme.cue-tone(root.cue.slot, root.cue.tone);
    width: 0px;
    if !root.across && !root.memory && root.cue.is-loop && root.loop-w > 0: Rectangle {
        x: 0; width: root.loop-w; height: parent.height;
        background: root.tone.with-alpha(0.16);
        Rectangle { y: 0; height: 2px; background: root.tone; }
        Rectangle { x: parent.width - 2px; width: 2px; background: root.tone.with-alpha(0.8); }
    }
    if !root.across: Rectangle {
        x: -2px; width: 4px; height: parent.height;
        background: Theme.ground.with-alpha(root.memory ? 0.4 : 0.55);
        Rectangle { x: 1px; width: root.memory ? 1px : 2px; background: root.memory ? Theme.bone.with-alpha(0.75) : root.tone; }
    }
    if root.across: Rectangle {
        y: -2px; height: 4px; width: parent.width;
        background: Theme.ground.with-alpha(root.memory ? 0.4 : 0.55);
        Rectangle { y: 1px; height: root.memory ? 1px : 2px; background: root.memory ? Theme.bone.with-alpha(0.75) : root.tone; }
    }
    // Hot cue: the flag with the letter.
    if !root.memory: Rectangle {
        x: root.across ? 0 : 0; y: root.across ? -7px : 0;
        width: 14px; height: 14px;
        border-radius: 2px;
        background: root.tone;
        border-width: 1px; border-color: Theme.ground;
        Text {
            text: root.cue.letter;
            font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi;
            color: Theme.ground;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    // Memory cue: the triangle at the bottom (on the left when across).
    if root.memory: Path {
        x: root.across ? 0 : -6px; y: root.across ? -6px : parent.height - 10px;
        width: root.across ? 10px : 12px; height: root.across ? 12px : 10px;
        viewbox-width: root.across ? 10 : 12; viewbox-height: root.across ? 12 : 10;
        fill: Theme.fault;
        stroke: Theme.bone;
        stroke-width: 1px;
        commands: root.across ? "M 0 0 L 10 6 L 0 12 Z" : "M 6 0 L 12 10 L 0 10 Z";
    }
}

// Dragging a Perform lane (Rust: lane_drag.rs): a paused deck scrubs 1:1,
// a playing one nudges by the drag's speed. `to` gets the drag as seconds
// of audio (positive = later in the track); `text` is the readout.
export global LaneDrag {
    callback start(int);
    callback to(int, float);
    callback end(int);
    in-out property <int> deck;
    in-out property <string> text;
}

export component WaveLane inherits Rectangle {
    in property <DeckView> deck;
    in property <LaneMotion> motion;
    callback zoom(float);
    callback zoom-reset();
    // Click on the bar counter: the next counter mode.
    callback cycle-counter();
    // The lane that carries the `wave.playhead` label (one per window).
    in property <bool> playhead-label;
    // Draws the incoming track over this lane when it plays (Perform).
    in property <bool> overlay-on;
    property <color> tone: Theme.deck-color(root.deck.deck);
    property <length> gutter: 44px;
    property <length> area: root.width - root.gutter;
    property <duration> base-tick;
    // The tiles as last taken from `motion` (see LaneMotion.tiles).
    property <image> tile0;
    property <image> tile1;
    property <image> tile2;
    property <int> tiles-seen: -1;
    function take-tiles() {
        if (root.motion.tiles != root.tiles-seen) {
            root.tiles-seen = root.motion.tiles;
            root.tile0 = root.motion.tile0;
            root.tile1 = root.motion.tile1;
            root.tile2 = root.motion.tile2;
        }
    }
    init => { root.take-tiles(); root.take-ov-tiles(); }
    changed motion => { root.base-tick = animation-tick(); root.take-tiles(); }
    // Playhead now (seconds); only depends on the frame clock while moving.
    property <float> now: root.motion.rate == 0 ? root.motion.pos : root.motion.pos + root.motion.rate * ((animation-tick() - root.base-tick) / 1ms);
    // The playhead's anchor: by default the centre of the waveform area; in
    // Perform the window's centre (the mixer's axis), passed in as an x in
    // window coordinates. Past and future are drawn around it, so the past
    // side may be a little narrower than the future side.
    in property <length> anchor-x: -1px;
    // Perform: the lane can be dragged (scrub or nudge, see LaneDrag).
    in property <bool> draggable;
    property <length> head: root.anchor-x >= 0 ? clamp(root.anchor-x - self.absolute-position.x, root.gutter + 8px, root.width - 8px) : root.gutter + root.area / 2;
    // Fraction of the span left of the playhead.
    property <float> past: (root.head - root.gutter) / max(1px, root.area);
    property <float> left-t: root.now - root.motion.span * root.past;
    background: Theme.ground-band;
    clip: true;
    if root.motion.loaded: Image { x: root.gutter + (root.motion.t0 - root.left-t) / root.motion.span * root.area; width: root.area; height: parent.height; source: root.tile0; image-fit: fill; }
    if root.motion.loaded: Image { x: root.gutter + (root.motion.t1 - root.left-t) / root.motion.span * root.area; width: root.area; height: parent.height; source: root.tile1; image-fit: fill; }
    if root.motion.loaded: Image { x: root.gutter + (root.motion.t2 - root.left-t) / root.motion.span * root.area; width: root.area; height: parent.height; source: root.tile2; image-fit: fill; }
    // Played audio left of the playhead is veiled.
    if root.motion.loaded: Rectangle { x: root.gutter; width: root.head - root.gutter; height: parent.height; background: Theme.ground.with-alpha(0.45); }
    // The incoming track over the playing one: its outline in its deck
    // colour, where it plays now, or (cued) so that its cue meets the next
    // phrase of this deck; a line with its numeral marks the cue.
    property <LaneMotion> ov: DeckMix.overlay[root.deck.deck - 1];
    property <bool> ov-shown: root.overlay-on && root.motion.loaded && root.ov.loaded && root.ov.of-deck > 0 && root.ov.span > 0;
    property <duration> ov-tick;
    property <image> ov-tile0;
    property <image> ov-tile1;
    property <image> ov-tile2;
    property <int> ov-seen: -1;
    function take-ov-tiles() {
        if (root.ov.tiles != root.ov-seen) {
            root.ov-seen = root.ov.tiles;
            root.ov-tile0 = root.ov.tile0;
            root.ov-tile1 = root.ov.tile1;
            root.ov-tile2 = root.ov.tile2;
        }
    }
    changed ov => { root.ov-tick = animation-tick(); root.take-ov-tiles(); }
    property <float> ov-now: root.ov.rate == 0 ? root.ov.pos : root.ov.pos + root.ov.rate * ((animation-tick() - root.ov-tick) / 1ms);
    property <float> ov-left: root.ov-now - root.ov.span * root.past;
    property <color> ov-tone: Theme.deck-color(root.ov.of-deck);
    if root.ov-shown: Rectangle {
        accessible-role: image;
        accessible-id: "wave.incoming\{root.deck.deck}";
        accessible-value: root.ov.of-deck;
        // A waiting track is drawn from its cue on, not what lies before it.
        property <length> x0: root.ov.mark < 0 ? root.gutter : max(root.gutter, min(root.width, root.gutter + (root.ov.mark - root.ov-left) / root.ov.span * root.area));
        x: self.x0; width: max(0px, root.width - self.x0); height: parent.height;
        clip: true;
        Image { x: root.gutter - parent.x0 + (root.ov.t0 - root.ov-left) / root.ov.span * root.area; width: root.area; height: parent.height; source: root.ov-tile0; image-fit: fill; colorize: root.ov-tone; opacity: 0.85; }
        Image { x: root.gutter - parent.x0 + (root.ov.t1 - root.ov-left) / root.ov.span * root.area; width: root.area; height: parent.height; source: root.ov-tile1; image-fit: fill; colorize: root.ov-tone; opacity: 0.85; }
        Image { x: root.gutter - parent.x0 + (root.ov.t2 - root.ov-left) / root.ov.span * root.area; width: root.area; height: parent.height; source: root.ov-tile2; image-fit: fill; colorize: root.ov-tone; opacity: 0.85; }
    }
    if root.ov-shown && root.ov.mark >= 0: Rectangle {
        property <length> px: root.gutter + (root.ov.mark - root.ov-left) / root.ov.span * root.area;
        accessible-role: image;
        accessible-id: "wave.incoming-start\{root.deck.deck}";
        accessible-value: root.ov.of-deck;
        visible: self.px >= root.gutter && self.px <= root.width;
        x: self.px - 1px; width: 2px; height: parent.height;
        background: root.ov-tone;
        Rectangle {
            x: 2px; y: parent.height - 18px; width: 14px; height: 14px;
            border-radius: 2px; background: root.ov-tone;
            Text { text: root.ov.of-deck; font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; color: Theme.ground; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    // The loop: a light amber wash with solid in / out lines and bands along
    // the edges (the waveform's colours stay readable through it).
    if root.motion.loaded && root.deck.loop-out > root.deck.loop-in: band := Rectangle {
        accessible-role: image;
        accessible-id: "wave.loop\{root.deck.deck}";
        property <length> x0: root.gutter + (root.deck.loop-in - root.left-t) / root.motion.span * root.area;
        property <length> x1: root.gutter + (root.deck.loop-out - root.left-t) / root.motion.span * root.area;
        property <float> strength: root.deck.looping ? 1 : 0.45;
        x: max(root.gutter, self.x0);
        width: max(0px, min(parent.width, self.x1) - max(root.gutter, self.x0));
        height: parent.height;
        background: Theme.attention.with-alpha(0.16 * self.strength);
        Rectangle { y: 0; height: 3px; background: Theme.attention.with-alpha(band.strength); }
        Rectangle { y: parent.height - 3px; height: 3px; background: Theme.attention.with-alpha(band.strength); }
        if band.x0 >= root.gutter: Rectangle { x: 0; width: 2px; background: Theme.attention.with-alpha(band.strength); }
        if band.x1 <= root.width: Rectangle { x: parent.width - 2px; width: 2px; background: Theme.attention.with-alpha(band.strength); }
        // A held roll names itself on the band (filled, like the key).
        if root.deck.rolling: Rectangle {
            accessible-role: text;
            accessible-id: "wave.roll\{root.deck.deck}";
            accessible-value: root.deck.roll-size;
            // Left of the band: the bar counter sits right of the playhead.
            x: -self.width - 4px; y: 5px; width: roll-text.preferred-width + 8px; height: 14px;
            border-radius: 2px; background: Theme.attention;
            roll-text := Text { text: @tr("ROLL {}", root.deck.roll-size); font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; color: Theme.ink-on; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    // A manual loop's in point waiting for its out: an amber line with an
    // IN plate at its head, until LOOP OUT closes the loop or exit cancels it.
    if root.motion.loaded && root.deck.loop-in-set: Rectangle {
        property <length> px: root.gutter + (root.deck.loop-pending - root.left-t) / root.motion.span * root.area;
        accessible-role: image;
        accessible-id: "wave.loop-in\{root.deck.deck}";
        accessible-value: root.deck.loop-pending;
        visible: self.px >= root.gutter && self.px <= root.width;
        x: self.px - 1px; width: 2px; height: parent.height;
        background: Theme.attention;
        Rectangle {
            x: 2px; y: 3px; width: in-text.preferred-width + 8px; height: 14px;
            border-radius: 2px; background: Theme.attention;
            in-text := Text { text: @tr("IN"); font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; color: Theme.ink-on; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    // Slip / roll: where playback carries on underneath, a thin line that
    // the playhead returns to on release.
    if root.motion.loaded && root.deck.slip-pos >= 0: Rectangle {
        property <length> px: root.gutter + (root.deck.slip-pos - root.left-t) / root.motion.span * root.area;
        accessible-role: image;
        accessible-id: "wave.slip\{root.deck.deck}";
        visible: self.px >= root.gutter && self.px <= root.width;
        x: self.px; width: 1px; height: parent.height;
        background: Theme.bone.with-alpha(0.7);
    }
    // The marked drop: a bone line with a DROP plate at its foot.
    if root.motion.loaded && root.deck.drop-at >= 0: Rectangle {
        property <length> px: root.gutter + (root.deck.drop-at - root.left-t) / root.motion.span * root.area;
        accessible-role: image;
        accessible-id: "wave.drop\{root.deck.deck}";
        accessible-value: root.deck.drop-at;
        visible: self.px >= root.gutter && self.px <= root.width;
        x: self.px - 1px; width: 2px; height: parent.height;
        background: Theme.bone;
        Rectangle {
            x: 2px; y: parent.height - 15px; width: drop-text.preferred-width + 8px; height: 14px;
            border-radius: 2px; background: Theme.bone;
            drop-text := Text { text: @tr("DROP"); font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; color: Theme.ink-on; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    // Hot cues (flag with the letter) and memory cues (triangle at the
    // bottom) where they fall in the visible span.
    for c[i] in root.deck.cues: CueMarker {
        property <length> px: root.gutter + (c.pos * root.deck.length - root.left-t) / root.motion.span * root.area;
        property <length> lw: c.is-loop ? (c.end - c.pos) * root.deck.length / root.motion.span * root.area : 0px;
        accessible-role: image;
        accessible-id: c.slot >= 0 ? "wave.cue\{root.deck.deck}." + c.letter : "wave.memory\{root.deck.deck}." + i;
        accessible-value: c.time;
        visible: root.motion.loaded && root.deck.length > 0 && self.px + self.lw >= root.gutter && self.px <= root.width;
        x: self.px; y: 0; height: parent.height;
        cue: c; loop-w: self.lw;
    }
    Rectangle {
        x: 0; y: 0; width: root.gutter; height: parent.height;
        background: Theme.ground;
        VLine { x: 0; height: parent.height; weight: 3px; tone: root.tone; form: root.deck.master ? "double" : "solid"; }
        Text {
            x: 8px; width: root.gutter - 12px; y: 4px;
            text: root.deck.deck;
            font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi; color: root.tone;
            horizontal-alignment: center;
        }
        if root.deck.master: Text {
            x: 8px; width: root.gutter - 12px; y: parent.height - 16px;
            text: "M";
            font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; color: root.tone;
            horizontal-alignment: center;
        }
        // Tall lanes: GRID opens the deck's track in EDIT GRID (Prepare).
        if root.deck.loaded && parent.height >= 60px: Rectangle {
            accessible-role: button; accessible-id: "wave.grid-edit\{root.deck.deck}";
            // Fully inside the numeral column, clear of its divider.
            x: 6px; y: 30px; width: root.gutter - 14px; height: 16px;
            border-radius: 3px;
            clip: true;
            background: grid-key.has-hover ? Theme.plate-raised : Theme.plate;
            border-width: 1px; border-color: Theme.rule;
            Text { text: @tr("GRID"); font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: 0.4px; color: Theme.bone-2; horizontal-alignment: center; vertical-alignment: center; }
            grid-key := TouchArea { mouse-cursor: pointer; clicked => { GridEdit.open-deck(root.deck.deck); } }
        }
        VLine { x: parent.width - 1px; height: parent.height; weight: 1px; tone: Theme.rule; }
    }
    // Playhead at the centre of the waveform area. Calm waveform: a crisp
    // 1 px bone line between two dark rims, so it stays sharp on any peak.
    if Theme.calm-wave: Rectangle {
        x: root.head - 1.5px; width: 3px; height: parent.height;
        background: Theme.ground;
    }
    Rectangle {
        x: root.head - (Theme.calm-wave ? 0.5px : 1px); width: Theme.calm-wave ? 1px : 2px; height: parent.height;
        accessible-role: image;
        accessible-id: root.playhead-label ? "wave.playhead" : "";
        background: root.deck.loaded ? Theme.bone : Theme.rule-strong;
    }
    // Scroll to zoom; double-click resets. Drag (Perform, a track loaded):
    // past a few px a paused deck scrubs and a playing one is nudged; a
    // click without movement stays a click.
    property <bool> dragging;
    lane-touch := TouchArea {
        x: root.gutter; width: root.area;
        mouse-cursor: root.draggable && root.motion.loaded ? (root.dragging ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;
        scroll-event(e) => {
            root.zoom(e.delta-y / 1px);
            accept
        }
        double-clicked => { root.zoom-reset(); }
        moved => {
            if (self.pressed && root.draggable && root.motion.loaded && root.motion.span > 0) {
                if (!root.dragging && Math.abs(self.mouse-x - self.pressed-x) > 4px) {
                    root.dragging = true;
                    LaneDrag.start(root.deck.deck);
                }
                if (root.dragging) {
                    LaneDrag.to(root.deck.deck, -(self.mouse-x - self.pressed-x) / root.area * root.motion.span);
                }
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                LaneDrag.end(root.deck.deck);
            }
        }
    }
    // While dragging: the offset (paused) or the bend (playing) at the playhead.
    if root.dragging && LaneDrag.deck == root.deck.deck: Rectangle {
        accessible-role: text;
        accessible-id: "wave.drag\{root.deck.deck}";
        accessible-value: LaneDrag.text;
        x: root.head + 5px; y: parent.height - self.height - 4px;
        width: drag-text.preferred-width + 10px; height: 16px;
        border-radius: Theme.r-control;
        background: Theme.bone;
        drag-text := Text {
            text: LaneDrag.text;
            font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi;
            color: Theme.ground;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    // Right-click on the waveform: the deck's EDIT IN PREPARE menu (any
    // lane height; tall lanes also have the GRID key in the gutter).
    if root.deck.loaded: DeckEditMenu {
        x: root.gutter; width: root.area; height: parent.height;
        deck: root.deck;
    }
    // Bar counter at the playhead: the phrase (or what is counted) small
    // above, the count large below, on a quiet plate right of the needle so
    // it never covers what is about to play for long. A click picks the next
    // mode (to phrase / to memory cue / bar.beat).
    if root.deck.loaded: Rectangle {
        accessible-role: button;
        accessible-id: "wave.counter\{root.deck.deck}";
        accessible-value: root.deck.beat-pos;
        property <bool> tall: parent.height >= 44px;
        x: root.head + 5px; y: 3px;
        width: max(caption.preferred-width, count.preferred-width) + 12px;
        height: self.tall ? 36px : min(parent.height - 6px, 20px);
        border-radius: 2px;
        background: Theme.ground.with-alpha(counter-touch.has-hover ? 0.9 : 0.72);
        caption := Text {
            visible: parent.tall;
            x: 6px; y: 2px;
            text: root.deck.counter-mode == "to-memory-cue" ? @tr("TO CUE") : root.deck.counter-mode == "up" ? @tr("BAR") : root.deck.phrase-kind != "" ? root.deck.phrase-kind : @tr("TO PHRASE");
            font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: 1px;
            color: Theme.bone-2;
        }
        count := Text {
            x: 6px; y: parent.tall ? 13px : 0; height: parent.tall ? 22px : parent.height;
            text: root.deck.beat-pos;
            font-family: Theme.family; font-size: parent.tall ? Theme.heading : Theme.control; font-weight: Theme.weight-semi;
            color: Theme.bone;
            vertical-alignment: center;
        }
        counter-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.cycle-counter(); }
        }
    }
    HLine { y: parent.height - 1px; width: parent.width; tone: Theme.rule; }
}

// The same lane turned for the vertical layouts: time runs downwards, the
// playhead is the horizontal line in the middle, the deck numeral on top.
export component VerticalLane inherits Rectangle {
    in property <DeckView> deck;
    in property <LaneMotion> motion;
    callback zoom(float);
    callback zoom-reset();
    property <color> tone: Theme.deck-color(root.deck.deck);
    property <length> gutter: 26px;
    property <length> area: root.height - root.gutter;
    property <duration> base-tick;
    // The tiles as last taken from `motion` (see LaneMotion.tiles).
    property <image> tile0;
    property <image> tile1;
    property <image> tile2;
    property <int> tiles-seen: -1;
    function take-tiles() {
        if (root.motion.tiles != root.tiles-seen) {
            root.tiles-seen = root.motion.tiles;
            root.tile0 = root.motion.tile0;
            root.tile1 = root.motion.tile1;
            root.tile2 = root.motion.tile2;
        }
    }
    init => { root.take-tiles(); }
    changed motion => { root.base-tick = animation-tick(); root.take-tiles(); }
    property <float> now: root.motion.rate == 0 ? root.motion.pos : root.motion.pos + root.motion.rate * ((animation-tick() - root.base-tick) / 1ms);
    property <float> top-t: root.now - root.motion.span / 2;
    background: Theme.ground-band;
    clip: true;
    if root.motion.loaded: Image { y: root.gutter + (root.motion.t0 - root.top-t) / root.motion.span * root.area; height: root.area; width: parent.width; source: root.tile0; image-fit: fill; }
    if root.motion.loaded: Image { y: root.gutter + (root.motion.t1 - root.top-t) / root.motion.span * root.area; height: root.area; width: parent.width; source: root.tile1; image-fit: fill; }
    if root.motion.loaded: Image { y: root.gutter + (root.motion.t2 - root.top-t) / root.motion.span * root.area; height: root.area; width: parent.width; source: root.tile2; image-fit: fill; }
    // Played audio above the playhead is veiled.
    if root.motion.loaded: Rectangle { y: root.gutter; height: root.area / 2; width: parent.width; background: Theme.ground.with-alpha(0.45); }
    // Cues across the lane: flag (hot) or triangle (memory) on the left.
    for c[i] in root.deck.cues: CueMarker {
        property <length> py: root.gutter + (c.pos * root.deck.length - root.top-t) / root.motion.span * root.area;
        accessible-role: image;
        accessible-id: c.slot >= 0 ? "wave.cue\{root.deck.deck}." + c.letter : "wave.memory\{root.deck.deck}." + i;
        accessible-value: c.time;
        visible: root.motion.loaded && root.deck.length > 0 && self.py >= root.gutter && self.py <= root.height;
        across: true;
        x: 0; y: self.py; width: parent.width; height: 0px;
        cue: c;
    }
    Rectangle {
        x: 0; y: 0; height: root.gutter; width: parent.width;
        background: Theme.ground;
        HLine { y: 0; tone: root.tone; form: root.deck.master ? "double" : "solid"; }
        Text {
            text: root.deck.deck;
            font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi; color: root.tone;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    if Theme.calm-wave: Rectangle {
        y: root.gutter + root.area / 2 - 1.5px; height: 3px; width: parent.width;
        background: Theme.ground;
    }
    Rectangle {
        y: root.gutter + root.area / 2 - (Theme.calm-wave ? 0.5px : 1px); height: Theme.calm-wave ? 1px : 2px; width: parent.width;
        background: root.deck.loaded ? Theme.bone : Theme.rule-strong;
    }
    TouchArea {
        y: root.gutter; height: root.area;
        scroll-event(e) => {
            root.zoom(e.delta-y / 1px);
            accept
        }
        double-clicked => { root.zoom-reset(); }
    }
    VLine { x: parent.width - 1px; height: parent.height; weight: 1px; tone: Theme.rule; }
}
