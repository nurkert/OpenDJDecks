// Mix Preview (Perform, above the waveforms): a mix-out point on the
// outgoing track and a mix-in point on the incoming one. With LINK on, the
// incoming deck starts from its mix-in point the moment the outgoing deck
// passes its mix-out point.

import { Theme } from "tokens.slint";
import { HLine, VLine } from "lines.slint";
import { Caps, PlateButton } from "controls.slint";

export struct MixPreviewDeck {
    deck: int,
    // Memory cues plus the mix points of the loaded track.
    points: int,
    // "" = not set.
    mix-in: string,
    mix-out: string,
}

export global MixPreview {
    in property <bool> link;
    // The deck MIX IN / MIX OUT / ◀ ▶ act on (1-based).
    in property <int> edit-deck: 1;
    in property <[MixPreviewDeck]> decks;
    // Playback reservation: the next reserved track and how many wait.
    in property <string> next;
    in property <int> waiting;
    // "mix-in", "mix-out", "prev", "next", "edit", "link", "reserve",
    // "clear-queue".
    callback act(string);
}

component Readout inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> a11y;
    spacing: Theme.s1;
    Caps { text: root.label; font-size: 9px; vertical-alignment: center; }
    Text {
        accessible-role: text; accessible-label: root.a11y; accessible-value: self.text;
        min-width: 58px;
        text: root.value == "" ? "—" : root.value;
        font-family: Theme.family; font-size: 13px; font-weight: 600;
        color: root.value == "" ? Theme.bone-3 : Theme.bone; vertical-alignment: center;
    }
}

component DeckPoints inherits HorizontalLayout {
    in property <MixPreviewDeck> d;
    in property <bool> editing;
    spacing: Theme.s3;
    Rectangle {
        width: 3px;
        background: root.editing ? Theme.deck-color(root.d.deck) : Theme.rule-strong;
    }
    Caps { text: @tr("DECK {}", root.d.deck); vertical-alignment: center; color: root.editing ? Theme.bone : Theme.bone-3; }
    Text {
        accessible-role: text; accessible-label: "mix-preview.deck\{root.d.deck}.points"; accessible-value: root.d.points;
        text: @tr("{} POINTS", root.d.points);
        font-family: Theme.family; font-size: 11px; color: Theme.bone-2; vertical-alignment: center;
    }
    Readout { a11y: "mix-preview.deck\{root.d.deck}.mix-in-time"; label: @tr("IN"); value: root.d.mix-in; }
    Readout { a11y: "mix-preview.deck\{root.d.deck}.mix-out-time"; label: @tr("OUT"); value: root.d.mix-out; }
}

export component MixPreviewPanel inherits Rectangle {
    // Kiosk: 44 px keys on one line, the points of the decks on the next.
    height: Theme.touch ? 84px : 40px;
    background: Theme.ground-band;
    VerticalLayout {
    padding-left: Theme.s3; padding-right: Theme.s3; padding-top: Theme.touch ? Theme.key-gap : Theme.s2; padding-bottom: Theme.touch ? Theme.key-gap : Theme.s2;
    spacing: Theme.s1;
    HorizontalLayout {
        spacing: Theme.s2;
        PlateButton {
            accessible-label: "mix-preview.mix-in"; accessible-role: button; horizontal-stretch: 0; compact: !Theme.touch; tall: Theme.touch;
            label: @tr("MIX IN"); tone: Theme.live;
            tooltip: @tr("Set the mix-in point of the edited deck at its playhead");
            clicked => { MixPreview.act("mix-in"); }
        }
        PlateButton {
            accessible-label: "mix-preview.mix-out"; accessible-role: button; horizontal-stretch: 0; compact: !Theme.touch; tall: Theme.touch;
            label: @tr("MIX OUT"); tone: Theme.fault;
            tooltip: @tr("Set the mix-out point of the edited deck at its playhead");
            clicked => { MixPreview.act("mix-out"); }
        }
        PlateButton {
            accessible-label: "mix-preview.prev"; accessible-role: button; horizontal-stretch: 0; compact: !Theme.touch; tall: Theme.touch; glyph: "prev";
            tooltip: @tr("Edited deck: back to the previous point");
            clicked => { MixPreview.act("prev"); }
        }
        PlateButton {
            accessible-label: "mix-preview.next"; accessible-role: button; horizontal-stretch: 0; compact: !Theme.touch; tall: Theme.touch; glyph: "next";
            tooltip: @tr("Edited deck: on to the next point");
            clicked => { MixPreview.act("next"); }
        }
        PlateButton {
            accessible-label: "mix-preview.edit"; accessible-role: button; accessible-value: MixPreview.edit-deck; horizontal-stretch: 0; compact: !Theme.touch; tall: Theme.touch;
            label: @tr("EDIT DECK {}", MixPreview.edit-deck); tone: Theme.deck-color(MixPreview.edit-deck);
            tooltip: @tr("Switch the deck the points are set on");
            clicked => { MixPreview.act("edit"); }
        }
        PlateButton {
            accessible-label: "mix-preview.link"; accessible-role: button; accessible-checkable: true; accessible-checked: MixPreview.link;
            horizontal-stretch: 0; compact: !Theme.touch; tall: Theme.touch;
            label: "LINK"; active: MixPreview.link; tone: Theme.attention;
            tooltip: MixPreview.link ? @tr("Stop linking the mix points") : @tr("Link: the other deck starts from its mix-in point when this one reaches its mix-out point");
            clicked => { MixPreview.act("link"); }
        }
        Rectangle { width: Theme.s3; }
        if !Theme.touch: HorizontalLayout { spacing: Theme.s2; for d in MixPreview.decks: DeckPoints { d: d; editing: d.deck == MixPreview.edit-deck; } }
        Rectangle { horizontal-stretch: 1; }
        // Playback reservation: queue the selected tracks; the next one
        // loads into the deck that has played out.
        Text {
            accessible-role: text; accessible-label: "mix-preview.reserved"; accessible-value: MixPreview.next;
            horizontal-stretch: 0; max-width: 260px; overflow: elide;
            text: MixPreview.waiting == 0 ? @tr("NOTHING RESERVED") : MixPreview.waiting == 1 ? @tr("NEXT  {}", MixPreview.next) : @tr("NEXT  {}  +{}", MixPreview.next, MixPreview.waiting - 1);
            font-family: Theme.family; font-size: 11px; font-weight: 600; letter-spacing: 0.8px;
            color: MixPreview.waiting == 0 ? Theme.bone-3 : Theme.bone; vertical-alignment: center;
        }
        PlateButton {
            accessible-label: "mix-preview.reserve"; accessible-role: button; horizontal-stretch: 0; compact: !Theme.touch; tall: Theme.touch;
            label: @tr("RESERVE"); tone: Theme.live;
            tooltip: @tr("Reserve the tracks selected in the list: each loads into the deck that has played out, ready for the next link");
            clicked => { MixPreview.act("reserve"); }
        }
        if MixPreview.waiting > 0: PlateButton {
            accessible-label: "mix-preview.clear-queue"; accessible-role: button; horizontal-stretch: 0; compact: !Theme.touch; tall: Theme.touch;
            label: @tr("CLEAR");
            tooltip: @tr("Clear the reserved tracks");
            clicked => { MixPreview.act("clear-queue"); }
        }
    }
    if Theme.touch: HorizontalLayout {
        spacing: Theme.s4;
        for d in MixPreview.decks: DeckPoints { d: d; editing: d.deck == MixPreview.edit-deck; }
        Rectangle { horizontal-stretch: 1; }
    }
    }
    HLine { y: parent.height - 1px; width: parent.width; tone: Theme.rule; }
}
