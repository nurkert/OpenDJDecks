// The update notice (SPEC §14.1): a slim, non-modal bar under the top bar.
// It never covers the decks and never takes focus; the line on the left
// carries the state (sodium: on offer, live: installing / ready, fault:
// failed).

import { Theme } from "tokens.slint";
import { VLine, HLine, ProgressLine } from "lines.slint";
import { PlateButton } from "controls.slint";

export component UpdateBar inherits Rectangle {
    // "available" | "installing" | "ready" | "info" | "error"
    in property <string> state;
    in property <string> text;
    in property <float> progress;
    // "install" | "notes" | "later" | "skip" | "cancel" | "restart" | "page" | "close"
    callback act(string);

    property <color> tone: root.state == "error" ? Theme.fault : root.state == "available" ? Theme.attention : Theme.live;
    height: 34px;
    background: Theme.ground-band;
    accessible-role: groupbox;
    accessible-label: "app.update";
    accessible-value: root.text;

    HLine { y: parent.height - self.height; width: parent.width; tone: Theme.rule; }
    if root.state == "installing": ProgressLine { x: 0; y: parent.height - 2px; width: parent.width; height: 2px; progress: root.progress; tone: Theme.live; }

    HorizontalLayout {
        padding-left: Theme.s4;
        padding-right: Theme.s3;
        padding-top: Theme.s1;
        padding-bottom: Theme.s1;
        spacing: Theme.s2;
        VLine { weight: 2px; tone: root.tone; form: root.state == "available" ? "double" : "solid"; }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-family: Theme.family; font-size: Theme.control; color: Theme.bone;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.state == "available": PlateButton { accessible-label: "app.update.install"; accessible-role: button; compact: true; label: @tr("INSTALL NOW"); tone: Theme.attention; clicked => { root.act("install"); } }
        if root.state == "available": PlateButton { accessible-label: "app.update.notes"; accessible-role: button; compact: true; label: @tr("RELEASE NOTES"); clicked => { root.act("notes"); } }
        if root.state == "available": PlateButton { accessible-label: "app.update.later"; accessible-role: button; compact: true; label: @tr("LATER"); clicked => { root.act("later"); } }
        if root.state == "available": PlateButton { accessible-label: "app.update.skip"; accessible-role: button; compact: true; label: @tr("SKIP THIS VERSION"); clicked => { root.act("skip"); } }
        if root.state == "installing": PlateButton { accessible-label: "app.update.cancel"; accessible-role: button; compact: true; label: @tr("CANCEL"); clicked => { root.act("cancel"); } }
        if root.state == "ready": PlateButton { accessible-label: "app.update.restart"; accessible-role: button; compact: true; label: @tr("RESTART NOW"); tone: Theme.live; clicked => { root.act("restart"); } }
        if root.state == "ready": PlateButton { accessible-label: "app.update.later"; accessible-role: button; compact: true; label: @tr("LATER"); clicked => { root.act("later"); } }
        if root.state == "info" || root.state == "error": PlateButton { accessible-label: "app.update.page"; accessible-role: button; compact: true; label: @tr("RELEASE PAGE"); clicked => { root.act("page"); } }
        if root.state == "info" || root.state == "error": PlateButton { accessible-label: "app.update.close"; accessible-role: button; compact: true; label: @tr("CLOSE"); clicked => { root.act("close"); } }
    }
}

// Asks once per version, and only while no music plays: the update starts
// after one click and restarts the app by itself.
export component UpdatePrompt inherits Rectangle {
    in property <string> title;
    in property <string> notes;
    // "install" | "notes" | "dismiss" | "skip"
    callback act(string);

    background: #00000099;
    accessible-role: groupbox;
    accessible-label: "app.update.prompt";
    TouchArea { }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 48px, 520px);
        height: card.preferred-height;
        background: Theme.ground-band;
        border-width: 1px;
        border-color: Theme.rule-strong;
        card := VerticalLayout {
            padding: Theme.s5;
            spacing: Theme.s4;
            Text {
                text: root.title;
                font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi; color: Theme.bone;
                wrap: word-wrap;
            }
            Text {
                text: @tr("Update now? OpenDJDecks downloads the new version, checks it and restarts. Your library and settings stay as they are.");
                font-family: Theme.family; font-size: Theme.body; color: Theme.bone-2;
                wrap: word-wrap;
            }
            if root.notes != "": Text {
                text: root.notes;
                font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3;
                wrap: word-wrap;
                max-height: 170px;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: Theme.s2;
                alignment: end;
                PlateButton { accessible-label: "app.update.prompt.skip"; accessible-role: button; compact: true; label: @tr("SKIP THIS VERSION"); clicked => { root.act("skip"); } }
                PlateButton { accessible-label: "app.update.prompt.notes"; accessible-role: button; compact: true; label: @tr("RELEASE NOTES"); clicked => { root.act("notes"); } }
                PlateButton { accessible-label: "app.update.prompt.later"; accessible-role: button; compact: true; label: @tr("LATER"); clicked => { root.act("dismiss"); } }
                PlateButton { accessible-label: "app.update.prompt.install"; accessible-role: button; compact: true; active: true; tone: Theme.attention; label: @tr("UPDATE NOW"); clicked => { root.act("install"); } }
            }
        }
    }
}
