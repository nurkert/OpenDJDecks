// The device board: every stick is one line whose form says its state.

import { Theme } from "tokens.slint";
import { VLine, HLine, ProgressLine } from "lines.slint";
import { Caps, PlateButton, KeyFocus, TooltipState } from "controls.slint";
import { DeviceRow, VolumeRow } from "structs.slint";

// A format the stick carries, as a labelled badge ([28], [48]).
export component FormatBadge inherits Rectangle {
    in property <string> text;
    height: 18px;
    width: t.preferred-width + 12px;
    border-radius: Theme.r-control;
    background: Theme.plate-raised;
    t := Text {
        x: 6px; height: parent.height;
        text: root.text;
        font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: 1.2px;
        color: Theme.bone-2; vertical-alignment: center;
    }
}

// [28] The formats of a stick as one labelled element: a FORMAT legend
// and a badge per format (CLUB USB, its WAV option, OPENDJDECKS), the same
// on the USB screen, in the tree and over a stick's track list.
export component FormatBadges inherits HorizontalLayout {
    // Test id prefix: `<prefix>.club`, `<prefix>.wav`, `<prefix>.native`.
    in property <string> prefix;
    in property <bool> club;
    in property <bool> compat;
    in property <bool> native;
    // Without the FORMAT legend (a tight row that names it otherwise).
    in property <bool> legend: true;
    spacing: Theme.s1;
    alignment: start;
    accessible-role: text;
    accessible-id: root.prefix;
    accessible-value: (root.club ? "CLUB USB " : "") + (root.club && root.compat ? "WAV " : "") + (root.native ? "OPENDJDECKS" : "");
    if root.legend: Caps { horizontal-stretch: 0; text: root.club || root.native ? @tr("FORMAT") : @tr("NO FORMAT YET"); vertical-alignment: center; }
    if root.club: FormatBadge { accessible-role: text; accessible-id: root.prefix + ".club"; accessible-value: self.text; text: @tr("CLUB USB"); }
    if root.club && root.compat: FormatBadge { accessible-role: text; accessible-id: root.prefix + ".wav"; accessible-value: self.text; text: "WAV"; }
    if root.native: FormatBadge { accessible-role: text; accessible-id: root.prefix + ".native"; accessible-value: self.text; text: "OPENDJDECKS"; }
}

// [28] The emergency stick: one press copies the open set or playlist and
// the tracks on the decks to a plugged-in stick in the formats club
// players and OpenDJDecks play.
export global Emergency {
    // A stick is plugged in to copy to.
    in property <bool> available;
    // "" (idle), "copying", "done" or "failed".
    in property <string> stage;
    in property <float> progress;
    // The stick's name, and what happens or happened in words.
    in property <string> stick;
    in property <string> detail;
    // The formats written.
    in property <bool> club;
    in property <bool> compat;
    in property <bool> native;
    callback start();
    callback eject();
    callback dismiss();
}

// The key: at rest a plate, filled live with its percent while copying.
export component EmergencyKey inherits PlateButton {
    accessible-id: "devices.emergency";
    compact: true;
    tone: Theme.live;
    enabled: Emergency.available || Emergency.stage == "copying";
    active: Emergency.stage == "copying";
    label: Emergency.stage == "copying" ? @tr("COPYING {} %", Math.round(Emergency.progress * 100)) : @tr("EMERGENCY STICK");
    tooltip: Emergency.available || Emergency.stage == "copying"
        ? @tr("Copy the open set or playlist and the tracks on the decks to the plugged-in stick, ready to play on club players")
        : @tr("Plug in a USB stick for an emergency copy");
    command: "devices.emergency";
    clicked => { if (Emergency.stage != "copying") { Emergency.start(); } }
}

// The result band on the USB screen: the line in the state's form, the
// stick, what happened, the formats, EJECT when it is ready.
export component EmergencyBand inherits Rectangle {
    accessible-role: groupbox;
    accessible-id: "devices.emergency-band";
    accessible-value: Emergency.stage;
    height: 84px;
    border-radius: Theme.r-panel;
    background: Theme.ground;
    property <string> form: Emergency.stage == "done" ? "solid" : Emergency.stage == "failed" ? "struck" : "dashed";
    property <color> tone: Emergency.stage == "done" ? Theme.live : Emergency.stage == "failed" ? Theme.fault : Theme.attention;
    if Emergency.stage != "copying": VLine { x: 12px; y: 10px; height: parent.height - 20px; form: root.form; tone: root.tone; }
    if Emergency.stage == "copying": Rectangle {
        x: 12px; y: 10px; width: Theme.line; height: parent.height - 20px;
        VLine { height: parent.height; form: "dashed"; tone: Theme.attention.with-alpha(0.6); }
        Rectangle {
            y: parent.height * (1 - clamp(Emergency.progress, 0, 1));
            height: parent.height * clamp(Emergency.progress, 0, 1);
            background: Theme.live;
            animate y, height { duration: Theme.t-panel; easing: Theme.ease; }
        }
    }
    property <length> keys-w: keys.preferred-width + Theme.s2;
    Text {
        accessible-role: text; accessible-id: "devices.emergency-state"; accessible-value: self.text;
        x: 26px; y: 8px; width: root.width - 26px - root.keys-w; height: 22px;
        text: Emergency.stage == "done" ? @tr("Emergency stick ready: {}", Emergency.stick)
            : Emergency.stage == "failed" ? @tr("Emergency stick failed") : @tr("Copying to {} for an emergency", Emergency.stick);
        overflow: elide; vertical-alignment: center;
        font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi;
        color: Emergency.stage == "failed" ? Theme.fault : Theme.bone;
    }
    Text {
        accessible-role: text; accessible-id: "devices.emergency-detail"; accessible-value: self.text;
        x: 26px; y: 33px; width: root.width - 26px - Theme.s2; height: 18px;
        text: Emergency.detail; overflow: elide; vertical-alignment: center;
        font-family: Theme.family; font-size: Theme.control;
        color: Emergency.stage == "failed" ? Theme.fault : Theme.bone-2;
    }
    // The formats written, as on the stick's own row.
    HorizontalLayout {
        x: 26px; y: 56px; width: root.width - 26px - Theme.s2; height: 18px;
        spacing: Theme.s1;
        FormatBadges { prefix: "devices.emergency.format"; legend: false; club: Emergency.club; compat: Emergency.compat; native: Emergency.native; }
        Rectangle { horizontal-stretch: 1; }
    }
    keys := HorizontalLayout {
        x: parent.width - self.width - Theme.s2; y: 6px; height: 26px;
        width: self.preferred-width;
        spacing: Theme.key-gap;
        if Emergency.stage == "done": PlateButton { accessible-id: "devices.emergency-eject"; compact: true; label: @tr("EJECT"); tone: Theme.bone-3; tooltip: @tr("Eject the emergency stick"); clicked => { Emergency.eject(); } }
        if Emergency.stage != "copying": PlateButton { accessible-id: "devices.emergency-close"; compact: true; label: @tr("CLOSE"); tooltip: @tr("Hide this result"); clicked => { Emergency.dismiss(); } }
    }
}

// One stick on the USB screen: its device line (the state as line form),
// name and format badges, the sync state in words, space, and its actions.
// Selected: the sodium tick and a hairline edge.
export component DeviceLine inherits Rectangle {
    in property <DeviceRow> device;
    in property <bool> roomy: false;
    in property <bool> selected: false;
    callback sync();
    callback eject();
    callback open();
    callback check();
    accessible-role: list-item;
    accessible-id: "devices.stick\{root.device.id}";
    accessible-value: root.device.name + " · " + root.state-text;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    height: 84px;
    border-radius: Theme.r-control;
    // Each stick sits in its own well; the open one carries the sodium
    // tick and a bone name, its keys keep their plates.
    background: Theme.ground;
    border-width: root.selected ? Theme.hair : 0px;
    border-color: Theme.rule-strong;

    property <string> form:
        device.state == "in-sync" ? "solid" :
        device.state == "pending" ? "dashed" :
        device.state == "error" ? "struck" :
        device.state == "syncing" ? "double" : "half";
    property <color> tone:
        device.state == "in-sync" ? Theme.live :
        device.state == "pending" ? Theme.attention :
        device.state == "error" ? Theme.fault :
        device.state == "syncing" ? Theme.attention : Theme.bone-3;
    // The sync state in words, beside the line that draws it.
    out property <string> state-text:
        !device.connected ? @tr("NOT PLUGGED IN") :
        device.state == "in-sync" ? @tr("IN SYNC") :
        device.state == "pending" ? @tr("CHANGES WAITING") :
        device.state == "syncing" ? @tr("SYNCING {} %", Math.round(device.progress * 100)) :
        device.state == "error" ? @tr("SYNC FAILED") : @tr("NOT REGISTERED");

    if root.selected: Rectangle {
        x: 0; y: parent.height / 2 - 1px; width: 6px; height: 2px;
        background: Theme.attention;
    }
    if root.device.state != "syncing": VLine { x: 12px; y: 10px; height: parent.height - 20px; form: root.form; tone: root.tone; }
    // Syncing: the dashed line fills up to solid by progress.
    if root.device.state == "syncing": Rectangle {
        x: 12px; y: 10px; width: Theme.line; height: parent.height - 20px;
        VLine { height: parent.height; form: "dashed"; tone: Theme.attention.with-alpha(0.6); }
        Rectangle {
            y: parent.height * (1 - clamp(root.device.progress, 0, 1));
            height: parent.height * clamp(root.device.progress, 0, 1);
            background: Theme.live;
            animate y, height { duration: Theme.t-mode; easing: Theme.ease; }
        }
    }
    property <length> text-x: 26px;
    property <length> keys-w: keys.preferred-width + Theme.s2;
    // Name (the keys on its right).
    Text {
        x: root.text-x; y: 8px; width: root.width - root.text-x - root.keys-w; height: 22px;
        text: root.device.name;
        font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi;
        color: root.device.connected ? Theme.bone : Theme.bone-2;
        overflow: elide; vertical-alignment: center;
    }
    // The sync state in words (tone and line form say it as well).
    HorizontalLayout {
        x: root.text-x; y: 33px; width: root.width - root.text-x - Theme.s2; height: 18px;
        spacing: Theme.s2;
        Text {
            accessible-role: text; accessible-id: "devices.state\{root.device.id}"; accessible-value: self.text;
            horizontal-stretch: 0;
            text: root.state-text;
            font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: 1.6px;
            color: root.device.state == "error" ? Theme.fault : root.device.state == "in-sync" && root.device.connected ? Theme.bone : Theme.bone-2;
            vertical-alignment: center;
        }
        Text {
            min-width: 0px; horizontal-stretch: 1;
            text: root.device.detail;
            font-family: Theme.family; font-size: Theme.control;
            color: root.device.state == "error" ? Theme.fault : Theme.bone-3;
            overflow: elide; vertical-alignment: center;
        }
    }
    // Format badges (labelled), then the space.
    HorizontalLayout {
        x: root.text-x; y: 56px; width: root.width - root.text-x - Theme.s2; height: 18px;
        spacing: Theme.s1;
        FormatBadges { horizontal-stretch: 0; prefix: "devices.badge\{root.device.id}"; club: root.device.club; compat: root.device.compat; native: root.device.native; }
        Rectangle { width: Theme.s1; }
        Caps { min-width: 0px; horizontal-stretch: 1; text: root.device.space; overflow: elide; vertical-alignment: center; }
    }
    open-area := TouchArea {
        width: parent.width - root.keys-w;
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
    keys := HorizontalLayout {
        x: parent.width - self.width - Theme.s2; y: 6px; height: 26px;
        width: self.preferred-width;
        spacing: Theme.key-gap;
        if root.device.connected && root.device.state != "syncing": PlateButton {
            accessible-role: button; accessible-id: "devices.sync\{root.device.id}";
            compact: true; label: @tr("SYNC"); tone: Theme.live; tooltip: @tr("Sync this stick now"); command: "devices.sync";
            clicked => { root.sync(); }
        }
        if root.device.connected && root.device.state != "syncing": PlateButton {
            accessible-role: button; accessible-id: "devices.check\{root.device.id}";
            compact: true; label: @tr("CHECK"); tone: Theme.attention; tooltip: @tr("Read the stick back and compare every track, cue, grid and playlist with the library");
            clicked => { root.check(); }
        }
        if root.device.connected: PlateButton {
            accessible-role: button; accessible-id: "devices.eject\{root.device.id}";
            compact: true; label: @tr("EJECT"); tone: Theme.bone-3; tooltip: @tr("Eject this stick"); command: "devices.eject";
            clicked => { root.eject(); }
        }
    }
}

export component DeviceBoard inherits Rectangle {
    in property <[DeviceRow]> devices;
    in property <[VolumeRow]> volumes;
    in property <string> register-target;
    callback sync(int);
    callback eject(int);
    callback open(int);
    callback register(int);

    VerticalLayout {
        spacing: Theme.s1;
        alignment: start;
        HorizontalLayout {
            Caps { text: @tr("DEVICES"); color: Theme.bone-2; }
            Rectangle { horizontal-stretch: 1; }
        }
        HLine { tone: Theme.rule; }
        if root.devices.length == 0 && root.volumes.length == 0: Text {
            text: @tr("Plug in a USB stick to register it. Registered sticks stay in sync automatically.");
            wrap: word-wrap;
            font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3;
        }
        for d in root.devices: DeviceLine {
            device: d;
            sync => { root.sync(d.id); }
            eject => { root.eject(d.id); }
            open => { root.open(d.id); }
        }
        for v in root.volumes: Rectangle {
            height: 64px;
            VLine { x: 0; y: 8px; height: parent.height - 16px; form: "half"; tone: Theme.bone-2; }
            Text {
                x: 18px; y: 8px; width: parent.width - 18px;
                text: @tr("New stick: {}", v.name);
                font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi; color: Theme.bone;
                overflow: elide;
            }
            Caps { x: 18px; y: 30px; text: v.space; font-size: Theme.label; }
            PlateButton {
                x: 18px; y: 40px; compact: true;
                enabled: root.register-target != "";
                label: root.register-target == "" ? @tr("SELECT A PLAYLIST FIRST") : @tr("REGISTER WITH {}", root.register-target);
                tone: Theme.live;
                clicked => { root.register(v.index); }
            }
        }
    }
}

// The stick check before a gig (roadmap [53]): one verdict, then a row per
// track with its file, cues and grid, problems first.
export struct StickCheckRow {
    title: string,
    artist: string,
    // "ok", "missing", "differs", "unreadable", "none".
    file: string,
    cues: string,
    grid: string,
}

export global StickCheck {
    // The panel shows (for the selected stick).
    in-out property <bool> visible;
    in property <bool> running;
    in property <bool> ready;
    // "2 of 2 tracks in order · 1 playlist as in the library".
    in property <string> summary;
    // Whole-stick problems, one per line ("" when none).
    in property <string> problems;
    in property <[StickCheckRow]> rows;
    callback run(int);
    callback close();
}

// One mark: a short line in the status grammar over its legend.
component CheckMark inherits HorizontalLayout {
    in property <string> state;
    in property <string> label;
    width: 64px; spacing: Theme.s1;
    VerticalLayout {
        padding-top: Theme.s2; padding-bottom: Theme.s2;
        VLine {
            tone: root.state == "ok" ? Theme.live : root.state == "differs" ? Theme.attention : root.state == "none" ? Theme.rule-strong : Theme.bone-3;
            form: root.state == "ok" ? "solid" : root.state == "differs" ? "dashed" : root.state == "none" ? "half" : "struck";
        }
    }
    Caps {
        text: root.label; vertical-alignment: center;
        color: root.state == "missing" || root.state == "unreadable" ? Theme.fault : root.state == "ok" ? Theme.bone-3 : Theme.bone-2;
    }
}

export component StickCheckPanel inherits VerticalLayout {
    accessible-role: groupbox;
    accessible-id: "devices.check-panel";
    accessible-value: StickCheck.running ? "running" : StickCheck.ready ? "ready" : "not ready";
    spacing: Theme.s2;
    HorizontalLayout {
        spacing: Theme.s3;
        height: 44px;
        VerticalLayout {
            padding-top: Theme.s1; padding-bottom: Theme.s1;
            VLine {
                weight: 2px;
                tone: StickCheck.running ? Theme.attention : StickCheck.ready ? Theme.live : Theme.bone-3;
                form: StickCheck.running ? "dashed" : StickCheck.ready ? "solid" : "struck";
            }
        }
        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: Theme.key-gap;
            Text {
                accessible-role: text; accessible-id: "devices.check-verdict"; accessible-value: self.text;
                text: StickCheck.running ? @tr("Checking the stick…") : StickCheck.ready ? @tr("Ready") : @tr("Not ready");
                font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi;
                color: !StickCheck.running && !StickCheck.ready ? Theme.fault : Theme.bone;
            }
            if !StickCheck.running: Text {
                text: StickCheck.summary; overflow: elide;
                font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.bone-2;
            }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            PlateButton { accessible-role: button; accessible-id: "devices.check-close"; compact: true; label: @tr("CLOSE"); clicked => { StickCheck.close(); } }
        }
    }
    if StickCheck.problems != "": Text {
        accessible-role: text; accessible-id: "devices.check-problems"; accessible-value: self.text;
        text: StickCheck.problems; wrap: word-wrap;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.fault;
    }
    HLine { tone: Theme.rule; }
    Rectangle {
        vertical-stretch: 1;
        Flickable {
            VerticalLayout {
                alignment: start;
                for r in StickCheck.rows: HorizontalLayout {
                    accessible-role: text;
                    accessible-id: "devices.check-row";
                    accessible-value: r.title + " file " + r.file + " cues " + r.cues + " grid " + r.grid;
                    height: 40px; spacing: Theme.s3;
                    VerticalLayout {
                        horizontal-stretch: 1; alignment: center;
                        Text { text: r.title; overflow: elide; font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-medium; color: Theme.bone; }
                        Text { text: r.artist; overflow: elide; font-family: Theme.family; font-size: Theme.label; color: Theme.bone-3; }
                    }
                    CheckMark { state: r.file; label: @tr("FILE"); }
                    CheckMark { state: r.cues; label: @tr("CUES"); }
                    CheckMark { state: r.grid; label: @tr("GRID"); }
                }
            }
        }
    }
    Text {
        text: @tr("Solid: as in the library. Dashed: changed since the last sync. Struck: missing or unreadable. Half: nothing to compare.");
        wrap: word-wrap; font-family: Theme.family; font-size: Theme.label; color: Theme.bone-3;
    }
}
