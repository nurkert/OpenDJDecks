// Prepare player: the header line, overview with phrase bar and the
// enlarged waveform beside a cue list (ALL / MEMORY / HOT CUE / INFO), and
// under both one dock across the full width: CUE / PLAY on the left, then
// the tool tabs (CUE / LOOP | GRID | PHRASE | EDIT) with the loop and jump
// keys on one line and the keys of the chosen tool on the line below.

import { Theme } from "tokens.slint";
import { VLine, HLine } from "lines.slint";
import { Caps, PlateButton, Toggle, Transport, Splitter, Field, Stepper, Glyph, TipArea, PopupPlace } from "controls.slint";
import { Pad } from "perform.slint";
import { CueMarker } from "wave.slint";
import { ChoiceList } from "fx.slint";
import { DropZone } from "drag.slint";
import { CueMark, HotCueSlot, PhraseMark, GridEdit, AnalysisSure } from "structs.slint";

component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> current;
    // Room beside the legend.
    in property <length> pad: 24px;
    callback clicked();
    accessible-role: tab;
    accessible-item-selectable: true;
    accessible-item-selected: root.current;
    min-width: t.preferred-width + root.pad;
    height: 26px;
    border-radius: Theme.r-control;
    background: root.current ? Theme.bone : touch.pressed || touch.has-hover ? Theme.plate-raised : Theme.plate;
    t := Text {
        text: root.label;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; letter-spacing: 1.2px;
        color: root.current ? Theme.ground : touch.has-hover ? Theme.bone : Theme.bone-2;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Reading inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    // Widest value shown here; keeps the width fixed while digits change.
    in property <string> template;
    // Test / screen-reader identifier of the value (empty: none).
    in property <string> a11y-label;
    // [62] How sure the analysis is of this value ("92 %", "" = none),
    // whether that is unsure (a half-height sodium line before it, the
    // percent in sodium), and the likely alternative to take with one press.
    in property <string> sure;
    in property <bool> unsure;
    in property <string> alt;
    in property <string> sure-a11y;
    in property <string> alt-tip;
    // A key of its own in the row instead (e.g. ANALYSE AGAIN).
    in property <string> action;
    in property <string> action-a11y;
    in property <string> action-tip;
    callback use-alt();
    callback act();
    spacing: Theme.s2;
    Caps { text: root.label; font-size: Theme.label; vertical-alignment: center; }
    if root.sure != "" || root.action != "": Rectangle { horizontal-stretch: 1; }
    if root.sure != "": HorizontalLayout {
        spacing: Theme.s1;
        if root.unsure: VerticalLayout { alignment: center; VLine { height: 14px; weight: 2px; tone: Theme.attention; form: "half"; } }
        Text {
            accessible-role: text; accessible-label: root.sure-a11y; accessible-value: self.text;
            accessible-description: root.unsure ? "unsure" : "sure";
            text: root.sure; font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: 0.6px;
            color: root.unsure ? Theme.attention : Theme.bone-3; vertical-alignment: center;
        }
    }
    if root.unsure && root.alt != "": VerticalLayout {
        alignment: center;
        PlateButton {
            accessible-role: button; accessible-label: root.sure-a11y + ".use";
            compact: true; label: @tr("USE {}", root.alt); tone: Theme.attention;
            tooltip: root.alt-tip;
            clicked => { root.use-alt(); }
        }
    }
    if root.action != "": VerticalLayout {
        alignment: center;
        PlateButton {
            accessible-role: button; accessible-label: root.action-a11y;
            compact: true; label: root.action; tooltip: root.action-tip;
            clicked => { root.act(); }
        }
    }
    Text {
        accessible-role: text;
        accessible-label: root.a11y-label;
        accessible-value: self.text;
        min-width: probe.preferred-width;
        horizontal-alignment: right;
        text: root.value == "" ? "—" : root.value; font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi; color: Theme.bone; vertical-alignment: center;
        probe := Text { visible: false; text: root.template; font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi; }
    }
}

// Cue editing in the cue list (indices into the player's `cues`).
export global CueEdit {
    in property <[color]> palette;
    callback label(int, string);
    callback color(int, int);
    callback move-to-cursor(int);
    callback to-hot(int);
    // Active loop on / off (loops).
    callback active(int);
    callback delete(int);
}

// Phrase editing at the cursor (PHRASE tab).
export global PhraseEdit {
    // Labels of the kinds offered, in button order.
    in property <[string]> kinds;
    // The phrase at the cursor (its label; "" = none).
    in property <string> current;
    // How sure the analysis was of it when unsure ("41 %"; "" = sure,
    // checked by you, or none).
    in property <string> current-sure;
    // Counts up when the type picker of phrase `picker-index` should open
    // (the key: the phrase at the cursor).
    in-out property <int> picker-request;
    in-out property <int> picker-index: -1;
    callback kind(int);
    callback cut();
    callback merge();
    callback boundary();
    callback clear();
    // On the phrase strip (positions as fractions of the track): the phrase
    // at `pos` takes kind `i`; it joins the next one; the edge at `from`
    // moves to `to` (snapped to a bar).
    callback kind-at(float, int);
    callback merge-at(float);
    callback move-edge(float, float);
    // The bar an edge dragged to `pos` lands on.
    pure callback snap(float) -> float;
}

// The phrases of the Prepare player, editable in place: a click on a phrase
// opens its type picker beside it (with MERGE WITH NEXT), its right edge
// drags to another bar. Empty with a hint while the track has none.
component PhraseStrip inherits Rectangle {
    in property <[PhraseMark]> phrases;
    in property <bool> can-edit;
    in property <float> cursor;
    // The phrase whose picker is open, and where.
    property <int> picked: -1;
    property <float> picked-pos;
    // An edge being dragged: its index and where it would land.
    property <int> dragging: -1;
    property <float> guide;
    // The key opens the picker of the phrase at the cursor.
    property <int> request: PhraseEdit.picker-request;
    changed request => { root.open(PhraseEdit.picker-index); }
    function open(i: int) {
        if (!root.can-edit || i < 0 || i >= root.phrases.length) { return; }
        root.picked = i;
        root.picked-pos = (root.phrases[i].pos + root.phrases[i].end) / 2;
        picker.show();
    }
    accessible-role: list;
    accessible-label: "player1.phrases";
    height: 22px;
    background: Theme.ground;
    if root.phrases.length == 0: Text {
        x: 8px; height: parent.height;
        text: root.can-edit ? @tr("No phrases — analyse the track, or pick a type in the PHRASE tab") : "";
        font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3; vertical-alignment: center;
    }
    for p[i] in root.phrases: Rectangle {
        accessible-role: button;
        accessible-label: "player1.phrase.block\{i}";
        accessible-value: p.label;
        accessible-description: p.unsure ? "unsure" : "sure";
        x: parent.width * p.pos;
        width: max(1px, parent.width * (p.end - p.pos) - 1px);
        background: p.tone.with-alpha(block.has-hover && root.can-edit ? 0.5 : 0.32);
        Rectangle { y: 0; height: 2px; background: p.tone; }
        // [62] Unsure: a half-height sodium line at its start, as for an
        // unsure key; picking its type (or moving an edge) confirms it.
        if p.unsure: VLine {
            accessible-role: text; accessible-label: "player1.phrase.unsure\{i}"; accessible-value: p.sure;
            x: 2px; y: 4px; height: parent.height - 6px; weight: 2px; tone: Theme.attention; form: "half";
        }
        Text {
            x: p.unsure ? 8px : 4px; width: parent.width - (p.unsure ? 10px : 6px); height: parent.height;
            text: parent.width > 30px ? p.label : "";
            font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: 0.8px;
            color: Theme.bone; vertical-alignment: center; overflow: clip;
        }
        block := TipArea {
            enabled: root.can-edit;
            mouse-cursor: pointer;
            tooltip: p.unsure
                ? @tr("The analysis is unsure of this phrase ({}): click to confirm its type or pick another · drag an edge to move it", p.sure)
                : @tr("Click: phrase type · drag an edge to move it (snaps to bars) · Shift+X split at the cursor · Shift+J merge");
            clicked => { root.open(i); }
        }
    }
    // Edges: the end of every phrase but the last, wide enough to grab.
    for p[i] in root.phrases: Rectangle {
        visible: i + 1 < root.phrases.length && root.can-edit;
        accessible-role: slider;
        accessible-label: "player1.phrase.edge\{i}";
        accessible-value: Math.round(p.end * 1000) / 10 + " %";
        x: parent.width * p.end - 5px; width: 10px;
        Rectangle {
            x: 4px; width: 2px;
            background: edge.has-hover || root.dragging == i ? Theme.bone : transparent;
        }
        edge := TipArea {
            mouse-cursor: ew-resize;
            tooltip: @tr("Drag to move the boundary (snaps to bars)");
            moved => {
                if (self.pressed) {
                    root.dragging = i;
                    root.guide = PhraseEdit.snap(clamp((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width, 0, 1));
                }
            }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up && root.dragging == i) {
                    PhraseEdit.move-edge(p.end, root.guide);
                    root.dragging = -1;
                }
            }
        }
    }
    // Where the dragged edge lands.
    if root.dragging >= 0: Rectangle {
        accessible-role: text; accessible-label: "player1.phrase.guide"; accessible-value: Math.round(root.guide * 1000) / 10 + " %";
        x: parent.width * root.guide - 1px; width: 2px;
        background: Theme.attention;
    }
    picker := PopupWindow {
        property <length> w: kinds-list.width;
        property <length> h: kinds-list.height + 30px;
        x: PopupPlace.x(root.absolute-position.x, root.width * root.picked-pos - self.w / 2, self.w);
        y: PopupPlace.y(root.absolute-position.y, root.height + 2px, -self.h - 2px, self.h);
        width: self.w; height: self.h;
        VerticalLayout {
            kinds-list := ChoiceList {
                accessible-role: list; accessible-label: "player1.phrase.picker";
                items: PhraseEdit.kinds; columns: 2; cell-w: 92px;
                current: -1;
                chosen(k) => { PhraseEdit.kind-at(root.picked-pos, k); picker.close(); }
            }
            PlateButton {
                accessible-role: button; accessible-label: "player1.phrase.merge-next";
                compact: true; height: 30px; label: @tr("MERGE WITH NEXT"); glyph: "plus";
                enabled: root.picked >= 0 && root.picked + 1 < root.phrases.length;
                clicked => { PhraseEdit.merge-at(root.picked-pos); picker.close(); }
            }
        }
    }
}

// Edit mode (EDIT tab): a region rendered into a new file.
export global TrackEdit {
    // Region ends as fractions of the track (-1 = not set).
    in property <float> start: -1;
    in property <float> end: -1;
    // Both ends set: CUT / TRIM / REPEAT work.
    in property <bool> ready;
    // An edit is being rendered.
    in property <bool> busy;
    // "0:12.000 – 0:28.000  (0:16)".
    in property <string> region;
    callback mark-in();
    callback mark-out();
    // A region dragged on the overview (fractions, either order).
    callback select(float, float);
    callback clear();
    // "cut", "trim" or "repeat".
    callback apply(string);
}

// ── EDIT GRID ──────────────────────────────────────────────────────────

// Colour of an error class (0 within 5 ms, 1 within 15 ms, 2 beyond).
global GridTone {
    public pure function of(tone: int) -> color {
        return tone == 0 ? Theme.bone : tone == 1 ? Theme.attention : tone == 2 ? Theme.fault : Theme.bone-3;
    }
}

// Session header over the enlarged waveform: what is edited, how well the
// grid fits, and the two ways out.
component GridHeader inherits Rectangle {
    height: 34px;
    background: Theme.ground-band;
    accessible-role: text; accessible-label: "player1.grid.edit-hint"; accessible-value: GridEdit.title;
    // A sodium line mark on the left edge: the session is on.
    Rectangle { x: 0; width: 3px; background: Theme.attention; }
    HorizontalLayout {
        padding-left: Theme.s4; padding-right: Theme.s2; spacing: Theme.s4;
        Caps { text: @tr("EDIT GRID"); color: Theme.attention; font-weight: Theme.weight-semi; vertical-alignment: center; }
        Text {
            accessible-role: text; accessible-label: "player1.grid.title"; accessible-value: self.text;
            horizontal-stretch: 1;
            text: GridEdit.title;
            font-family: Theme.family; font-size: Theme.control; color: Theme.bone; vertical-alignment: center; overflow: elide;
        }
        HorizontalLayout {
            spacing: Theme.s2; horizontal-stretch: 0;
            Caps { text: "FIT"; font-size: Theme.label; vertical-alignment: center; }
            Text {
                accessible-role: text; accessible-label: "player1.grid.fit"; accessible-value: self.text;
                min-width: 52px;
                text: GridEdit.fit;
                font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi; vertical-alignment: center;
                color: GridTone.of(GridEdit.fit-tone);
            }
        }
        VerticalLayout { horizontal-stretch: 0; alignment: center; PlateButton { accessible-role: button; accessible-label: "player1.grid.cancel"; compact: true; label: @tr("CANCEL"); tone: Theme.fault; tooltip: @tr("Back to the grid before editing (nothing is stored)"); command: "player.grid.cancel"; clicked => { GridEdit.cancel(); } } }
        VerticalLayout { horizontal-stretch: 0; alignment: center; PlateButton { accessible-role: button; accessible-label: "player1.grid.done"; compact: true; label: @tr("DONE"); tone: Theme.live; tooltip: @tr("Keep the grid (one undo step)"); command: "player.grid.done"; clicked => { GridEdit.done(); } } }
    }
}

// DRIFT: the error of every beat over the whole track (up: the beat comes
// before its kick, down: after), the cursor, and the worst spot.
component DriftStrip inherits Rectangle {
    in property <float> cursor;
    height: 24px;
    HorizontalLayout {
        padding-left: Theme.s3; padding-right: Theme.s2; spacing: Theme.s3;
        Caps { text: @tr("DRIFT"); font-size: Theme.label; vertical-alignment: center; width: 44px; }
        Rectangle {
            accessible-role: image; accessible-label: "player1.grid.drift";
            horizontal-stretch: 1;
            y: 5px; height: parent.height - 10px;
            background: Theme.ground-band;
            border-width: 1px; border-color: Theme.rule;
            Image { width: parent.width; height: parent.height; source: GridEdit.drift; image-fit: fill; }
            Rectangle { x: parent.width * root.cursor - 1px; width: 2px; background: Theme.bone; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { GridEdit.drift-seek(self.mouse-x / self.width); }
            }
        }
        Rectangle {
            accessible-role: button; accessible-label: "player1.grid.worst"; accessible-value: GridEdit.worst;
            horizontal-stretch: 0;
            min-width: worst.preferred-width + 16px;
            worst := Text {
                text: GridEdit.worst == "" ? @tr("no spot over 5 ms") : @tr("worst {} ▸", GridEdit.worst);
                font-family: Theme.family; font-size: Theme.label; vertical-alignment: center;
                color: GridEdit.worst == "" ? Theme.bone-3 : wt.has-hover ? Theme.bone : Theme.bone-2;
            }
            wt := TipArea { tooltip: @tr("Jump to the spot where the grid is furthest off"); command: "player.grid.next-problem"; mouse-cursor: pointer; clicked => { GridEdit.act("worst", ""); } }
        }
    }
}

// One label of the EDIT GRID readout.
component GridLabel inherits Caps { font-size: Theme.label; }

// The readout beside the waveform while the grid is edited: tempo (type
// it), the error at the cursor, the pins, where the grid came from and the
// colour key of the beat ticks.
component GridReadout inherits VerticalLayout {
    in property <bool> enabled;
    padding: Theme.s3; spacing: Theme.s2;
    alignment: start;
    GridLabel { text: GridEdit.tempos > 1 ? @tr("BPM AT CURSOR · {} TEMPOS", GridEdit.tempos) : @tr("BPM"); }
    Field {
        accessible-role: text-input; accessible-label: "player1.grid.bpm"; accessible-value: self.text;
        height: 32px;
        text: GridEdit.bpm; placeholder: "BPM";
        // Follows the grid (also after typing).
        property <string> grid-bpm: GridEdit.bpm;
        changed grid-bpm => { self.text = self.grid-bpm; }
        accepted(t) => { GridEdit.act("bpm", t); self.text = GridEdit.bpm; }
    }
    Rectangle { height: Theme.s2; }
    GridLabel { text: @tr("AT CURSOR"); }
    Text {
        accessible-role: text; accessible-label: "player1.grid.at-cursor"; accessible-value: self.text;
        text: GridEdit.at-cursor;
        font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi;
        color: GridTone.of(GridEdit.at-cursor-tone);
    }
    Rectangle { height: Theme.s2; }
    GridLabel { text: @tr("SOURCE"); }
    Text {
        accessible-role: text; accessible-label: "player1.grid.source"; accessible-value: self.text;
        text: GridEdit.source == "" ? "—" : GridEdit.source;
        font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2;
    }
    Rectangle { height: Theme.s2; }
    GridLabel { text: @tr("PINS"); }
    for p[i] in GridEdit.pins: HorizontalLayout {
        accessible-role: list-item; accessible-label: "player1.grid.pin" + i; accessible-value: p;
        spacing: Theme.s2; alignment: start;
        Text { text: "◆"; font-size: Theme.label; color: Theme.attention; vertical-alignment: center; }
        Text { text: p; font-family: Theme.family; font-size: Theme.control; color: Theme.bone; vertical-alignment: center; }
    }
    if GridEdit.pins.length == 0: Text {
        text: @tr("PIN a kick near the start and one near the end: the tempo between them is solved.");
        wrap: word-wrap; font-family: Theme.family; font-size: Theme.label; color: Theme.bone-3;
    }
    Rectangle { height: Theme.s3; }
    // Key of the tick colours.
    for k in [{ t: 0, l: @tr("within 5 ms") }, { t: 1, l: @tr("within 15 ms") }, { t: 2, l: @tr("further off") }]: HorizontalLayout {
        spacing: Theme.s2; height: 16px;
        Rectangle { width: 2px; background: GridTone.of(k.t); }
        Text { text: k.l; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; }
    }
    HorizontalLayout {
        spacing: Theme.s2; height: 16px;
        Rectangle { width: 2px; height: 8px; y: 8px; background: Theme.bone-2; }
        Text { text: @tr("transient (long: kick)"); font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; }
    }
}

// Row label of the EDIT GRID keys.
component KeyRowLabel inherits Caps { min-width: self.preferred-width + 4px; font-size: Theme.label; vertical-alignment: center; color: Theme.attention; }

// The EDIT GRID keys in the dock: MOVE, TEMPO, SOLVE, HEAR.
component GridSessionKeys inherits VerticalLayout {
    in property <bool> enabled;
    // A narrow player: TEMPO and HEAR on lines of their own.
    in property <bool> narrow;
    spacing: Theme.s2;
    HorizontalLayout {
        height: 30px; spacing: Theme.s1;
        KeyRowLabel { text: @tr("MOVE"); }
        Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.shift-left"; label: "◀ 10"; tooltip: @tr("Grid 10 ms earlier"); command: "player.grid.move-earlier-coarse"; enabled: root.enabled; clicked => { GridEdit.act("shift", "-10"); } }
        Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.nudge-left"; label: "◀ 1"; tooltip: @tr("Grid 1 ms earlier"); command: "player.grid.move-earlier"; enabled: root.enabled; clicked => { GridEdit.act("shift", "-1"); } }
        Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.nudge-right"; label: "1 ▶"; tooltip: @tr("Grid 1 ms later"); command: "player.grid.move-later"; enabled: root.enabled; clicked => { GridEdit.act("shift", "1"); } }
        Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.shift-right"; label: "10 ▶"; tooltip: @tr("Grid 10 ms later"); command: "player.grid.move-later-coarse"; enabled: root.enabled; clicked => { GridEdit.act("shift", "10"); } }
        Rectangle { width: Theme.s2; }
        Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.beat-earlier"; label: @tr("◀ BEAT"); tooltip: @tr("Grid one beat earlier"); command: "player.grid.beat-earlier"; enabled: root.enabled; clicked => { GridEdit.act("beat", "-1"); } }
        Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.beat-later"; label: @tr("BEAT ▶"); tooltip: @tr("Grid one beat later"); command: "player.grid.beat-later"; enabled: root.enabled; clicked => { GridEdit.act("beat", "1"); } }
        Rectangle { width: Theme.s2; }
        Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.set-one"; label: @tr("SET 1 HERE"); tone: Theme.attention; tooltip: @tr("The beat at the cursor becomes the 1 and sits on its kick (±60 ms)"); command: "player.grid.set-one"; enabled: root.enabled; clicked => { GridEdit.act("set-one", ""); } }
        if !root.narrow: Rectangle { width: Theme.s4; }
        if !root.narrow: KeyRowLabel { text: @tr("TEMPO"); }
        if !root.narrow: Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.slower"; label: "−.01"; tooltip: @tr("Tempo 0.01 BPM slower about the cursor"); command: "player.grid.slower"; enabled: root.enabled; clicked => { GridEdit.act("step", "-0.01"); } }
        if !root.narrow: Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.faster"; label: "+.01"; tooltip: @tr("Tempo 0.01 BPM faster about the cursor"); command: "player.grid.faster"; enabled: root.enabled; clicked => { GridEdit.act("step", "0.01"); } }
        if !root.narrow: Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.halve"; label: "÷2"; tooltip: @tr("Half the tempo"); command: "player.grid.half"; enabled: root.enabled; clicked => { GridEdit.act("scale", "0.5"); } }
        if !root.narrow: Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.double"; label: "×2"; tooltip: @tr("Double the tempo"); command: "player.grid.double"; enabled: root.enabled; clicked => { GridEdit.act("scale", "2"); } }
        if !root.narrow: Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.tap"; label: @tr("TAP"); tooltip: @tr("Tap along: from the fourth tap the tempo follows; while it plays the taps also set the phase"); command: "player.grid.tap-along"; enabled: root.enabled; clicked => { GridEdit.act("tap", ""); } }
        if !root.narrow: Rectangle { width: Theme.s2; }
        if !root.narrow: Caps { text: @tr("PIVOT ▸ CURSOR"); font-size: Theme.label; vertical-alignment: center; color: Theme.bone-3; }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.narrow: HorizontalLayout {
        height: 30px; spacing: Theme.s1;
        KeyRowLabel { text: @tr("TEMPO"); }
        Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.slower"; label: "−.01"; tooltip: @tr("Tempo 0.01 BPM slower about the cursor"); command: "player.grid.slower"; enabled: root.enabled; clicked => { GridEdit.act("step", "-0.01"); } }
        Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.faster"; label: "+.01"; tooltip: @tr("Tempo 0.01 BPM faster about the cursor"); command: "player.grid.faster"; enabled: root.enabled; clicked => { GridEdit.act("step", "0.01"); } }
        Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.halve"; label: "÷2"; tooltip: @tr("Half the tempo"); command: "player.grid.half"; enabled: root.enabled; clicked => { GridEdit.act("scale", "0.5"); } }
        Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.double"; label: "×2"; tooltip: @tr("Double the tempo"); command: "player.grid.double"; enabled: root.enabled; clicked => { GridEdit.act("scale", "2"); } }
        Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.tap"; label: @tr("TAP"); tooltip: @tr("Tap along: from the fourth tap the tempo follows; while it plays the taps also set the phase"); command: "player.grid.tap-along"; enabled: root.enabled; clicked => { GridEdit.act("tap", ""); } }
        Rectangle { width: Theme.s2; }
        Caps { text: @tr("PIVOT ▸ CURSOR"); font-size: Theme.label; vertical-alignment: center; color: Theme.bone-3; }
        Rectangle { horizontal-stretch: 1; }
    }
    HorizontalLayout {
        height: 30px; spacing: Theme.s1;
        KeyRowLabel { text: @tr("SOLVE"); }
        Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.pin"; label: GridEdit.pins.length > 0 ? @tr("PIN HERE ◆{}", GridEdit.pins.length) : @tr("PIN HERE"); tone: Theme.attention; on: GridEdit.pins.length > 0; tooltip: @tr("This beat sits exactly here (snapped to its kick): one pin moves the grid, two pins solve the tempo"); command: "player.grid.pin"; enabled: root.enabled; clicked => { GridEdit.act("pin", ""); } }
        Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.auto-fix"; label: @tr("AUTO-FIX"); tooltip: @tr("Correct slip and tempo from the kicks of the tempo section at the cursor"); command: "player.grid.auto-fix"; enabled: root.enabled; clicked => { GridEdit.act("auto-fix", ""); } }
        Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.tempo-change"; label: @tr("TEMPO CHANGE HERE"); tooltip: @tr("A new tempo from the beat at the cursor on, measured from the kicks after it"); enabled: root.enabled; clicked => { GridEdit.act("tempo-change", ""); } }
        Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.clear-pins"; label: @tr("CLEAR PINS"); tooltip: @tr("Remove the pins (the grid stays)"); enabled: root.enabled && GridEdit.pins.length > 0; clicked => { GridEdit.act("clear-pins", ""); } }
        if !root.narrow: Rectangle { width: Theme.s4; }
        if !root.narrow: KeyRowLabel { text: @tr("HEAR"); }
        if !root.narrow: Toggle { size: 30px; accessible-role: checkbox; accessible-checkable: true; accessible-checked: GridEdit.click; accessible-label: "player1.grid.click"; label: GridEdit.click ? @tr("CLICK ●") : @tr("CLICK ○"); on: GridEdit.click; tone: Theme.live; tooltip: @tr("Metronome on the grid while the preview plays (higher on the 1)"); command: "player.grid.click"; clicked => { GridEdit.act("click", ""); } }
        if !root.narrow: Toggle { size: 30px; accessible-role: checkbox; accessible-checkable: true; accessible-checked: GridEdit.snap; accessible-label: "player1.grid.snap"; label: GridEdit.snap ? @tr("SNAP ●") : @tr("SNAP ○"); on: GridEdit.snap; tone: Theme.live; tooltip: @tr("Snap SET 1, PIN and drags to the kicks (hold Alt while dragging: no snap)"); command: "player.grid.snap"; clicked => { GridEdit.act("snap", ""); } }
        if !root.narrow: Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.undo"; label: @tr("UNDO"); tooltip: @tr("Undo the last grid change of this session"); command: "player.grid.undo"; enabled: GridEdit.can-undo; clicked => { GridEdit.act("undo", ""); } }
        if !root.narrow: Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.redo"; label: @tr("REDO"); tooltip: @tr("Redo"); command: "player.grid.redo"; enabled: GridEdit.can-redo; clicked => { GridEdit.act("redo", ""); } }
        if !root.narrow: Toggle { size: 30px; accessible-role: checkbox; accessible-checkable: true; accessible-checked: GridEdit.locked; accessible-label: "player1.grid.lock"; label: GridEdit.locked ? @tr("GRID LOCKED") : @tr("LOCK GRID"); on: GridEdit.locked; tone: Theme.attention; tooltip: @tr("Lock the grid against changes (analysis and edits)"); clicked => { GridEdit.act("lock", ""); } }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.narrow: HorizontalLayout {
        height: 30px; spacing: Theme.s1;
        KeyRowLabel { text: @tr("HEAR"); }
        Toggle { size: 30px; accessible-role: checkbox; accessible-checkable: true; accessible-checked: GridEdit.click; accessible-label: "player1.grid.click"; label: GridEdit.click ? @tr("CLICK ●") : @tr("CLICK ○"); on: GridEdit.click; tone: Theme.live; tooltip: @tr("Metronome on the grid while the preview plays (higher on the 1)"); command: "player.grid.click"; clicked => { GridEdit.act("click", ""); } }
        Toggle { size: 30px; accessible-role: checkbox; accessible-checkable: true; accessible-checked: GridEdit.snap; accessible-label: "player1.grid.snap"; label: GridEdit.snap ? @tr("SNAP ●") : @tr("SNAP ○"); on: GridEdit.snap; tone: Theme.live; tooltip: @tr("Snap SET 1, PIN and drags to the kicks (hold Alt while dragging: no snap)"); command: "player.grid.snap"; clicked => { GridEdit.act("snap", ""); } }
        Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.undo"; label: @tr("UNDO"); tooltip: @tr("Undo the last grid change of this session"); command: "player.grid.undo"; enabled: GridEdit.can-undo; clicked => { GridEdit.act("undo", ""); } }
        Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.redo"; label: @tr("REDO"); tooltip: @tr("Redo"); command: "player.grid.redo"; enabled: GridEdit.can-redo; clicked => { GridEdit.act("redo", ""); } }
        Toggle { size: 30px; accessible-role: checkbox; accessible-checkable: true; accessible-checked: GridEdit.locked; accessible-label: "player1.grid.lock"; label: GridEdit.locked ? @tr("GRID LOCKED") : @tr("LOCK GRID"); on: GridEdit.locked; tone: Theme.attention; tooltip: @tr("Lock the grid against changes (analysis and edits)"); clicked => { GridEdit.act("lock", ""); } }
        Rectangle { horizontal-stretch: 1; }
    }
}

export component PreparePlayer inherits Rectangle {
    // A narrow window (a small screen at a large interface scale): a
    // slimmer cue list and the read-outs that matter while preparing.
    property <bool> narrow: PopupPlace.window-width < 1000px;
    property <length> side-w: root.narrow ? 184px : 264px;
    in property <bool> has-track;
    in property <string> title;
    in property <string> artist;
    in property <string> bpm;
    // The active BPM detection range, e.g. "70–180".
    in property <string> bpm-range;
    in property <string> key;
    in property <string> duration;
    in property <string> position;
    in property <string> grid-source;
    in property <bool> grid-locked;
    in property <bool> analysed;
    in property <bool> read-only;
    in property <image> overview;
    in property <image> detail;
    // Span of the enlarged waveform as a fraction of the track.
    in property <float> detail-span;
    // Cover art thumbnail (empty: none).
    in property <bool> has-artwork;
    in property <image> artwork;
    in property <[CueMark]> cues;
    in property <[PhraseMark]> phrases;
    in property <[HotCueSlot]> hot-cues;
    in property <float> cursor;
    in property <bool> previewing;
    // Time left, loop state of the preview, global quantize, the jump size
    // of − / + and the zoom of the enlarged waveform.
    in property <string> remaining;
    in property <string> loop-size: "4";
    in property <bool> looping;
    in property <bool> loop-in-set;
    in property <bool> quantize;
    in property <string> jump-size: "2 S";
    in property <string> zoom: "8 S";
    // Preview at another tempo or key (TEMPO / KEY tab): read-outs.
    in property <string> shift-tempo: "0 %";
    in property <string> shift-key: "0";
    in property <string> shift-result;
    // Loops, quantize, memory cue stepping, zoom, jump size and the menu.
    callback act(string);
    in property <length> info-width: 260px;
    callback seek(float);
    callback nudge(float);
    callback hot-cue(int);
    callback remove-hot-cue(int);
    callback add-memory-cue();
    callback grid-shift(int);
    callback grid-scale(float);
    callback grid-downbeat();
    callback grid-lock();
    // TAP tempo and a typed BPM (Return).
    callback grid-tap();
    callback grid-bpm(string);
    callback analyse();
    callback toggle-preview();
    callback jump-start();
    callback info-dragged(length);
    callback info-reset();
    property <string> tool-tab: "cue";
    // EDIT GRID shows the GRID tools.
    property <bool> grid-editing: GridEdit.active;
    changed grid-editing => { if (self.grid-editing) { root.tool-tab = "grid"; } }
    property <string> list-tab: AnalysisSure.first-tab;
    // Cue list row being edited (index into `cues`), -1 = none.
    property <int> selected-cue: -1;
    background: Theme.ground-band; border-radius: Theme.r-panel;
    // At least 268 px, more when the dock needs it (narrow: more key lines).
    min-height: max(268px, body.min-height);

    body := VerticalLayout {
        spacing: 0;
        // Waveforms and the cue list.
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0;

            // Cue list: MEMORY / HOT CUE / INFO.
            VerticalLayout {
                width: root.side-w;
                spacing: 0;
                // EDIT GRID: the readout in place of the cue list.
                if GridEdit.active && root.has-track: Flickable {
                    vertical-stretch: 1;
                    // Scrolls when the readout is taller than the player.
                    content-height: max(self.height, readout.preferred-height);
                    readout := GridReadout { width: root.side-w; height: max(parent.height, self.preferred-height); enabled: !GridEdit.locked && !root.read-only; }
                }
                if !(GridEdit.active && root.has-track): VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0;
                    Flickable {
                        accessible-role: list;
                        accessible-label: "player1.cue-list.rows";
                        vertical-stretch: 1;
                        VerticalLayout {
                            width: root.side-w;
                            padding: Theme.s2;
                            spacing: Theme.key-gap;
                            alignment: start;
                            for c[i] in root.cues: Rectangle {
                                accessible-role: list-item;
                                accessible-label: "player1.cue-list.row\{i}";
                                accessible-value: c.label;
                                property <bool> shown: root.list-tab == "all" ? true : root.list-tab == "memory" ? c.slot < 0 : root.list-tab == "hot" ? c.slot >= 0 : false;
                                visible: self.shown;
                                height: self.shown ? 26px : 0px;
                                background: i == root.selected-cue ? Theme.plate-raised : row.has-hover ? Theme.plate : Theme.ground-band;
                                Rectangle { x: 0; width: 3px; background: Theme.cue-tone(c.slot, c.tone); }
                                Text { x: 10px; text: c.slot >= 0 ? c.letter : (c.is-loop ? "LOOP" : "MEM"); font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.bone; vertical-alignment: center; }
                                Text { x: 52px; width: min(100px, parent.width - 124px); text: c.label; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                                Text { x: parent.width - 64px; width: 58px; text: c.time; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; horizontal-alignment: right; vertical-alignment: center; }
                                row := TouchArea {
                                    mouse-cursor: pointer;
                                    // Selecting seeks (which rebuilds the rows), so the second
                                    // click of a double-click lands on the selected row: that
                                    // opens the name field.
                                    clicked => {
                                        if (root.selected-cue == i) {
                                            name.text = c.label;
                                            name.focus-field();
                                        } else {
                                            root.selected-cue = i;
                                            root.seek(c.pos);
                                        }
                                    }
                                }
                            }
                            if root.list-tab != "info" && root.has-track: Text {
                                visible: root.cues.length == 0 || root.list-tab != "all";
                                text: root.list-tab == "memory" ? @tr("Memory cues appear here. Set one with MEMORY +.") : root.list-tab == "hot" ? @tr("Hot cues appear here. Click an empty pad to set one at the cursor.") : @tr("Cues appear here. Double-click one to name it.");
                                wrap: word-wrap; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3;
                            }
                            if root.list-tab == "info": VerticalLayout {
                                spacing: Theme.s2;
                                // [62] BPM and KEY say how sure the analysis is, with
                                // the likely alternative one press away; GRID offers
                                // a fresh analysis when something is unsure.
                                Reading {
                                    label: "BPM"; value: root.bpm;
                                    sure: root.has-track ? AnalysisSure.grid : ""; unsure: AnalysisSure.grid-unsure; alt: AnalysisSure.bpm-alt;
                                    sure-a11y: "player1.grid-sure"; alt-tip: @tr("Set the grid to the likely other tempo (half or double)");
                                    use-alt => { AnalysisSure.fix("bpm"); }
                                }
                                Reading {
                                    label: @tr("KEY"); value: root.key;
                                    sure: root.has-track ? AnalysisSure.key : ""; unsure: AnalysisSure.key-unsure; alt: AnalysisSure.key-alt;
                                    sure-a11y: "player1.key-sure"; alt-tip: @tr("Take the likely other key as your key (one undo step)");
                                    use-alt => { AnalysisSure.fix("key"); }
                                }
                                Reading {
                                    label: @tr("GRID"); value: root.grid-source;
                                    action: root.analysed && root.has-track && !root.read-only && (AnalysisSure.key == "" || AnalysisSure.key-unsure || AnalysisSure.grid-unsure) ? @tr("ANALYSE AGAIN") : "";
                                    action-a11y: "player1.reanalyse";
                                    action-tip: AnalysisSure.key == "" ? @tr("Analyse again to see how sure key and grid are") : @tr("Analyse the track again (your own key and locked grid stay)");
                                    act => { AnalysisSure.fix("analyse"); }
                                }
                                Reading { label: @tr("TIME"); value: root.duration; }
                                // The tempo range the analysis folds into (Preferences › Analysis).
                                Reading { a11y-label: "player1.bpm-range"; label: @tr("BPM RANGE"); value: root.bpm-range; }
                                if !root.analysed && root.has-track: PlateButton { accessible-role: button; accessible-label: "player1.analyse"; label: @tr("ANALYSE"); tone: Theme.attention; enabled: !root.read-only; clicked => { root.analyse(); } }
                            }
                        }
                    }
                    // Editor of the selected cue: name, colour, move, delete.
                    VerticalLayout {
                        visible: root.selected-cue >= 0 && root.selected-cue < root.cues.length && root.has-track && !root.read-only;
                        height: self.visible ? self.preferred-height : 0px;
                        padding: Theme.s2; spacing: Theme.s1;
                        name := Field {
                            accessible-label: "player1.cue-list.name"; accessible-role: text-input;
                            placeholder: @tr("Cue name");
                            accepted(t) => { CueEdit.label(root.selected-cue, t); }
                        }
                        HorizontalLayout {
                            spacing: Theme.key-gap; height: 20px;
                            for c[ci] in CueEdit.palette: Rectangle {
                                accessible-label: "player1.cue-list.color" + ci; accessible-role: button;
                                background: c; border-width: 1px; border-color: Theme.rule;
                                TouchArea { mouse-cursor: pointer; clicked => { CueEdit.color(root.selected-cue, ci); } }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.s1;
                            PlateButton {
                                accessible-label: "player1.cue-list.move"; accessible-role: button;
                                compact: true; label: @tr("TO CURSOR"); horizontal-stretch: 1;
                                tooltip: @tr("Move the cue to the cursor (snapped to the beat)");
                                clicked => { CueEdit.move-to-cursor(root.selected-cue); }
                            }
                            if root.selected-cue >= 0 && root.selected-cue < root.cues.length && root.cues[root.selected-cue].slot < 0: PlateButton {
                                accessible-label: "player1.cue-list.to-hot"; accessible-role: button;
                                compact: true; label: @tr("→ HOT"); horizontal-stretch: 1;
                                tooltip: @tr("Make this memory cue a hot cue on the first free pad");
                                clicked => { CueEdit.to-hot(root.selected-cue); }
                            }
                            if root.selected-cue >= 0 && root.selected-cue < root.cues.length && root.cues[root.selected-cue].is-loop: PlateButton {
                                accessible-label: "player1.cue-list.active"; accessible-role: button;
                                accessible-checkable: true; accessible-checked: root.cues[root.selected-cue].active;
                                compact: true; label: @tr("ACTIVE"); horizontal-stretch: 1;
                                active: root.cues[root.selected-cue].active; tone: Theme.attention;
                                tooltip: @tr("Active loop: the loop engages by itself when playback reaches it");
                                clicked => { CueEdit.active(root.selected-cue); }
                            }
                            PlateButton {
                                accessible-label: "player1.cue-list.delete"; accessible-role: button;
                                compact: true; glyph: "close"; width: 30px; tone: Theme.fault;
                                tooltip: @tr("Delete this cue");
                                clicked => { CueEdit.delete(root.selected-cue); root.selected-cue = -1; }
                            }
                        }
                    }
                    HLine { tone: Theme.rule; }
                    // The tabs wrap onto two lines in a narrow cue list.
                    FlexboxLayout {
                        padding: Theme.s2;
                        spacing: Theme.key-gap;
                        alignment: stretch;
                        Tab { accessible-label: "player1.cue-list.tab.all"; horizontal-stretch: 1; pad: 12px; label: @tr("ALL"); current: root.list-tab == "all"; clicked => { root.list-tab = "all"; } }
                        Tab { accessible-label: "player1.cue-list.tab.memory"; horizontal-stretch: 1; pad: 12px; label: "MEMORY"; current: root.list-tab == "memory"; clicked => { root.list-tab = "memory"; } }
                        Tab { accessible-label: "player1.cue-list.tab.hot-cue"; horizontal-stretch: 1; pad: 12px; label: "HOT CUE"; current: root.list-tab == "hot"; clicked => { root.list-tab = "hot"; } }
                        Tab { accessible-label: "player1.cue-list.tab.info"; horizontal-stretch: 1; pad: 12px; label: "INFO"; current: root.list-tab == "info"; clicked => { root.list-tab = "info"; } }
                    }
                }
            }
            VLine { weight: 1px; tone: Theme.rule; }

            // Header, overview and the waveforms.
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0;
                // EDIT GRID: its header in place of the track's (same height).
                if GridEdit.active && root.has-track: GridHeader { }
                if !(GridEdit.active && root.has-track): HorizontalLayout {
                    height: 34px;
                    padding-left: Theme.s3; padding-right: Theme.s3;
                    spacing: root.narrow ? Theme.s2 : Theme.s4;
                    // Cover art, an outlined square when the track has none.
                    VerticalLayout { alignment: center; Rectangle {
                        accessible-role: image; accessible-label: "player1.artwork";
                        accessible-value: root.has-artwork && root.has-track ? "cover" : "none";
                        width: 26px; height: 26px;
                        background: Theme.plate;
                        border-width: root.has-artwork && root.has-track ? 0px : 1px; border-color: Theme.rule;
                        if root.has-artwork && root.has-track: Image { width: parent.width; height: parent.height; source: root.artwork; image-fit: cover; }
                    } }
                    Text {
                        accessible-role: text;
                        accessible-label: "player1.title";
                        accessible-value: self.text;
                        horizontal-stretch: 2;
                        text: root.has-track ? root.title : @tr("No track selected");
                        font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi; vertical-alignment: center;
                        color: root.has-track ? Theme.bone : Theme.bone-3; overflow: elide;
                    }
                    Text { accessible-role: text; accessible-label: "player1.artist"; accessible-value: self.text; horizontal-stretch: 1; text: root.artist; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                    Reading { a11y-label: "player1.time-remaining"; label: @tr("REMAIN"); template: "-00:00"; value: root.has-track ? root.remaining : ""; }
                    if !root.narrow: Reading { a11y-label: "player1.time-elapsed"; label: @tr("POS"); template: "00:00.000"; value: root.position; }
                    if !root.narrow: Reading { a11y-label: "player1.duration"; label: @tr("TIME"); template: "00:00"; value: root.duration; }
                    Reading { a11y-label: "player1.bpm"; label: "BPM"; template: "000.00"; value: root.bpm; }
                    Reading { a11y-label: "player1.key"; label: @tr("KEY"); template: "12A"; value: root.key; }
                }
                // Zoom of the enlarged waveform: in, reset, out, and the span shown.
                HorizontalLayout {
                    height: 24px;
                    spacing: 0px;
                    for z in [{ id: "zoom-in", glyph: "plus", tip: @tr("Zoom in") }, { id: "zoom-reset", glyph: "", tip: @tr("Reset the zoom (Preferences > View > Waveform zoom)") }, { id: "zoom-out", glyph: "minus", tip: @tr("Zoom out") }]: Rectangle {
                        accessible-role: button; accessible-label: "player1." + z.id;
                        width: 28px;
                        background: zt.has-hover ? Theme.plate-raised : Theme.plate;
                        border-width: 1px; border-color: Theme.ground;
                        if z.glyph != "": Glyph { x: 9px; y: 7px; width: 10px; height: 10px; kind: z.glyph; tone: Theme.bone-2; }
                        if z.glyph == "": Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: Theme.bone-2; }
                        zt := TipArea { tooltip: z.tip; mouse-cursor: pointer; clicked => { root.act(z.id); } }
                    }
                    Caps { text: "  " + root.zoom; font-size: Theme.label; vertical-alignment: center; }
                    // EDIT GRID: the drift of the whole track beside the zoom.
                    if GridEdit.active && root.has-track: DriftStrip { horizontal-stretch: 1; cursor: root.cursor; }
                    if !(GridEdit.active && root.has-track): Rectangle { horizontal-stretch: 1; }
                }
                Rectangle {
                    accessible-role: image;
                    accessible-label: "player1.enlarged";
                    vertical-stretch: 1;
                    min-height: 60px;
                    background: Theme.ground-band;
                    Image { width: parent.width; height: parent.height; source: root.detail; image-fit: fill; }
                    // Hot cues (flag with the letter) and memory cues (triangle).
                    for c[i] in root.cues: CueMarker {
                        property <length> px: parent.width / 2 + (c.pos - root.cursor) / max(root.detail-span, 0.00001) * parent.width;
                        property <length> lw: c.is-loop ? (c.end - c.pos) / max(root.detail-span, 0.00001) * parent.width : 0px;
                        accessible-role: image;
                        accessible-label: c.slot >= 0 ? "player1.wave.cue." + c.letter : "player1.wave.memory." + i;
                        accessible-value: c.time;
                        visible: root.has-track && root.detail-span > 0 && self.px + self.lw >= 0 && self.px <= parent.width;
                        x: self.px; y: 0; height: parent.height;
                        cue: c; loop-w: self.lw;
                    }
                    if root.has-track: Rectangle { x: parent.width / 2 - 1px; width: 2px; height: parent.height; background: Theme.bone; }
                    wave-touch := TouchArea {
                        mouse-cursor: GridEdit.active ? (self.pressed ? grabbing : grab) : ew-resize;
                        // Drag the zoomed waveform to nudge the cursor (8 s across).
                        // EDIT GRID: a drag moves the grid (live, snapped to the
                        // kick on release, Alt: exactly), a click moves the
                        // cursor, a double-click makes the beat there the 1;
                        // the wheel scrolls, Ctrl / ⌘ + wheel zooms.
                        property <length> last;
                        property <length> from;
                        property <bool> dragged;
                        property <bool> alt-held;
                        pointer-event(ev) => {
                            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                                self.last = self.mouse-x; self.from = self.mouse-x; self.dragged = false;
                                self.alt-held = ev.modifiers.alt;
                            }
                            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up && GridEdit.active) {
                                if (self.dragged) {
                                    GridEdit.commit((self.mouse-x - self.from) / self.width, self.mouse-x / self.width - 0.5, self.alt-held || ev.modifiers.alt);
                                } else {
                                    GridEdit.act("seek", "" + (self.mouse-x / self.width - 0.5));
                                }
                            }
                        }
                        double-clicked => {
                            // The first click already brought that spot to the
                            // cursor, the second moved it again by the same.
                            if (GridEdit.active) { GridEdit.set-one-at(0.5 - self.mouse-x / self.width); }
                        }
                        moved => {
                            if (self.pressed) {
                                if (abs(self.mouse-x - self.from) > 3px) { self.dragged = true; }
                                if (GridEdit.active) {
                                    if (self.dragged) { GridEdit.preview((self.mouse-x - self.from) / self.width); }
                                } else {
                                    root.nudge((self.last - self.mouse-x) / self.width * 8.0);
                                    self.last = self.mouse-x;
                                }
                            }
                        }
                        scroll-event(ev) => {
                            if (!GridEdit.active) { return reject; }
                            if (ev.modifiers.control || ev.modifiers.meta) {
                                if (ev.delta-y != 0) { root.act(ev.delta-y > 0 ? "zoom-in" : "zoom-out"); }
                                return accept;
                            }
                            root.nudge(-(ev.delta-x + ev.delta-y) / self.width * 2.0);
                            accept
                        }
                    }
                    if !root.has-track: Text { text: @tr("Select a track to prepare it"); font-family: Theme.family; font-size: Theme.body; color: Theme.bone-3; }
                }
                HLine { tone: Theme.rule; }
                Rectangle {
                    accessible-role: slider;
                    accessible-label: "player1.overview";
                    height: 40px;
                    background: Theme.ground-band;
                    Image { width: parent.width; height: parent.height; source: root.overview; image-fit: fill; }
                    for c in root.cues: Rectangle {
                        x: parent.width * c.pos;
                        width: 1px;
                        VLine {
                            height: parent.height; weight: c.slot >= 0 ? 2px : 1px;
                            tone: c.slot >= 0 ? Theme.cue-tone(c.slot, c.tone) : Theme.bone;
                            form: c.slot >= 0 ? "solid" : "dashed";
                        }
                        Text { x: 4px; y: 1px; text: c.letter; font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; color: Theme.bone; }
                    }
                    // Edit region: a sodium bar along the top between dashed IN / OUT lines.
                    if root.has-track && TrackEdit.start >= 0 && TrackEdit.end >= 0: Rectangle {
                        accessible-role: text; accessible-label: "player1.edit.span"; accessible-value: TrackEdit.region;
                        x: parent.width * min(TrackEdit.start, TrackEdit.end);
                        width: max(1px, parent.width * abs(TrackEdit.end - TrackEdit.start));
                        y: 0; height: 3px;
                        background: Theme.attention.with-alpha(0.6);
                    }
                    for f in [TrackEdit.start, TrackEdit.end]: Rectangle {
                        visible: root.has-track && f >= 0;
                        x: parent.width * f; width: 1px;
                        VLine { height: parent.height; weight: 1px; tone: Theme.attention; form: "dashed"; }
                    }
                    if root.has-track: Rectangle { x: parent.width * root.cursor - 1px; width: 2px; height: parent.height; background: Theme.bone; }
                    TouchArea {
                        mouse-cursor: crosshair;
                        // Shift-drag selects the edit region; otherwise the cursor follows.
                        property <float> from: -1;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down) {
                                self.from = ev.modifiers.shift ? clamp(self.mouse-x / self.width, 0, 1) : -1;
                            }
                        }
                        clicked => { if (self.from < 0) { root.seek(clamp(self.mouse-x / self.width, 0, 1)); } }
                        moved => {
                            if (self.pressed && self.from >= 0) {
                                TrackEdit.select(self.from, clamp(self.mouse-x / self.width, 0, 1));
                            } else if (self.pressed) {
                                root.seek(clamp(self.mouse-x / self.width, 0, 1));
                            }
                        }
                    }
                }
                PhraseStrip { phrases: root.has-track ? root.phrases : []; can-edit: root.has-track && !root.read-only; cursor: root.cursor; }
            }
        }
        HLine { tone: Theme.rule; }
        // The dock: the tool tabs with the loop and jump keys over the keys of the
        // chosen tool, all on 30 px lines, then CUE / PLAY.
        HorizontalLayout {
            padding: Theme.s2;
            spacing: Theme.s3;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.s2;
                // EDIT GRID: its four rows of keys in place of the tools.
                if GridEdit.active && root.has-track: GridSessionKeys { narrow: PopupPlace.window-width < 1200px; enabled: !GridEdit.locked && !root.read-only; }
                // Tool tabs left, loop and jump keys right.
                if !(GridEdit.active && root.has-track): HorizontalLayout {
                    height: 30px;
                    spacing: Theme.key-gap;
                    Tab { accessible-label: "player1.tab.cue-loop"; height: 30px; label: "CUE / LOOP"; current: root.tool-tab == "cue"; clicked => { root.tool-tab = "cue"; } }
                    Tab { accessible-label: "player1.tab.grid"; height: 30px; label: @tr("GRID"); current: root.tool-tab == "grid"; clicked => { root.tool-tab = "grid"; } }
                    Tab { accessible-label: "player1.tab.phrase"; height: 30px; label: @tr("PHRASE"); current: root.tool-tab == "phrase"; clicked => { root.tool-tab = "phrase"; } }
                    Tab { accessible-label: "player1.tab.edit"; height: 30px; label: @tr("EDIT"); current: root.tool-tab == "edit"; clicked => { root.tool-tab = "edit"; } }
                    Tab { accessible-label: "player1.tab.shift"; height: 30px; label: @tr("TEMPO / KEY"); current: root.tool-tab == "shift"; clicked => { root.tool-tab = "shift"; } }
                    Rectangle { horizontal-stretch: 1; min-width: 16px; }
                    // Narrow: the loop is set with the CUE / LOOP keys below.
                    if !root.narrow: HorizontalLayout {
                        spacing: Theme.s1;
                        Toggle { accessible-label: "player1.loop-in"; accessible-role: button; size: 30px; min-w: 44px; label: "IN"; on: root.loop-in-set; tone: Theme.attention; tooltip: @tr("Loop in point at the playhead (while the track plays)"); enabled: root.has-track; clicked => { root.act("loop-in"); } }
                        Toggle { accessible-label: "player1.loop-out"; accessible-role: button; size: 30px; min-w: 44px; label: "OUT"; on: root.looping; tone: Theme.attention; tooltip: @tr("Loop out point: the loop starts"); enabled: root.has-track; clicked => { root.act("loop-out"); } }
                    }
                    if !root.narrow: Rectangle { width: Theme.s3; }
                    HorizontalLayout {
                        spacing: Theme.s1;
                        Toggle { accessible-label: "player1.jump-back"; accessible-role: button; size: 30px; min-w: 30px; label: "−"; tooltip: @tr("Jump back by the jump size"); clicked => { root.act("jump-back"); } }
                        Toggle { accessible-label: "player1.jump-forward"; accessible-role: button; size: 30px; min-w: 30px; label: "+"; tooltip: @tr("Jump forward by the jump size"); clicked => { root.act("jump-forward"); } }
                        Stepper {
                            accessible-role: spinbox; accessible-label: "player1.jump-size"; accessible-value: root.jump-size;
                            size: 30px; arrow: 22px; font-size: Theme.control; template: "16 S";
                            value: root.jump-size;
                            tooltip: @tr("Jump size of − / +: shorter / longer");
                            step(d) => { root.act(d > 0 ? "jump-size-up" : "jump-size-down"); }
                        }
                    }
                }
                // The keys of the chosen tool.
                if !(GridEdit.active && root.has-track): HorizontalLayout {
                    height: 30px;
                    if root.tool-tab == "cue": VerticalLayout {
                        horizontal-stretch: 1;
                        // The keys centred on the 30 px line.
                        alignment: center;
                        HorizontalLayout {
                            spacing: Theme.s1;
                            for c in root.hot-cues: Pad {
                                accessible-role: button;
                                accessible-label: "player1.hot-cue." + c.letter;
                                accessible-value: c.set ? (c.label != "" ? c.label : c.time) : "";
                                horizontal-stretch: 3; cue: c; pressed => { root.hot-cue(c.slot); } }
                            Rectangle { width: Theme.s2; }
                            PlateButton { accessible-role: button; accessible-label: "player1.memory.set"; horizontal-stretch: 0; compact: true; height: 30px; label: root.narrow ? "" : @tr("MEMORY"); tooltip: @tr("Add a memory cue at the cursor"); glyph: "plus"; enabled: root.has-track && !root.read-only; clicked => { root.add-memory-cue(); } }
                            Toggle { accessible-role: button; accessible-label: "player1.memory.prev"; size: 30px; width: 26px; label: "‹"; tooltip: @tr("Previous cue"); enabled: root.has-track; clicked => { root.act("memory-prev"); } }
                            Toggle { accessible-role: button; accessible-label: "player1.memory.next"; size: 30px; width: 26px; label: "›"; tooltip: @tr("Next cue"); enabled: root.has-track; clicked => { root.act("memory-next"); } }
                            Toggle { accessible-role: button; accessible-label: "player1.memory.delete"; size: 30px; label: @tr("DEL"); tone: Theme.fault; tooltip: @tr("Delete the memory cue at the cursor"); enabled: root.has-track && !root.read-only; clicked => { root.act("memory-delete"); } }
                            Rectangle { width: Theme.s2; }
                            Toggle { accessible-role: checkbox; accessible-checkable: true; accessible-checked: root.looping; accessible-label: "player1.loop.auto"; size: 30px; label: "LOOP"; on: root.looping; tone: Theme.attention; tooltip: @tr("Auto loop of the shown length while the track plays; again to leave"); enabled: root.has-track; clicked => { root.act("loop-auto"); } }
                            Toggle { accessible-role: button; accessible-label: "player1.loop.manual"; size: 30px; label: root.looping ? @tr("EXIT") : root.loop-in-set ? @tr("OUT") : @tr("IN"); armed: root.loop-in-set && !root.looping; tone: Theme.attention; tooltip: @tr("Manual loop: in point, then out point; again to leave"); enabled: root.has-track; clicked => { root.act("loop-manual"); } }
                            Toggle { accessible-role: button; accessible-label: "player1.loop.halve"; size: 30px; width: 26px; label: "½"; tooltip: @tr("Halve the loop"); clicked => { root.act("loop-halve"); } }
                            Rectangle {
                                accessible-role: text; accessible-label: "player1.loop.size"; accessible-value: root.loop-size;
                                width: 34px;
                                background: Theme.plate; border-radius: Theme.r-control;
                                Text { text: root.loop-size; font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.bone; }
                            }
                            Toggle { accessible-role: button; accessible-label: "player1.loop.double"; size: 30px; width: 26px; label: "2×"; tooltip: @tr("Double the loop"); clicked => { root.act("loop-double"); } }
                            Toggle { accessible-role: checkbox; accessible-checkable: true; accessible-checked: root.quantize; accessible-label: "player1.quantize"; size: 30px; width: 28px; label: "Q"; on: root.quantize; tone: Theme.setup-on; tooltip: @tr("Quantize loops and cues to the beat"); clicked => { root.act("quantize"); } }
                            player-menu := ContextMenuArea {
                                width: 28px;
                                Menu {
                                    MenuItem { title: @tr("Analyse again"); enabled: root.has-track && !root.read-only; activated => { root.act("menu:analyse"); } }
                                    MenuItem { title: @tr("Show info"); enabled: root.has-track; activated => { root.act("menu:info"); } }
                                    MenuItem { title: @tr("Show in file manager"); enabled: root.has-track; activated => { root.act("menu:reveal"); } }
                                }
                                Rectangle {
                                    accessible-role: button; accessible-label: "player1.menu";
                                    background: mt.has-hover ? Theme.plate-raised : Theme.plate;
                                    border-width: 1px; border-color: Theme.rule;
                                    Text { text: "⋯"; font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi; color: Theme.bone-2; }
                                    mt := TipArea { tooltip: @tr("More for this track"); mouse-cursor: pointer; clicked => { player-menu.show({ x: 0, y: self.height }); } }
                                }
                            }
                        }
                    }
                    if root.tool-tab == "grid": VerticalLayout {
                        horizontal-stretch: 1;
                        // The keys centred on the 30 px line: EDIT GRID opens the
                        // editor; the quick fixes work on the stored grid.
                        alignment: center;
                        HorizontalLayout {
                            spacing: Theme.s1;
                            PlateButton { accessible-role: button; accessible-label: "player1.grid.edit"; horizontal-stretch: 0; compact: true; height: 30px; label: @tr("EDIT GRID"); tone: Theme.attention; command: "player.grid.edit"; tooltip: @tr("Edit the beatgrid with the kicks in view: move, tempo about the cursor, pins, AUTO-FIX; DONE keeps it"); enabled: !root.grid-locked && !root.read-only && root.has-track; clicked => { GridEdit.start(); } }
                            Rectangle { width: Theme.s2; }
                            Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.nudge-left"; label: "◀ 1"; tooltip: @tr("Grid 1 ms earlier"); command: "player.grid.earlier-fine"; enabled: !root.grid-locked && !root.read-only && root.has-track; clicked => { root.grid-shift(-1); } }
                            Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.nudge-right"; label: "1 ▶"; tooltip: @tr("Grid 1 ms later"); command: "player.grid.later-fine"; enabled: !root.grid-locked && !root.read-only && root.has-track; clicked => { root.grid-shift(1); } }
                            Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.halve"; label: "÷2"; tooltip: @tr("Half the tempo"); command: "player.grid.half"; enabled: !root.grid-locked && !root.read-only && root.has-track; clicked => { root.grid-scale(0.5); } }
                            Toggle { size: 30px; min-w: 44px; accessible-role: button; accessible-label: "player1.grid.double"; label: "×2"; tooltip: @tr("Double the tempo"); command: "player.grid.double"; enabled: !root.grid-locked && !root.read-only && root.has-track; clicked => { root.grid-scale(2.0); } }
                            Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.downbeat"; label: @tr("SET 1 HERE"); tooltip: @tr("The beat at the cursor becomes the 1 and sits on its kick"); command: "player.grid.downbeat"; enabled: !root.grid-locked && !root.read-only && root.has-track; clicked => { root.grid-downbeat(); } }
                            Rectangle { horizontal-stretch: 1; }
                            // Narrow: the source, UNDO and REDO give way (EDIT GRID has its own).
                            if !root.narrow: Caps { accessible-role: text; accessible-label: "player1.grid.source-tab"; accessible-value: self.text; text: root.grid-source; font-size: Theme.label; vertical-alignment: center; }
                            if !root.narrow: Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.undo"; label: @tr("UNDO"); tooltip: @tr("Undo the last change"); command: "library.undo"; enabled: !root.read-only; clicked => { root.act("undo"); } }
                            if !root.narrow: Toggle { size: 30px; accessible-role: button; accessible-label: "player1.grid.redo"; label: @tr("REDO"); tooltip: @tr("Redo"); command: "library.redo"; enabled: !root.read-only; clicked => { root.act("redo"); } }
                            Toggle { size: 30px; accessible-role: checkbox; accessible-label: "player1.grid.lock"; accessible-checkable: true; accessible-checked: root.grid-locked; label: root.grid-locked ? @tr("GRID LOCKED") : @tr("LOCK GRID"); on: root.grid-locked; tone: Theme.attention; command: "player.grid.lock"; enabled: !root.read-only && root.has-track; clicked => { root.grid-lock(); } }
                        }
                    }
                    if root.tool-tab == "phrase": VerticalLayout {
                        horizontal-stretch: 1;
                        // The keys centred on the 30 px line.
                        alignment: center;
                        HorizontalLayout {
                            spacing: Theme.s1;
                            property <bool> can-edit: root.has-track && !root.read-only;
                            for k[i] in PhraseEdit.kinds: Toggle { size: 30px;
                                accessible-role: button; accessible-label: "player1.phrase.kind" + i;
                                accessible-checkable: true; accessible-checked: PhraseEdit.current == k;
                                label: k; on: PhraseEdit.current == k; enabled: parent.can-edit;
                                tooltip: @tr("The phrase at the cursor becomes this kind (in a gap: a new phrase)");
                                clicked => { PhraseEdit.kind(i); }
                            }
                            Rectangle { width: Theme.s2; }
                            Toggle { size: 30px; accessible-role: button; accessible-label: "player1.phrase.cut"; label: @tr("CUT"); command: "player.phrase.cut"; tooltip: @tr("Split the phrase at the cursor (on the nearest bar)"); enabled: parent.can-edit; clicked => { PhraseEdit.cut(); } }
                            Toggle { size: 30px; accessible-role: button; accessible-label: "player1.phrase.merge"; label: @tr("MERGE"); command: "player.phrase.merge"; tooltip: @tr("Join the phrase at the cursor with the next one"); enabled: parent.can-edit; clicked => { PhraseEdit.merge(); } }
                            Toggle { size: 30px; accessible-role: button; accessible-label: "player1.phrase.boundary"; label: @tr("BOUNDARY TO CURSOR"); command: "player.phrase.boundary"; tooltip: @tr("Move the nearest phrase boundary to the cursor (on the nearest bar)"); enabled: parent.can-edit; clicked => { PhraseEdit.boundary(); } }
                            // [62] An unsure phrase at the cursor says so, in
                            // the unsure-key language: half sodium line, sodium text.
                            if PhraseEdit.current-sure != "": VerticalLayout {
                                alignment: center;
                                VLine { height: 14px; weight: 2px; tone: Theme.attention; form: "half"; }
                            }
                            Caps {
                                accessible-role: text; accessible-label: "player1.phrase.hint"; accessible-value: self.text;
                                accessible-description: PhraseEdit.current-sure != "" ? "unsure" : "";
                                horizontal-stretch: 1; min-width: 0;
                                text: PhraseEdit.current-sure != ""
                                    ? @tr("UNSURE {}: PICK ITS TYPE TO CONFIRM", PhraseEdit.current-sure)
                                    : @tr("OR ON THE STRIP: CLICK A PHRASE FOR ITS TYPE, DRAG AN EDGE");
                                color: PhraseEdit.current-sure != "" ? Theme.attention : Theme.bone-3;
                                font-size: Theme.control; vertical-alignment: center; horizontal-alignment: center; overflow: elide;
                            }
                            Toggle { size: 30px; accessible-role: button; accessible-label: "player1.phrase.clear"; label: @tr("CLEAR"); command: "player.phrase.clear"; tone: Theme.fault; tooltip: @tr("Remove all phrases of this track"); enabled: parent.can-edit; clicked => { PhraseEdit.clear(); } }
                        }
                    }
                    if root.tool-tab == "shift": VerticalLayout {
                        horizontal-stretch: 1;
                        // Hear the track at another tempo or key; the keys
                        // centred on the 30 px line. Nothing is stored.
                        alignment: center;
                        HorizontalLayout {
                            spacing: Theme.s2;
                            Caps { text: @tr("TEMPO"); font-size: Theme.label; vertical-alignment: center; }
                            Stepper {
                                a11y-prev: "player1.shift.tempo-down"; a11y-value: "player1.shift.tempo"; a11y-next: "player1.shift.tempo-up";
                                size: 30px; arrow: 22px; font-size: Theme.control; template: "+16 %"; value: root.shift-tempo;
                                lit: root.shift-tempo != "0 %"; tone: Theme.attention; enabled: root.has-track;
                                tooltip: @tr("Preview at another tempo (the key stays); the track and its analysis are not changed");
                                step(d) => { root.act(d > 0 ? "shift-tempo-up" : "shift-tempo-down"); }
                            }
                            Rectangle { width: Theme.s2; }
                            Caps { text: @tr("KEY"); font-size: Theme.label; vertical-alignment: center; }
                            Stepper {
                                a11y-prev: "player1.shift.key-down"; a11y-value: "player1.shift.key"; a11y-next: "player1.shift.key-up";
                                size: 30px; arrow: 22px; font-size: Theme.control; template: "+12"; value: root.shift-key;
                                lit: root.shift-key != "0"; tone: Theme.attention; enabled: root.has-track;
                                tooltip: @tr("Preview in another key, in semitones; the track and its analysis are not changed");
                                step(d) => { root.act(d > 0 ? "shift-key-up" : "shift-key-down"); }
                            }
                            Text {
                                accessible-role: text; accessible-label: "player1.shift.result"; accessible-value: self.text;
                                text: root.shift-result; font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
                                color: Theme.bone-2; vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Toggle {
                                size: 30px; accessible-role: button; accessible-label: "player1.shift.reset";
                                label: @tr("RESET"); tooltip: @tr("Back to the original tempo and key");
                                enabled: root.shift-tempo != "0 %" || root.shift-key != "0";
                                clicked => { root.act("shift-reset"); }
                            }
                        }
                    }
                    if root.tool-tab == "edit": VerticalLayout {
                        horizontal-stretch: 1;
                        // The keys centred on the 30 px line.
                        alignment: center;
                        HorizontalLayout {
                            spacing: Theme.s1;
                            property <bool> can-edit: root.has-track && !root.read-only && !TrackEdit.busy;
                            Toggle { size: 30px; accessible-role: button; accessible-label: "player1.edit.in"; label: "IN"; command: "player.edit.in"; tooltip: @tr("Region start at the cursor (or shift-drag on the overview)"); enabled: parent.can-edit; on: TrackEdit.start >= 0; clicked => { TrackEdit.mark-in(); } }
                            Toggle { size: 30px; accessible-role: button; accessible-label: "player1.edit.out"; label: "OUT"; command: "player.edit.out"; tooltip: @tr("Region end at the cursor (or shift-drag on the overview)"); enabled: parent.can-edit; on: TrackEdit.end >= 0; clicked => { TrackEdit.mark-out(); } }
                            Caps {
                                accessible-role: text; accessible-label: "player1.edit.region"; accessible-value: TrackEdit.region;
                                min-width: 190px;
                                text: TrackEdit.busy ? @tr("RENDERING…") : TrackEdit.region == "" ? @tr("SET IN AND OUT") : TrackEdit.region;
                                font-size: Theme.control; vertical-alignment: center; horizontal-alignment: center;
                            }
                            Toggle { size: 30px; accessible-role: button; accessible-label: "player1.edit.cut"; label: @tr("CUT OUT"); command: "player.edit.cut"; tooltip: @tr("New file without the region"); enabled: parent.can-edit && TrackEdit.ready; clicked => { TrackEdit.apply("cut"); } }
                            Toggle { size: 30px; accessible-role: button; accessible-label: "player1.edit.trim"; label: @tr("TRIM"); command: "player.edit.trim"; tooltip: @tr("New file with only the region"); enabled: parent.can-edit && TrackEdit.ready; clicked => { TrackEdit.apply("trim"); } }
                            Toggle { size: 30px; accessible-role: button; accessible-label: "player1.edit.repeat"; label: @tr("REPEAT"); command: "player.edit.repeat"; tooltip: @tr("New file with the region played twice"); enabled: parent.can-edit && TrackEdit.ready; clicked => { TrackEdit.apply("repeat"); } }
                            Rectangle { horizontal-stretch: 1; }
                            Caps { text: @tr("NEW FILE · ORIGINAL KEPT"); font-size: Theme.label; vertical-alignment: center; }
                            Toggle { size: 30px; accessible-role: button; accessible-label: "player1.edit.clear"; label: @tr("CLEAR"); tone: Theme.fault; tooltip: @tr("Forget the region"); enabled: TrackEdit.start >= 0 || TrackEdit.end >= 0; clicked => { TrackEdit.clear(); } }
                        }
                    }
                }
            }
            VLine { weight: 1px; tone: Theme.rule; }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: Theme.s2;
                    Transport { accessible-label: "player1.cue"; accessible-role: button; kind: "cue"; tone: Theme.attention; size: 52px; clicked => { root.jump-start(); } }
                    Transport { accessible-label: "player1.play"; accessible-role: button; accessible-checkable: true; accessible-checked: root.previewing; kind: "play"; on: root.previewing; tone: Theme.live; size: 52px; clicked => { root.toggle-preview(); } }
                }
            }
        }
    }
    DropZone { width: parent.width; height: parent.height; id: -1; }
}

// A compact player: title line, readings and the overview with its cursor,
// CUE / PLAY on the left. Used for player 2 in the 2-player layouts, for
// both players in DUAL and for player 1 in SIMPLE.
export struct MiniView {
    has-track: bool,
    title: string,
    artist: string,
    bpm: string,
    key: string,
    position: string,
    overview: image,
    cursor: float,
    previewing: bool,
    // Time left, rating as stars, cover art (player 1).
    remaining: string,
    rating: string,
    has-artwork: bool,
    artwork: image,
}

export component MiniPlayer inherits Rectangle {
    // 1 or 2: the accessible labels are `player<index>.*`.
    in property <int> index: 2;
    in property <MiniView> view;
    // Player 2 offers LOAD (the selected track of the browser).
    in property <bool> can-load: root.index == 2;
    callback seek(float);
    // "play", "cue" or "load".
    callback act(string);
    property <string> p: "player\{root.index}";
    // SIMPLE layout: everything on one line.
    in property <bool> single-line;
    // Two players side by side on a narrow window: the read-outs that
    // matter, tighter.
    property <bool> narrow: PopupPlace.window-width < 1200px;
    background: Theme.ground-band; border-radius: Theme.r-panel;
    min-height: root.single-line ? 48px : 110px;
    if root.single-line: HorizontalLayout {
        padding-left: Theme.s3; padding-right: Theme.s3; padding-top: Theme.s2; padding-bottom: Theme.s2;
        spacing: Theme.s3;
        VerticalLayout { alignment: center; Transport { accessible-label: root.p + ".play"; accessible-role: button; accessible-checkable: true; accessible-checked: root.view.previewing; kind: "play"; on: root.view.previewing; tone: Theme.live; size: 32px; clicked => { root.act("play"); } } }
        VerticalLayout { alignment: center; Rectangle {
            accessible-role: image; accessible-label: root.p + ".artwork"; accessible-value: root.view.has-artwork ? "cover" : "none";
            width: 30px; height: 30px;
            background: Theme.plate; border-width: root.view.has-artwork ? 0px : 1px; border-color: Theme.rule;
            if root.view.has-artwork: Image { width: parent.width; height: parent.height; source: root.view.artwork; image-fit: cover; }
        } }
        Text {
            accessible-role: text; accessible-label: root.p + ".title"; accessible-value: self.text;
            width: 220px;
            text: root.view.has-track ? root.view.title : @tr("No track selected");
            font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi; vertical-alignment: center;
            color: root.view.has-track ? Theme.bone : Theme.bone-3; overflow: elide;
        }
        Rectangle {
            accessible-role: slider; accessible-label: root.p + ".overview";
            accessible-value: round(root.view.cursor * 100) + "%";
            horizontal-stretch: 1;
            background: Theme.ground-band;
            Image { width: parent.width; height: parent.height; source: root.view.overview; image-fit: fill; }
            if root.view.has-track: Rectangle { x: parent.width * root.view.cursor - 1px; width: 2px; height: parent.height; background: Theme.bone; }
            TouchArea {
                mouse-cursor: crosshair;
                clicked => { root.seek(clamp(self.mouse-x / self.width, 0, 1)); }
                moved => { if (self.pressed) { root.seek(clamp(self.mouse-x / self.width, 0, 1)); } }
            }
        }
        Reading { a11y-label: root.p + ".time-remaining"; label: @tr("REMAIN"); template: "-00:00"; value: root.view.remaining; }
        Reading { a11y-label: root.p + ".bpm"; label: "BPM"; template: "000.00"; value: root.view.bpm; }
        Text {
            accessible-role: text; accessible-label: root.p + ".rating"; accessible-value: self.text;
            text: root.view.has-track ? root.view.rating : "☆☆☆☆☆";
            font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center;
        }
    }
    if !root.single-line: HorizontalLayout {
        VerticalLayout {
            width: 84px;
            padding: Theme.s2;
            spacing: Theme.s2;
            alignment: center;
            HorizontalLayout { alignment: center; Transport { accessible-label: root.p + ".cue"; accessible-role: button; kind: "cue"; tone: Theme.attention; size: 36px; clicked => { root.act("cue"); } } }
            HorizontalLayout { alignment: center; Transport { accessible-label: root.p + ".play"; accessible-role: button; accessible-checkable: true; accessible-checked: root.view.previewing; kind: "play"; on: root.view.previewing; tone: Theme.live; size: 36px; clicked => { root.act("play"); } } }
        }
        VLine { weight: 1px; tone: Theme.rule; }
        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: root.narrow ? Theme.s2 : Theme.s3; padding-right: root.narrow ? Theme.s2 : Theme.s3; padding-top: Theme.s2; padding-bottom: Theme.s2;
            spacing: Theme.s2;
            HorizontalLayout {
                height: 28px;
                spacing: root.narrow ? Theme.s2 : Theme.s4;
                Caps { text: "\{root.index}"; color: Theme.deck-color(root.index); vertical-alignment: center; }
                Text {
                    accessible-role: text; accessible-label: root.p + ".title"; accessible-value: self.text;
                    horizontal-stretch: 2;
                    text: root.view.has-track ? root.view.title : (root.can-load ? @tr("Empty — select a track and press LOAD, or drag it here") : @tr("No track selected"));
                    font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi; vertical-alignment: center;
                    color: root.view.has-track ? Theme.bone : Theme.bone-3; overflow: elide;
                }
                if !root.narrow: Text { accessible-role: text; accessible-label: root.p + ".artist"; accessible-value: self.text; horizontal-stretch: 1; text: root.view.artist; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                if !root.narrow: Reading { a11y-label: root.p + ".time-elapsed"; label: @tr("POS"); template: "00:00.000"; value: root.view.position; }
                Reading { a11y-label: root.p + ".bpm"; label: "BPM"; template: "000.00"; value: root.view.bpm; }
                Reading { a11y-label: root.p + ".key"; label: @tr("KEY"); template: "12A"; value: root.view.key; }
                if root.can-load: PlateButton {
                    accessible-label: root.p + ".load"; accessible-role: button; horizontal-stretch: 0; compact: true;
                    label: @tr("LOAD"); tone: Theme.deck-color(root.index);
                    tooltip: @tr("Load the selected track into this player");
                    clicked => { root.act("load"); }
                }
            }
            Rectangle {
                accessible-role: slider; accessible-label: root.p + ".overview";
                accessible-value: round(root.view.cursor * 100) + "%";
                vertical-stretch: 1;
                min-height: 36px;
                background: Theme.ground-band;
                Image { width: parent.width; height: parent.height; source: root.view.overview; image-fit: fill; }
                if root.view.has-track: Rectangle { x: parent.width * root.view.cursor - 1px; width: 2px; height: parent.height; background: Theme.bone; }
                TouchArea {
                    mouse-cursor: crosshair;
                    clicked => { root.seek(clamp(self.mouse-x / self.width, 0, 1)); }
                    moved => { if (self.pressed) { root.seek(clamp(self.mouse-x / self.width, 0, 1)); } }
                }
            }
        }
    }
    // Tracks dragged from the list load here (player 2) or show (player 1).
    DropZone { width: parent.width; height: parent.height; id: -root.index; }
}
