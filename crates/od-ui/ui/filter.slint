// Quick filter bar under the track table header: BPM range, key and tempo
// relative to the master deck, minimum rating and one tag value.

import { Theme } from "tokens.slint";
import { VLine } from "lines.slint";
import { Caps, Field, LineToggle, PlateButton, Star, TipArea, KeyFocus, TooltipState } from "controls.slint";
import { FilterView } from "structs.slint";

export component FilterBar inherits Rectangle {
    in property <FilterView> filter;
    // "Category: Value" entries of the Tags menu.
    in property <[string]> user-tags;
    // (field, value): "bpm-min", "bpm-max", "pct", "key" ("1" / ""),
    // "rating" (0..5), "user-tag" ("" = any), "clear".
    callback edit(string, string);
    height: 40px;
    accessible-id: "browser.filter"; accessible-role: groupbox;

    tag-menu := ContextMenuArea {
        Menu {
            MenuItem { title: @tr("Any Tags"); activated => { root.edit("user-tag", ""); } }
            for t in root.user-tags: MenuItem { title: t; activated => { root.edit("user-tag", t); } }
        }
    }
    HorizontalLayout {
        padding-left: Theme.s4;
        padding-right: Theme.s3;
        padding-top: Theme.s2;
        padding-bottom: Theme.s2;
        spacing: Theme.s3;
        Caps { text: "BPM"; vertical-alignment: center; }
        min := Field {
            accessible-id: "browser.filter.bpm-min"; accessible-role: text-input; accessible-value: self.text;
            width: 70px; height: 28px;
            placeholder: @tr("FROM");
            text: root.filter.bpm-min;
            edited(t) => { root.edit("bpm-min", t); }
        }
        max := Field {
            accessible-id: "browser.filter.bpm-max"; accessible-role: text-input; accessible-value: self.text;
            width: 70px; height: 28px;
            placeholder: @tr("TO");
            text: root.filter.bpm-max;
            edited(t) => { root.edit("bpm-max", t); }
        }
        VLine { width: 1px; tone: Theme.rule; }
        LineToggle {
            accessible-id: "browser.filter.key-master"; accessible-role: checkbox;
            accessible-checkable: true; accessible-checked: self.checked;
            label: @tr("Key fits master");
            tooltip: @tr("Only keys compatible with the master deck (same, ±1, relative)");
            checked: root.filter.key-match;
            tone: Theme.w546;
            toggled(v) => { root.edit("key", v ? "1" : ""); }
        }
        pct := Field {
            accessible-id: "browser.filter.bpm-pct"; accessible-role: text-input; accessible-value: self.text;
            width: 86px; height: 28px;
            placeholder: @tr("BPM ±%");
            text: root.filter.bpm-pct;
            edited(t) => { root.edit("pct", t); }
        }
        Caps {
            accessible-id: "browser.filter.reference"; accessible-role: text; accessible-value: self.text;
            text: root.filter.reference == "" ? @tr("NO MASTER DECK") : root.filter.reference;
            vertical-alignment: center;
            color: root.filter.reference == "" ? Theme.bone-3 : Theme.bone-2;
        }
        VLine { width: 1px; tone: Theme.rule; }
        Caps { text: @tr("RATING"); vertical-alignment: center; }
        HorizontalLayout {
            spacing: Theme.s1;
            padding-top: Theme.s2; padding-bottom: Theme.s2;
            for i in 5: VerticalLayout {
                alignment: center;
                Star {
                    accessible-id: "browser.filter.rating\{i + 1}"; accessible-role: button;
                    lit: i < root.filter.rating;
                    TouchArea {
                        x: -2px; width: parent.width + 4px; y: -6px; height: parent.height + 12px;
                        mouse-cursor: pointer;
                        clicked => { root.edit("rating", i + 1 == root.filter.rating ? "0" : "\{i + 1}"); }
                    }
                }
            }
        }
        VLine { width: 1px; tone: Theme.rule; }
        tag := PlateButton {
            accessible-id: "browser.filter.user-tag"; accessible-role: button;
            compact: true;
            label: root.filter.user-tag == "" ? @tr("TAGS: ANY") : root.filter.user-tag;
            tone: Theme.w436;
            active: root.filter.user-tag != "";
            tooltip: @tr("Only tracks with this tag value");
            clicked => { tag-menu.show({ x: self.x, y: self.y + self.height }); }
        }
        VLine { width: 1px; tone: Theme.rule; }
        LineToggle {
            accessible-id: "browser.filter.unplayed"; accessible-role: checkbox;
            accessible-checkable: true; accessible-checked: self.checked;
            label: @tr("Not played tonight");
            tooltip: @tr("Leave out the tracks that were on air in this session");
            checked: root.filter.unplayed;
            tone: Theme.live;
            toggled(v) => { root.edit("unplayed", v ? "1" : ""); }
        }
        Rectangle { horizontal-stretch: 1; }
        PlateButton {
            accessible-id: "browser.filter.clear"; accessible-role: button;
            compact: true;
            label: @tr("CLEAR");
            enabled: root.filter.active;
            tooltip: @tr("Remove every filter condition");
            clicked => {
                min.text = "";
                max.text = "";
                pct.text = "";
                root.edit("clear", "");
            }
        }
    }
}

// The active conditions as chips over the list ([26]): each names its
// condition and a click on it (or its ×) removes it; CLEAR removes all.
// Shown whether the filter bar is open or not, so a narrowed list is never
// a surprise.
export component FilterChips inherits HorizontalLayout {
    in property <FilterView> filter;
    callback edit(string, string);
    accessible-role: list;
    accessible-id: "browser.filter.chips";
    accessible-item-count: root.filter.chips.length;
    spacing: Theme.s1;
    alignment: start;
    height: 26px;
    Caps { text: @tr("FILTERED BY"); vertical-alignment: center; }
    Rectangle { width: Theme.s1; }
    for c[i] in root.filter.chips: Rectangle {
        accessible-role: button;
        accessible-id: "browser.filter.chip\{i}";
        accessible-value: c.text;
        accessible-action-default => { root.edit(c.field, ""); }
        y: 1px; height: 24px;
        width: t.preferred-width + 34px;
        border-radius: Theme.r-control;
        // On: the condition is filled in sodium, its × lifts on hover.
        background: Theme.attention;
        t := Text {
            x: 10px; height: parent.height;
            text: c.text;
            font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: 1.2px;
            color: Theme.ink-on;
            vertical-alignment: center;
        }
        Rectangle {
            x: parent.width - 22px; y: 4px; width: 16px; height: 16px; border-radius: Theme.r-control;
            background: ta.has-hover ? Theme.ground.with-alpha(0.25) : transparent;
            Rectangle { x: 4px; y: 4px; width: 8px; height: 8px;
                Path { width: 8px; height: 8px; viewbox-width: 10; viewbox-height: 10; stroke: Theme.ink-on; stroke-width: 1.5px; commands: "M 1 1 L 9 9 M 9 1 L 1 9"; }
            }
        }
        ta := TipArea { tooltip: @tr("Remove this condition"); mouse-cursor: pointer; clicked => { root.edit(c.field, ""); } }
    }
    PlateButton {
        accessible-id: "browser.filter.clear-all"; accessible-role: button;
        compact: true; label: @tr("CLEAR"); tooltip: @tr("Remove every condition");
        clicked => { root.edit("clear", ""); }
    }
}
