// Preferences: a separate window (categories on a panel surface on the
// left, the page on the right), in the state language of DESIGN.md: the
// current category and each chosen value are filled, switches are filled
// tracks, sections start on a band of the panel surface, and the View page
// previews what its settings change.

import { Theme } from "tokens.slint";
import { VLine, HLine } from "lines.slint";
import { Caps, PlateButton, Field, Glyph, TipArea, TooltipState, KeyFocus } from "controls.slint";
import { TooltipLayer } from "tooltip.slint";
import { ComboBox } from "std-widgets.slint";

export struct KeyRow {
    // Empty for group headers.
    id: string,
    title: string,
    binding: string,
    // "PREPARE", "PERFORM" or empty (everywhere).
    scope: string,
    custom: bool,
    header: bool,
}

// One control in the controller self-test.
export struct SelfTestRow {
    name: string,
    // "verified", "partial", "untested".
    status: string,
    // Its MIDI message arrived since START.
    seen: bool,
}

// One category on the left rail.
component Category inherits Rectangle {
    // The spoken name (readable, translated; the test id is `accessible-id`).
    accessible-label: TooltipState.name-for(self.accessible-id, root.label, "");
    in property <string> label;
    in property <bool> current;
    callback clicked();
    accessible-role: tab;
    accessible-item-selectable: true;
    accessible-item-selected: root.current;
    height: 34px;
    border-radius: Theme.r-control;
    background: root.current ? Theme.bone : touch.has-hover ? Theme.plate-raised : transparent;
    Text {
        x: 16px; height: parent.height;
        text: root.label;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; letter-spacing: 2.2px;
        color: root.current ? Theme.ground : Theme.bone-2;
        vertical-alignment: center;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A section heading on a page.
// Each section starts on a band of the panel surface (no outline).
component Heading inherits VerticalLayout {
    in property <string> text;
    in property <string> note;
    // Accessible label of the heading text (test hook; empty: none).
    in property <string> a11y;
    padding-top: Theme.s3;
    padding-bottom: Theme.s1;
    Rectangle {
        background: Theme.ground-band;
        border-radius: Theme.r-control;
        HorizontalLayout {
            padding-left: Theme.s3; padding-right: Theme.s3; padding-top: Theme.s1; padding-bottom: Theme.s1;
            spacing: Theme.s3;
            Text { accessible-id: root.a11y; text: root.text; font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi; color: Theme.bone; vertical-alignment: center; }
            if root.note != "": Caps { text: root.note; color: Theme.attention; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

// A labelled setting row.
component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: Theme.s4;
    // At least 30 px, and never less than its control needs (a min-height
    // on the row itself would override what its children need).
    VerticalLayout {
        min-height: 30px;
        // Narrow window: the label column gives way first (its text wraps).
        min-width: 96px; preferred-width: 190px; max-width: 190px;
        horizontal-stretch: 0;
        padding-top: Theme.s1;
        Text {
            text: root.label;
            font-family: Theme.family; font-size: Theme.body; color: Theme.bone-2;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
    }
    @children
}

// One of several values, as outlined plates side by side.
// A row of colours to choose from.
component Swatches inherits HorizontalLayout {
    in property <string> key;
    in property <[color]> colours;
    in property <int> selected;
    callback picked(int);
    spacing: Theme.s2;
    alignment: start;
    for c[i] in root.colours: Rectangle {
        accessible-role: button;
        accessible-id: root.key + "." + i;
        accessible-checkable: true;
        accessible-checked: i == root.selected;
        accessible-action-default => { root.picked(i); }
        width: 24px;
        height: 24px;
        background: c;
        border-width: i == root.selected ? 2px : 1px;
        border-color: i == root.selected ? Theme.bone : touch.has-hover ? Theme.bone-2 : Theme.rule-strong;
        touch := TouchArea { clicked => { root.picked(i); } }
    }
}

// The plates wrap onto a second line when the row is narrow.
component Choice inherits HorizontalLayout {
    // The setting it chooses (the row's label), its spoken name.
    in property <string> name;
    accessible-label: root.name;
    in property <[string]> options;
    in property <int> selected;
    callback picked(int);
    accessible-role: combobox;
    accessible-value: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "";
    // One segmented control: its keys touch (DESIGN.md, Buttons).
    spacing: Theme.key-gap;
    alignment: start;
    for o[i] in root.options: PlateButton {
        compact: true;
        label: o;
        selected: i == root.selected;
        clicked => { root.picked(i); }
    }
}

// Long choices one under the other (they would not fit side by side in
// German in a small window).
component ChoiceStack inherits VerticalLayout {
    // The setting it chooses (the row's label), its spoken name.
    in property <string> name;
    accessible-label: root.name;
    in property <[string]> options;
    in property <int> selected;
    callback picked(int);
    accessible-role: combobox;
    accessible-value: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "";
    // One segmented control: its keys touch (DESIGN.md, Buttons).
    spacing: Theme.key-gap;
    for o[i] in root.options: PlateButton {
        compact: true;
        label: o;
        selected: i == root.selected;
        clicked => { root.picked(i); }
    }
}

// An on / off setting: a line that is solid when on, half when off.
component Switch inherits Rectangle {
    // The spoken name (readable, translated; the test id is `accessible-id`).
    accessible-label: TooltipState.name-for(self.accessible-id, root.label, "");
    in property <string> label;
    in property <bool> on;
    callback toggled(bool);
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.on;
    height: 28px;
    // A narrow row elides the text; the tooltip then shows it whole.
    min-width: 120px;
    preferred-width: probe.preferred-width + 44px;
    probe := Text { visible: false; text: root.label; font-family: Theme.family; font-size: Theme.body; }
    property <bool> elided: root.width < probe.preferred-width + 34px;
    // A filled track with a thumb (DESIGN.md, Toggles and status lines).
    Rectangle {
        x: 0; y: (parent.height - 14px) / 2; width: 26px; height: 14px; border-radius: 7px;
        background: root.on ? Theme.live : Theme.plate-raised;
        Rectangle {
            y: (parent.height - 10px) / 2; x: root.on ? parent.width - self.width - 2px : 2px;
            width: 10px; height: 10px; border-radius: 5px; background: root.on ? Theme.ink-on : Theme.bone-3;
            animate x { duration: Theme.t-toggle; easing: Theme.ease; }
        }
    }
    t := Text {
        x: 34px; width: parent.width - 34px; height: parent.height;
        text: root.label;
        font-family: Theme.family; font-size: Theme.body; overflow: elide;
        color: root.on ? Theme.bone : Theme.bone-2;
        vertical-alignment: center;
    }
    TipArea { tooltip: root.elided ? root.label : ""; mouse-cursor: pointer; clicked => { root.toggled(!root.on); } }
}

// A choice among many (devices): one line per option.
component RadioList inherits VerticalLayout {
    in property <[string]> options;
    in property <int> selected;
    callback picked(int);
    accessible-role: list;
    accessible-value: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "";
    alignment: start;
    for o[i] in root.options: Rectangle {
        height: 26px;
        background: ta.has-hover ? Theme.ground-band : transparent;
        VLine { x: 2px; y: 5px; height: parent.height - 10px; weight: 2px; tone: i == root.selected ? Theme.attention : Theme.rule-strong; form: i == root.selected ? "double" : "half"; }
        Text {
            x: 16px; width: parent.width - 20px; height: parent.height;
            text: o; overflow: elide;
            font-family: Theme.family; font-size: Theme.body;
            color: i == root.selected ? Theme.bone : Theme.bone-2;
            vertical-alignment: center;
        }
        ta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
    }
}

// A compact plate that keeps its size in a row.
component Button inherits VerticalLayout {
    // The spoken name (readable, translated; the test id is `accessible-id`).
    accessible-role: button;
    accessible-label: TooltipState.name-for(self.accessible-id, root.label, root.tooltip);
    accessible-description: root.tooltip;
    in property <string> label;
    in property <color> tone: Theme.bone-3;
    in property <string> tooltip;
    // Test / screen-reader identifier of the plate (empty: none).
    in property <string> a11y-label;
    callback clicked();
    horizontal-stretch: 0;
    alignment: center;
    PlateButton { accessible-role: button; accessible-id: root.a11y-label; compact: true; label: root.label; tone: root.tone; tooltip: root.tooltip; clicked => { root.clicked(); } }
}

// Plain explanatory text.
component Note inherits Text {
    font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3;
    wrap: word-wrap;
}

// Previews of the View page ([48]): drawn with the same tokens and
// renderer as the app, so a change shows at once.
// The waveform: colours, calm mode, playhead and beat lines.
component PreviewWave inherits VerticalLayout {
    in property <image> wave;
    in property <bool> calm;
    spacing: Theme.s1;
    Rectangle {
        accessible-role: image; accessible-id: "prefs.view.preview.wave";
        accessible-value: root.calm ? "calm" : "standard";
        height: 60px; background: Theme.ground; clip: true;
        for b in 16: Rectangle {
            x: parent.width * (b + 0.5) / 16; width: 1px;
            y: root.calm ? 0px : 0px; height: root.calm ? 6px : parent.height;
            background: root.calm ? Theme.rule : Theme.rule-strong;
        }
        for b in 16: Rectangle {
            visible: root.calm;
            x: parent.width * (b + 0.5) / 16; width: 1px;
            y: parent.height - 6px; height: 6px; background: Theme.rule;
        }
        Image { width: parent.width; height: parent.height; source: root.wave; image-fit: fill; }
        // Playhead: crisp bone between dark rims when calm, doubled sodium otherwise.
        if root.calm: Rectangle { x: parent.width / 2 - 1.5px; width: 3px; height: parent.height; background: Theme.ground; }
        if root.calm: Rectangle { x: parent.width / 2 - 0.5px; width: 1px; height: parent.height; background: Theme.bone; }
        if !root.calm: Rectangle { x: parent.width / 2 - 3.5px; width: 2px; height: parent.height; background: Theme.attention; }
        if !root.calm: Rectangle { x: parent.width / 2 + 1.5px; width: 2px; height: parent.height; background: Theme.attention; }
    }
    Caps { text: root.calm ? @tr("CALM WAVEFORM") : @tr("WAVEFORM"); height: 16px; }
}

// Deck colours with their numerals and the status lines: they follow the
// colour-blind palette and the contrast at once.
component PreviewColours inherits VerticalLayout {
    accessible-role: groupbox; accessible-id: "prefs.view.preview.colours";
    spacing: Theme.s1;
    HorizontalLayout {
        height: 26px; spacing: Theme.s2;
        for d in 4: HorizontalLayout {
            spacing: Theme.s1;
            Rectangle { width: 2px; background: Theme.deck-color(d + 1); }
            Text { text: d + 1; font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.deck-color(d + 1); vertical-alignment: center; }
        }
    }
    HorizontalLayout {
        height: 26px; spacing: Theme.s2;
        VLine { tone: Theme.live; form: "solid"; }
        Caps { text: @tr("LIVE"); vertical-alignment: center; }
        VLine { tone: Theme.attention; form: "dashed"; }
        Caps { text: @tr("WAIT"); vertical-alignment: center; }
        VLine { tone: Theme.fault; form: "struck"; }
        Caps { text: @tr("FAULT"); vertical-alignment: center; }
    }
    Caps { text: @tr("COLOURS"); height: 16px; }
}

// A reading at the chosen interface scale.
component PreviewScale inherits VerticalLayout {
    in property <float> scale;
    accessible-role: text; accessible-id: "prefs.view.preview.scale";
    accessible-value: Math.round(root.scale * 100) + " %";
    spacing: Theme.s1;
    Rectangle {
        height: 60px; clip: true;
        Text {
            x: 0; height: parent.height;
            text: "124.00";
            font-family: Theme.family; font-weight: Theme.weight-semi;
            font-size: Theme.heading * min(2, max(0.75, root.scale));
            color: Theme.bone; vertical-alignment: center;
        }
    }
    Caps { text: @tr("SCALE {} %", Math.round(root.scale * 100)); height: 16px; }
}

// The deck layout as a plan (0 Simple, 1 Standard, 2 Full).
component PreviewLayout inherits VerticalLayout {
    in property <int> layout;
    accessible-role: image; accessible-id: "prefs.view.preview.layout";
    accessible-value: root.layout == 0 ? "simple" : root.layout == 2 ? "full" : "standard";
    spacing: Theme.s1;
    Rectangle {
        height: 60px; background: Theme.ground; border-radius: Theme.r-control;
        // Pads: two rows of four.
        for p in 8: Rectangle {
            x: 6px + Math.mod(p, 4) * (root.layout == 0 ? 15px : 11px);
            y: (root.layout == 0 ? 8px : 30px) + Math.floor(p / 4) * (root.layout == 0 ? 15px : 11px);
            width: root.layout == 0 ? 13px : 9px; height: self.width;
            background: Theme.plate-raised; border-radius: 2px;
        }
        // Platter (Standard and Full).
        if root.layout != 0: Rectangle {
            x: 6px; y: 4px; width: 22px; height: 22px; border-radius: 11px;
            border-width: 2px; border-color: Theme.bone-3;
        }
        // Setup keys (Standard and Full).
        if root.layout != 0: Rectangle { x: 32px; y: 6px; width: 16px; height: 5px; background: Theme.plate; }
        if root.layout != 0: Rectangle { x: 32px; y: 14px; width: 16px; height: 5px; background: Theme.plate; }
        // Effects strip (Full).
        if root.layout == 2: Rectangle { x: 54px; y: 4px; width: 44px; height: 10px; background: Theme.plate; border-radius: 2px; }
        // Transport and tempo fader.
        Rectangle { x: parent.width - 34px; y: parent.height - 18px; width: 12px; height: 12px; border-radius: 6px; background: Theme.plate-raised; }
        Rectangle { x: parent.width - 18px; y: parent.height - 18px; width: 12px; height: 12px; border-radius: 6px; background: Theme.live; }
        Rectangle { x: parent.width - 10px; y: 18px; width: 2px; height: 22px; background: Theme.rule-strong; }
    }
    Caps { text: root.layout == 0 ? @tr("SIMPLE") : root.layout == 2 ? @tr("FULL") : @tr("STANDARD"); height: 16px; }
}

// Live previews on the View page ([48]): a row on top of the page, or a
// column beside it when the window is wide.
component LivePreview inherits Rectangle {
    in property <image> wave;
    in property <bool> calm;
    in property <float> scale;
    // 0 Simple, 1 Standard, 2 Full.
    in property <int> layout;
    // A column beside the settings instead of a row above them.
    in property <bool> stacked;
    accessible-role: groupbox;
    accessible-id: "prefs.view.preview";
    background: Theme.ground-band;
    border-radius: Theme.r-panel;
    height: root.stacked ? col.preferred-height + 40px : 128px;
    Caps { x: Theme.s3; y: Theme.s2; height: 16px; text: @tr("PREVIEW"); color: Theme.bone-2; }
    if !root.stacked: Caps {
        x: parent.width * 0.4; y: Theme.s2; width: parent.width * 0.6 - Theme.s3; height: 16px;
        horizontal-alignment: right; overflow: elide;
        text: @tr("CHANGES SHOW HERE AS YOU MAKE THEM");
    }
    if !root.stacked: HorizontalLayout {
        x: Theme.s3; y: 32px; width: parent.width - 2 * Theme.s3; height: 84px;
        spacing: Theme.s4;
        PreviewWave { horizontal-stretch: 1; min-width: 120px; wave: root.wave; calm: root.calm; }
        PreviewColours { width: 150px; }
        if root.width >= 640px: PreviewScale { width: 150px; scale: root.scale; }
        PreviewLayout { width: 104px; layout: root.layout; }
    }
    col := VerticalLayout {
        visible: root.stacked;
        x: Theme.s3; y: 32px; width: parent.width - 2 * Theme.s3; height: root.stacked ? self.preferred-height : 0px;
        spacing: Theme.s3;
        if root.stacked: PreviewWave { wave: root.wave; calm: root.calm; }
        if root.stacked: HorizontalLayout {
            spacing: Theme.s4;
            PreviewColours { horizontal-stretch: 1; }
            PreviewLayout { width: 104px; layout: root.layout; }
        }
        if root.stacked: PreviewScale { scale: root.scale; }
        if root.stacked: Caps { text: @tr("CHANGES SHOW HERE AS YOU MAKE THEM"); wrap: word-wrap; }
    }
}

export component PreferencesWindow inherits Window {
    title: @tr("Preferences — OpenDJDecks");
    // Window / taskbar icon (X11 and Windows; Wayland and macOS take it
    // from the .desktop file / the bundle).
    icon: @image-url("../../../packaging/assets/icon-256.png");
    preferred-width: 900px;
    preferred-height: 680px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.ground;
    default-font-family: Theme.family;
    default-font-weight: Theme.weight-medium;
    default-font-size: Theme.body;

    in-out property <string> page: "audio";
    in property <string> platform-note;

    // Audio.
    in property <[string]> audio-devices;
    in property <int> audio-device;
    in property <[string]> buffer-options;
    in property <int> buffer;
    in property <[string]> rate-options;
    in property <int> rate;
    in property <int> headphones;
    in property <string> audio-status;
    in property <bool> audio-pending;

    // View.
    in property <int> language;
    in property <int> notation;
    in property <[string]> scale-options;
    in property <int> scale;
    in property <bool> colorblind;
    in property <bool> high-contrast;
    in property <bool> reduced-motion;
    in property <int> appearance;
    // 0 countdown to phrase end, 1 to the next memory cue, 2 count up.
    in property <int> bar-counter;
    in property <int> deck-time;
    in property <int> waveform;
    // Chosen swatch per band, -1 when the colour is not one of the swatches.
    in property <int> waveform-low;
    in property <int> waveform-mid;
    in property <int> waveform-high;
    in property <[color]> waveform-swatches;
    // The colour rows are folded away until asked for.
    property <bool> waveform-own: false;
    // Phrases on the enlarged waveforms and on the overviews; phrase types
    // as names (0) or colours only (1).
    in property <bool> phrases;
    in property <bool> phrases-overview;
    in property <int> phrase-types;
    // Index into the zoom spans (4, 8, 16, 32 s), text sizes (12–18 px)
    // and line spacings (compact, normal, roomy).
    in property <int> zoom-span;
    in property <int> font-size;
    in property <int> line-spacing;

    // Controller > Decks and Mixer (indices into the option lists).
    in property <int> tempo-range;
    in property <bool> deck-quantize;
    in property <int> jog-mode;
    in property <int> sync-mode;
    in property <bool> auto-cue;
    in property <int> eq-mode;
    in property <int> fader-curve;
    in property <int> crossfader-curve;
    in property <bool> auto-gain;

    // Analysis.
    in property <[string]> bpm-options;
    in property <int> bpm-range;
    in property <bool> detect-key;
    in property <bool> detect-phrases;
    in property <bool> auto-analyse;
    in property <bool> auto-cues;

    // Controller.
    in property <[string]> controllers;
    in property <[string]> mappings;
    in property <string> mapping-file;
    // MIDI monitor and learn.
    in property <bool> midi-monitor;
    in property <[string]> midi-lines;
    in property <bool> learn-active;
    in property <[string]> learn-actions;
    in property <int> learn-action;
    in property <int> learn-deck;
    in property <int> learn-number;
    in property <string> learn-result;
    in property <string> learn-entry;
    in property <string> learn-file;
    in property <bool> mapping-pending;
    // Self-test before a gig.
    in property <[string]> test-mappings;
    in property <int> test-mapping;
    in property <bool> test-active;
    in property <bool> test-flashing;
    in property <int> test-seen;
    in property <int> test-lights;
    in property <[SelfTestRow]> test-rows;
    // Scroll position of the Controller page (documentation screenshots).
    in-out property <length> controller-scroll;

    // Keyboard.
    in property <[KeyRow]> key-rows;
    in-out property <string> key-search;
    in property <string> recording-id;
    in property <string> key-message;
    in property <bool> key-conflict;
    in property <int> key-count;
    // Keyboard navigation of the list: the selected action, the scroll
    // position and the visible height.
    in property <string> key-selected;
    in-out property <length> key-scroll;
    out property <length> key-view-height;

    // Recording.
    in property <int> rec-format;
    in property <string> rec-folder;
    in property <bool> auto-split;
    in property <bool> silence-start;
    in property <bool> silence-stop;
    in property <bool> rec-voice;
    in property <string> rec-note;
    in property <string> rec-pattern;
    // The file name the pattern gives (example).
    in property <string> rec-example;
    in property <[string]> rec-gain-options;
    in property <int> rec-gain;

    // Advanced.
    in property <string> library-path;
    in property <bool> library-pending;
    in property <string> backups-text;
    in property <bool> backup-on-start;
    in property <bool> update-auto;
    in property <bool> update-prereleases;
    in property <string> update-status;
    // "missing" | "partial" | "downloading" | "installed" | "damaged" | "unsupported"
    in property <string> stems-state: "missing";
    in property <string> stems-status;
    in property <bool> stems-help;

    callback select-page(string);
    // Choices by key ("audio.device", "view.language", …) and index.
    callback choose(string, int);
    callback flag(string, bool);
    callback act(string);
    // A typed setting by key ("rec.pattern"), on Return.
    callback text(string, string);
    callback search-keys(string);
    // Preferences search: opens the page whose settings match.
    callback search-settings(string);
    in property <bool> tooltips: true;
    in property <bool> club-other-beat: true;
    in property <bool> incoming-overlay: true;
    in property <bool> calm-waveform;
    in property <bool> touch-layout;
    // Live previews: the waveform as drawn now, the interface scale and
    // the deck layout (0 Simple, 1 Standard, 2 Full).
    in property <image> preview-wave;
    in property <float> preview-scale: 1;
    in property <int> deck-layout: 1;
    callback record-key(string);
    callback reset-key(string);
    callback clear-key(string);
    // Key text and modifiers as in the main window.
    callback key-event(string, bool, bool, bool, bool) -> bool;

    public function focus-keys() { keys.focus(); }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (root.key-event(event.text, event.modifiers.control, event.modifiers.meta, event.modifiers.alt, event.modifiers.shift)) {
                return accept;
            }
            reject
        }

        HorizontalLayout {
            // ── Categories ──
            Rectangle {
                width: 200px;
                background: Theme.ground-band;
                VerticalLayout {
                    padding-top: Theme.s4;
                    spacing: Theme.key-gap;
                    alignment: start;
                    Caps { x: 28px; text: @tr("PREFERENCES"); height: 28px; vertical-alignment: center; }
                    // Find a setting: opens the page that has it.
                    HorizontalLayout {
                        padding-left: Theme.s3; padding-right: Theme.s3; padding-bottom: Theme.s2;
                        Field {
                            accessible-id: "prefs.search"; accessible-role: text-input;
                            accessible-value: self.text; accessible-placeholder-text: self.placeholder;
                            height: 28px;
                            placeholder: @tr("FIND A SETTING");
                            tone: Theme.attention;
                            edited(t) => { root.search-settings(t); }
                        }
                    }
                    Category { accessible-id: "prefs.nav.audio"; label: @tr("AUDIO"); current: root.page == "audio"; clicked => { root.select-page("audio"); } }
                    Category { accessible-id: "prefs.nav.view"; label: @tr("VIEW"); current: root.page == "view"; clicked => { root.select-page("view"); } }
                    Category { accessible-id: "prefs.nav.analysis"; label: @tr("ANALYSIS"); current: root.page == "analysis"; clicked => { root.select-page("analysis"); } }
                    Category { accessible-id: "prefs.nav.controller"; label: @tr("CONTROLLER"); current: root.page == "controller"; clicked => { root.select-page("controller"); } }
                    Category { accessible-id: "prefs.nav.keyboard"; label: @tr("KEYBOARD"); current: root.page == "keyboard"; clicked => { root.select-page("keyboard"); } }
                    Category { accessible-id: "prefs.nav.recording"; label: @tr("RECORDING"); current: root.page == "recording"; clicked => { root.select-page("recording"); } }
                    Category { accessible-id: "prefs.nav.advanced"; label: @tr("ADVANCED"); current: root.page == "advanced"; clicked => { root.select-page("advanced"); } }
                }
                Caps {
                    x: 28px; y: parent.height - 58px; width: parent.width - 36px; height: 50px;
                    vertical-alignment: bottom;
                    text: root.platform-note; font-size: Theme.label; wrap: word-wrap;
                }
            }
            // ── Page ──
            VerticalLayout {
                horizontal-stretch: 1;
                padding-left: Theme.s5;
                padding-right: Theme.s5;
                padding-top: Theme.s4;
                padding-bottom: Theme.s3;
                spacing: Theme.s2;

                HorizontalLayout {
                    height: 36px;
                    Text {
                        text: root.page == "audio" ? @tr("Audio") : root.page == "view" ? @tr("View") : root.page == "analysis" ? @tr("Analysis")
                            : root.page == "controller" ? @tr("Controller") : root.page == "keyboard" ? @tr("Keyboard") : root.page == "recording" ? @tr("Recording") : @tr("Advanced");
                        font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi; color: Theme.bone;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // ── Audio ──
                if root.page == "audio": Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: Theme.s1;
                        Heading { text: @tr("Output"); note: root.audio-pending ? @tr("APPLIES AFTER RESTART") : ""; }
                        Row { label: @tr("Output device"); RadioList { accessible-id: "prefs.audio.device"; horizontal-stretch: 1; options: root.audio-devices; selected: root.audio-device; picked(i) => { root.choose("audio.device", i); } } }
                        Row { label: @tr("Buffer size"); Choice { name: @tr("Buffer size"); accessible-id: "prefs.audio.buffer"; options: root.buffer-options; selected: root.buffer; picked(i) => { root.choose("audio.buffer", i); } } }
                        Row { label: @tr("Sample rate"); Choice { name: @tr("Sample rate"); accessible-id: "prefs.audio.sample-rate"; options: root.rate-options; selected: root.rate; picked(i) => { root.choose("audio.rate", i); } } }
                        Row {
                            label: @tr("Headphones (cue)");
                            Choice { name: @tr("Headphones (cue)"); accessible-id: "prefs.audio.headphone-routing"; options: [@tr("AUTOMATIC"), @tr("OUTPUTS 3/4"), @tr("OFF")]; selected: root.headphones; picked(i) => { root.choose("audio.headphones", i); } }
                        }
                        Note { text: @tr("Automatic picks the controller's audio interface when it is connected, else the system output. Headphones play on outputs 3/4 when the device has four outputs."); }
                        Heading { text: @tr("Now"); }
                        Text { text: root.audio-status; font-family: Theme.family; font-size: Theme.body; color: Theme.bone-2; wrap: word-wrap; }
                    }
                }

                // ── View ──
                // A wide window shows the preview beside the settings, a
                // narrow one above them.
                if root.page == "view": HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: Theme.s5;
                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: Theme.s1;
                        if root.width < 1100px: LivePreview { wave: root.preview-wave; calm: root.calm-waveform; scale: root.preview-scale; layout: root.deck-layout; }
                        Heading { text: @tr("Display"); }
                        Row { label: @tr("Language"); Choice { name: @tr("Language"); accessible-id: "prefs.view.language"; options: [@tr("SYSTEM"), "ENGLISH", "DEUTSCH"]; selected: root.language; picked(i) => { root.choose("view.language", i); } } }
                        Row { label: @tr("Tooltips"); Switch { accessible-id: "prefs.view.tooltips"; label: @tr("Show what a control does and its shortcut on hover"); on: root.tooltips; toggled(v) => { root.flag("view.tooltips", v); } } }
                        Row { label: @tr("Text size"); Choice { name: @tr("Text size"); accessible-id: "prefs.view.font-size"; options: ["12", "14", "16", "18"]; selected: root.font-size; picked(i) => { root.choose("view.font-size", i); } } }
                        Row { label: @tr("UI scale"); Choice { name: @tr("UI scale"); accessible-id: "prefs.view.scale"; options: root.scale-options; selected: root.scale; picked(i) => { root.choose("view.scale", i); } } }
                        Row { label: @tr("Line spacing"); Choice { name: @tr("Line spacing"); accessible-id: "prefs.view.line-space"; options: [@tr("COMPACT"), @tr("NORMAL"), @tr("ROOMY")]; selected: root.line-spacing; picked(i) => { root.choose("view.line-spacing", i); } } }
                        Row { label: @tr("Appearance"); Choice { name: @tr("Appearance"); accessible-id: "prefs.view.appearance"; options: [@tr("DARK"), @tr("LIGHT"), @tr("SYSTEM")]; selected: root.appearance; picked(i) => { root.choose("view.appearance", i); } } }
                        Heading { text: @tr("Waveforms and phrases"); }
                        Row { label: @tr("Phrases"); Switch { accessible-id: "prefs.view.phrase-enlarged"; label: @tr("Show phrases on the enlarged waveforms"); on: root.phrases; toggled(v) => { root.flag("view.phrases", v); } } }
                        Row { label: ""; Switch { accessible-id: "prefs.view.phrase-overview"; label: @tr("Show the phrase bar under the overviews"); on: root.phrases-overview; toggled(v) => { root.flag("view.phrases-overview", v); } } }
                        Row { label: @tr("Phrase types"); Choice { name: @tr("Phrase types"); accessible-id: "prefs.view.phrase-types"; options: [@tr("NAMES"), @tr("COLOURS ONLY")]; selected: root.phrase-types; picked(i) => { root.choose("view.phrase-types", i); } } }
                        Row { label: @tr("Waveform colour"); HorizontalLayout { alignment: start; spacing: Theme.s4; Choice { name: @tr("Waveform colour"); accessible-id: "prefs.view.waveform-colour"; options: [@tr("3-BAND"), @tr("ONE COLOUR"), "RGB"]; selected: root.waveform; picked(i) => { root.choose("view.waveform", i); } } if root.waveform == 0: PlateButton { compact: true; accessible-role: button; accessible-id: "prefs.view.waveform-customise"; label: @tr("OWN COLOURS"); selected: root.waveform-own; clicked => { root.waveform-own = !root.waveform-own; } } } }
                        if root.waveform == 0 && root.waveform-own: Row { label: @tr("Lows"); Swatches { key: "prefs.view.waveform-low"; colours: root.waveform-swatches; selected: root.waveform-low; picked(i) => { root.choose("view.waveform-low", i); } } }
                        if root.waveform == 0 && root.waveform-own: Row { label: @tr("Mids"); Swatches { key: "prefs.view.waveform-mid"; colours: root.waveform-swatches; selected: root.waveform-mid; picked(i) => { root.choose("view.waveform-mid", i); } } }
                        if root.waveform == 0 && root.waveform-own: Row { label: @tr("Highs"); Swatches { key: "prefs.view.waveform-high"; colours: root.waveform-swatches; selected: root.waveform-high; picked(i) => { root.choose("view.waveform-high", i); } } }
                        if root.waveform == 0 && root.waveform-own: Row { label: ""; HorizontalLayout { alignment: start; PlateButton { compact: true; accessible-role: button; accessible-id: "prefs.view.waveform-reset"; label: @tr("STANDARD COLOURS"); clicked => { root.choose("view.waveform-reset", 0); } } } }
                        Row { label: @tr("Waveform zoom"); Choice { name: @tr("Waveform zoom"); accessible-id: "prefs.view.zoom"; options: [@tr("4 S"), @tr("8 S"), @tr("16 S"), @tr("32 S")]; selected: root.zoom-span; picked(i) => { root.choose("view.zoom", i); } } }
                        Row { label: @tr("Remaining time"); Choice { name: @tr("Remaining time"); accessible-id: "prefs.view.deck-time"; options: [@tr("TRACK TIME"), @tr("REAL TIME AT TEMPO"), @tr("BOTH")]; selected: root.deck-time; picked(i) => { root.choose("view.deck-time", i); } } }
                        Row { label: @tr("Bar counter"); Choice { name: @tr("Bar counter"); accessible-id: "prefs.view.bar-counter"; options: [@tr("TO PHRASE END"), @tr("TO NEXT MEMORY CUE"), @tr("COUNT UP")]; selected: root.bar-counter; picked(i) => { root.choose("view.bar-counter", i); } } }
                        Heading { text: @tr("Colour and accessibility"); }
                        Row { label: @tr("Colour"); Switch { accessible-id: "prefs.view.colour-blind"; label: @tr("Colour-blind-safe palette"); on: root.colorblind; toggled(v) => { root.flag("view.colorblind", v); } } }
                        Row { label: @tr("Contrast"); Switch { accessible-id: "prefs.view.high-contrast"; label: @tr("High contrast (bright light)"); on: root.high-contrast; toggled(v) => { root.flag("view.contrast", v); } } }
                        Row { label: @tr("Motion"); Switch { accessible-id: "prefs.view.reduced-motion"; label: @tr("Reduce motion"); on: root.reduced-motion; toggled(v) => { root.flag("view.motion", v); } } }
                        Row { label: @tr("Deck layout"); Choice { name: @tr("Deck layout"); accessible-id: "prefs.view.deck-layout"; options: [@tr("SIMPLE"), @tr("STANDARD"), @tr("FULL")]; selected: root.deck-layout; picked(i) => { root.choose("view.deck-layout", i); } } }
                        Row { label: @tr("Club mode"); Switch { accessible-id: "prefs.view.club-other-beat"; label: @tr("Show the other deck's beat under the beat boxes"); on: root.club-other-beat; toggled(v) => { root.flag("view.club-other-beat", v); } } }
                        Row { label: @tr("Incoming track"); Switch { accessible-id: "prefs.view.incoming-overlay"; label: @tr("Draw the incoming track over the playing waveform"); on: root.incoming-overlay; toggled(v) => { root.flag("view.incoming-overlay", v); } } }
                        Row { label: @tr("Calm waveform"); Switch { accessible-id: "prefs.view.calm-waveform"; label: @tr("Crisp playhead, faint beat lines, softer colours"); on: root.calm-waveform; toggled(v) => { root.flag("view.calm-waveform", v); } } }
                        Row { label: @tr("Touch"); Switch { accessible-id: "prefs.view.touch"; label: @tr("Touch layout: every control at least 44 px"); on: root.touch-layout; toggled(v) => { root.flag("view.touch", v); } } }
                    }
                }
                if root.width >= 1100px: VerticalLayout {
                    width: 300px;
                    alignment: start;
                    LivePreview { stacked: true; wave: root.preview-wave; calm: root.calm-waveform; scale: root.preview-scale; layout: root.deck-layout; }
                }
                }

                // ── Analysis ──
                if root.page == "analysis": Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: Theme.s1;
                        Heading { text: @tr("Track analysis"); }
                        Row { label: @tr("BPM range"); Choice { name: @tr("BPM range"); accessible-id: "prefs.analysis.bpm-range"; options: root.bpm-options; selected: root.bpm-range; picked(i) => { root.choose("analysis.bpm", i); } } }
                        Note { text: @tr("Tempos are folded into this range: pick a lower range for hip-hop, a higher one for drum & bass, 150–300 for hardcore and other tempos above 200. The range shows in the Prepare player's INFO tab and beside the analysis progress."); }
                        Row { label: @tr("Key"); Switch { accessible-id: "prefs.analysis.key"; label: @tr("Detect the key"); on: root.detect-key; toggled(v) => { root.flag("analysis.key", v); } } }
                        Row { label: @tr("Phrases"); Switch { accessible-id: "prefs.analysis.phrase"; label: @tr("Detect phrases (intro, verse, chorus …)"); on: root.detect-phrases; toggled(v) => { root.flag("analysis.phrases", v); } } }
                        Row { label: @tr("Key notation"); Choice { name: @tr("Key notation"); accessible-id: "prefs.analysis.key-notation"; options: [@tr("CAMELOT  8A"), @tr("OPEN KEY  1M"), @tr("MUSICAL  Am")]; selected: root.notation; picked(i) => { root.choose("view.notation", i); } } }
                        Row { label: @tr("New tracks"); Switch { accessible-id: "prefs.analysis.auto-analyse"; label: @tr("Analyse automatically when added"); on: root.auto-analyse; toggled(v) => { root.flag("analysis.auto", v); } } }
                        Row { label: @tr("Cue points"); Switch { accessible-id: "prefs.analysis.auto-cues"; label: @tr("Set cues like my other tracks"); on: root.auto-cues; toggled(v) => { root.flag("analysis.auto-cues", v); } } }
                        Note { text: @tr("Learns where you put hot cues and memory cues — by bars from the first downbeat, the phrases and the end — and places them, with their names and colours, on newly analysed tracks that have no cues. Each placement is one undo step. The row menu offers it for any selected track."); }
                        Note { text: @tr("Changes apply to tracks analysed from now on. Use ANALYSE in the player to analyse a track again."); }
                        if root.stems-state != "unsupported": Heading { text: @tr("Stems"); }
                        if root.stems-state != "unsupported": Row {
                            label: @tr("Separation model");
                            Text { accessible-id: "prefs.analysis.stems-status"; accessible-value: self.text; horizontal-stretch: 1; text: root.stems-status; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; wrap: word-wrap; }
                            if root.stems-state == "missing" || root.stems-state == "partial": Button { a11y-label: "prefs.analysis.stems-download"; label: @tr("DOWNLOAD"); tone: Theme.live; tooltip: @tr("Download the stem model once (it stays on this computer)"); clicked => { root.act("stems.download"); } }
                            if root.stems-state == "downloading": Button { a11y-label: "prefs.analysis.stems-cancel"; label: @tr("CANCEL"); clicked => { root.act("stems.cancel"); } }
                            if root.stems-help: Button { a11y-label: "prefs.analysis.stems-help"; label: @tr("HELP"); tooltip: @tr("Open the guide section on fixing this"); clicked => { root.act("stems.help"); } }
                        }
                        if root.stems-state == "partial" || root.stems-state == "installed" || root.stems-state == "damaged": Row {
                            label: @tr("Repair");
                            Rectangle { horizontal-stretch: 1; }
                            Button { a11y-label: "prefs.analysis.stems-redownload"; label: @tr("DELETE AND DOWNLOAD AGAIN"); tooltip: @tr("Delete the model and every leftover, then download it from the start"); clicked => { root.act("stems.redownload"); } }
                            Button { a11y-label: "prefs.analysis.stems-remove"; label: @tr("REMOVE MODEL"); tone: Theme.fault; tooltip: @tr("Delete the model from this computer (stems you already separated stay)"); clicked => { root.act("stems.remove"); } }
                        }
                        if root.stems-state != "unsupported": Note { text: @tr("The model is downloaded once and stays on this computer; your music never leaves it. Removing the model does not remove stems you already separated."); }
                    }
                }

                // ── Controller ──
                if root.page == "controller": Flickable {
                    vertical-stretch: 1;
                    viewport-y <=> root.controller-scroll;
                    content-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: Theme.s1;
                        Heading { text: @tr("Decks"); }
                        Row { label: @tr("Tempo range"); Choice { name: @tr("Tempo range"); accessible-id: "prefs.controller.tempo-range"; options: ["±6 %", "±10 %", "±16 %", @tr("WIDE")]; selected: root.tempo-range; picked(i) => { root.choose("deck.tempo-range", i); } } }
                        Row { label: @tr("Quantize"); Switch { accessible-id: "prefs.controller.quantize"; label: @tr("Quantize cues, loops and jumps to the beat"); on: root.deck-quantize; toggled(v) => { root.flag("deck.quantize", v); } } }
                        Row { label: @tr("Sync"); Choice { name: @tr("Sync"); accessible-id: "prefs.controller.sync-mode"; options: [@tr("BEAT"), @tr("TEMPO ONLY"), @tr("PHRASE")]; selected: root.sync-mode; picked(i) => { root.choose("deck.sync-mode", i); } } }
                        if root.sync-mode == 2: Note { text: @tr("PHRASE: a playing deck that syncs also jumps whole beats, so it stands as far before its next phrase as the master deck."); }
                        Row { label: @tr("Jog wheel"); Choice { name: @tr("Jog wheel"); accessible-id: "prefs.controller.jog-mode"; options: [@tr("VINYL"), @tr("PITCH BEND")]; selected: root.jog-mode; picked(i) => { root.choose("deck.jog-mode", i); } } }
                        Row { label: @tr("Auto cue"); Switch { accessible-id: "prefs.controller.auto-cue"; label: @tr("A loaded track waits at its first sound"); on: root.auto-cue; toggled(v) => { root.flag("deck.auto-cue", v); } } }
                        Heading { text: @tr("Mixer"); }
                        Row { label: @tr("EQ"); Choice { name: @tr("EQ"); accessible-id: "prefs.controller.eq-mode"; options: [@tr("ISOLATOR"), @tr("CLASSIC EQ")]; selected: root.eq-mode; picked(i) => { root.choose("mixer.eq-mode", i); } } }
                        Row { label: @tr("Channel fader curve"); Choice { name: @tr("Channel fader curve"); accessible-id: "prefs.controller.fader-curve"; options: [@tr("LINEAR"), @tr("SMOOTH"), @tr("SHARP")]; selected: root.fader-curve; picked(i) => { root.choose("mixer.fader-curve", i); } } }
                        Row { label: @tr("Crossfader curve"); Choice { name: @tr("Crossfader curve"); accessible-id: "prefs.controller.crossfader-curve"; options: [@tr("CONSTANT POWER"), @tr("LINEAR"), @tr("CUT")]; selected: root.crossfader-curve; picked(i) => { root.choose("mixer.crossfader-curve", i); } } }
                        Row { label: @tr("Auto gain"); Switch { accessible-id: "prefs.controller.auto-gain"; label: @tr("Level tracks by their analysed loudness"); on: root.auto-gain; toggled(v) => { root.flag("mixer.auto-gain", v); } } }
                        Note { text: @tr("Deck and mixer settings apply at once and every time audio starts."); }
                        Heading { a11y: "prefs.controller.guided-setup"; text: @tr("Guided setup"); }
                        HorizontalLayout {
                            spacing: Theme.s3;
                            Note { text: @tr("For a controller without a mapping: choose what kind it is, then move each control when asked. The result is a mapping file you can share."); horizontal-stretch: 1; }
                            Button { a11y-label: "prefs.controller.setup-open"; label: @tr("SET UP A CONTROLLER"); tone: Theme.live; tooltip: @tr("Open the guided setup in the main window"); clicked => { root.act("setup.open"); } }
                        }
                        Heading { a11y: "prefs.controller.midi-learn"; text: @tr("MIDI learn"); }
                        Row {
                            label: @tr("Action");
                            ComboBox { accessible-id: "prefs.controller.learn-action"; horizontal-stretch: 1; model: root.learn-actions; current-index: root.learn-action; selected => { root.choose("learn.action", self.current-index); } }
                        }
                        Row { label: @tr("Deck / channel"); Choice { name: @tr("Deck / channel"); accessible-id: "prefs.controller.learn-deck"; options: [@tr("NONE"), "1", "2", "3", "4"]; selected: root.learn-deck; picked(i) => { root.choose("learn.deck", i); } } }
                        Row { label: @tr("Pad, page or group"); Choice { name: @tr("Pad, page or group"); accessible-id: "prefs.controller.learn-number"; options: [@tr("NONE"), "1", "2", "3", "4", "5", "6", "7", "8"]; selected: root.learn-number; picked(i) => { root.choose("learn.number", i); } } }
                        Row {
                            label: @tr("Control");
                            Text {
                                accessible-role: AccessibleRole.text; accessible-id: "prefs.controller.learn-result"; accessible-value: self.text;
                                horizontal-stretch: 1;
                                text: root.learn-result != "" ? root.learn-result : root.learn-active ? @tr("Move or press the control now …") : @tr("Press LEARN, then move the control");
                                font-family: Theme.family; font-size: Theme.body; color: root.learn-result != "" ? Theme.bone : Theme.bone-3; vertical-alignment: center; overflow: elide;
                            }
                            Button { a11y-label: "prefs.controller.learn"; label: root.learn-active ? @tr("STOP") : @tr("LEARN"); tone: Theme.attention; tooltip: @tr("Listen for the next control you move"); clicked => { root.act(root.learn-active ? "learn.stop" : "learn.start"); } }
                            Button { a11y-label: "prefs.controller.learn-save"; label: @tr("ADD TO MY MAPPING"); tone: Theme.live; tooltip: @tr("Write the learned control into your own mapping file"); clicked => { root.act("learn.save"); } }
                        }
                        if root.learn-entry != "": Text {
                            accessible-role: AccessibleRole.text; accessible-id: "prefs.controller.learn-entry"; accessible-value: self.text;
                            text: root.learn-entry; font-family: "Menlo"; font-size: Theme.label; color: Theme.bone-2; wrap: word-wrap;
                        }
                        Note { text: @tr("Learned controls go into {} and are used from the next start.", root.learn-file); }

                        Heading { text: @tr("Detected"); }
                        if root.controllers.length == 0: Note { text: @tr("No MIDI controller found. Connect a supported controller by USB; it is picked up within a few seconds."); }
                        for c in root.controllers: Text { text: c; font-family: Theme.family; font-size: Theme.body; color: Theme.bone; height: 24px; vertical-alignment: center; }
                        Heading { a11y: "prefs.controller.self-test"; text: @tr("Self-test"); }
                        Row {
                            label: @tr("Mapping");
                            ComboBox { accessible-id: "prefs.controller.test-mapping"; horizontal-stretch: 1; model: root.test-mappings; current-index: root.test-mapping; selected => { root.choose("test.mapping", self.current-index); } }
                        }
                        Row {
                            label: root.test-rows.length == 0 ? "" : @tr("{} of {} answered", root.test-seen, root.test-rows.length);
                            Button { a11y-label: "prefs.controller.test-start"; label: root.test-active ? @tr("STOP") : @tr("START"); tone: Theme.live; tooltip: root.test-active ? @tr("Stop listening") : @tr("Listen to the controller and tick each control that answers"); clicked => { root.act(root.test-active ? "test.stop" : "test.start"); } }
                            Button { a11y-label: "prefs.controller.test-flash"; label: root.test-flashing ? @tr("LEDS ON…") : @tr("FLASH LEDS"); tone: Theme.attention; tooltip: @tr("Light every LED of the mapping for two seconds ({} lights)", root.test-lights); clicked => { root.act("test.flash"); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.test-rows.length > 0: Rectangle {
                            accessible-role: list; accessible-id: "prefs.controller.test-list";
                            accessible-value: root.test-seen + "/" + root.test-rows.length;
                            height: 240px;
                            background: Theme.ground-band;
                            border-radius: Theme.r-panel;
                            Flickable {
                                content-height: max(self.height, root.test-rows.length * 26px + 8px);
                                VerticalLayout {
                                    padding: Theme.s1; padding-left: Theme.s3; padding-right: Theme.s3; alignment: start;
                                    for r in root.test-rows: HorizontalLayout {
                                        accessible-role: AccessibleRole.text;
                                        accessible-id: "prefs.controller.test-row";
                                        accessible-value: (r.seen ? "seen " : "waiting ") + r.status + " " + r.name;
                                        height: 26px; spacing: Theme.s2;
                                        VerticalLayout {
                                            padding-top: Theme.s1; padding-bottom: Theme.s1;
                                            VLine { tone: r.seen ? Theme.live : Theme.rule-strong; form: r.seen ? "solid" : "half"; }
                                        }
                                        Text { horizontal-stretch: 1; text: r.name; overflow: elide; font-family: Theme.family; font-size: Theme.body; color: r.seen ? Theme.bone : Theme.bone-2; vertical-alignment: center; }
                                        Caps {
                                            width: 96px; horizontal-alignment: right; vertical-alignment: center;
                                            text: r.status == "verified" ? @tr("VERIFIED") : r.status == "partial" ? @tr("PARTIAL") : @tr("UNTESTED");
                                        }
                                    }
                                }
                            }
                        }
                        Note { text: @tr("Press START and move every control once; each is ticked when its message arrives. FLASH LEDS lights every mapped LED. VERIFIED: confirmed on a unit. PARTIAL: from a public source, not yet tried on a unit. UNTESTED: neither."); }

                        Heading { text: @tr("Mappings"); note: root.mapping-pending ? @tr("APPLIES AFTER RESTART") : ""; }
                        for m in root.mappings: Text { text: m; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; height: 22px; vertical-alignment: center; overflow: elide; }
                        Row {
                            label: @tr("Own mapping file");
                            Text { horizontal-stretch: 1; text: root.mapping-file == "" ? @tr("None") : root.mapping-file; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                            Button { a11y-label: "prefs.controller.mapping-choose"; label: @tr("CHOOSE…"); tooltip: @tr("Pick a mapping file"); clicked => { root.act("mapping.choose"); } }
                            if root.mapping-file != "": Button { a11y-label: "prefs.controller.mapping-clear"; label: @tr("REMOVE"); tone: Theme.fault; tooltip: @tr("Use only the built-in mappings"); clicked => { root.act("mapping.clear"); } }
                        }
                        Note { text: @tr("A mapping file (TOML, see docs/controller-mappings.md) is loaded in addition to the built-in mappings and wins for its device."); }

                        Heading { text: @tr("MIDI monitor"); }
                        Row {
                            label: @tr("Monitor");
                            Switch { accessible-id: "prefs.controller.midi-monitor"; label: @tr("Show every MIDI message and what it does"); on: root.midi-monitor; toggled(v) => { root.flag("midi.monitor", v); } }
                            Rectangle { horizontal-stretch: 1; }
                            Button { a11y-label: "prefs.controller.midi-clear"; label: @tr("CLEAR"); tooltip: @tr("Empty the monitor"); clicked => { root.act("midi.clear"); } }
                        }
                        if root.midi-monitor: Rectangle {
                            accessible-role: list; accessible-id: "prefs.controller.midi-log";
                            accessible-value: root.midi-lines.length;
                            height: 160px;
                            background: Theme.ground-band;
                            Flickable {
                                content-height: max(self.height, root.midi-lines.length * 18px + 8px);
                                content-y: min(0px, self.height - self.content-height);
                                VerticalLayout {
                                    padding: Theme.s1; alignment: start;
                                    for l in root.midi-lines: Text { height: 18px; text: l; font-family: "Menlo"; font-size: Theme.label; color: Theme.bone-2; overflow: elide; }
                                }
                            }
                            if root.midi-lines.length == 0: Note { text: @tr("Move a control on your controller."); horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                // ── Keyboard ──
                if root.page == "keyboard": VerticalLayout {
                    vertical-stretch: 1;
                    spacing: Theme.s2;
                    HorizontalLayout {
                        spacing: Theme.s2;
                        Field {
                            accessible-role: text-input;
                            accessible-id: "prefs.keyboard.search";
                            accessible-value: self.text;
                            horizontal-stretch: 1;
                            placeholder: @tr("SEARCH {} ACTIONS OR KEYS", root.key-count);
                            text <=> root.key-search;
                            edited(t) => { root.search-keys(t); }
                        }
                        Button { a11y-label: "prefs.keyboard.import"; label: @tr("IMPORT…"); tooltip: @tr("Load key bindings from a TOML file"); clicked => { root.act("keys.import"); } }
                        Button { a11y-label: "prefs.keyboard.export"; label: @tr("EXPORT…"); tooltip: @tr("Save all key bindings as a TOML file"); clicked => { root.act("keys.export"); } }

                    }
                    if root.key-message != "": HorizontalLayout {
                        spacing: Theme.s3;
                        min-height: 30px;
                        VLine { weight: 2px; form: root.key-conflict ? "double" : "solid"; tone: root.key-conflict ? Theme.attention : Theme.live; }
                        Text { horizontal-stretch: 1; text: root.key-message; font-family: Theme.family; font-size: Theme.body; color: Theme.bone; vertical-alignment: center; wrap: word-wrap; }
                        if root.key-conflict: Button { label: @tr("REPLACE"); tone: Theme.attention; tooltip: @tr("Take the keys from the other action"); clicked => { root.act("keys.replace"); root.focus-keys(); } }
                        if root.key-conflict: Button { label: @tr("CANCEL"); tooltip: @tr("Keep the bindings as they are"); clicked => { root.act("keys.cancel"); root.focus-keys(); } }
                    }
                    Note { text: @tr("Click a binding (or pick one with ↑ ↓ and press Return), then press the new keys. Esc cancels, Backspace removes the binding; on a conflict Return replaces. ← → switch pages."); }
                    Rectangle {
                        vertical-stretch: 1;
                        HLine { y: 0; width: parent.width; tone: Theme.rule; }
                        Flickable {
                            accessible-role: list;
                            accessible-id: "prefs.keyboard.shortcut-list";
                            y: 1px; height: parent.height - 1px;
                            content-y <=> root.key-scroll;
                            init => { root.key-view-height = self.height; }
                            changed height => { root.key-view-height = self.height; }
                            VerticalLayout {
                            alignment: start;
                            for r in root.key-rows: Rectangle {
                                height: r.header ? 36px : 28px;
                                background: !r.header && (rt.has-hover || r.id == root.key-selected) ? Theme.ground-band : transparent;
                                if !r.header && r.id == root.key-selected: VLine { x: 0; y: 6px; height: parent.height - 12px; tone: Theme.attention; }
                                if r.header: Caps { x: 0; y: 14px; text: r.title; color: Theme.bone-2; }
                                if !r.header: Text {
                                    x: 12px; width: parent.width - 440px; height: parent.height;
                                    text: r.title; overflow: elide;
                                    font-family: Theme.family; font-size: Theme.body;
                                    color: r.id == root.recording-id ? Theme.bone : Theme.bone-2;
                                    vertical-alignment: center;
                                }
                                if !r.header && r.scope != "": Caps {
                                    x: parent.width - 420px; width: 76px; height: parent.height;
                                    text: r.scope; vertical-alignment: center; horizontal-alignment: right; overflow: elide;
                                }
                                rt := TouchArea {
                                    enabled: !r.header;
                                    width: parent.width - 340px;
                                }
                                if !r.header: Rectangle {
                                    x: parent.width - 334px; y: 3px; width: 200px; height: parent.height - 6px;
                                    background: bt.has-hover ? Theme.plate-raised : Theme.plate;
                                    if r.id == root.recording-id: Rectangle {
                                        HLine { x: 0; y: 0; width: parent.width; tone: Theme.attention; form: "dashed"; }
                                        HLine { x: 0; y: parent.height - self.height; width: parent.width; tone: Theme.attention; form: "dashed"; }
                                        VLine { x: 0; y: 0; height: parent.height; tone: Theme.attention; form: "dashed"; }
                                        VLine { x: parent.width - self.width; y: 0; height: parent.height; tone: Theme.attention; form: "dashed"; }
                                    }
                                    VLine { x: 8px; y: 5px; height: parent.height - 10px; tone: r.custom ? Theme.w436 : Theme.rule-strong; form: r.binding == "" ? "half" : "solid"; }
                                    Text {
                                        x: 18px; width: parent.width - 24px; height: parent.height;
                                        text: r.id == root.recording-id ? @tr("PRESS KEYS…") : r.binding == "" ? @tr("NOT SET") : r.binding;
                                        overflow: elide;
                                        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-medium; letter-spacing: 0.6px;
                                        color: r.id == root.recording-id ? Theme.attention : r.binding == "" ? Theme.bone-3 : Theme.bone;
                                        vertical-alignment: center;
                                    }
                                    bt := TipArea { tooltip: @tr("Click, then press the new keys"); mouse-cursor: pointer; clicked => { root.record-key(r.id); root.focus-keys(); } }
                                }
                                if !r.header && r.custom: PlateButton { x: parent.width - 126px; y: 1px; width: 90px; compact: true; label: @tr("DEFAULT"); tooltip: @tr("Back to the default binding"); clicked => { root.reset-key(r.id); } }
                                if !r.header && r.binding != "": Rectangle {
                                    x: parent.width - 26px; y: 4px; width: 20px; height: parent.height - 8px;
                                    background: ct.has-hover ? Theme.plate : transparent;
                                    Glyph { kind: "close"; tone: Theme.bone-3; x: 5px; y: (parent.height - 10px) / 2; }
                                    ct := TipArea { tooltip: @tr("Remove this binding"); mouse-cursor: pointer; clicked => { root.clear-key(r.id); } }
                                }
                            }
                            }
                        }
                    }
                }

                // ── Recording ──
                if root.page == "recording": Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: Theme.s1;
                        Heading { text: @tr("Files"); }
                        Row { label: @tr("Format"); Choice { name: @tr("Format"); accessible-id: "prefs.recording.format"; options: ["WAV", "FLAC", "WAV + MP3"]; selected: root.rec-format; picked(i) => { root.choose("rec.format", i); } } }
                        if root.rec-note != "": Note { text: root.rec-note; }
                        Row {
                            label: @tr("Folder");
                            Text { horizontal-stretch: 1; text: root.rec-folder; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                            Button { a11y-label: "prefs.recording.folder"; label: @tr("CHOOSE…"); tooltip: @tr("Pick the folder for recordings"); clicked => { root.act("rec.folder"); } }
                        }
                        Row {
                            label: @tr("File name");
                            Field {
                                accessible-role: text-input;
                                accessible-id: "prefs.recording.name-pattern";
                                accessible-value: self.text;
                                horizontal-stretch: 1;
                                text: root.rec-pattern;
                                placeholder: "Mix {date} {time}";
                                accepted(t) => { root.text("rec.pattern", t); }
                            }
                        }
                        Note { text: @tr("{{date}}, {{time}} and {{n}} (number of the day) are filled in; Return saves. Example: {}", root.rec-example); }
                        Row { label: @tr("Recording level"); ChoiceStack { name: @tr("Recording level"); accessible-id: "prefs.recording.level"; options: root.rec-gain-options; selected: root.rec-gain; picked(i) => { root.choose("rec.gain", i); } } }
                        Heading { text: @tr("Automation"); }
                        Row { label: @tr("Split"); Switch { accessible-id: "prefs.recording.auto-split"; label: @tr("Split into one file per track when recording stops"); on: root.auto-split; toggled(v) => { root.flag("rec.split", v); } } }
                        Row { label: @tr("Start"); Switch { accessible-id: "prefs.recording.silence-start"; label: @tr("Start recording when sound starts"); on: root.silence-start; toggled(v) => { root.flag("rec.silence", v); } } }
                        Row { label: @tr("Stop"); Switch { accessible-id: "prefs.recording.silence-stop"; label: @tr("Stop recording after 30 seconds of silence"); on: root.silence-stop; toggled(v) => { root.flag("rec.silence-stop", v); } } }
                        Note { text: @tr("With automatic start, recording begins once the master carries sound for two seconds; stopping it by hand disarms it until the next start of the app."); }
                        Heading { text: @tr("Voice"); }
                        Row { label: @tr("Voice track"); Switch { accessible-id: "prefs.recording.voice"; label: @tr("Record the microphone on its own track as well"); on: root.rec-voice; toggled(v) => { root.flag("rec.voice", v); } } }
                        Note { text: @tr("The voice track is a second WAV file next to the mix, sample for sample beside it, with only the MIC input in it. The mix keeps the voice as you heard it."); }
                    }
                }

                // ── Advanced ──
                if root.page == "advanced": Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: Theme.s1;
                        Heading { text: @tr("Library"); note: root.library-pending ? @tr("APPLIES AFTER RESTART") : ""; }
                        Row {
                            label: @tr("Location");
                            Text { horizontal-stretch: 1; text: root.library-path; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                            Button { a11y-label: "prefs.advanced.library-choose"; label: @tr("CHOOSE…"); tooltip: @tr("Pick the library file to open from the next start"); clicked => { root.act("library.choose"); } }
                            Button { a11y-label: "prefs.advanced.library-show"; label: @tr("SHOW"); tooltip: @tr("Show the library file in the file manager"); clicked => { root.act("library.show"); } }
                        }
                        Note { text: @tr("Choose the library file (library.sqlite) to open from the next start. The command-line option --library still wins."); }
                        Row {
                            label: @tr("rekordbox");
                            Text { horizontal-stretch: 1; text: @tr("Preferences and keyboard shortcuts"); font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                            Button { a11y-label: "prefs.advanced.import-settings"; label: @tr("IMPORT"); tooltip: @tr("Take over the preferences and shortcuts of a rekordbox installation (rekordbox itself is not changed)"); clicked => { root.act("import.settings"); } }
                        }
                        Heading { text: @tr("Backups"); }
                        Row { label: @tr("At start"); Switch { accessible-id: "prefs.advanced.backup-on-start"; label: @tr("Back up the library every time the app starts"); on: root.backup-on-start; toggled(v) => { root.flag("adv.backup", v); } } }
                        Row {
                            label: @tr("Backups");
                            Rectangle {
                                horizontal-stretch: 1; min-width: 40px;
                                Text { width: parent.width; height: parent.height; text: root.backups-text; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                                TipArea { tooltip: root.backups-text; }
                            }
                            Button { a11y-label: "prefs.advanced.backups"; label: @tr("BACK UP NOW"); tone: Theme.live; tooltip: @tr("Copy the library to the backups folder now"); clicked => { root.act("backup.now"); } }
                            Button { a11y-label: "prefs.advanced.backup-show"; label: @tr("SHOW"); tooltip: @tr("Show the backups folder"); clicked => { root.act("backup.show"); } }
                        }
                        Heading { text: @tr("Files"); }
                        Row {
                            label: @tr("Moved files");
                            Text { horizontal-stretch: 1; text: @tr("Find tracks whose files were moved or renamed"); font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                            Button { a11y-label: "prefs.advanced.relocate"; label: @tr("RELOCATE…"); tooltip: @tr("Search a folder for the missing files and point the tracks at them"); clicked => { root.act("library.relocate"); } }
                        }
                        Row {
                            label: @tr("Consolidate");
                            Text { horizontal-stretch: 1; text: @tr("Copy every track into one music folder"); font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                            Button { a11y-label: "prefs.advanced.consolidate"; label: @tr("CONSOLIDATE…"); tooltip: @tr("Copy every track into a folder you pick (Artist / file) and point the library at the copies"); clicked => { root.act("library.consolidate"); } }
                        }
                        Heading { text: @tr("Updates"); }
                        Row { label: @tr("Automatically"); Switch { accessible-id: "prefs.advanced.update-auto"; label: @tr("Check for updates automatically"); on: root.update-auto; toggled(v) => { root.flag("update.auto", v); } } }
                        Row { label: @tr("Pre-releases"); Switch { accessible-id: "prefs.advanced.update-prereleases"; label: @tr("Include pre-releases"); on: root.update-prereleases; toggled(v) => { root.flag("update.pre", v); } } }
                        Row {
                            label: @tr("Now");
                            Text { horizontal-stretch: 1; text: root.update-status; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                            Button { a11y-label: "prefs.advanced.update-check"; label: @tr("CHECK NOW"); tone: Theme.live; clicked => { root.act("update.check"); } }
                        }
                        Note { text: @tr("Only GitHub's public release list is read; nothing about you or your library is sent. Checks never run while a deck plays in Perform, and an update never interrupts a performance."); }
                    }
                }

                // ── Footer: back to the defaults, at the bottom left ──
                HLine { tone: Theme.rule; }
                HorizontalLayout {
                    alignment: start;
                    if root.page != "keyboard": Button { a11y-label: "prefs.reset"; label: @tr("RESET PAGE"); tooltip: @tr("Set everything on this page back to the defaults"); clicked => { root.act("reset-page"); } }
                    if root.page == "keyboard": Button { a11y-label: "prefs.reset"; label: @tr("RESET ALL"); tone: Theme.fault; tooltip: @tr("Restore every default key binding"); clicked => { root.act("keys.reset-all"); } }
                }
            }
        }
    }

    // Tooltips draw above everything.
    TooltipLayer { }
}
