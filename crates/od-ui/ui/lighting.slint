// LIGHTING (SPEC §10.5): the DMX rig, a live stage preview and the show
// controls. State lives in the `Lighting` global so the view can be placed
// in the main window or a detached one without re-plumbing properties.
//
// Layout: RIG (patch, outputs) | STAGE (live preview, what the show does
// now) | SHOW (enable, mode, master, momentary buttons, mode panel).

import { Theme } from "tokens.slint";
import { VLine, HLine } from "lines.slint";
import { Caps, PlateButton, Field, LineToggle, Fader, HoldButton, Stepper, KeyFocus, TooltipState } from "controls.slint";
import { ChoiceList } from "fx.slint";

export struct LightFixtureView {
    name: string,
    group: string,
    // "wash" | "mover" | "bar" | "effect"
    role: string,
    address: string,
    // Stage position, 0..1.
    x: float,
    y: float,
    color: color,
    intensity: float,
    // Beam end for movers, 0..1 stage coordinates.
    beam-x: float,
    beam-y: float,
    strobe: bool,
    cells: [color],
}

export struct LightGroupView {
    name: string,
    // Index into `programs`, -1 = follow the music.
    program: int,
    // Index into `swatches`, -1 = colour from the track.
    color: int,
    // Index into `effects` (0 = none).
    effect: int,
    // Fixed position (pan / tilt 0..1), or -1 = from the program.
    pan: float,
    tilt: float,
    has-movers: bool,
}

// One row of the patch table.
export struct LightPatchRow {
    name: string,
    group: string,
    // 1-based, as text for the fields.
    universe: string,
    address: string,
    mode: string,
    channels: string,
    // What is wrong with the place ("" = fine), e.g. "OVERLAPS PAR 2".
    clash: string,
    identify: bool,
    // "fog" | "laser" | "".
    hazard: string,
}

// One output link and its state.
export struct LightOutputRow {
    universe: string,
    target: string,
    // "ok" | "lost" | "back" (came back in the last 20 s).
    state: string,
    detail: string,
}

export struct LightCapRow {
    name: string,
    // 0..1.
    cap: float,
}

// One pad of the current page: an own look or chase, or empty.
export struct LightPadView {
    // 0..7 on the page.
    slot: int,
    // "1.3": page and pad.
    number: string,
    // "" = empty pad.
    name: string,
    chase: bool,
    // On while held (else latched).
    flash: bool,
    // What the look shows, one colour per group it sets (or per step).
    colors: [color],
    // In control now (latched, or held).
    on: bool,
    // Opened in the editor.
    selected: bool,
}

// A group master.
export struct LightMasterRow {
    name: string,
    // 0..1.
    level: float,
}

// One row of the phrase-to-look table.
export struct LightAutoRow {
    label: string,
    pick: string,
    // Playing now (the phrase of the deck you hear).
    now: bool,
}

// A group of the look being edited.
export struct LightLookGroupRow {
    name: string,
    // The look sets this group (else it keeps what runs underneath).
    set: bool,
    program: string,
    // Index into `swatches`, -1 = from the music.
    color: int,
    level: string,
}

// [32] A fixture on the floor plan (STAGE in SETUP).
export struct LightPlaceRow {
    name: string,
    group: string,
    // "wash" | "mover" | "bar" | "effect"
    role: string,
    // 0..1 across (stage left to right) and from the back to the front.
    x: float,
    y: float,
    // Degrees clockwise, 0 = towards the audience.
    rotation: float,
    // Placed by hand (else the default spot for its role).
    placed: bool,
    color: color,
    intensity: float,
}

// [32] The fixture open on the floor plan: place and programming.
export struct LightTuneView {
    name: string,
    group: string,
    rotation: string,
    height: string,
    pan-from: string,
    pan-to: string,
    tilt-from: string,
    tilt-to: string,
    invert-pan: bool,
    invert-tilt: bool,
    red: string,
    green: string,
    blue: string,
    curve: string,
    mover: bool,
    placed: bool,
}

// [33] One light cue of the track: where, its name, what it plays, its fade.
export struct LightCueRow {
    bar: string,
    name: string,
    plays: string,
    fade: string,
    // In effect now.
    active: bool,
}

// [35] A venue, rig or show file.
export struct LightFileRow {
    name: string,
    // "RIG CLUB · SHOW FRIDAY · 3 PER SECOND", "4 FIXTURES · 1 OUTPUT", …
    detail: string,
    // In use now.
    current: bool,
}

// [36] One DJ event and what it plays.
export struct LightTriggerRow {
    event: string,
    // "NOTHING", "RELEASE", "PAD 1.3 RED WASH", "CUE 2 WARM", …
    plays: string,
    // "UNTIL NEXT", "8 BEATS", …
    beats: string,
    // Something is tied to it.
    set: bool,
    // Playing now.
    active: bool,
}

export global Lighting {
    // The compact lighting strip inside Perform.
    in-out property <bool> panel;
    in-out property <bool> enabled;
    // "auto" | "easy" | "pro"
    in-out property <string> mode: "auto";
    in-out property <float> master: 1;
    in-out property <bool> blackout;
    in property <bool> flash;
    in property <bool> strobe;
    in property <bool> fog;
    in property <[string]> effects;
    // Tapped tempo for the lights when no deck plays ("" = 120 BPM).
    in property <string> tap-bpm;
    in property <[LightFixtureView]> fixtures;
    in property <[LightGroupView]> groups;
    in property <[string]> programs;
    in property <[color]> swatches;
    in property <[string]> fixture-types;
    in property <int> easy-program;
    in property <int> easy-color: -1;
    in property <[string]> cues;
    in property <int> active-cue: -1;
    // What the show does now, e.g. "DECK 1 · CHORUS → SWEEP".
    in property <string> status;
    in property <string> output-text;
    in property <string> rig-path;

    callback set-enabled(bool);
    callback set-mode(string);
    callback set-master(float);
    callback set-blackout(bool);
    callback flash-held(bool);
    callback strobe-held(bool);
    callback choose-easy-program(int);
    callback choose-easy-color(int);
    callback group-program(int, int);
    callback group-color(int, int);
    callback remove-fixture(int);
    // Kind, target, universe (1-based text, "" = 1).
    callback set-output(string, string, string);
    callback cue-go();
    callback cue-back();
    callback cue-store(string);
    callback cue-delete(int);
    callback fog-held(bool);
    callback tap();
    callback group-effect(int, int);
    callback group-position(int, float, float);
    callback group-position-clear(int);
    callback import-ofl();
    callback detach();
    // [21] The view's two modes: "setup" (rig, patch, outputs, safety,
    // files) or "show" (stage, pads, cues, AUTO, masters, keys).
    in-out property <string> space: "setup";
    // [33] The light cues of the track you hear (or the one in Prepare).
    in property <string> cue-title;
    in property <[LightCueRow]> cue-rows;
    in property <bool> cue-can-add;
    callback cue-add();
    callback cue-move(int, int);
    callback cue-rename(int, string);
    callback cue-plays(int, int);
    callback cue-fade(int, int);
    callback cue-remove(int);
    // [32] The floor plan.
    in property <[LightPlaceRow]> places;
    in-out property <int> selected-fixture: -1;
    in property <LightTuneView> tune;
    in-out property <bool> snap: true;
    callback select-fixture(int);
    callback place-fixture(int, float, float);
    callback unplace-fixture(int);
    callback rotate-fixture(int, int);
    callback step-height(int, int);
    callback set-group(int, string);
    // Field: "pan-from" | "pan-to" | "tilt-from" | "tilt-to" | "red" |
    // "green" | "blue" | "curve" | "invert-pan" | "invert-tilt".
    callback step-tune(int, string, int);
    // [35] Venue profiles, rigs and shows.
    in property <string> files-kind: "venue";
    callback choose-files-kind(string);
    in property <[LightFileRow]> file-rows;
    in property <string> venue;
    in property <string> files-note;
    callback file-load(int);
    callback file-save(int);
    callback file-save-as(string);
    callback file-rename(int, string);
    callback file-duplicate(int);
    callback file-delete(int);
    callback file-import();
    callback file-export();

    // [34] A separate lighting operator: a controller of its own (by its
    // MIDI input), OSC in, and the music sent to another instance.
    in property <[string]> midi-inputs;
    in property <string> light-controller;
    in property <string> light-controller-note;
    callback refresh-midi();
    // Index into `midi-inputs`, -1 = none.
    callback use-controller(int);
    in property <bool> osc-in;
    in property <string> osc-port;
    in property <string> osc-note;
    callback set-osc-in(bool);
    callback set-osc-port(string);
    in property <bool> osc-send;
    in property <string> osc-send-to;
    in property <string> osc-send-note;
    callback set-osc-send(bool, string);
    // [36] The music the show follows: "decks" | "input" | "network", and
    // what arrives from it; DJ events tied to pads and cues.
    in property <string> source: "decks";
    in property <string> source-text;
    callback set-source(string);
    in property <[LightTriggerRow]> triggers;
    in property <string> last-event;
    callback trigger-plays(int, int);
    callback trigger-beats(int, int);
    // [37] Unattended mode for a fixed venue.
    in property <bool> unattended;
    in property <bool> autostart;
    in property <string> calm-after;
    // The show runs unattended and the setup is locked: the show controls
    // are locked too.
    in property <bool> show-locked;
    in property <string> unattended-text;
    callback set-unattended(bool);
    callback set-autostart(bool);
    callback step-calm(int);

    // Centre of the view: SETUP "stage" | "patch" | "channels", SHOW
    // "stage" | "pads" | "cues" | "triggers".
    in-out property <string> centre: "stage";
    // Setup panel: "rig" | "output" | "safety" | "files" | "remote".
    in-out property <string> setup-tab: "rig";
    // Patch table.
    in property <[LightPatchRow]> patch-rows;
    callback patch-universe(int, string);
    callback patch-address(int, string);
    callback patch-mode(int, int);
    callback patch-channels(int, string);
    callback identify(int);
    // Type, name, group, count, universe, start address.
    callback add-fixtures(int, string, string, string, string, string);
    // Outputs and failsafe.
    in property <[LightOutputRow]> outputs;
    // Summary for Perform: "off" | "ok" | "lost" | "back" | "fault".
    in property <string> link: "off";
    in property <string> link-text;
    // "hold" | "safe" | "blackout".
    in property <string> failsafe: "hold";
    callback remove-output(int);
    callback set-failsafe(string);
    // Live channel view of one universe.
    in property <[int]> channels;
    in property <[string]> universes;
    in property <int> channel-universe;
    callback choose-universe(int);
    // Safety limits.
    in property <float> strobe-hz: 3;
    in property <bool> fog-armed;
    in property <bool> laser-armed;
    in property <bool> has-fog;
    in property <bool> has-laser;
    in property <[LightCapRow]> caps;
    in property <bool> pin-set;
    // Setup is locked by the PIN (the show controls stay free).
    in property <bool> locked;
    in property <string> pin-error;
    callback step-strobe(int);
    callback arm-fog(bool);
    callback arm-laser(bool);
    callback step-cap(int, int);
    callback unlock(string);
    callback lock();
    callback set-pin(string);

    // ── Own looks and chases (pads) ──
    in property <[LightPadView]> pads;
    in property <int> page;
    // PADS: a click opens the pad in the editor instead of playing it.
    in property <bool> editing;
    // A click on a pad adds it as a step of the chase being edited.
    in property <bool> adding-steps;
    // The pad in the editor: its number ("" = none), and whether it holds
    // a look.
    in property <string> edit-number;
    in property <bool> edit-has;
    in property <string> edit-name;
    in property <bool> edit-chase;
    in property <bool> edit-flash;
    in property <[LightLookGroupRow]> edit-groups;
    in property <[string]> edit-steps;
    in property <string> edit-step-beats;
    in property <[LightMasterRow]> masters;
    // Slot on the page, pressed or released.
    callback pad-pressed(int, bool);
    callback choose-page(int);
    callback set-editing(bool);
    // New look (false) or chase (true) on the pad in the editor.
    callback pad-new(bool);
    // Store the PRO group settings in the look.
    callback pad-capture();
    callback pad-rename(string);
    callback pad-flash(bool);
    callback pad-delete();
    callback pad-group-program(int, int);
    callback pad-group-color(int, int);
    callback pad-group-level(int, int);
    callback pad-group-clear(int);
    callback pad-add-steps(bool);
    callback pad-step-remove(int);
    callback pad-step-beats(int);
    callback group-master(int, float);

    // ── AUTO you can steer ──
    in property <bool> hold;
    // Who is in control: "blackout" | "momentary" | "flash-pad" | "latched"
    // | "hold" | "base".
    in property <string> layer: "base";
    in property <string> layer-text;
    in property <[string]> palettes;
    in property <int> palette;
    // Swatches in the custom palette.
    in property <[bool]> custom-colors;
    in property <[LightAutoRow]> auto-rows;
    callback set-hold(bool);
    callback release();
    callback choose-palette(int);
    callback custom-color(int);
    callback auto-step(int, int);

    // ── Connecting interfaces ──
    in property <[string]> ports;
    in property <[string]> nodes;
    in property <bool> finding;
    in property <string> find-text;
    // "" | "each" | "colours" | "full".
    in property <string> test;
    // Guided setup: 0 = closed, 1 kind, 2 find, 3 universe, 4 test, 5 done.
    in property <int> guide-step;
    in property <string> guide-kind;
    in property <string> guide-target;
    in property <string> guide-universe;
    in property <string> guide-note;
    callback refresh-ports();
    // Port or node index, universe text.
    callback use-port(int, string);
    callback find-nodes();
    callback use-node(int, string);
    callback set-test(string);
    callback guide(string);
}

// Colour chips; -1 is "from the track".
component Swatches inherits HorizontalLayout {
    in property <int> current;
    // Accessible labels: <a11y>.track and <a11y><n>.
    in property <string> a11y: "lighting.swatch";
    // Narrower chips (the look editor).
    in property <length> chip: 24px;
    callback chosen(int);
    spacing: Theme.s1;
    height: root.chip;
    Rectangle {
        accessible-id: root.a11y + ".track"; accessible-role: button;
        width: 40px;
        border-radius: Theme.r-control;
        background: root.current == -1 ? Theme.bone : Theme.plate;
        Text { text: @tr("TRACK"); font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: 1px; color: root.current == -1 ? Theme.ground : Theme.bone-2; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { mouse-cursor: pointer; clicked => { root.chosen(-1); } }
    }
    for c[i] in Lighting.swatches: Rectangle {
        accessible-id: root.a11y + i; accessible-role: button;
        width: root.chip;
        background: c;
        border-width: root.current == i ? 2px : 1px;
        border-color: root.current == i ? Theme.bone : Theme.rule;
        TouchArea { mouse-cursor: pointer; clicked => { root.chosen(i); } }
    }
}

// Live preview of the rig: wash fixtures as glowing lenses, movers with
// their beam, bars as cells. Strobing fixtures flicker.
component Stage inherits Rectangle {
    in property <bool> compact;
    background: #0B0B0B;
    border-width: 1px;
    border-color: Theme.rule;
    clip: true;
    // The strobe preview flashes as the light does; steady with reduced motion.
    property <bool> blink: !Theme.motion || Math.mod(animation-tick() / 1ms, 90) < 45;

    // Trusses.
    for y in [0.18, 0.5, 0.82]: Rectangle {
        x: 16px; width: parent.width - 32px; height: 1px;
        y: parent.height * y;
        background: #2A2A27;
    }
    for f[i] in Lighting.fixtures: Rectangle {
        property <float> lit: f.strobe && !root.blink ? 0 : f.intensity;
        property <length> cx: root.width * f.x;
        property <length> cy: root.height * f.y;
        accessible-id: "lighting.stage.fixture" + i; accessible-role: text;
        accessible-value: f.name;
        x: 0; y: 0; width: root.width; height: root.height;

        if f.role == "mover": Path {
            x: 0; y: 0; width: root.width; height: root.height;
            viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
            stroke: f.color.with-alpha(0.55 * lit);
            stroke-width: 6px;
            MoveTo { x: cx / 1px; y: cy / 1px; }
            LineTo { x: root.width * f.beam-x / 1px; y: root.height * f.beam-y / 1px; }
        }
        if f.role != "bar": Rectangle {
            x: cx - 22px; y: cy - 22px; width: 44px; height: 44px;
            border-radius: 22px;
            background: f.color.with-alpha(0.25 * lit);
        }
        if f.role != "bar": Rectangle {
            x: cx - 11px; y: cy - 11px; width: 22px; height: 22px;
            border-radius: f.role == "mover" ? 4px : 11px;
            background: lit > 0.02 ? f.color.with-alpha(0.35 + 0.65 * lit) : #1C1C1B;
            border-width: 1px; border-color: #4B4A46;
        }
        if f.role == "bar": HorizontalLayout {
            x: cx - 80px; y: cy - 7px; width: 160px; height: 14px;
            spacing: Theme.key-gap;
            for c in f.cells: Rectangle {
                background: c.with-alpha(0.25 + 0.75 * lit);
                border-width: 1px; border-color: #33322F;
            }
        }
        // Kept inside the stage at its edges.
        if !root.compact: Text {
            x: clamp(cx - 60px, 0px, root.width - 120px); y: min(cy + (f.role == "bar" ? 10px : 24px), root.height - 15px); width: 120px; height: 15px;
            text: f.name;
            font-family: Theme.family; font-size: Theme.label; color: Theme.bone-3;
            horizontal-alignment: center; overflow: elide;
        }
    }
    if Lighting.fixtures.length == 0: Text {
        // Wraps inside a small stage (the Perform strip).
        x: Theme.s2; width: parent.width - 2 * Theme.s2;
        text: @tr("No fixtures patched yet. Add your lights on the left.");
        font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3; wrap: word-wrap;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// The status line of an output: solid green sending, dashed sodium came
// back a moment ago, struck when lost.
component LinkLine inherits VLine {
    in property <string> state;
    tone: root.state == "ok" ? Theme.live : root.state == "back" ? Theme.attention : root.state == "off" ? Theme.rule-strong : Theme.bone-3;
    form: root.state == "ok" ? "solid" : root.state == "back" ? "dashed" : root.state == "off" ? "half" : "struck";
}

component Body inherits Text {
    font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2;
    wrap: word-wrap;
    // Wraps to the width its column gives it and never asks for more.
    min-width: 0px; preferred-width: 0px;
}

// [32] The stage as an editor: every fixture on a top-down floor plan,
// the audience at the bottom. Drag a fixture to move it (it snaps to the
// grid while GRID is on); click it to open its place and programming
// beside the plan. Positions drive the preview and the effects that run
// across the stage (chases and sweeps go from left to right).
component FloorPlan inherits Rectangle {
    accessible-id: "lighting.plan"; accessible-role: image;
    background: #0B0B0B;
    border-width: 1px;
    border-color: Theme.rule;
    clip: true;
    // The fixture being dragged and where it would land.
    property <int> dragging: -1;
    property <float> gx;
    property <float> gy;
    // Inner area (room for the captions).
    property <length> pad: 22px;
    property <length> iw: self.width - 2 * self.pad;
    property <length> ih: self.height - 2 * self.pad;
    pure function fx(v: float) -> length { return root.pad + root.iw * v; }
    pure function fy(v: float) -> length { return root.pad + root.ih * v; }
    pure function snapped(v: float) -> float { return Lighting.snap ? Math.round(clamp(v, 0, 1) * 20) / 20 : clamp(v, 0, 1); }

    // The grid, every 1/20 of the stage (every fifth line a little stronger).
    if Lighting.snap: Rectangle {
        for i in 21: Rectangle {
            x: root.fx(i / 20) ; y: root.pad; width: 1px; height: root.ih;
            background: Math.mod(i, 5) == 0 ? #262624 : #181817;
        }
        for i in 21: Rectangle {
            x: root.pad; y: root.fy(i / 20); width: root.iw; height: 1px;
            background: Math.mod(i, 5) == 0 ? #262624 : #181817;
        }
    }
    // The stage's front edge.
    Rectangle { x: root.pad; y: root.fy(1); width: root.iw; height: 1px; background: Theme.rule-strong; }
    Text {
        x: root.pad; y: 2px; width: root.iw; height: root.pad - 4px;
        text: @tr("BACK"); font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: 1px;
        color: Theme.bone-3; horizontal-alignment: center; vertical-alignment: center;
    }
    Text {
        x: root.pad; y: root.height - root.pad + 2px; width: root.iw; height: root.pad - 4px;
        text: @tr("AUDIENCE"); font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: 1px;
        color: Theme.bone-3; horizontal-alignment: center; vertical-alignment: center;
    }
    // A click on the floor closes the fixture.
    TouchArea { clicked => { Lighting.select-fixture(-1); } }
    for f[i] in Lighting.places: Rectangle {
        property <bool> moving: root.dragging == i;
        property <length> cx: root.fx(self.moving ? root.gx : f.x);
        property <length> cy: root.fy(self.moving ? root.gy : f.y);
        property <bool> chosen: Lighting.selected-fixture == i;
        property <length> sz: f.role == "bar" ? 44px : 24px;
        accessible-id: "lighting.plan.fixture" + i; accessible-role: button;
        accessible-value: f.name + " " + Math.round(f.x * 100) + " " + Math.round(f.y * 100) + " " + Math.round(f.rotation) + (self.chosen ? " selected" : "");
        accessible-item-selectable: true; accessible-item-selected: self.chosen;
        x: self.cx - 22px; y: self.cy - 22px; width: 44px; height: 44px;
        Rectangle {
            x: (parent.width - parent.sz) / 2; y: (parent.height - (f.role == "bar" ? 12px : 24px)) / 2;
            width: parent.sz; height: f.role == "bar" ? 12px : 24px;
            border-radius: f.role == "mover" ? 4px : f.role == "bar" ? 2px : 12px;
            background: f.intensity > 0.02 ? f.color.with-alpha(0.35 + 0.65 * f.intensity) : #1C1C1B;
            border-width: parent.chosen ? 2px : 1px;
            border-color: parent.chosen ? Theme.attention : f.placed ? #6B6A64 : #4B4A46;
        }
        // Where it points: a line out of the symbol (0° = towards the audience).
        Path {
            x: 0; y: 0; width: 44px; height: 44px;
            viewbox-width: 44; viewbox-height: 44;
            stroke: parent.chosen ? Theme.attention : Theme.bone-3; stroke-width: 2px;
            MoveTo { x: 22 - 8 * Math.sin(f.rotation * 1deg); y: 22 + 8 * Math.cos(f.rotation * 1deg); }
            LineTo { x: 22 - 21 * Math.sin(f.rotation * 1deg); y: 22 + 21 * Math.cos(f.rotation * 1deg); }
        }
        grab := TouchArea {
            mouse-cursor: root.dragging == i ? MouseCursor.grabbing : MouseCursor.grab;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    Lighting.select-fixture(i);
                }
                if (ev.kind == PointerEventKind.up && root.dragging == i) {
                    Lighting.place-fixture(i, root.gx, root.gy);
                    root.dragging = -1;
                }
            }
            moved => {
                if (self.pressed) {
                    root.dragging = i;
                    root.gx = root.snapped((self.absolute-position.x + self.mouse-x - root.absolute-position.x - root.pad) / root.iw);
                    root.gy = root.snapped((self.absolute-position.y + self.mouse-y - root.absolute-position.y - root.pad) / root.ih);
                }
            }
        }
    }
    // Names under the fixtures (over the symbols' neighbours, never under).
    // Kept inside the plan at its edges.
    for f[i] in Lighting.places: Text {
        x: clamp(root.fx(root.dragging == i ? root.gx : f.x) - 50px, 0px, root.width - 100px);
        y: min(root.fy(root.dragging == i ? root.gy : f.y) + 14px, root.height - 15px);
        width: 100px; height: 15px;
        text: f.name; font-family: Theme.family; font-size: Theme.label;
        color: Lighting.selected-fixture == i ? Theme.bone : Theme.bone-3;
        horizontal-alignment: center; overflow: elide;
    }
    if Lighting.places.length == 0: Text {
        x: Theme.s2; width: parent.width - 2 * Theme.s2;
        text: @tr("No fixtures patched yet. Add your lights on the left.");
        font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3; wrap: word-wrap;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// A labelled stepper row of the fixture inspector.
component TuneRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> a11y;
    in property <string> tip;
    in property <bool> lit;
    in property <string> template: "+50 %";
    callback step(int);
    spacing: Theme.s2; height: 26px;
    Text { text: root.label; font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.bone-2; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; min-width: 40px; }
    Stepper {
        accessible-id: root.a11y; accessible-role: spinbox; accessible-value: self.value;
        a11y-prev: root.a11y + ".down"; a11y-next: root.a11y + ".up";
        value: root.value; template: root.template; size: 26px; lit: root.lit;
        tooltip: root.tip;
        step(d) => { root.step(d); }
    }
}

// [32] The fixture open on the floor plan: its place and its programming.
component FixtureInspector inherits Flickable {
    in property <int> index;
    accessible-id: "lighting.plan.inspector"; accessible-role: groupbox;
    property <LightTuneView> t: Lighting.tune;
    content-height: max(col.min-height, col.preferred-height) + Theme.s3;
    col := VerticalLayout {
        width: root.width;
        alignment: start;
        spacing: Theme.s2;
        Text { text: root.t.name; font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi; color: Theme.bone; overflow: elide; }
        HorizontalLayout {
            spacing: Theme.s2;
            Caps { text: @tr("GROUP"); vertical-alignment: center; }
            Field {
                accessible-id: "lighting.fixture.group"; accessible-role: text-input;
                text: root.t.group; horizontal-stretch: 1; enabled: !Lighting.locked;
                accepted(v) => { Lighting.set-group(root.index, v); }
            }
        }
        TuneRow {
            label: @tr("TURN"); value: root.t.rotation; template: "315°"; a11y: "lighting.fixture.rotate";
            tip: @tr("Which way it points, in steps of 15°: 0° towards the audience");
            step(d) => { Lighting.rotate-fixture(root.index, d); }
        }
        TuneRow {
            label: @tr("HEIGHT"); value: root.t.height; template: "10.5 m"; a11y: "lighting.fixture.height";
            tip: @tr("How high it hangs");
            step(d) => { Lighting.step-height(root.index, d); }
        }
        HorizontalLayout {
            spacing: Theme.s1;
            PlateButton {
                accessible-id: "lighting.plan.snap"; accessible-role: button;
                accessible-checkable: true; accessible-checked: Lighting.snap;
                compact: true; label: @tr("GRID"); active: Lighting.snap; tone: Theme.attention; horizontal-stretch: 1;
                tooltip: @tr("Snap to the grid while dragging");
                clicked => { Lighting.snap = !Lighting.snap; }
            }
            PlateButton {
                accessible-id: "lighting.fixture.unplace"; accessible-role: button;
                compact: true; label: @tr("DEFAULT SPOT"); enabled: root.t.placed && !Lighting.locked; horizontal-stretch: 1;
                tooltip: @tr("Back to the spot for its kind (movers at the back, washes at the front)");
                clicked => { Lighting.unplace-fixture(root.index); }
            }
        }
        HLine { }
        Caps { text: @tr("PROGRAMMING"); }
        if root.t.mover: TuneRow {
            label: @tr("PAN FROM"); value: root.t.pan-from; template: "100 %"; a11y: "lighting.fixture.pan-from";
            tip: @tr("Where the pan travel starts that looks use"); lit: root.t.pan-from != "0 %";
            step(d) => { Lighting.step-tune(root.index, "pan-from", d); }
        }
        if root.t.mover: TuneRow {
            label: @tr("PAN TO"); value: root.t.pan-to; template: "100 %"; a11y: "lighting.fixture.pan-to";
            tip: @tr("Where the pan travel ends that looks use"); lit: root.t.pan-to != "100 %";
            step(d) => { Lighting.step-tune(root.index, "pan-to", d); }
        }
        if root.t.mover: TuneRow {
            label: @tr("TILT FROM"); value: root.t.tilt-from; template: "100 %"; a11y: "lighting.fixture.tilt-from";
            tip: @tr("Where the tilt travel starts that looks use"); lit: root.t.tilt-from != "0 %";
            step(d) => { Lighting.step-tune(root.index, "tilt-from", d); }
        }
        if root.t.mover: TuneRow {
            label: @tr("TILT TO"); value: root.t.tilt-to; template: "100 %"; a11y: "lighting.fixture.tilt-to";
            tip: @tr("Where the tilt travel ends that looks use"); lit: root.t.tilt-to != "100 %";
            step(d) => { Lighting.step-tune(root.index, "tilt-to", d); }
        }
        if root.t.mover: HorizontalLayout {
            spacing: Theme.s1;
            PlateButton {
                accessible-id: "lighting.fixture.invert-pan"; accessible-role: button;
                accessible-checkable: true; accessible-checked: root.t.invert-pan;
                compact: true; label: @tr("INVERT PAN"); active: root.t.invert-pan; tone: Theme.attention; horizontal-stretch: 1;
                tooltip: @tr("Mirror pan, for a mover hung the other way round");
                clicked => { Lighting.step-tune(root.index, "invert-pan", 1); }
            }
            PlateButton {
                accessible-id: "lighting.fixture.invert-tilt"; accessible-role: button;
                accessible-checkable: true; accessible-checked: root.t.invert-tilt;
                compact: true; label: @tr("INVERT TILT"); active: root.t.invert-tilt; tone: Theme.attention; horizontal-stretch: 1;
                tooltip: @tr("Mirror tilt, for a mover hung upside down");
                clicked => { Lighting.step-tune(root.index, "invert-tilt", 1); }
            }
        }
        TuneRow {
            label: @tr("RED"); value: root.t.red; a11y: "lighting.fixture.red"; lit: root.t.red != "0 %";
            tip: @tr("Colour calibration: more or less red, so fixtures of different makes match");
            step(d) => { Lighting.step-tune(root.index, "red", d); }
        }
        TuneRow {
            label: @tr("GREEN"); value: root.t.green; a11y: "lighting.fixture.green"; lit: root.t.green != "0 %";
            tip: @tr("Colour calibration: more or less green");
            step(d) => { Lighting.step-tune(root.index, "green", d); }
        }
        TuneRow {
            label: @tr("BLUE"); value: root.t.blue; a11y: "lighting.fixture.blue"; lit: root.t.blue != "0 %";
            tip: @tr("Colour calibration: more or less blue");
            step(d) => { Lighting.step-tune(root.index, "blue", d); }
        }
        TuneRow {
            label: @tr("DIMMER CURVE"); value: root.t.curve; template: "LINEAR"; a11y: "lighting.fixture.curve";
            tip: @tr("How the light follows the level: LINEAR, SQUARE (darker low end), ROOT (brighter low end), SOFT");
            step(d) => { Lighting.step-tune(root.index, "curve", d); }
        }
        Body { text: @tr("The safety limits still apply to every value."); color: Theme.bone-3; }
    }
}

// [32] STAGE in SETUP: the floor plan and the open fixture.
component StageEditor inherits HorizontalLayout {
    spacing: Theme.s3;
    FloorPlan { horizontal-stretch: 1; min-width: 160px; }
    VerticalLayout {
        width: 232px;
        if Lighting.selected-fixture >= 0 && Lighting.selected-fixture < Lighting.places.length: FixtureInspector { index: Lighting.selected-fixture; vertical-stretch: 1; }
        if Lighting.selected-fixture < 0 || Lighting.selected-fixture >= Lighting.places.length: VerticalLayout {
            spacing: Theme.s2;
            Caps { text: @tr("FLOOR PLAN"); }
            Body { text: @tr("Drag a fixture to where it hangs; click it to turn it, set its height and group and tune it. Chases and sweeps run from left to right as placed."); color: Theme.bone-3; }
            PlateButton {
                accessible-id: "lighting.plan.snap"; accessible-role: button;
                accessible-checkable: true; accessible-checked: Lighting.snap;
                compact: true; label: @tr("GRID"); active: Lighting.snap; tone: Theme.attention;
                tooltip: @tr("Snap to the grid while dragging");
                clicked => { Lighting.snap = !Lighting.snap; }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

// [33] CUES in SHOW: the light cues of the track you hear, editable.
component CueList inherits VerticalLayout {
    spacing: Theme.s2;
    HorizontalLayout {
        height: 26px; spacing: Theme.s2;
        Caps { text: @tr("TRACK"); vertical-alignment: center; }
        Text {
            accessible-id: "lighting.cues.track"; accessible-role: text; accessible-value: self.text;
            text: Lighting.cue-title == "" ? @tr("Load or play a track to give it light cues.") : Lighting.cue-title;
            font-family: Theme.family; font-size: Theme.control; color: Lighting.cue-title == "" ? Theme.bone-3 : Theme.bone;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
        }
        PlateButton {
            accessible-id: "lighting.cues.add"; accessible-role: button;
            compact: true; label: @tr("CUE AT PLAYHEAD"); glyph: "plus"; enabled: Lighting.cue-can-add; horizontal-stretch: 0;
            tooltip: @tr("A light cue at the bar you hear, playing the cue, pad or chase that runs now");
            clicked => { Lighting.cue-add(); }
        }
    }
    HorizontalLayout {
        height: 18px; spacing: Theme.s2; padding-left: Theme.s3;
        Caps { text: @tr("AT"); width: 110px; vertical-alignment: center; }
        Caps { text: @tr("NAME"); horizontal-stretch: 1; vertical-alignment: center; min-width: 60px; }
        Caps { text: @tr("PLAYS"); width: 230px; vertical-alignment: center; }
        Caps { text: @tr("FADE"); width: 110px; vertical-alignment: center; }
        Rectangle { width: 30px; }
    }
    HLine { }
    if Lighting.cue-rows.length == 0: Body {
        text: @tr("No light cues for this track yet. A light cue plays a cue of the stack, a pad or a chase from its bar on, every time the track plays. In Prepare they sit on a lane under the waveform, where you can drag them.");
        color: Theme.bone-3;
    }
    if Lighting.cue-rows.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: rows.preferred-height;
        rows := VerticalLayout {
            width: parent.width;
            alignment: start;
            for c[i] in Lighting.cue-rows: Rectangle {
                accessible-id: "lighting.cues.row" + i; accessible-role: list-item;
                accessible-value: c.bar + " " + c.name + " " + c.plays + " " + c.fade + (c.active ? " active" : "");
                height: 34px;
                HorizontalLayout {
                    spacing: Theme.s2;
                    // In effect now: the sodium tick.
                    VerticalLayout { padding-top: Theme.s1; padding-bottom: Theme.s1; width: Theme.s3 - Theme.s2; VLine { tone: c.active ? Theme.attention : transparent; } }
                    VerticalLayout {
                        alignment: center;
                        Stepper {
                            accessible-id: "lighting.cues.row" + i + ".bar"; accessible-role: spinbox; accessible-value: self.value;
                            a11y-prev: "lighting.cues.row" + i + ".earlier"; a11y-next: "lighting.cues.row" + i + ".later";
                            width: 110px; size: 26px; value: c.bar; template: "BAR 000"; lit: c.active;
                            tooltip: @tr("Move the cue a bar earlier or later");
                            step(d) => { Lighting.cue-move(i, d); }
                        }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 1; min-width: 60px;
                        Field {
                            accessible-id: "lighting.cues.row" + i + ".name"; accessible-role: text-input;
                            height: 26px; text: c.name; placeholder: @tr("Name");
                            accepted(t) => { Lighting.cue-rename(i, t); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Stepper {
                            accessible-id: "lighting.cues.row" + i + ".plays"; accessible-role: spinbox; accessible-value: self.value;
                            a11y-prev: "lighting.cues.row" + i + ".plays.prev"; a11y-next: "lighting.cues.row" + i + ".plays.next";
                            width: 230px; size: 26px; value: c.plays; template: "CHASE 4.8 MUSIC";
                            tooltip: @tr("What the cue plays: a cue of the stack, a pad's look or a chase");
                            step(d) => { Lighting.cue-plays(i, d); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Stepper {
                            accessible-id: "lighting.cues.row" + i + ".fade"; accessible-role: spinbox; accessible-value: self.value;
                            a11y-prev: "lighting.cues.row" + i + ".fade.down"; a11y-next: "lighting.cues.row" + i + ".fade.up";
                            width: 110px; size: 26px; value: c.fade; template: "16 BEATS";
                            tooltip: @tr("Fade into the cue, in beats");
                            step(d) => { Lighting.cue-fade(i, d); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        PlateButton {
                            accessible-id: "lighting.cues.row" + i + ".delete"; accessible-role: button;
                            compact: true; glyph: "close"; width: 30px;
                            tooltip: @tr("Remove this light cue");
                            clicked => { Lighting.cue-remove(i); }
                        }
                    }
                }
            }
        }
    }
    if Lighting.cue-rows.length > 0: Body { text: @tr("Type a name and press Enter to rename. The cue starts at its bar each time the track plays, in every mode."); color: Theme.bone-3; }
}

// Setup is locked: the PIN opens it again.
component LockedSetup inherits VerticalLayout {
    spacing: Theme.s2;
    Caps { text: @tr("SETUP LOCKED"); color: Theme.attention; }
    Body { text: @tr("Patch, outputs and safety limits need the PIN. The show controls on the right stay free."); }
    HorizontalLayout {
        spacing: Theme.s2;
        pin := Field {
            accessible-id: "lighting.pin.entry"; accessible-role: text-input;
            input-type: InputType.password; placeholder: @tr("PIN"); horizontal-stretch: 1;
            accepted(t) => { Lighting.unlock(t); self.text = ""; }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            PlateButton {
                accessible-id: "lighting.pin.unlock"; accessible-role: button;
                compact: true; label: @tr("UNLOCK"); tooltip: @tr("Open the setup with the PIN");
                clicked => { Lighting.unlock(pin.text); pin.text = ""; }
            }
        }
    }
    if Lighting.pin-error != "": Text {
        text: Lighting.pin-error;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.fault;
    }
}

component RigTab inherits VerticalLayout {
    property <int> type-index: 0;
    spacing: Theme.s2;
    Caps { text: @tr("ADD FIXTURES"); }
    ChoiceList {
        accessible-id: "lighting.rig.type"; accessible-role: list;
        items: Lighting.fixture-types; current: root.type-index; columns: 2; cell-w: 150px; cell-h: 24px;
        chosen(i) => { root.type-index = i; }
    }
    HorizontalLayout {
        spacing: Theme.s2;
        name := Field { accessible-id: "lighting.rig.name"; accessible-role: text-input; placeholder: @tr("Name"); horizontal-stretch: 1; }
        group := Field { accessible-id: "lighting.rig.group"; accessible-role: text-input; placeholder: @tr("Group"); width: 110px; }
    }
    HorizontalLayout {
        spacing: Theme.s2;
        VerticalLayout {
            spacing: Theme.key-gap;
            Caps { text: @tr("COUNT"); }
            count := Field { accessible-id: "lighting.rig.count"; accessible-role: text-input; placeholder: "1"; width: 56px; }
        }
        VerticalLayout {
            spacing: Theme.key-gap;
            Caps { text: @tr("UNIVERSE"); }
            universe := Field { accessible-id: "lighting.rig.universe"; accessible-role: text-input; placeholder: @tr("free"); width: 66px; }
        }
        VerticalLayout {
            spacing: Theme.key-gap;
            Caps { text: @tr("START"); }
            start := Field { accessible-id: "lighting.rig.start"; accessible-role: text-input; placeholder: @tr("free"); width: 66px; }
        }
        VerticalLayout {
            alignment: end;
            PlateButton {
                accessible-id: "lighting.rig.add"; accessible-role: button;
                label: @tr("ADD"); glyph: "plus"; tone: Theme.live;
                tooltip: @tr("Patch the fixtures one after another from the start address (empty: the first free addresses)");
                clicked => {
                    Lighting.add-fixtures(root.type-index, name.text, group.text, count.text, universe.text, start.text);
                    name.text = ""; count.text = ""; start.text = "";
                }
            }
        }
    }
    Body { text: @tr("Change universe, address, mode and channel count in the patch table in the middle."); color: Theme.bone-3; }
    HLine { }
    PlateButton {
        accessible-id: "lighting.rig.import-ofl"; accessible-role: button;
        compact: true; label: @tr("IMPORT FIXTURE FILE…");
        tooltip: @tr("Patch a fixture from an Open Fixture Library file (.json)");
        clicked => { Lighting.import-ofl(); }
    }
}

// A list of choices with a USE key each (serial ports, Art-Net nodes).
component UseList inherits VerticalLayout {
    in property <[string]> items;
    in property <string> a11y;
    in property <string> use-label;
    callback used(int);
    spacing: Theme.key-gap;
    for t[i] in root.items: Rectangle {
        accessible-id: root.a11y + i; accessible-role: list-item; accessible-value: t;
        height: 30px;
        background: Theme.plate.with-alpha(0.5);
        border-radius: Theme.r-control;
        HorizontalLayout {
            padding-left: Theme.s2; spacing: Theme.s2;
            Text { text: t; font-family: Theme.family; font-size: Theme.control; color: Theme.bone; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                PlateButton {
                    accessible-id: root.a11y + i + ".use"; accessible-role: button;
                    compact: true; label: root.use-label;
                    clicked => { root.used(i); }
                }
            }
        }
    }
}

// The short guided setup of a connection: kind, the interface, the
// universe, then a test pattern to check by eye.
component ConnectGuide inherits VerticalLayout {
    spacing: Theme.s2;
    HorizontalLayout {
        spacing: Theme.s2; height: 26px;
        Caps {
            accessible-id: "lighting.guide.step"; accessible-role: text; accessible-value: Lighting.guide-step;
            text: Lighting.guide-step >= 5 ? @tr("CONNECTION SET UP") : @tr("CONNECT · STEP {} OF 4", Lighting.guide-step);
            color: Theme.attention; vertical-alignment: center; horizontal-stretch: 1;
        }
        PlateButton {
            accessible-id: "lighting.guide.close"; accessible-role: button;
            compact: true; glyph: "close"; width: 30px; tooltip: @tr("Close the guided setup");
            clicked => { Lighting.guide("close"); }
        }
    }
    // Progress: dashed at half strength, filled solid up to the step.
    Rectangle {
        height: 2px;
        background: Theme.attention.with-alpha(0.3);
        Rectangle { x: 0; width: parent.width * min(Lighting.guide-step, 4) / 4; background: Theme.attention; }
    }
    if Lighting.guide-step == 1: VerticalLayout {
        spacing: Theme.s2;
        Body { text: @tr("How are your lights connected to this computer?"); color: Theme.bone; }
        for k in [{ id: "artnet", label: @tr("ART-NET NODE"), hint: @tr("A box on the network that turns Art-Net into DMX") },
                  { id: "sacn", label: @tr("SACN RECEIVER"), hint: @tr("A node or fixture on the network that listens to sACN") },
                  { id: "usb", label: @tr("USB-DMX INTERFACE"), hint: @tr("A cable from a USB port to the first fixture") }]: VerticalLayout {
            spacing: Theme.key-gap;
            PlateButton {
                accessible-id: "lighting.guide." + k.id; accessible-role: button;
                tall: true; label: k.label; selected: Lighting.guide-kind == k.id;
                clicked => { Lighting.guide("kind:" + k.id); }
            }
            Body { text: k.hint; color: Theme.bone-3; }
        }
    }
    if Lighting.guide-step == 2 && Lighting.guide-kind == "artnet": VerticalLayout {
        spacing: Theme.s2;
        Body { text: @tr("Switch the node on and connect it to the same network as this computer, then look for it."); color: Theme.bone; }
        HorizontalLayout {
            spacing: Theme.s2;
            PlateButton {
                accessible-id: "lighting.guide.find"; accessible-role: button;
                label: Lighting.finding ? @tr("LOOKING…") : @tr("FIND NODES"); enabled: !Lighting.finding;
                clicked => { Lighting.find-nodes(); }
            }
            Caps { text: Lighting.find-text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Theme.bone-3; }
        }
        UseList { a11y: "lighting.guide.node"; items: Lighting.nodes; use-label: @tr("CHOOSE"); used(i) => { Lighting.guide("node:" + i); } }
        HorizontalLayout {
            spacing: Theme.s2;
            addr := Field { accessible-id: "lighting.guide.address"; accessible-role: text-input; placeholder: @tr("or type its address"); horizontal-stretch: 1; accepted(t) => { Lighting.guide("target:" + t); } }
            VerticalLayout { alignment: center; horizontal-stretch: 0; PlateButton { accessible-id: "lighting.guide.address.use"; accessible-role: button; compact: true; label: @tr("CHOOSE"); clicked => { Lighting.guide("target:" + addr.text); } } }
        }
    }
    if Lighting.guide-step == 2 && Lighting.guide-kind == "usb": VerticalLayout {
        spacing: Theme.s2;
        Body { text: @tr("Plug the interface in, then choose its port. Not listed? Plug it in again and press REFRESH."); color: Theme.bone; }
        HorizontalLayout {
            PlateButton { accessible-id: "lighting.guide.refresh"; accessible-role: button; compact: true; label: @tr("REFRESH"); clicked => { Lighting.refresh-ports(); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if Lighting.ports.length == 0: Body { text: @tr("No serial port found."); color: Theme.bone-3; }
        UseList { a11y: "lighting.guide.port"; items: Lighting.ports; use-label: @tr("CHOOSE"); used(i) => { Lighting.guide("port:" + i); } }
    }
    if Lighting.guide-step == 2 && Lighting.guide-kind == "sacn": Body {
        text: @tr("sACN goes out as multicast to every receiver on the network. Nothing to choose: set your receiver to the universe of the next step.");
        color: Theme.bone;
    }
    if Lighting.guide-step == 3: VerticalLayout {
        spacing: Theme.s2;
        Body { text: @tr("Which universe goes there? The patch table shows your fixtures' universe; a small rig is universe 1."); color: Theme.bone; }
        HorizontalLayout {
            Stepper {
                accessible-id: "lighting.guide.universe"; accessible-role: spinbox; accessible-value: self.value;
                a11y-prev: "lighting.guide.universe.down"; a11y-next: "lighting.guide.universe.up";
                value: @tr("UNIVERSE {}", Lighting.guide-universe); template: "UNIVERSE 000"; size: 32px; lit: true;
                step(d) => { Lighting.guide("universe:" + d); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    if Lighting.guide-step == 4: VerticalLayout {
        spacing: Theme.s2;
        Body { text: @tr("The test pattern lights your fixtures one after another, within the safety limits. Do your lights follow it?"); color: Theme.bone; }
        PlateButton { accessible-id: "lighting.guide.works"; accessible-role: button; tall: true; label: @tr("YES, THEY FOLLOW"); tone: Theme.live; active: true; clicked => { Lighting.guide("works"); } }
        PlateButton { accessible-id: "lighting.guide.fails"; accessible-role: button; tall: true; label: @tr("NOTHING HAPPENS"); clicked => { Lighting.guide("fails"); } }
    }
    if Lighting.guide-step >= 5: Body { text: @tr("DMX OUT is on and the test pattern has stopped. Patch your fixtures in RIG if you have not yet."); color: Theme.bone; }
    if Lighting.guide-target != "" && Lighting.guide-step >= 2: Caps {
        accessible-id: "lighting.guide.target"; accessible-role: text; accessible-value: self.text;
        text: @tr("TO {}", Lighting.guide-target); overflow: elide; color: Theme.bone-2;
    }
    if Lighting.guide-note != "": Body { accessible-id: "lighting.guide.note"; accessible-role: text; accessible-value: self.text; text: Lighting.guide-note; color: Theme.attention; }
    HorizontalLayout {
        spacing: Theme.s1;
        if Lighting.guide-step >= 2 && Lighting.guide-step <= 4: PlateButton {
            accessible-id: "lighting.guide.back"; accessible-role: button;
            label: @tr("BACK"); horizontal-stretch: 1;
            clicked => { Lighting.guide("back"); }
        }
        if Lighting.guide-step == 2: PlateButton {
            accessible-id: "lighting.guide.next"; accessible-role: button;
            label: @tr("NEXT"); tone: Theme.live; active: Lighting.guide-target != ""; enabled: Lighting.guide-target != "";
            horizontal-stretch: 1;
            clicked => { Lighting.guide("next"); }
        }
        if Lighting.guide-step == 3: PlateButton {
            accessible-id: "lighting.guide.apply"; accessible-role: button;
            label: @tr("SET AND TEST"); tone: Theme.live; active: true; horizontal-stretch: 1;
            clicked => { Lighting.guide("apply"); }
        }
        if Lighting.guide-step >= 5: PlateButton {
            accessible-id: "lighting.guide.done"; accessible-role: button;
            label: @tr("CLOSE"); horizontal-stretch: 1;
            clicked => { Lighting.guide("close"); }
        }
    }
}

component OutputTab inherits Flickable {
    property <string> output-kind: "artnet";
    // Never shorter than the column's minimum (wrapped notes in nested rows
    // can ask for more than its preferred height), with room after the last
    // note so the end of the page scrolls clear of the panel's edge.
    content-height: max(col.min-height, col.preferred-height) + Theme.s5;
    col := VerticalLayout {
        width: root.width;
        alignment: start;
        spacing: Theme.s2;
        if Lighting.guide-step > 0: ConnectGuide { }
        if Lighting.guide-step == 0: VerticalLayout {
            spacing: Theme.s2;
            HorizontalLayout {
                spacing: Theme.s2;
                Caps { text: @tr("OUTPUTS"); vertical-alignment: center; horizontal-stretch: 1; }
                PlateButton {
                    accessible-id: "lighting.guide.open"; accessible-role: button;
                    compact: true; label: @tr("GUIDED SETUP"); tone: Theme.live;
                    tooltip: @tr("Connect an interface step by step, with a test at the end");
                    clicked => { Lighting.guide("open"); }
                }
            }
            if Lighting.outputs.length == 0: Body { text: @tr("No output set. The show runs in the preview only."); color: Theme.bone-3; }
            for o[i] in Lighting.outputs: Rectangle {
                accessible-id: "lighting.output.row" + i; accessible-role: list-item;
                accessible-value: o.universe + " " + o.state + " " + o.detail;
                height: 44px;
                HorizontalLayout {
                    spacing: Theme.s2;
                    VerticalLayout { padding-top: Theme.s1; padding-bottom: Theme.s1; LinkLine { state: o.state; } }
                    VerticalLayout {
                        horizontal-stretch: 1; alignment: center; spacing: Theme.key-gap;
                        HorizontalLayout {
                            spacing: Theme.s2;
                            Text { text: o.universe; font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.bone; }
                            Text { text: o.target; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; overflow: elide; horizontal-stretch: 1; }
                        }
                        Text {
                            text: o.detail; overflow: elide;
                            font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: Theme.tracking-index;
                            color: o.state == "lost" ? Theme.fault : o.state == "back" ? Theme.attention : Theme.bone-3;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        PlateButton {
                            accessible-id: "lighting.output.remove" + i; accessible-role: button;
                            compact: true; glyph: "close"; width: 30px; tooltip: @tr("Remove this output");
                            clicked => { Lighting.remove-output(i); }
                        }
                    }
                }
            }
            HLine { }
            Caps { text: @tr("SET OUTPUT"); }
            HorizontalLayout {
                spacing: Theme.s1;
                for k[i] in [{ id: "artnet", label: "ART-NET" }, { id: "sacn", label: "SACN" }, { id: "enttec", label: "USB-DMX" }]: PlateButton {
                    accessible-id: "lighting.output." + k.id; accessible-role: tab;
                    compact: true; label: k.label; selected: root.output-kind == k.id; horizontal-stretch: 1;
                    tooltip: @tr("Choose how the universe leaves the computer");
                    clicked => { root.output-kind = k.id; if (k.id == "enttec") { Lighting.refresh-ports(); } }
                }
            }
            HorizontalLayout {
                spacing: Theme.s2;
                universe := Field { accessible-id: "lighting.output.universe"; accessible-role: text-input; placeholder: "U 1"; width: 56px; }
                target := Field {
                    accessible-id: "lighting.output.target"; accessible-role: text-input;
                    horizontal-stretch: 1;
                    placeholder: root.output-kind == "artnet" ? "2.0.0.10:6454" : root.output-kind == "sacn" ? "1" : "/dev/cu.usbserial";
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    PlateButton {
                        accessible-id: "lighting.output.apply"; accessible-role: button;
                        compact: true; label: @tr("SET"); tooltip: @tr("Send this universe to the output");
                        clicked => { Lighting.set-output(root.output-kind, target.text, universe.text); }
                    }
                }
            }
            if root.output-kind == "artnet": VerticalLayout {
                spacing: Theme.s2;
                HorizontalLayout {
                    spacing: Theme.s2;
                    PlateButton {
                        accessible-id: "lighting.output.find"; accessible-role: button;
                        compact: true; label: Lighting.finding ? @tr("LOOKING…") : @tr("FIND NODES"); enabled: !Lighting.finding;
                        tooltip: @tr("Ask the local network which Art-Net nodes are there");
                        clicked => { Lighting.find-nodes(); }
                    }
                    Caps { accessible-id: "lighting.output.find-text"; accessible-role: text; accessible-value: self.text; text: Lighting.find-text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Theme.bone-3; }
                }
                UseList { a11y: "lighting.output.node"; items: Lighting.nodes; use-label: @tr("USE"); used(i) => { Lighting.use-node(i, universe.text); } }
            }
            if root.output-kind == "enttec": VerticalLayout {
                spacing: Theme.s2;
                HorizontalLayout {
                    spacing: Theme.s2;
                    Caps { text: @tr("PORTS"); vertical-alignment: center; horizontal-stretch: 1; }
                    PlateButton {
                        accessible-id: "lighting.output.refresh"; accessible-role: button;
                        compact: true; label: @tr("REFRESH"); tooltip: @tr("Look for USB serial ports again");
                        clicked => { Lighting.refresh-ports(); }
                    }
                }
                if Lighting.ports.length == 0: Body { text: @tr("No serial port found. Plug the interface in and press REFRESH."); color: Theme.bone-3; }
                UseList { a11y: "lighting.output.port"; items: Lighting.ports; use-label: @tr("USE"); used(i) => { Lighting.use-port(i, universe.text); } }
            }
            Caps { text: Lighting.output-text; overflow: elide; color: Theme.bone-3; }
            HLine { }
            Caps { text: @tr("TEST PATTERN"); }
            HorizontalLayout {
                spacing: Theme.s1;
                for t in [{ id: "", label: @tr("OFF") }, { id: "each", label: @tr("EACH") }, { id: "colours", label: @tr("COLOURS") }, { id: "full", label: @tr("FULL") }]: PlateButton {
                    accessible-id: "lighting.test." + (t.id == "" ? "off" : t.id); accessible-role: tab;
                    compact: true; label: t.label; selected: Lighting.test == t.id; horizontal-stretch: 1;
                    clicked => { Lighting.set-test(t.id); }
                }
            }
            Body {
                color: Theme.bone-3;
                text: Lighting.test == "" ? @tr("Checks a connection: EACH lights one fixture after another, COLOURS steps the rig through red, green, blue and white, FULL lights everything. It replaces the show while it runs, within the safety limits.")
                    : @tr("The test pattern replaces the show until you press OFF.");
            }
            HLine { }
            Caps { text: @tr("WHEN A LINK IS LOST"); }
            HorizontalLayout {
                spacing: Theme.s1;
                for f in [{ id: "hold", label: @tr("HOLD") }, { id: "safe", label: @tr("SAFE SCENE") }, { id: "blackout", label: @tr("BLACKOUT") }]: PlateButton {
                    accessible-id: "lighting.failsafe." + f.id; accessible-role: tab;
                    compact: true; label: f.label; selected: Lighting.failsafe == f.id; horizontal-stretch: 1;
                    clicked => { Lighting.set-failsafe(f.id); }
                }
            }
            Body {
                text: Lighting.failsafe == "hold" ? @tr("The whole rig keeps the last look until every link is back, then fades back to the show in one second.")
                    : Lighting.failsafe == "safe" ? @tr("The whole rig fades to a calm warm wash at 30 % in two seconds: no strobe, no fog, no lasers.")
                    : @tr("The whole rig goes dark at once and fades back in when every link is back.");
            }
            Body { text: @tr("The same choice applies when the show fails and when the app quits."); color: Theme.bone-3; }
        }
    }
}

component SafetyTab inherits Flickable {
    accessible-id: "lighting.safety"; accessible-role: groupbox;
    content-height: max(col.min-height, col.preferred-height) + Theme.s5;
    col := VerticalLayout {
    width: root.width;
    alignment: start;
    spacing: Theme.s2;
    Caps { text: @tr("STROBE AND FLASH CAP"); }
    HorizontalLayout {
        spacing: Theme.s2;
        Stepper {
            accessible-id: "lighting.safety.strobe"; accessible-role: spinbox;
            accessible-value: self.value;
            a11y-prev: "lighting.safety.strobe.down"; a11y-next: "lighting.safety.strobe.up";
            value: Lighting.strobe-hz <= 0 ? @tr("NO STROBE") : @tr("{} PER SECOND", Lighting.strobe-hz);
            template: "00 PER SECOND"; size: 26px; lit: true;
            tooltip: @tr("Most flashes per second any look may send");
            step(d) => { Lighting.step-strobe(d); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    Body { text: @tr("Fast flashing can trigger seizures in people with photosensitive epilepsy. 3 per second or less is the safe default; every look, button and cue is held to it."); }
    HLine { }
    Caps { text: @tr("LOCKOUT"); }
    HorizontalLayout {
        spacing: Theme.s2;
        PlateButton {
            accessible-id: "lighting.safety.fog"; accessible-role: button;
            accessible-checkable: true; accessible-checked: Lighting.fog-armed;
            label: Lighting.fog-armed ? @tr("FOG ARMED") : @tr("ARM FOG"); active: Lighting.fog-armed; tone: Theme.attention;
            horizontal-stretch: 1;
            tooltip: @tr("Fog machines stay off until armed. Arming ends when the app quits.");
            clicked => { Lighting.arm-fog(!Lighting.fog-armed); }
        }
        PlateButton {
            accessible-id: "lighting.safety.laser"; accessible-role: button;
            accessible-checkable: true; accessible-checked: Lighting.laser-armed;
            label: Lighting.laser-armed ? @tr("LASERS ARMED") : @tr("ARM LASERS"); active: Lighting.laser-armed; tone: Theme.fault;
            horizontal-stretch: 1;
            tooltip: @tr("Lasers stay dark until armed. Arming ends when the app quits.");
            clicked => { Lighting.arm-laser(!Lighting.laser-armed); }
        }
    }
    Body {
        color: Theme.bone-3;
        text: !Lighting.has-fog && !Lighting.has-laser ? @tr("No fog machine or laser is patched.")
            : @tr("Arming lasts until the app quits; each start begins locked.");
    }
    HLine { }
    Caps { text: @tr("LEVEL CAP PER GROUP"); }
    if Lighting.caps.length == 0: Body { text: @tr("Groups appear here once fixtures are patched."); color: Theme.bone-3; }
    for c[i] in Lighting.caps: HorizontalLayout {
        spacing: Theme.s2; height: 26px;
        Text { text: c.name; font-family: Theme.family; font-size: Theme.control; color: Theme.bone; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Stepper {
            accessible-id: "lighting.safety.cap" + i; accessible-role: spinbox;
            accessible-value: self.value;
            a11y-prev: "lighting.safety.cap" + i + ".down"; a11y-next: "lighting.safety.cap" + i + ".up";
            value: Math.round(c.cap * 100) + " %"; template: "100 %"; size: 26px; lit: c.cap < 1;
            tooltip: @tr("Highest level this group may reach");
            step(d) => { Lighting.step-cap(i, d); }
        }
    }
    HLine { }
    Caps { text: @tr("SETUP PIN"); }
    HorizontalLayout {
        spacing: Theme.s2;
        newpin := Field {
            accessible-id: "lighting.pin.new"; accessible-role: text-input;
            input-type: InputType.password; placeholder: Lighting.pin-set ? @tr("New PIN (empty clears it)") : @tr("4 to 8 digits");
            horizontal-stretch: 1;
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            PlateButton {
                accessible-id: "lighting.pin.set"; accessible-role: button;
                compact: true; label: Lighting.pin-set && newpin.text == "" ? @tr("CLEAR") : @tr("SET");
                tooltip: @tr("With a PIN, guests can play the show but not change the setup");
                clicked => { Lighting.set-pin(newpin.text); newpin.text = ""; }
            }
        }
    }
    if Lighting.pin-error != "": Text {
        text: Lighting.pin-error;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.fault;
    }
    // [37] Unattended mode for a fixed venue, behind the PIN.
    HLine { }
    Caps { text: @tr("UNATTENDED"); }
    PlateButton {
        accessible-id: "lighting.unattended"; accessible-role: button;
        accessible-checkable: true; accessible-checked: Lighting.unattended;
        label: Lighting.unattended ? @tr("RUNS UNATTENDED") : @tr("RUN UNATTENDED"); active: Lighting.unattended; tone: Theme.live;
        enabled: Lighting.pin-set || Lighting.unattended;
        tooltip: @tr("For a fixed venue: the show runs by itself, locked behind the setup PIN");
        clicked => { Lighting.set-unattended(!Lighting.unattended); }
    }
    HorizontalLayout {
        spacing: Theme.s2;
        VerticalLayout {
            alignment: center;
            LineToggle {
                accessible-id: "lighting.unattended.autostart"; accessible-role: checkbox;
                label: @tr("START WITH THE APP"); checked: Lighting.autostart;
                tooltip: @tr("Each start of the app opens LIGHTING in SHOW with DMX OUT on");
                toggled(on) => { Lighting.set-autostart(on); }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    HorizontalLayout {
        spacing: Theme.s2;
        Caps { text: @tr("CALM AFTER"); vertical-alignment: center; }
        Stepper {
            accessible-id: "lighting.unattended.calm"; accessible-role: spinbox; accessible-value: self.value;
            a11y-prev: "lighting.unattended.calm.down"; a11y-next: "lighting.unattended.calm.up";
            value: Lighting.calm-after; template: "000 S"; size: 26px;
            tooltip: @tr("Silence for this long fades the rig to a calm warm wash");
            step(d) => { Lighting.step-calm(d); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    Body {
        color: Theme.bone-3;
        text: !Lighting.pin-set ? @tr("Set a setup PIN first: the PIN is what takes the show back.")
            : @tr("The show follows the music and comes back by itself after a restart; on silence the rig fades to a calm warm wash. The keys, the lighting controller and OSC are locked, fog and lasers stay locked out, and every limit above holds. LOCK the setup when you leave.");
    }
    }
}

// [34] A separate lighting operator: a controller of its own, OSC in, and
// the music sent to another instance on the local network.
component RemoteTab inherits Flickable {
    content-height: max(col.min-height, col.preferred-height) + Theme.s5;
    col := VerticalLayout {
        width: root.width;
        alignment: start;
        spacing: Theme.s2;
        HorizontalLayout {
            spacing: Theme.s2;
            Caps { text: @tr("LIGHTING CONTROLLER"); vertical-alignment: center; horizontal-stretch: 1; }
            PlateButton {
                accessible-id: "lighting.remote.refresh"; accessible-role: button;
                compact: true; label: @tr("REFRESH"); tooltip: @tr("Look for MIDI controllers again");
                clicked => { Lighting.refresh-midi(); }
            }
        }
        Body { color: Theme.bone-3; text: @tr("Give one controller to the lights: it plays them with the lighting layout (pads, pages, group masters, blackout, flash, strobe, fog) while another controller keeps the decks."); }
        if Lighting.midi-inputs.length == 0: Body { text: @tr("No MIDI controller found. Plug it in and press REFRESH."); color: Theme.bone-3; }
        for p[i] in Lighting.midi-inputs: Rectangle {
            accessible-id: "lighting.remote.controller" + i; accessible-role: list-item;
            accessible-value: p + (p == Lighting.light-controller ? " lights" : "");
            height: 44px;
            border-radius: Theme.r-control;
            background: p == Lighting.light-controller ? Theme.plate : transparent;
            Rectangle { x: 0; width: 3px; background: p == Lighting.light-controller ? Theme.attention : transparent; }
            HorizontalLayout {
                padding-left: Theme.s2; padding-right: Theme.s1; spacing: Theme.s2;
                Text {
                    text: p; font-family: Theme.family; font-size: Theme.control; color: Theme.bone;
                    vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    PlateButton {
                        accessible-id: "lighting.remote.controller" + i + ".use"; accessible-role: button;
                        compact: true; label: p == Lighting.light-controller ? @tr("GIVE BACK") : @tr("USE FOR LIGHTS");
                        active: p == Lighting.light-controller; tone: Theme.attention;
                        tooltip: p == Lighting.light-controller ? @tr("The controller goes back to its own mapping") : @tr("This controller plays the lights with the lighting layout");
                        clicked => { Lighting.use-controller(p == Lighting.light-controller ? -1 : i); }
                    }
                }
            }
        }
        if Lighting.light-controller != "": Caps {
            accessible-id: "lighting.remote.controller-note"; accessible-role: text; accessible-value: self.text;
            text: Lighting.light-controller-note; overflow: elide; color: Theme.bone-3;
        }
        HLine { }
        HorizontalLayout {
            spacing: Theme.s2;
            Caps { text: @tr("OSC IN"); vertical-alignment: center; horizontal-stretch: 1; }
            VerticalLayout {
                horizontal-stretch: 0;
                alignment: center;
                LineToggle {
                    accessible-id: "lighting.remote.osc-in"; accessible-role: checkbox;
                    label: @tr("LISTEN"); checked: Lighting.osc-in;
                    tooltip: @tr("Take lighting commands and music over OSC on the port below");
                    toggled(on) => { Lighting.set-osc-in(on); }
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.s2;
            Caps { text: @tr("UDP PORT"); vertical-alignment: center; }
            Field {
                accessible-id: "lighting.remote.osc-port"; accessible-role: text-input;
                width: 90px; text: Lighting.osc-port; placeholder: "9300";
                accepted(t) => { Lighting.set-osc-port(t); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Caps {
            accessible-id: "lighting.remote.osc-note"; accessible-role: text; accessible-value: self.text;
            text: Lighting.osc-note; overflow: elide; color: Lighting.osc-in ? Theme.bone-2 : Theme.bone-3;
        }
        Body { color: Theme.bone-3; text: @tr("Off by default. While on, any device on the local network can play the lights: a tablet, a second computer, a show controller. The addresses are in the guide."); }
        HLine { }
        Caps { text: @tr("SEND THE MUSIC"); }
        HorizontalLayout {
            spacing: Theme.s2;
            send := Field {
                accessible-id: "lighting.remote.send-to"; accessible-role: text-input;
                horizontal-stretch: 1; text: Lighting.osc-send-to; placeholder: "192.168.1.20:9300";
            }
            VerticalLayout {
                horizontal-stretch: 0;
                alignment: center;
                LineToggle {
                    accessible-id: "lighting.remote.send"; accessible-role: checkbox;
                    label: @tr("SEND"); checked: Lighting.osc-send;
                    tooltip: @tr("Send tempo, beat, phrase and energy to the address on the left");
                    toggled(on) => { Lighting.set-osc-send(on, send.text); }
                }
            }
        }
        Caps {
            accessible-id: "lighting.remote.send-note"; accessible-role: text; accessible-value: self.text;
            text: Lighting.osc-send-note; overflow: elide; color: Theme.bone-3;
        }
        Body { color: Theme.bone-3; text: @tr("Sends the tempo, beat, phrase and energy of the deck you hear 20 times a second. On the other computer turn OSC IN on and choose MUSIC FROM NETWORK under SHOW › TRIGGERS."); }
    }
}

// [36] DJ events as triggers, and the music the show follows.
component TriggersCentre inherits VerticalLayout {
    spacing: Theme.s2;
    HorizontalLayout {
        height: 26px; spacing: Theme.s2;
        Caps { text: @tr("MUSIC FROM"); vertical-alignment: center; }
        HorizontalLayout {
            spacing: Theme.s1;
            for m in [{ id: "decks", label: @tr("DECKS") }, { id: "input", label: @tr("AUDIO INPUT") }, { id: "network", label: @tr("NETWORK") }]: PlateButton {
                accessible-id: "lighting.source." + m.id; accessible-role: tab;
                compact: true; label: m.label; selected: Lighting.source == m.id; horizontal-stretch: 0;
                tooltip: m.id == "decks" ? @tr("The show follows the decks of this app")
                    : m.id == "input" ? @tr("The show follows an audio input (line-in or a microphone) by its beat and level")
                    : @tr("The show follows another OpenDJDecks on the network (OSC IN under SETUP › REMOTE)");
                clicked => { Lighting.set-source(m.id); }
            }
        }
        Caps {
            accessible-id: "lighting.source.text"; accessible-role: text; accessible-value: self.text;
            text: Lighting.source-text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; color: Theme.bone-2;
        }
    }
    HLine { }
    HorizontalLayout {
        height: 26px; spacing: Theme.s2;
        Caps { text: @tr("DJ EVENTS"); vertical-alignment: center; }
        Caps {
            accessible-id: "lighting.triggers.last"; accessible-role: text; accessible-value: self.text;
            text: Lighting.last-event == "" ? "" : @tr("LAST: {}", Lighting.last-event);
            overflow: elide; horizontal-stretch: 1; vertical-alignment: center; color: Theme.bone-3;
        }
    }
    HorizontalLayout {
        height: 18px; spacing: Theme.s2; padding-left: Theme.s3;
        Caps { text: @tr("WHEN"); horizontal-stretch: 1; min-width: 60px; vertical-alignment: center; }
        Caps { text: @tr("PLAYS"); width: 230px; vertical-alignment: center; }
        Caps { text: @tr("FOR"); width: 130px; vertical-alignment: center; }
    }
    HLine { }
    Flickable {
        vertical-stretch: 1;
        mouse-drag-pan-enabled: false;
        content-height: rows.preferred-height;
        rows := VerticalLayout {
            width: parent.width;
            alignment: start;
            for t[i] in Lighting.triggers: Rectangle {
                accessible-id: "lighting.triggers.row" + i; accessible-role: list-item;
                accessible-value: t.event + " " + t.plays + " " + t.beats + (t.active ? " active" : "");
                height: 34px;
                HorizontalLayout {
                    spacing: Theme.s2;
                    // Playing now: the sodium tick.
                    VerticalLayout { padding-top: Theme.s1; padding-bottom: Theme.s1; width: Theme.s3 - Theme.s2; VLine { tone: t.active ? Theme.attention : transparent; } }
                    Text {
                        text: t.event; font-family: Theme.family; font-size: Theme.control;
                        font-weight: t.set ? Theme.weight-semi : Theme.weight-medium;
                        color: t.set ? Theme.bone : Theme.bone-3;
                        vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 60px;
                    }
                    VerticalLayout {
                        alignment: center;
                        Stepper {
                            accessible-id: "lighting.triggers.row" + i + ".plays"; accessible-role: spinbox; accessible-value: self.value;
                            a11y-prev: "lighting.triggers.row" + i + ".plays.prev"; a11y-next: "lighting.triggers.row" + i + ".plays.next";
                            width: 230px; size: 26px; value: t.plays; template: "CHASE 4.8 MUSIC"; lit: t.set;
                            tooltip: @tr("What the event plays: nothing, RELEASE, a pad's look or chase, or a cue of the stack");
                            step(d) => { Lighting.trigger-plays(i, d); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Stepper {
                            accessible-id: "lighting.triggers.row" + i + ".for"; accessible-role: spinbox; accessible-value: self.value;
                            a11y-prev: "lighting.triggers.row" + i + ".for.down"; a11y-next: "lighting.triggers.row" + i + ".for.up";
                            width: 130px; size: 26px; value: t.beats; template: "UNTIL NEXT"; enabled: t.set;
                            tooltip: @tr("How long it plays, in beats, or until the next event");
                            step(d) => { Lighting.trigger-beats(i, d); }
                        }
                    }
                }
            }
        }
    }
    Body { text: @tr("A DJ event plays a pad's look or chase or a cue of the stack over what runs, for the beats set or until the next event; RELEASE hands back. A drop or a breakdown wins over PHRASE CHANGES. Everything stays within the safety limits."); color: Theme.bone-3; }
}

// [37] SHOW while the show runs unattended: locked until the PIN.
component UnattendedNote inherits VerticalLayout {
    alignment: start;
    spacing: Theme.s2;
    HorizontalLayout {
        height: 18px; spacing: Theme.s2;
        VLine { tone: Theme.live; }
        Caps { text: @tr("UNATTENDED"); color: Theme.attention; vertical-alignment: center; }
    }
    Text {
        accessible-id: "lighting.unattended.state"; accessible-role: text; accessible-value: self.text;
        text: Lighting.unattended-text; wrap: word-wrap;
        font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi; color: Theme.bone;
    }
    Body { text: @tr("The show runs by itself and follows the music; on silence it fades to a calm warm wash. The keys, the lighting controller and OSC are locked; BLACKOUT stays. The setup PIN takes over."); }
    HorizontalLayout {
        spacing: Theme.s2;
        pin := Field {
            accessible-id: "lighting.unattended.pin"; accessible-role: text-input;
            input-type: InputType.password; placeholder: @tr("PIN"); horizontal-stretch: 1;
            accepted(t) => { Lighting.unlock(t); self.text = ""; }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            PlateButton {
                accessible-id: "lighting.unattended.unlock"; accessible-role: button;
                compact: true; label: @tr("TAKE OVER"); tooltip: @tr("Open the show and the setup with the PIN");
                clicked => { Lighting.unlock(pin.text); pin.text = ""; }
            }
        }
    }
    if Lighting.pin-error != "": Text {
        text: Lighting.pin-error;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.fault;
    }
}

// [35] Venue profiles, rigs and shows as named files: pick a venue on
// arrival, save, rename, duplicate, delete; one file in and out.
component FilesTab inherits Flickable {
    property <int> chosen: -1;
    property <bool> has: root.chosen >= 0 && root.chosen < Lighting.file-rows.length;
    content-height: max(col.min-height, col.preferred-height) + Theme.s5;
    col := VerticalLayout {
        width: root.width;
        alignment: start;
        spacing: Theme.s2;
        HorizontalLayout {
            spacing: Theme.s1; height: 26px;
            for k in [{ id: "venue", label: @tr("VENUES") }, { id: "rig", label: @tr("RIGS") }, { id: "show", label: @tr("SHOWS") }]: PlateButton {
                accessible-id: "lighting.files." + k.id; accessible-role: tab;
                compact: true; label: k.label; selected: Lighting.files-kind == k.id; horizontal-stretch: 1;
                clicked => { Lighting.choose-files-kind(k.id); root.chosen = -1; }
            }
        }
        Body {
            color: Theme.bone-3;
            text: Lighting.files-kind == "venue" ? @tr("A venue binds a rig to a show and the safety limits. Pick yours when you arrive and press LOAD.")
                : Lighting.files-kind == "rig" ? @tr("A rig is the patch and the outputs.")
                : @tr("A show is the looks, pads, chases, cue lists, the AUTO table and the palette.");
        }
        if Lighting.file-rows.length == 0: Body { text: @tr("Nothing saved yet. Type a name and press SAVE AS NEW."); color: Theme.bone-3; }
        for r[i] in Lighting.file-rows: Rectangle {
            accessible-id: "lighting.files.row" + i; accessible-role: list-item;
            accessible-value: r.name + (r.current ? " in use" : "");
            accessible-item-selectable: true; accessible-item-selected: root.chosen == i;
            height: 40px;
            border-radius: Theme.r-control;
            background: root.chosen == i ? Theme.plate : row.has-hover ? Theme.plate-raised.with-alpha(0.4) : transparent;
            // The chosen row carries the sodium selection tick.
            Rectangle { x: 0; width: 3px; background: root.chosen == i ? Theme.attention : transparent; }
            HorizontalLayout {
                padding-left: Theme.s2; padding-right: Theme.s2; spacing: Theme.s2;
                VerticalLayout {
                    alignment: center; horizontal-stretch: 1; spacing: 0;
                    Text { text: r.name; font-family: Theme.family; font-size: Theme.body; color: Theme.bone; overflow: elide; }
                    Text { text: r.detail; font-family: Theme.family; font-size: Theme.label; color: Theme.bone-3; overflow: elide; }
                }
                if r.current: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: Theme.s1; height: 16px;
                        VLine { tone: Theme.live; }
                        Caps { text: @tr("IN USE"); vertical-alignment: center; color: Theme.bone-2; }
                    }
                }
            }
            row := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.chosen = i; }
                double-clicked => { root.chosen = i; Lighting.file-load(i); }
            }
        }
        HorizontalLayout {
            spacing: Theme.s1;
            PlateButton {
                accessible-id: "lighting.files.load"; accessible-role: button;
                compact: true; label: @tr("LOAD"); tone: Theme.live; enabled: root.has; horizontal-stretch: 1;
                tooltip: Lighting.files-kind == "venue" ? @tr("Load the venue: its rig, its show and its safety limits") : @tr("Load it in place of the one in use");
                clicked => { Lighting.file-load(root.chosen); }
            }
            PlateButton {
                accessible-id: "lighting.files.save"; accessible-role: button;
                compact: true; label: @tr("SAVE"); enabled: root.has; horizontal-stretch: 1;
                tooltip: @tr("Save what runs now under this name");
                clicked => { Lighting.file-save(root.chosen); }
            }
        }
        HorizontalLayout {
            spacing: Theme.s1;
            PlateButton {
                accessible-id: "lighting.files.duplicate"; accessible-role: button;
                compact: true; label: @tr("DUPLICATE"); enabled: root.has; horizontal-stretch: 1;
                tooltip: @tr("Make a copy under a new name");
                clicked => { Lighting.file-duplicate(root.chosen); }
            }
            PlateButton {
                accessible-id: "lighting.files.delete"; accessible-role: button;
                compact: true; label: @tr("DELETE"); tone: Theme.fault; enabled: root.has; horizontal-stretch: 1;
                tooltip: @tr("Delete this file (what runs now stays)");
                clicked => { Lighting.file-delete(root.chosen); root.chosen = -1; }
            }
        }
        name := Field {
            accessible-id: "lighting.files.name"; accessible-role: text-input;
            placeholder: @tr("Name");
            accepted(t) => { Lighting.file-save-as(t); self.text = ""; }
        }
        HorizontalLayout {
            spacing: Theme.s1;
            PlateButton {
                accessible-id: "lighting.files.rename"; accessible-role: button;
                compact: true; label: @tr("RENAME"); enabled: root.has && name.text != ""; horizontal-stretch: 1;
                tooltip: @tr("Give the chosen file the name typed above");
                clicked => { Lighting.file-rename(root.chosen, name.text); name.text = ""; }
            }
            PlateButton {
                accessible-id: "lighting.files.save-as"; accessible-role: button;
                compact: true; label: @tr("SAVE AS NEW"); glyph: "plus"; enabled: name.text != ""; horizontal-stretch: 1;
                tooltip: @tr("Save what runs now under the name typed above");
                clicked => { Lighting.file-save-as(name.text); name.text = ""; }
            }
        }
        if Lighting.files-note != "": Body { text: Lighting.files-note; color: Theme.bone-2; }
        HLine { }
        Caps { text: @tr("ONE FILE"); }
        HorizontalLayout {
            spacing: Theme.s1;
            PlateButton {
                accessible-id: "lighting.files.import"; accessible-role: button;
                compact: true; label: @tr("IMPORT…"); horizontal-stretch: 1;
                tooltip: @tr("Open a venue with its rig and show from one file");
                clicked => { Lighting.file-import(); }
            }
            PlateButton {
                accessible-id: "lighting.files.export"; accessible-role: button;
                compact: true; label: @tr("EXPORT…"); horizontal-stretch: 1;
                tooltip: @tr("Write the venue, rig and show in use to one file");
                clicked => { Lighting.file-export(); }
            }
        }
        Body { text: @tr("The files sit in the lighting folder next to the library."); color: Theme.bone-3; }
    }
}

component SetupPanel inherits VerticalLayout {
    spacing: Theme.s2;
    padding: Theme.s3;
    // The venue in use, and the files.
    HorizontalLayout {
        height: 26px; spacing: Theme.s2;
        Caps { text: @tr("VENUE"); vertical-alignment: center; }
        Text {
            accessible-id: "lighting.venue"; accessible-role: text; accessible-value: self.text;
            text: Lighting.venue == "" ? @tr("None") : Lighting.venue;
            font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
            color: Lighting.venue == "" ? Theme.bone-3 : Theme.bone;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
        }
        PlateButton {
            accessible-id: "lighting.setup.remote"; accessible-role: tab;
            compact: true; label: @tr("REMOTE"); selected: Lighting.setup-tab == "remote";
            tooltip: @tr("A second controller for the lights, OSC in, and the music sent to another computer");
            clicked => { Lighting.setup-tab = Lighting.setup-tab == "remote" ? "rig" : "remote"; }
        }
        PlateButton {
            accessible-id: "lighting.setup.files"; accessible-role: tab;
            compact: true; label: @tr("FILES"); selected: Lighting.setup-tab == "files";
            tooltip: @tr("Venues, rigs and shows: load, save, rename, duplicate, import and export");
            clicked => { Lighting.setup-tab = Lighting.setup-tab == "files" ? "rig" : "files"; }
        }
    }
    HorizontalLayout {
        height: 26px;
        spacing: Theme.s1;
        for t in [{ id: "rig", label: @tr("RIG") }, { id: "output", label: @tr("OUTPUT") }, { id: "safety", label: @tr("SAFETY") }]: PlateButton {
            accessible-id: "lighting.setup." + t.id; accessible-role: tab;
            compact: true; label: t.label; selected: Lighting.setup-tab == t.id; horizontal-stretch: 1;
            clicked => { Lighting.setup-tab = t.id; }
        }
        if Lighting.pin-set && !Lighting.locked: PlateButton {
            accessible-id: "lighting.pin.lock"; accessible-role: button;
            compact: true; label: @tr("LOCK"); tooltip: @tr("Lock the setup with the PIN");
            clicked => { Lighting.lock(); }
        }
    }
    if Lighting.locked: LockedSetup { vertical-stretch: 0; }
    if !Lighting.locked && Lighting.setup-tab == "rig": RigTab { vertical-stretch: 0; }
    if !Lighting.locked && Lighting.setup-tab == "output": OutputTab { vertical-stretch: 1; }
    if !Lighting.locked && Lighting.setup-tab == "safety": SafetyTab { vertical-stretch: 1; }
    if !Lighting.locked && Lighting.setup-tab == "files": FilesTab { vertical-stretch: 1; }
    if !Lighting.locked && Lighting.setup-tab == "remote": RemoteTab { vertical-stretch: 1; }
    if Lighting.locked || Lighting.setup-tab == "rig": Rectangle { vertical-stretch: 1; }
}

// Patch table: every fixture with its place. Collisions are kept and shown
// (struck line, the reason in red) rather than refused, so a rig can be
// re-addressed step by step.
component PatchTable inherits VerticalLayout {
    spacing: 0;
    HorizontalLayout {
        height: 26px; spacing: Theme.s2; padding-left: Theme.s3; padding-right: Theme.s1;
        Caps { text: @tr("NAME"); horizontal-stretch: 1; vertical-alignment: center; }
        Caps { text: @tr("GROUP"); width: 90px; vertical-alignment: center; }
        Caps { text: @tr("UNIV"); width: 50px; vertical-alignment: center; }
        Caps { text: @tr("ADDRESS"); width: 62px; vertical-alignment: center; }
        Caps { text: @tr("MODE"); width: 120px; vertical-alignment: center; }
        Caps { text: @tr("CH"); width: 50px; vertical-alignment: center; }
        Caps { text: @tr("CHECK"); width: 130px; vertical-alignment: center; }
        Rectangle { width: 30px + 30px + Theme.s2; }
    }
    HLine { }
    if Lighting.patch-rows.length == 0: Body {
        text: @tr("No fixtures patched yet. Add your lights on the left.");
        color: Theme.bone-3; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 1;
    }
    if Lighting.patch-rows.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: rows.preferred-height;
        rows := VerticalLayout {
            width: parent.width;
            alignment: start;
            for r[i] in Lighting.patch-rows: Rectangle {
                accessible-id: "lighting.patch.row" + i; accessible-role: list-item;
                accessible-value: r.name + " " + r.universe + "." + r.address + " " + r.clash;
                height: 32px;
                background: ta.has-hover ? Theme.plate-raised.with-alpha(0.4) : transparent;
                ta := TouchArea { }
                HorizontalLayout {
                    spacing: Theme.s2; padding-right: Theme.s1;
                    VerticalLayout {
                        padding-top: Theme.s1; padding-bottom: Theme.s1; padding-left: Theme.s1; width: Theme.s3;
                        if r.clash != "": VLine { tone: Theme.bone-3; form: "struck"; }
                    }
                    Text { text: r.name; font-family: Theme.family; font-size: Theme.body; color: Theme.bone; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Text { text: r.group; width: 90px; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                    VerticalLayout {
                        alignment: center;
                        Field {
                            accessible-id: "lighting.patch.universe" + i; accessible-role: text-input;
                            width: 50px; height: 26px; text: r.universe; enabled: !Lighting.locked;
                            accepted(t) => { Lighting.patch-universe(i, t); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Field {
                            accessible-id: "lighting.patch.address" + i; accessible-role: text-input;
                            width: 62px; height: 26px; text: r.address; enabled: !Lighting.locked;
                            accepted(t) => { Lighting.patch-address(i, t); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Stepper {
                            accessible-id: "lighting.patch.mode" + i; accessible-role: spinbox; accessible-value: r.mode;
                            a11y-prev: "lighting.patch.mode" + i + ".prev"; a11y-next: "lighting.patch.mode" + i + ".next";
                            width: 120px; size: 26px; value: r.mode; template: "Custom"; enabled: !Lighting.locked;
                            tooltip: @tr("DMX mode of the fixture");
                            step(d) => { Lighting.patch-mode(i, d); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Field {
                            accessible-id: "lighting.patch.channels" + i; accessible-role: text-input;
                            width: 50px; height: 26px; text: r.channels; enabled: !Lighting.locked;
                            accepted(t) => { Lighting.patch-channels(i, t); }
                        }
                    }
                    Text {
                        accessible-id: "lighting.patch.clash" + i; accessible-role: text; accessible-value: self.text;
                        width: 130px; text: r.clash != "" ? r.clash : r.hazard == "fog" ? @tr("FOG · LOCKOUT") : r.hazard == "laser" ? @tr("LASER · LOCKOUT") : "";
                        font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: Theme.tracking-index;
                        color: r.clash != "" ? Theme.fault : Theme.bone-3; vertical-alignment: center; overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        PlateButton {
                            accessible-id: "lighting.patch.identify" + i; accessible-role: button;
                            accessible-checkable: true; accessible-checked: r.identify;
                            compact: true; label: "ID"; width: 30px; active: r.identify; tone: Theme.attention;
                            tooltip: @tr("Identify: blink this fixture");
                            clicked => { Lighting.identify(i); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        PlateButton {
                            accessible-id: "lighting.patch.remove" + i; accessible-role: button;
                            compact: true; glyph: "close"; width: 30px; enabled: !Lighting.locked;
                            tooltip: @tr("Remove this fixture");
                            clicked => { Lighting.remove-fixture(i); }
                        }
                    }
                }
            }
        }
    }
    Body { text: @tr("Type a value and press Enter to apply it."); color: Theme.bone-3; height: 24px; vertical-alignment: center; }
}

// What leaves the computer: 512 channels of one universe after the safety
// limits, 32 to a row.
component ChannelGrid inherits VerticalLayout {
    spacing: Theme.s2;
    HorizontalLayout {
        spacing: Theme.s1; height: 26px;
        for u[i] in Lighting.universes: PlateButton {
            accessible-id: "lighting.channels.universe" + i; accessible-role: tab;
            compact: true; label: u; selected: Lighting.channel-universe == i;
            clicked => { Lighting.choose-universe(i); }
        }
        Rectangle { horizontal-stretch: 1; }
        Caps { text: @tr("AS SENT, AFTER THE SAFETY LIMITS"); vertical-alignment: center; }
    }
    if Lighting.universes.length == 0: Body { text: @tr("No fixtures patched yet. Add your lights on the left."); color: Theme.bone-3; }
    grid := Rectangle {
        vertical-stretch: 1;
        accessible-id: "lighting.channels"; accessible-role: table;
        property <length> label-w: 30px;
        property <length> cw: (self.width - self.label-w) / 32;
        property <length> ch: min(self.height / 16, 34px);
        for r in 16: Text {
            x: 0; y: r * grid.ch; width: grid.label-w - 4px; height: grid.ch;
            text: r * 32 + 1;
            font-family: Theme.family; font-size: Theme.label; color: Theme.bone-3;
            horizontal-alignment: right; vertical-alignment: center;
        }
        for v[i] in Lighting.channels: Rectangle {
            x: grid.label-w + Math.mod(i, 32) * grid.cw;
            y: Math.floor(i / 32) * grid.ch;
            width: grid.cw - 1px; height: grid.ch - 1px;
            background: Theme.plate;
            Rectangle {
                y: parent.height - self.height; height: parent.height * v / 255;
                background: Theme.bone-3.with-alpha(0.45);
            }
            // The value where the cell is wide enough for three digits.
            Text {
                text: grid.cw >= 20px ? v : ""; font-family: Theme.family; font-size: Theme.label;
                color: v > 0 ? Theme.bone : Theme.bone-3;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}

// One pad of an own look or chase. An empty pad is a hollow outline; a
// look shows its colours along the bottom (the preview follows every
// edit); the pad in control is filled in the live tone, the one open in
// the editor carries the sodium selection tick.
component LightPad inherits Rectangle {
    in property <LightPadView> pad;
    in property <string> a11y;
    callback pressed(bool);
    property <bool> empty: root.pad.name == "";
    property <bool> lit: root.pad.on || (touch.pressed && !root.empty);
    accessible-role: button;
    accessible-id: root.a11y;
    accessible-value: root.pad.number + " " + root.pad.name + (root.pad.chase ? " chase" : "") + (root.pad.flash ? " flash" : " latch") + (root.pad.on ? " on" : "") + (root.pad.selected ? " selected" : "");
    border-radius: Theme.r-control;
    background: root.empty ? (touch.has-hover ? Theme.plate.with-alpha(0.5) : transparent)
        : Theme.face(true, touch.pressed, touch.has-hover, false, root.lit, Theme.live);
    border-width: root.empty ? Theme.hair : 0px;
    border-color: Theme.rule-strong;
    property <color> ink: root.empty ? Theme.bone-3 : Theme.ink(true, touch.pressed, touch.has-hover, false, root.lit);
    Text {
        x: 8px; y: 5px;
        text: root.pad.number;
        font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: Theme.tracking-index;
        color: root.ink;
    }
    if !root.empty && (root.pad.chase || root.pad.flash): Text {
        x: parent.width - self.width - 8px; y: 5px;
        text: root.pad.chase && root.pad.flash ? @tr("CHASE · FLASH") : root.pad.chase ? @tr("CHASE") : @tr("FLASH");
        font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: Theme.tracking-index;
        color: root.ink;
    }
    Text {
        x: 8px; width: parent.width - 16px;
        y: (parent.height - self.height) / 2 + 2px;
        text: root.empty ? @tr("EMPTY") : root.pad.name;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
        letter-spacing: root.empty ? Theme.tracking-index : 0px;
        color: root.ink; overflow: elide;
    }
    if !root.empty: HorizontalLayout {
        x: 8px; y: parent.height - 10px; width: parent.width - 16px; height: 4px;
        spacing: Theme.key-gap;
        for c in root.pad.colors: Rectangle { background: c; border-radius: 1px; }
    }
    if root.pad.selected: Rectangle {
        x: 0; y: (parent.height - 16px) / 2; width: 3px; height: 16px;
        background: Theme.attention;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.pressed(true); }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) { root.pressed(false); }
        }
    }
}

// The eight pads of the current page, four to a row.
component PadGrid inherits Rectangle {
    in property <string> prefix;
    in property <length> gap: 4px;
    property <length> cw: (self.width - 3 * self.gap) / 4;
    property <length> ch: (self.height - self.gap) / 2;
    for p[i] in Lighting.pads: LightPad {
        x: Math.mod(i, 4) * (root.cw + root.gap);
        y: Math.floor(i / 4) * (root.ch + root.gap);
        width: root.cw; height: root.ch;
        pad: p; a11y: root.prefix + i;
        pressed(on) => { Lighting.pad-pressed(i, on); }
    }
}

// PAGE 1 to 4 as one segmented control.
component PageTabs inherits HorizontalLayout {
    in property <string> prefix;
    in property <bool> tall;
    spacing: Theme.key-gap;
    for n in 4: PlateButton {
        accessible-id: root.prefix + (n + 1); accessible-role: tab;
        label: n + 1; selected: Lighting.page == n; tall: root.tall; compact: !root.tall;
        width: root.tall ? 44px : 30px;
        tooltip: @tr("Page {} of the pads", n + 1);
        clicked => { Lighting.choose-page(n); }
    }
}

// Group masters: one fader per group.
component GroupMasters inherits HorizontalLayout {
    in property <string> prefix;
    in property <length> fader-w: 30px;
    spacing: Theme.s1;
    for m[i] in Lighting.masters: VerticalLayout {
        width: root.fader-w + 10px;
        spacing: Theme.key-gap;
        HorizontalLayout {
            alignment: center; vertical-stretch: 1;
            Fader {
                accessible-id: root.prefix + i; accessible-role: slider; accessible-value: Math.round(m.level * 100) + " %";
                width: root.fader-w; value: m.level; tone: Theme.bone;
                tooltip: @tr("Level of the group {}", m.name);
                changed(v) => { Lighting.group-master(i, v); }
            }
        }
        Caps { text: m.name; horizontal-alignment: center; overflow: elide; }
    }
}

// The pad open in PADS: name, latch or flash, and what it sets per group
// (a look) or the looks it steps through (a chase).
component LookEditor inherits VerticalLayout {
    spacing: Theme.s2;
    if Lighting.edit-number == "": Body { text: @tr("Click a pad to open it here."); color: Theme.bone-3; }
    if Lighting.edit-number != "" && !Lighting.edit-has: VerticalLayout {
        spacing: Theme.s2;
        Caps { text: @tr("PAD {} IS EMPTY", Lighting.edit-number); }
        HorizontalLayout {
            spacing: Theme.s1;
            PlateButton { accessible-id: "lighting.look.new"; accessible-role: button; compact: true; label: @tr("NEW LOOK"); glyph: "plus"; tone: Theme.live; tooltip: @tr("A look that sets the groups you choose"); clicked => { Lighting.pad-new(false); } }
            PlateButton { accessible-id: "lighting.look.new-chase"; accessible-role: button; compact: true; label: @tr("NEW CHASE"); glyph: "plus"; tooltip: @tr("A chase that steps through looks on the beat"); clicked => { Lighting.pad-new(true); } }
            PlateButton { accessible-id: "lighting.look.capture"; accessible-role: button; compact: true; label: @tr("FROM PRO"); tooltip: @tr("A look from the group settings of PRO mode"); clicked => { Lighting.pad-capture(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    if Lighting.edit-has: VerticalLayout {
        spacing: Theme.s2;
        HorizontalLayout {
            spacing: Theme.s2;
            Caps { text: Lighting.edit-number; vertical-alignment: center; color: Theme.attention; }
            Field {
                accessible-id: "lighting.look.name"; accessible-role: text-input;
                text: Lighting.edit-name; placeholder: @tr("Name"); horizontal-stretch: 1;
                accepted(t) => { Lighting.pad-rename(t); }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                HorizontalLayout {
                    spacing: Theme.key-gap;
                    PlateButton { accessible-id: "lighting.look.latch"; accessible-role: tab; compact: true; horizontal-stretch: 0; label: @tr("LATCH"); selected: !Lighting.edit-flash; tooltip: @tr("On until pressed again or released"); clicked => { Lighting.pad-flash(false); } }
                    PlateButton { accessible-id: "lighting.look.flash"; accessible-role: tab; compact: true; horizontal-stretch: 0; label: @tr("FLASH"); selected: Lighting.edit-flash; tooltip: @tr("On while held"); clicked => { Lighting.pad-flash(true); } }
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                PlateButton { accessible-id: "lighting.look.delete"; accessible-role: button; compact: true; glyph: "close"; width: 30px; tone: Theme.fault; tooltip: @tr("Delete this look"); clicked => { Lighting.pad-delete(); } }
            }
        }
        if !Lighting.edit-chase: Flickable {
            vertical-stretch: 1;
            content-height: groups.preferred-height;
            groups := VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: Theme.s2;
                if Lighting.edit-groups.length == 0: Body { text: @tr("Patch fixtures in RIG first: a look sets groups."); color: Theme.bone-3; }
                for g[gi] in Lighting.edit-groups: VerticalLayout {
                    spacing: Theme.key-gap;
                    HorizontalLayout {
                        height: 26px; spacing: Theme.s2;
                        VerticalLayout { padding-top: Theme.s1; padding-bottom: Theme.s1; VLine { tone: g.set ? Theme.live : Theme.rule-strong; form: g.set ? "solid" : "half"; } }
                        Text {
                            accessible-id: "lighting.look.group" + gi; accessible-role: text; accessible-value: g.name + (g.set ? " set" : " underneath");
                            text: g.name; font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
                            color: g.set ? Theme.bone : Theme.bone-3; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                        }
                        Stepper {
                            accessible-id: "lighting.look.group" + gi + ".program"; accessible-role: spinbox; accessible-value: self.value;
                            a11y-prev: "lighting.look.group" + gi + ".program.prev"; a11y-next: "lighting.look.group" + gi + ".program.next";
                            value: g.program; template: "BREATHE"; size: 26px; lit: g.set;
                            tooltip: @tr("Program of the group in this look (— keeps what runs underneath)");
                            step(d) => { Lighting.pad-group-program(gi, d); }
                        }
                        Stepper {
                            accessible-id: "lighting.look.group" + gi + ".level"; accessible-role: spinbox; accessible-value: self.value;
                            a11y-prev: "lighting.look.group" + gi + ".level.down"; a11y-next: "lighting.look.group" + gi + ".level.up";
                            value: g.level; template: "100 %"; size: 26px; lit: g.set;
                            tooltip: @tr("Level of the group in this look");
                            step(d) => { Lighting.pad-group-level(gi, d); }
                        }
                        PlateButton {
                            accessible-id: "lighting.look.group" + gi + ".clear"; accessible-role: button;
                            compact: true; glyph: "close"; width: 26px; enabled: g.set;
                            tooltip: @tr("Leave this group to what runs underneath");
                            clicked => { Lighting.pad-group-clear(gi); }
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.s3;
                        Swatches { a11y: "lighting.look.group" + gi + ".color"; chip: 20px; current: g.color; chosen(i) => { Lighting.pad-group-color(gi, i); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
        if Lighting.edit-chase: VerticalLayout {
            spacing: Theme.s2;
            HorizontalLayout {
                spacing: Theme.s2;
                Caps { text: @tr("STEPS"); vertical-alignment: center; horizontal-stretch: 1; }
                Stepper {
                    accessible-id: "lighting.look.step-beats"; accessible-role: spinbox; accessible-value: self.value;
                    a11y-prev: "lighting.look.step-beats.down"; a11y-next: "lighting.look.step-beats.up";
                    value: Lighting.edit-step-beats; template: "1/4 BEAT"; size: 26px; lit: true;
                    tooltip: @tr("How long each step lasts");
                    step(d) => { Lighting.pad-step-beats(d); }
                }
                PlateButton {
                    accessible-id: "lighting.look.add-steps"; accessible-role: button;
                    accessible-checkable: true; accessible-checked: Lighting.adding-steps;
                    compact: true; label: @tr("ADD STEPS"); armed: Lighting.adding-steps; tone: Theme.attention;
                    tooltip: @tr("Then click the looks to add, in order");
                    clicked => { Lighting.pad-add-steps(!Lighting.adding-steps); }
                }
            }
            Body {
                color: Theme.bone-3;
                text: Lighting.adding-steps ? @tr("Click the looks to add, in order. ADD STEPS again ends it.") : @tr("A chase steps through looks on the beat of the music.");
            }
            for st[si] in Lighting.edit-steps: Rectangle {
                accessible-id: "lighting.look.step" + si; accessible-role: list-item; accessible-value: st;
                height: 24px;
                HorizontalLayout {
                    padding-left: Theme.s2; spacing: Theme.s2;
                    Text { text: (si + 1) + "  " + st; font-family: Theme.family; font-size: Theme.control; color: Theme.bone; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    PlateButton { accessible-id: "lighting.look.step" + si + ".remove"; accessible-role: button; compact: true; glyph: "close"; width: 26px; tooltip: @tr("Remove this step"); clicked => { Lighting.pad-step-remove(si); } }
                }
            }
        }
    }
}

// PADS in the LIGHTING view: the page, its pads, the editor, and the group
// masters beside them.
component PadsCentre inherits HorizontalLayout {
    spacing: Theme.s3;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Theme.s2;
        HorizontalLayout {
            height: 26px; spacing: Theme.s2;
            Caps { text: @tr("PAGE"); vertical-alignment: center; }
            PageTabs { prefix: "lighting.page"; }
            Rectangle { horizontal-stretch: 1; }
            PlateButton {
                accessible-id: "lighting.pads.edit"; accessible-role: button;
                accessible-checkable: true; accessible-checked: Lighting.editing;
                compact: true; horizontal-stretch: 0; label: @tr("EDIT"); active: Lighting.editing; tone: Theme.attention;
                tooltip: Lighting.editing ? @tr("Back to playing the pads") : @tr("Click a pad to make or change its look");
                clicked => { Lighting.set-editing(!Lighting.editing); }
            }
        }
        PadGrid { prefix: "lighting.pad"; height: 132px; }
        HLine { }
        if !Lighting.editing: Body {
            text: @tr("Press a pad to play it: a latch pad stays on until pressed again, a flash pad is on while held. EDIT opens a pad to make or change its look.");
            color: Theme.bone-3;
        }
        if Lighting.editing: LookEditor { vertical-stretch: 1; }
        if !Lighting.editing: Rectangle { vertical-stretch: 1; }
    }
    VLine { }
    VerticalLayout {
        spacing: Theme.s2;
        Caps { text: @tr("GROUP MASTERS"); }
        if Lighting.masters.length == 0: Body { text: @tr("No groups yet."); color: Theme.bone-3; width: 110px; }
        GroupMasters { prefix: "lighting.master.group"; vertical-stretch: 1; }
    }
}

// The palette choice, as a segmented grid.
component PaletteList inherits Rectangle {
    in property <int> columns: 3;
    property <length> cw: (self.width - 2px) / root.columns;
    // Touch: 44 px rows.
    property <length> rh: Theme.touch-mode ? 44px : 26px;
    height: Math.ceil(Lighting.palettes.length / root.columns) * root.rh + 2px;
    background: Theme.plate; border-radius: Theme.r-control;
    for name[i] in Lighting.palettes: Rectangle {
        accessible-id: "lighting.auto.palette" + i; accessible-role: tab; accessible-value: name;
        accessible-label: TooltipState.name-for(self.accessible-id, name, "");
        KeyFocus { activate => { Lighting.choose-palette(i); } }
        accessible-item-selectable: true; accessible-item-selected: i == Lighting.palette;
        x: 1px + Math.mod(i, root.columns) * root.cw;
        y: 1px + Math.floor(i / root.columns) * root.rh;
        width: root.cw; height: root.rh;
        border-radius: Theme.r-control;
        background: i == Lighting.palette ? Theme.bone : ta.has-hover ? Theme.plate-raised : transparent;
        Text {
            x: 8px; width: parent.width - 12px; text: name; overflow: elide;
            font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; letter-spacing: 1px;
            color: i == Lighting.palette ? Theme.ground : Theme.bone-2; vertical-alignment: center;
        }
        ta := TouchArea { mouse-cursor: pointer; clicked => { Lighting.choose-palette(i); } }
    }
}

// AUTO you can steer: HOLD and RELEASE, the palette, the phrase-to-look
// table, and the order of who wins.
// The order of who wins, top first, with the layer in control lit.
component OrderChain inherits VerticalLayout {
    accessible-id: "lighting.order"; accessible-role: text; accessible-value: Lighting.layer;
    spacing: Theme.key-gap;
    for row in [[{ id: "blackout", label: @tr("BLACKOUT") }, { id: "momentary", label: @tr("FLASH / STROBE KEY") }, { id: "flash-pad", label: @tr("FLASH PAD") }],
                [{ id: "latched", label: @tr("LATCHED PAD") }, { id: "trigger", label: @tr("TRIGGER") }, { id: "hold", label: @tr("HOLD") }, { id: "base", label: @tr("AUTO") }]]: FlexboxLayout {
        // A row that does not fit (German, a narrow panel) wraps.
        spacing: Theme.s1;
        for item[i] in row: HorizontalLayout {
            spacing: Theme.s1;
            Caps {
                text: item.label;
                color: Lighting.layer == item.id ? (item.id == "blackout" ? Theme.fault : item.id == "base" ? Theme.bone : Theme.attention) : Theme.bone-3;
                font-weight: Lighting.layer == item.id ? Theme.weight-semi : Theme.weight-medium;
            }
            if item.id != "base": Caps { text: "›"; color: Theme.bone-3; }
        }
    }
}

component AutoSection inherits VerticalLayout {
    spacing: Theme.s2;
    Caps { text: @tr("WHO WINS, TOP FIRST"); }
    OrderChain { }
    HorizontalLayout {
        spacing: Theme.s1;
        PlateButton {
            accessible-id: "lighting.auto.hold"; accessible-role: button;
            accessible-checkable: true; accessible-checked: Lighting.hold;
            label: @tr("HOLD"); active: Lighting.hold; tone: Theme.attention; horizontal-stretch: 1;
            tooltip: @tr("Keep AUTO's current look through phrase changes");
            clicked => { Lighting.set-hold(!Lighting.hold); }
        }
        PlateButton {
            accessible-id: "lighting.auto.release"; accessible-role: button;
            label: @tr("RELEASE"); horizontal-stretch: 1;
            enabled: Lighting.layer == "latched" || Lighting.layer == "hold";
            tooltip: @tr("Hand back to AUTO: the latched pad and HOLD end, with a one-beat fade");
            clicked => { Lighting.release(); }
        }
    }
    Caps { text: @tr("PALETTE"); }
    PaletteList { }
    if Lighting.palette == Lighting.palettes.length - 1: HorizontalLayout {
        spacing: Theme.s1; height: 22px;
        for c[i] in Lighting.swatches: Rectangle {
            accessible-id: "lighting.auto.custom" + i; accessible-role: checkbox;
            accessible-checkable: true; accessible-checked: Lighting.custom-colors[i];
            width: 26px;
            background: c;
            border-radius: 2px;
            border-width: Lighting.custom-colors[i] ? 2px : 0px;
            border-color: Theme.bone;
            opacity: Lighting.custom-colors[i] ? 1 : 0.35;
            TouchArea { mouse-cursor: pointer; clicked => { Lighting.custom-color(i); } }
        }
    }
    Caps { text: @tr("PHRASE → LOOK"); }
    for r[ri] in Lighting.auto-rows: HorizontalLayout {
        height: 26px; spacing: Theme.s2;
        VerticalLayout { padding-top: Theme.s1; padding-bottom: Theme.s1; VLine { tone: r.now ? Theme.attention : transparent; } }
        Text { text: r.label; width: 78px; font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: r.now ? Theme.bone : Theme.bone-2; vertical-alignment: center; overflow: elide; }
        Stepper {
            accessible-id: "lighting.auto.row" + ri; accessible-role: spinbox; accessible-value: self.value;
            a11y-prev: "lighting.auto.row" + ri + ".prev"; a11y-next: "lighting.auto.row" + ri + ".next";
            value: r.pick; template: "1.8 PEAK"; size: 26px; lit: r.now; horizontal-stretch: 1;
            tooltip: @tr("What AUTO plays for this phrase: a program or one of your pads");
            step(d) => { Lighting.auto-step(ri, d); }
        }
    }
    Body {
        accessible-id: "lighting.auto.order"; accessible-role: text; accessible-value: self.text;
        color: Theme.bone-3;
        text: @tr("Who wins, from the top: BLACKOUT, the FLASH and STROBE keys, a flash pad while held, the latched pad, HOLD, then AUTO. A pad takes only the groups its look sets. RELEASE hands back to AUTO.");
    }
}

// SHOW: what runs now and how it is played. Everything scrolls but the
// BLACKOUT key, which stays large at the foot of the column.
component ShowPanel inherits VerticalLayout {
    property <string> cue-name;
    spacing: Theme.s2;
    padding: Theme.s3;
    padding-top: Theme.s2;

    if Lighting.show-locked: UnattendedNote { vertical-stretch: 1; }
    if !Lighting.show-locked: Flickable {
        accessible-id: Lighting.mode == "auto" ? "lighting.auto" : "lighting.show.body"; accessible-role: groupbox;
        vertical-stretch: 1;
        // The hold keys (FLASH, STROBE, FOG) act on the press, at once: no
        // drag to scroll (the wheel and trackpad scroll).
        mouse-drag-pan-enabled: false;
        content-height: body.preferred-height;
        body := VerticalLayout {
            width: parent.width;
            alignment: start;
            spacing: Theme.s2;
            HorizontalLayout {
                spacing: Theme.s1;
                for m in [{ id: "auto", label: "AUTO" }, { id: "easy", label: "EASY" }, { id: "pro", label: "PRO" }]: PlateButton {
                    accessible-id: "lighting.mode." + m.id; accessible-role: tab;
                    label: m.label; selected: Lighting.mode == m.id; horizontal-stretch: 1;
                    tooltip: m.id == "auto" ? @tr("The show follows phrases, beat and the mix")
                        : m.id == "easy" ? @tr("One look for the whole rig, locked to the beat")
                        : @tr("Programs and colours per group, cue stack");
                    clicked => { Lighting.set-mode(m.id); }
                }
                Rectangle { width: Theme.s2; }
                VerticalLayout {
                    alignment: center;
                    LineToggle {
                        accessible-id: "lighting.enable"; accessible-role: checkbox;
                        label: @tr("DMX OUT"); checked: Lighting.enabled; tone: Theme.live;
                        tooltip: @tr("Send the show to the outputs");
                        toggled(on) => { Lighting.set-enabled(on); }
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.s3;
                height: 128px;
                VerticalLayout {
                    spacing: Theme.key-gap;
                    // The fader centred over its caption.
                    HorizontalLayout {
                        alignment: center; vertical-stretch: 1;
                        Fader {
                            accessible-id: "lighting.master"; accessible-role: slider; accessible-value: Math.round(Lighting.master * 100) + " %";
                            value: Lighting.master; tone: Theme.attention; vertical-stretch: 1;
                            tooltip: @tr("Master dimmer");
                            changed(v) => { Lighting.set-master(v); }
                        }
                    }
                    Caps { text: @tr("MASTER"); horizontal-alignment: center; }
                }
                VerticalLayout {
                    spacing: Theme.s2; horizontal-stretch: 1;
                    HoldButton {
                        accessible-id: "lighting.flash"; accessible-role: button;
                        label: @tr("FLASH"); on: Lighting.flash; size: 34px; tone: Theme.bone;
                        tooltip: @tr("Full white while held");
                        pressed => { Lighting.flash-held(true); }
                        released => { Lighting.flash-held(false); }
                    }
                    HoldButton {
                        accessible-id: "lighting.strobe"; accessible-role: button;
                        label: @tr("STROBE"); on: Lighting.strobe; size: 34px;
                        tooltip: @tr("Strobe while held");
                        pressed => { Lighting.strobe-held(true); }
                        released => { Lighting.strobe-held(false); }
                    }
                    HorizontalLayout {
                        spacing: Theme.s2;
                        HoldButton {
                            accessible-id: "lighting.fog"; accessible-role: button;
                            label: @tr("FOG"); on: Lighting.fog; size: 34px; tone: Theme.attention; horizontal-stretch: 1;
                            tooltip: Lighting.fog-armed ? @tr("Fog machines on while held") : @tr("Fog is locked out: arm it under SAFETY");
                            pressed => { Lighting.fog-held(true); }
                            released => { Lighting.fog-held(false); }
                        }
                        PlateButton {
                            accessible-id: "lighting.tap"; accessible-role: button;
                            label: Lighting.tap-bpm == "" ? @tr("TAP") : "TAP " + Lighting.tap-bpm; horizontal-stretch: 1;
                            tooltip: @tr("Tap the tempo for the lights when no deck plays");
                            clicked => { Lighting.tap(); }
                        }
                    }
                }
            }
            HLine { }
            // Who is in control now (see AutoSection for the order).
            HorizontalLayout {
                spacing: Theme.s2; height: 18px;
                Caps { text: @tr("IN CONTROL"); vertical-alignment: center; }
                Caps {
                    accessible-id: "lighting.layer"; accessible-role: text; accessible-value: Lighting.layer + " " + Lighting.layer-text;
                    text: Lighting.layer-text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center;
                    color: Lighting.layer == "base" ? Theme.bone-2 : Lighting.layer == "blackout" ? Theme.fault : Theme.attention;
                }
            }
            if Lighting.mode == "auto": AutoSection { }
            if Lighting.mode == "easy": VerticalLayout {
                spacing: Theme.s2;
                Caps { text: @tr("LOOK"); }
                ChoiceList {
                    accessible-id: "lighting.easy.program"; accessible-role: list;
                    items: Lighting.programs; current: Lighting.easy-program; columns: 2; cell-w: 140px;
                    chosen(i) => { Lighting.choose-easy-program(i); }
                }
                Caps { text: @tr("COLOUR"); }
                Swatches { current: Lighting.easy-color; chosen(i) => { Lighting.choose-easy-color(i); } }
            }
            if Lighting.mode == "pro": VerticalLayout {
                spacing: Theme.s2;
                Caps { text: @tr("GROUPS"); }
                for g[gi] in Lighting.groups: VerticalLayout {
                    spacing: Theme.key-gap;
                    Text { text: g.name; font-family: Theme.family; font-size: Theme.control; color: Theme.bone; }
                    // The programs wrap to the column's width.
                    FlexboxLayout {
                        spacing: Theme.key-gap;
                        PlateButton {
                            accessible-id: "lighting.pro.group" + gi + ".follow"; accessible-role: button;
                            compact: true; label: @tr("MUSIC"); selected: g.program < 0;
                            tooltip: @tr("Follow the music");
                            clicked => { Lighting.group-program(gi, -1); }
                        }
                        for p[pi] in Lighting.programs: PlateButton {
                            accessible-id: "lighting.pro.group" + gi + ".program" + pi; accessible-role: button;
                            compact: true; label: p; selected: g.program == pi;
                            clicked => { Lighting.group-program(gi, pi); }
                        }
                    }
                    Swatches { current: g.color; chosen(i) => { Lighting.group-color(gi, i); } }
                    HorizontalLayout {
                        spacing: Theme.s2;
                        PlateButton {
                            accessible-id: "lighting.pro.group" + gi + ".effect"; accessible-role: button;
                            compact: true; horizontal-stretch: 1;
                            label: "FX: " + Lighting.effects[g.effect];
                            tooltip: @tr("Attribute effect: click for the next one");
                            clicked => { Lighting.group-effect(gi, Math.mod(g.effect + 1, Lighting.effects.length)); }
                        }
                        // Pan / tilt programmer: drag in the square; double-click frees it.
                        if g.has-movers: Rectangle {
                            accessible-id: "lighting.pro.group" + gi + ".xy"; accessible-role: slider;
                            width: 54px; height: 54px;
                            background: Theme.plate; border-width: 1px; border-color: Theme.rule;
                            Rectangle { x: parent.width / 2; width: 1px; background: Theme.rule; }
                            Rectangle { y: parent.height / 2; height: 1px; background: Theme.rule; }
                            if g.pan >= 0: Rectangle {
                                x: g.pan * (parent.width - 8px); y: (1 - g.tilt) * (parent.height - 8px);
                                width: 8px; height: 8px; border-radius: 4px; background: Theme.attention;
                            }
                            xy := TouchArea {
                                mouse-cursor: crosshair;
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down) {
                                        Lighting.group-position(gi, clamp(self.mouse-x / self.width, 0, 1), clamp(1 - self.mouse-y / self.height, 0, 1));
                                    }
                                }
                                moved => {
                                    if (self.pressed) {
                                        Lighting.group-position(gi, clamp(self.mouse-x / self.width, 0, 1), clamp(1 - self.mouse-y / self.height, 0, 1));
                                    }
                                }
                                double-clicked => { Lighting.group-position-clear(gi); }
                            }
                        }
                    }
                }
                HLine { }
                Caps { text: @tr("CUE STACK"); }
                for c[ci] in Lighting.cues: Rectangle {
                    accessible-id: "lighting.cue" + ci; accessible-role: list-item; accessible-value: c;
                    height: 24px;
                    background: transparent;
                    Rectangle { x: 0; width: 2px; background: ci == Lighting.active-cue ? Theme.attention : transparent; }
                    HorizontalLayout {
                        padding-left: Theme.s2; spacing: Theme.s2;
                        Text { text: (ci + 1) + "  " + c; font-family: Theme.family; font-size: Theme.control; color: Theme.bone; vertical-alignment: center; horizontal-stretch: 1; }
                        PlateButton { accessible-id: "lighting.cue" + ci + ".delete"; accessible-role: button; compact: true; glyph: "close"; tooltip: @tr("Delete this cue"); clicked => { Lighting.cue-delete(ci); } }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.s1;
                    PlateButton { accessible-id: "lighting.cue.back"; accessible-role: button; label: @tr("BACK"); horizontal-stretch: 1; tooltip: @tr("Previous cue"); clicked => { Lighting.cue-back(); } }
                    PlateButton { accessible-id: "lighting.cue.go"; accessible-role: button; label: @tr("GO"); tone: Theme.live; horizontal-stretch: 1; tooltip: @tr("Next cue"); clicked => { Lighting.cue-go(); } }
                }
                HorizontalLayout {
                    spacing: Theme.s2;
                    cue := Field { accessible-id: "lighting.cue.name"; accessible-role: text-input; placeholder: @tr("Cue name"); horizontal-stretch: 1; }
                    PlateButton {
                        accessible-id: "lighting.cue.store"; accessible-role: button;
                        compact: true; label: @tr("STORE"); tooltip: @tr("Store the group settings as a new cue");
                        clicked => { Lighting.cue-store(cue.text); cue.text = ""; }
                    }
                }
            }
        }
    }
    // [21] The large BLACKOUT, always in view.
    PlateButton {
        accessible-id: "lighting.blackout"; accessible-role: button;
        accessible-checkable: true; accessible-checked: Lighting.blackout;
        height: 56px; label: @tr("BLACKOUT"); active: Lighting.blackout; tone: Theme.fault;
        tooltip: @tr("All lights off, over everything else; press again to bring them back");
        clicked => { Lighting.set-blackout(!Lighting.blackout); }
    }
}

export component LightingView inherits Rectangle {
    in property <bool> detachable: true;
    accessible-id: "lighting.view"; accessible-role: groupbox;
    background: Theme.ground-band; border-radius: Theme.r-panel;
    // [21] Two modes, chosen at the top of the side column: SETUP (rig,
    // patch, outputs, safety, files; the stage as a floor plan; the output
    // test one key away) and SHOW (the stage, pads and cues; AUTO, the
    // masters and keys; a large BLACKOUT). A narrow window gives the side
    // column a little less room. Follows the width through a plain
    // property, so it does not feed back into the layout.
    property <bool> narrow;
    init => { self.narrow = self.width < 1240px; }
    changed width => { self.narrow = self.width < 1240px; }
    property <bool> setup: Lighting.space == "setup";
    HorizontalLayout {
        VerticalLayout {
            width: root.narrow ? 320px : 340px;
            HorizontalLayout {
                padding-left: Theme.s3; padding-right: Theme.s3; padding-top: Theme.s3;
                spacing: Theme.s1;
                for t in [{ id: "setup", label: @tr("SETUP") }, { id: "show", label: @tr("SHOW") }]: PlateButton {
                    accessible-id: "lighting.space." + t.id; accessible-role: tab;
                    horizontal-stretch: 1;
                    label: t.label; selected: Lighting.space == t.id;
                    tooltip: t.id == "setup" ? @tr("Rig, patch, outputs, safety and files; the stage as a floor plan")
                        : @tr("The stage, pads and light cues; AUTO, masters and the keys to play the show");
                    clicked => {
                        Lighting.space = t.id;
                        if (t.id == "setup" && (Lighting.centre == "pads" || Lighting.centre == "cues" || Lighting.centre == "triggers")) { Lighting.centre = "stage"; }
                        if (t.id == "show" && (Lighting.centre == "patch" || Lighting.centre == "channels")) { Lighting.centre = "stage"; }
                    }
                }
            }
            if root.setup: SetupPanel { vertical-stretch: 1; }
            if !root.setup: ShowPanel { vertical-stretch: 1; }
        }
        VLine { }
        VerticalLayout {
            horizontal-stretch: 1;
            padding: Theme.s3; spacing: Theme.s2;
            HorizontalLayout {
                height: 26px;
                spacing: Theme.s2;
                HorizontalLayout {
                    spacing: Theme.s1;
                    for c in (root.setup
                            ? [{ id: "stage", label: @tr("STAGE") }, { id: "patch", label: @tr("PATCH") }, { id: "channels", label: @tr("CHANNELS") }]
                            : [{ id: "stage", label: @tr("STAGE") }, { id: "pads", label: @tr("PADS") }, { id: "cues", label: @tr("CUES") }, { id: "triggers", label: @tr("TRIGGERS") }]): PlateButton {
                        accessible-id: "lighting.centre." + c.id; accessible-role: tab;
                        compact: true; label: c.label; selected: Lighting.centre == c.id; horizontal-stretch: 0;
                        tooltip: c.id == "stage" && root.setup ? @tr("The floor plan: place, turn and tune the fixtures") : "";
                        clicked => { Lighting.centre = c.id; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // The output test, one key away while setting up.
                if root.setup: PlateButton {
                    accessible-id: "lighting.test"; accessible-role: button;
                    accessible-checkable: true; accessible-checked: Lighting.test != "";
                    compact: true; label: @tr("TEST"); active: Lighting.test != ""; tone: Theme.attention; horizontal-stretch: 0;
                    tooltip: Lighting.test == "" ? @tr("Output test: light each fixture in turn (other patterns under OUTPUT)") : @tr("Stop the output test and go back to the show");
                    clicked => { Lighting.set-test(Lighting.test == "" ? "each" : ""); }
                }
                if root.detachable: PlateButton {
                    accessible-id: "lighting.detach"; accessible-role: button;
                    compact: true; label: @tr("WINDOW"); horizontal-stretch: 0; tooltip: @tr("Open the lighting in its own window (second screen)");
                    clicked => { Lighting.detach(); }
                }
                if !root.setup: Caps {
                    accessible-id: "lighting.status"; accessible-role: text; accessible-value: self.text;
                    overflow: elide;
                    text: Lighting.layer-text; color: Lighting.layer == "blackout" ? Theme.fault : Theme.attention; vertical-alignment: center;
                }
            }
            if !root.setup && Lighting.centre == "stage": Stage { vertical-stretch: 1; accessible-id: "lighting.stage"; accessible-role: image; }
            if root.setup && Lighting.centre == "stage": StageEditor { vertical-stretch: 1; }
            if !root.setup && Lighting.centre == "pads": PadsCentre { vertical-stretch: 1; }
            // The cue list and the patch table keep their columns: a narrow
            // centre scrolls them sideways (the wheel with ⇧, or the trackpad).
            if !root.setup && Lighting.centre == "cues": Flickable {
                vertical-stretch: 1;
                mouse-drag-pan-enabled: false;
                content-width: max(self.width, cues.min-width);
                cues := CueList { width: parent.content-width; height: parent.height; }
            }
            if !root.setup && Lighting.centre == "triggers": Flickable {
                vertical-stretch: 1;
                mouse-drag-pan-enabled: false;
                content-width: max(self.width, triggers.min-width);
                triggers := TriggersCentre { width: parent.content-width; height: parent.height; }
            }
            if root.setup && Lighting.centre == "patch": Flickable {
                vertical-stretch: 1;
                mouse-drag-pan-enabled: false;
                content-width: max(self.width, patch.min-width);
                patch := PatchTable { width: parent.content-width; height: parent.height; }
            }
            if root.setup && Lighting.centre == "channels": ChannelGrid { vertical-stretch: 1; }
        }
    }
}

// Compact output state: line, DMX, and what is wrong (Perform strip and top bar).
export component LinkStatus inherits HorizontalLayout {
    accessible-id: "lighting.link"; accessible-role: text;
    accessible-value: Lighting.link + " " + Lighting.link-text;
    spacing: Theme.s2;
    VerticalLayout { padding-top: Theme.s1; padding-bottom: Theme.s1; LinkLine { state: Lighting.link == "fault" ? "lost" : Lighting.link; } }
    Caps { text: "DMX"; vertical-alignment: center; }
    Text {
        text: Lighting.link-text; overflow: elide;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
        color: Lighting.link == "lost" || Lighting.link == "fault" ? Theme.fault : Theme.bone-2;
        vertical-alignment: center;
    }
}

// The lighting controls in Perform and Club (STRIP): in the browser's
// place, so the decks, waveforms and mixer keep their size. Every key and
// pad is at least 44 px for touch; the stage preview shows from 1360 px.
export component LightingPanel inherits Rectangle {
    accessible-id: "lighting.strip"; accessible-role: groupbox;
    background: Theme.ground-band; border-radius: Theme.r-panel;
    property <bool> roomy: root.width >= 1360px;
    // The kiosk and other narrow windows leave the faders out.
    property <bool> narrow: root.width < 1000px;
    HorizontalLayout {
        padding: Theme.s2; spacing: Theme.s3;
        if root.roomy: Stage { compact: true; width: 220px; accessible-id: "lighting.strip.stage"; accessible-role: image; }
        // [37] Unattended: the show is locked; BLACKOUT stays.
        if Lighting.show-locked: VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: Theme.s2;
            HorizontalLayout {
                height: 18px; spacing: Theme.s2;
                VLine { tone: Theme.live; }
                Caps { text: @tr("UNATTENDED"); color: Theme.attention; vertical-alignment: center; }
                Caps {
                    accessible-id: "lighting.strip.unattended"; accessible-role: text; accessible-value: self.text;
                    text: Lighting.unattended-text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; color: Theme.bone-2;
                }
            }
            Body { text: @tr("The show runs by itself. The setup PIN under LIGHTING takes over."); color: Theme.bone-3; }
        }
        if Lighting.show-locked: VerticalLayout {
            width: 160px; alignment: center;
            PlateButton {
                accessible-id: "lighting.strip.blackout"; accessible-role: button;
                tall: true; label: @tr("BLACKOUT"); active: Lighting.blackout; tone: Theme.fault;
                clicked => { Lighting.set-blackout(!Lighting.blackout); }
            }
        }
        if !Lighting.show-locked: VerticalLayout {
            horizontal-stretch: 1; min-width: 4 * 80px;
            spacing: Theme.s1;
            HorizontalLayout {
                height: 44px; spacing: Theme.s2;
                Caps { text: @tr("PAGE"); vertical-alignment: center; }
                PageTabs { prefix: "lighting.strip.page"; tall: true; }
                Rectangle { horizontal-stretch: 1; }
            }
            PadGrid { prefix: "lighting.strip.pad"; vertical-stretch: 1; min-height: 2 * 44px + 4px; }
        }
        if !root.narrow && !Lighting.show-locked: VerticalLayout {
            spacing: Theme.key-gap;
            HorizontalLayout {
                vertical-stretch: 1; spacing: Theme.s1;
                VerticalLayout {
                    width: 54px; spacing: Theme.key-gap;
                    HorizontalLayout {
                        alignment: center; vertical-stretch: 1;
                        Fader {
                            accessible-id: "lighting.strip.master"; accessible-role: slider; accessible-value: Math.round(Lighting.master * 100) + " %";
                            width: 44px; value: Lighting.master; tone: Theme.attention;
                            tooltip: @tr("Master dimmer");
                            changed(v) => { Lighting.set-master(v); }
                        }
                    }
                    Caps { text: @tr("MASTER"); horizontal-alignment: center; }
                }
                GroupMasters { prefix: "lighting.strip.group"; fader-w: 44px; }
            }
        }
        if !Lighting.show-locked: VerticalLayout {
            width: 300px; spacing: Theme.s1;
            HorizontalLayout {
                spacing: Theme.key-gap;
                for m in [{ id: "auto", label: "AUTO" }, { id: "easy", label: "EASY" }, { id: "pro", label: "PRO" }]: PlateButton {
                    accessible-id: "lighting.strip.mode." + m.id; accessible-role: tab;
                    tall: true; label: m.label; selected: Lighting.mode == m.id; horizontal-stretch: 1;
                    clicked => { Lighting.set-mode(m.id); }
                }
                PlateButton {
                    accessible-id: "lighting.strip.enable"; accessible-role: button;
                    accessible-checkable: true; accessible-checked: Lighting.enabled;
                    tall: true; label: @tr("DMX OUT"); active: Lighting.enabled; tone: Theme.live;
                    tooltip: @tr("Send the show to the outputs");
                    clicked => { Lighting.set-enabled(!Lighting.enabled); }
                }
            }
            HorizontalLayout {
                spacing: Theme.key-gap;
                PlateButton {
                    accessible-id: "lighting.strip.hold"; accessible-role: button;
                    accessible-checkable: true; accessible-checked: Lighting.hold;
                    tall: true; label: @tr("HOLD"); active: Lighting.hold; tone: Theme.attention; horizontal-stretch: 1;
                    tooltip: @tr("Keep AUTO's current look through phrase changes");
                    clicked => { Lighting.set-hold(!Lighting.hold); }
                }
                PlateButton {
                    accessible-id: "lighting.strip.release"; accessible-role: button;
                    tall: true; label: @tr("RELEASE"); horizontal-stretch: 1;
                    enabled: Lighting.layer == "latched" || Lighting.layer == "hold";
                    tooltip: @tr("Hand back to AUTO: the latched pad and HOLD end");
                    clicked => { Lighting.release(); }
                }
            }
            // A lost link takes the line: it is what needs you.
            HorizontalLayout {
                spacing: Theme.s2; vertical-stretch: 1; min-height: 18px;
                if Lighting.link == "lost" || Lighting.link == "fault": LinkStatus { horizontal-stretch: 1; }
                if Lighting.link != "lost" && Lighting.link != "fault": Caps {
                    accessible-id: "lighting.strip.layer"; accessible-role: text; accessible-value: Lighting.layer + " " + Lighting.layer-text;
                    text: Lighting.layer-text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center;
                    color: Lighting.layer == "base" ? Theme.bone-2 : Lighting.layer == "blackout" ? Theme.fault : Theme.attention;
                }
            }
            HorizontalLayout {
                spacing: Theme.key-gap;
                PlateButton {
                    accessible-id: "lighting.strip.blackout"; accessible-role: button;
                    tall: true; label: @tr("BLACKOUT"); active: Lighting.blackout; tone: Theme.fault; horizontal-stretch: 1;
                    clicked => { Lighting.set-blackout(!Lighting.blackout); }
                }
                HoldButton {
                    accessible-id: "lighting.strip.flash"; accessible-role: button;
                    label: @tr("FLASH"); on: Lighting.flash; size: 44px; tone: Theme.bone; horizontal-stretch: 1;
                    pressed => { Lighting.flash-held(true); } released => { Lighting.flash-held(false); }
                }
                HoldButton {
                    accessible-id: "lighting.strip.strobe"; accessible-role: button;
                    label: @tr("STROBE"); on: Lighting.strobe; size: 44px; horizontal-stretch: 1;
                    pressed => { Lighting.strobe-held(true); } released => { Lighting.strobe-held(false); }
                }
                HoldButton {
                    accessible-id: "lighting.strip.fog"; accessible-role: button;
                    label: @tr("FOG"); on: Lighting.fog; size: 44px; tone: Theme.attention; horizontal-stretch: 1;
                    tooltip: Lighting.fog-armed ? @tr("Fog machines on while held") : @tr("Fog is locked out: arm it under SAFETY");
                    pressed => { Lighting.fog-held(true); } released => { Lighting.fog-held(false); }
                }
            }
        }
    }
}

// The LIGHTING view on its own (detached window, second screen).
export component LightingWindow inherits Window {
    default-font-family: Theme.family;
    default-font-weight: Theme.weight-medium;
    title: "OpenDJDecks — Lighting";
    // Window / taskbar icon (X11 and Windows; Wayland and macOS take it
    // from the .desktop file / the bundle).
    icon: @image-url("../../../packaging/assets/icon-256.png");
    preferred-width: 1280px;
    preferred-height: 720px;
    background: Theme.ground;
    LightingView { detachable: false; }
}
