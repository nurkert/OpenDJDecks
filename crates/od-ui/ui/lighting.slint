// LIGHTING (SPEC §10.5): the DMX rig, a live stage preview and the show
// controls. State lives in the `Lighting` global so the view can be placed
// in the main window or a detached one without re-plumbing properties.
//
// Layout: RIG (patch, outputs) | STAGE (live preview, what the show does
// now) | SHOW (enable, mode, master, momentary buttons, mode panel).

import { Theme } from "tokens.slint";
import { VLine, HLine } from "lines.slint";
import { Caps, PlateButton, Field, LineToggle, Fader, HoldButton, Stepper } from "controls.slint";
import { ChoiceList } from "fx.slint";

export struct LightFixtureView {
    name: string,
    group: string,
    // "wash" | "mover" | "bar" | "effect"
    role: string,
    address: string,
    // Stage position, 0..1.
    x: float,
    y: float,
    color: color,
    intensity: float,
    // Beam end for movers, 0..1 stage coordinates.
    beam-x: float,
    beam-y: float,
    strobe: bool,
    cells: [color],
}

export struct LightGroupView {
    name: string,
    // Index into `programs`, -1 = follow the music.
    program: int,
    // Index into `swatches`, -1 = colour from the track.
    color: int,
    // Index into `effects` (0 = none).
    effect: int,
    // Fixed position (pan / tilt 0..1), or -1 = from the program.
    pan: float,
    tilt: float,
    has-movers: bool,
}

// One row of the patch table.
export struct LightPatchRow {
    name: string,
    group: string,
    // 1-based, as text for the fields.
    universe: string,
    address: string,
    mode: string,
    channels: string,
    // What is wrong with the place ("" = fine), e.g. "OVERLAPS PAR 2".
    clash: string,
    identify: bool,
    // "fog" | "laser" | "".
    hazard: string,
}

// One output link and its state.
export struct LightOutputRow {
    universe: string,
    target: string,
    // "ok" | "lost" | "back" (came back in the last 20 s).
    state: string,
    detail: string,
}

export struct LightCapRow {
    name: string,
    // 0..1.
    cap: float,
}

export global Lighting {
    // The compact lighting strip inside Perform.
    in-out property <bool> panel;
    in-out property <bool> enabled;
    // "auto" | "easy" | "pro"
    in-out property <string> mode: "auto";
    in-out property <float> master: 1;
    in-out property <bool> blackout;
    in property <bool> flash;
    in property <bool> strobe;
    in property <bool> fog;
    in property <[string]> effects;
    // Tapped tempo for the lights when no deck plays ("" = 120 BPM).
    in property <string> tap-bpm;
    in property <[LightFixtureView]> fixtures;
    in property <[LightGroupView]> groups;
    in property <[string]> programs;
    in property <[color]> swatches;
    in property <[string]> fixture-types;
    in property <int> easy-program;
    in property <int> easy-color: -1;
    in property <[string]> cues;
    in property <int> active-cue: -1;
    // What the show does now, e.g. "DECK 1 · CHORUS → SWEEP".
    in property <string> status;
    in property <string> output-text;
    in property <string> rig-path;

    callback set-enabled(bool);
    callback set-mode(string);
    callback set-master(float);
    callback set-blackout(bool);
    callback flash-held(bool);
    callback strobe-held(bool);
    callback choose-easy-program(int);
    callback choose-easy-color(int);
    callback group-program(int, int);
    callback group-color(int, int);
    callback remove-fixture(int);
    // Kind, target, universe (1-based text, "" = 1).
    callback set-output(string, string, string);
    callback cue-go();
    callback cue-back();
    callback cue-store(string);
    callback cue-delete(int);
    callback fog-held(bool);
    callback tap();
    callback group-effect(int, int);
    callback group-position(int, float, float);
    callback group-position-clear(int);
    callback import-ofl();
    callback detach();
    // Lighting cues of the track you hear (Pro): title and rows.
    in property <string> timeline-title;
    in property <[string]> timeline;
    callback timeline-add();
    callback timeline-delete(int);

    // Centre of the view: "stage" | "patch" | "channels".
    in-out property <string> centre: "stage";
    // Setup panel: "rig" | "output" | "safety".
    in-out property <string> setup-tab: "rig";
    // Patch table.
    in property <[LightPatchRow]> patch-rows;
    callback patch-universe(int, string);
    callback patch-address(int, string);
    callback patch-mode(int, int);
    callback patch-channels(int, string);
    callback identify(int);
    // Type, name, group, count, universe, start address.
    callback add-fixtures(int, string, string, string, string, string);
    // Outputs and failsafe.
    in property <[LightOutputRow]> outputs;
    // Summary for Perform: "off" | "ok" | "lost" | "back" | "fault".
    in property <string> link: "off";
    in property <string> link-text;
    // "hold" | "safe" | "blackout".
    in property <string> failsafe: "hold";
    callback remove-output(int);
    callback set-failsafe(string);
    // Live channel view of one universe.
    in property <[int]> channels;
    in property <[string]> universes;
    in property <int> channel-universe;
    callback choose-universe(int);
    // Safety limits.
    in property <float> strobe-hz: 3;
    in property <bool> fog-armed;
    in property <bool> laser-armed;
    in property <bool> has-fog;
    in property <bool> has-laser;
    in property <[LightCapRow]> caps;
    in property <bool> pin-set;
    // Setup is locked by the PIN (the show controls stay free).
    in property <bool> locked;
    in property <string> pin-error;
    callback step-strobe(int);
    callback arm-fog(bool);
    callback arm-laser(bool);
    callback step-cap(int, int);
    callback unlock(string);
    callback lock();
    callback set-pin(string);
}

component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    // As tall as the keys beside it (DMX OUT, WINDOW): the caption and the
    // keys share one centre line in all three panel headers.
    height: 26px;
    Caps { text: root.text; vertical-alignment: center; color: Theme.bone-2; }
}

// Colour chips; -1 is "from the track".
component Swatches inherits HorizontalLayout {
    in property <int> current;
    callback chosen(int);
    spacing: Theme.s1;
    height: 24px;
    Rectangle {
        accessible-label: "lighting.swatch.track"; accessible-role: button;
        width: 40px;
        border-radius: Theme.r-control;
        background: root.current == -1 ? Theme.bone : Theme.plate;
        Text { text: @tr("TRACK"); font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: 1px; color: root.current == -1 ? Theme.ground : Theme.bone-2; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { mouse-cursor: pointer; clicked => { root.chosen(-1); } }
    }
    for c[i] in Lighting.swatches: Rectangle {
        accessible-label: "lighting.swatch" + i; accessible-role: button;
        width: 24px;
        background: c;
        border-width: root.current == i ? 2px : 1px;
        border-color: root.current == i ? Theme.bone : Theme.rule;
        TouchArea { mouse-cursor: pointer; clicked => { root.chosen(i); } }
    }
}

// Live preview of the rig: wash fixtures as glowing lenses, movers with
// their beam, bars as cells. Strobing fixtures flicker.
component Stage inherits Rectangle {
    in property <bool> compact;
    background: #0B0B0B;
    border-width: 1px;
    border-color: Theme.rule;
    clip: true;
    property <bool> blink: Math.mod(animation-tick() / 1ms, 90) < 45;

    // Trusses.
    for y in [0.18, 0.5, 0.82]: Rectangle {
        x: 16px; width: parent.width - 32px; height: 1px;
        y: parent.height * y;
        background: #2A2A27;
    }
    for f[i] in Lighting.fixtures: Rectangle {
        property <float> lit: f.strobe && !root.blink ? 0 : f.intensity;
        property <length> cx: root.width * f.x;
        property <length> cy: root.height * f.y;
        accessible-label: "lighting.stage.fixture" + i; accessible-role: text;
        accessible-value: f.name;
        x: 0; y: 0; width: root.width; height: root.height;

        if f.role == "mover": Path {
            x: 0; y: 0; width: root.width; height: root.height;
            viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
            stroke: f.color.with-alpha(0.55 * lit);
            stroke-width: 6px;
            MoveTo { x: cx / 1px; y: cy / 1px; }
            LineTo { x: root.width * f.beam-x / 1px; y: root.height * f.beam-y / 1px; }
        }
        if f.role != "bar": Rectangle {
            x: cx - 22px; y: cy - 22px; width: 44px; height: 44px;
            border-radius: 22px;
            background: f.color.with-alpha(0.25 * lit);
        }
        if f.role != "bar": Rectangle {
            x: cx - 11px; y: cy - 11px; width: 22px; height: 22px;
            border-radius: f.role == "mover" ? 4px : 11px;
            background: lit > 0.02 ? f.color.with-alpha(0.35 + 0.65 * lit) : #1C1C1B;
            border-width: 1px; border-color: #4B4A46;
        }
        if f.role == "bar": HorizontalLayout {
            x: cx - 80px; y: cy - 7px; width: 160px; height: 14px;
            spacing: Theme.key-gap;
            for c in f.cells: Rectangle {
                background: c.with-alpha(0.25 + 0.75 * lit);
                border-width: 1px; border-color: #33322F;
            }
        }
        if !root.compact: Text {
            x: cx - 60px; y: cy + (f.role == "bar" ? 10px : 24px); width: 120px;
            text: f.name;
            font-family: Theme.family; font-size: Theme.label; color: Theme.bone-3;
            horizontal-alignment: center; overflow: elide;
        }
    }
    if Lighting.fixtures.length == 0: Text {
        text: @tr("No fixtures patched yet. Add your lights on the left.");
        font-family: Theme.family; font-size: Theme.control; color: Theme.bone-3;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// The status line of an output: solid green sending, dashed sodium came
// back a moment ago, struck when lost.
component LinkLine inherits VLine {
    in property <string> state;
    tone: root.state == "ok" ? Theme.live : root.state == "back" ? Theme.attention : root.state == "off" ? Theme.rule-strong : Theme.bone-3;
    form: root.state == "ok" ? "solid" : root.state == "back" ? "dashed" : root.state == "off" ? "half" : "struck";
}

component Body inherits Text {
    font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2;
    wrap: word-wrap;
}

// Setup is locked: the PIN opens it again.
component LockedSetup inherits VerticalLayout {
    spacing: Theme.s2;
    Caps { text: @tr("SETUP LOCKED"); color: Theme.attention; }
    Body { text: @tr("Patch, outputs and safety limits need the PIN. The show controls on the right stay free."); }
    HorizontalLayout {
        spacing: Theme.s2;
        pin := Field {
            accessible-label: "lighting.pin.entry"; accessible-role: text-input;
            input-type: InputType.password; placeholder: @tr("PIN"); horizontal-stretch: 1;
            accepted(t) => { Lighting.unlock(t); self.text = ""; }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            PlateButton {
                accessible-label: "lighting.pin.unlock"; accessible-role: button;
                compact: true; label: @tr("UNLOCK"); tooltip: @tr("Open the setup with the PIN");
                clicked => { Lighting.unlock(pin.text); pin.text = ""; }
            }
        }
    }
    if Lighting.pin-error != "": Text {
        text: Lighting.pin-error;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.fault;
    }
}

component RigTab inherits VerticalLayout {
    property <int> type-index: 0;
    spacing: Theme.s2;
    Caps { text: @tr("ADD FIXTURES"); }
    ChoiceList {
        accessible-label: "lighting.rig.type"; accessible-role: list;
        items: Lighting.fixture-types; current: root.type-index; columns: 2; cell-w: 150px; cell-h: 24px;
        chosen(i) => { root.type-index = i; }
    }
    HorizontalLayout {
        spacing: Theme.s2;
        name := Field { accessible-label: "lighting.rig.name"; accessible-role: text-input; placeholder: @tr("Name"); horizontal-stretch: 1; }
        group := Field { accessible-label: "lighting.rig.group"; accessible-role: text-input; placeholder: @tr("Group"); width: 110px; }
    }
    HorizontalLayout {
        spacing: Theme.s2;
        VerticalLayout {
            spacing: Theme.key-gap;
            Caps { text: @tr("COUNT"); }
            count := Field { accessible-label: "lighting.rig.count"; accessible-role: text-input; placeholder: "1"; width: 56px; }
        }
        VerticalLayout {
            spacing: Theme.key-gap;
            Caps { text: @tr("UNIVERSE"); }
            universe := Field { accessible-label: "lighting.rig.universe"; accessible-role: text-input; placeholder: @tr("free"); width: 66px; }
        }
        VerticalLayout {
            spacing: Theme.key-gap;
            Caps { text: @tr("START"); }
            start := Field { accessible-label: "lighting.rig.start"; accessible-role: text-input; placeholder: @tr("free"); width: 66px; }
        }
        VerticalLayout {
            alignment: end;
            PlateButton {
                accessible-label: "lighting.rig.add"; accessible-role: button;
                label: @tr("ADD"); glyph: "plus"; tone: Theme.live;
                tooltip: @tr("Patch the fixtures one after another from the start address (empty: the first free addresses)");
                clicked => {
                    Lighting.add-fixtures(root.type-index, name.text, group.text, count.text, universe.text, start.text);
                    name.text = ""; count.text = ""; start.text = "";
                }
            }
        }
    }
    Body { text: @tr("Change universe, address, mode and channel count in the patch table in the middle."); color: Theme.bone-3; }
    HLine { }
    PlateButton {
        accessible-label: "lighting.rig.import-ofl"; accessible-role: button;
        compact: true; label: @tr("IMPORT FIXTURE FILE…");
        tooltip: @tr("Patch a fixture from an Open Fixture Library file (.json)");
        clicked => { Lighting.import-ofl(); }
    }
}

component OutputTab inherits VerticalLayout {
    property <string> output-kind: "artnet";
    spacing: Theme.s2;
    Caps { text: @tr("OUTPUTS"); }
    if Lighting.outputs.length == 0: Body { text: @tr("No output set. The show runs in the preview only."); color: Theme.bone-3; }
    for o[i] in Lighting.outputs: Rectangle {
        accessible-label: "lighting.output.row" + i; accessible-role: list-item;
        accessible-value: o.universe + " " + o.state + " " + o.detail;
        height: 44px;
        HorizontalLayout {
            spacing: Theme.s2;
            VerticalLayout { padding-top: Theme.s1; padding-bottom: Theme.s1; LinkLine { state: o.state; } }
            VerticalLayout {
                horizontal-stretch: 1; alignment: center; spacing: Theme.key-gap;
                HorizontalLayout {
                    spacing: Theme.s2;
                    Text { text: o.universe; font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.bone; }
                    Text { text: o.target; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; overflow: elide; horizontal-stretch: 1; }
                }
                Text {
                    text: o.detail; overflow: elide;
                    font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: Theme.tracking-index;
                    color: o.state == "lost" ? Theme.fault : o.state == "back" ? Theme.attention : Theme.bone-3;
                }
            }
            VerticalLayout {
                alignment: center;
                PlateButton {
                    accessible-label: "lighting.output.remove" + i; accessible-role: button;
                    compact: true; glyph: "close"; width: 30px; tooltip: @tr("Remove this output");
                    clicked => { Lighting.remove-output(i); }
                }
            }
        }
    }
    HLine { }
    Caps { text: @tr("SET OUTPUT"); }
    HorizontalLayout {
        spacing: Theme.s1;
        for k[i] in [{ id: "artnet", label: "ART-NET" }, { id: "sacn", label: "SACN" }, { id: "enttec", label: "USB-DMX" }]: PlateButton {
            accessible-label: "lighting.output." + k.id; accessible-role: tab;
            compact: true; label: k.label; selected: root.output-kind == k.id; horizontal-stretch: 1;
            tooltip: @tr("Choose how the universe leaves the computer");
            clicked => { root.output-kind = k.id; }
        }
    }
    HorizontalLayout {
        spacing: Theme.s2;
        universe := Field { accessible-label: "lighting.output.universe"; accessible-role: text-input; placeholder: "U 1"; width: 56px; }
        target := Field {
            accessible-label: "lighting.output.target"; accessible-role: text-input;
            horizontal-stretch: 1;
            placeholder: root.output-kind == "artnet" ? "2.0.0.10:6454" : root.output-kind == "sacn" ? "1" : "/dev/tty.usbserial";
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            PlateButton {
                accessible-label: "lighting.output.apply"; accessible-role: button;
                compact: true; label: @tr("SET"); tooltip: @tr("Send this universe to the output");
                clicked => { Lighting.set-output(root.output-kind, target.text, universe.text); }
            }
        }
    }
    Caps { text: Lighting.output-text; overflow: elide; color: Theme.bone-3; }
    HLine { }
    Caps { text: @tr("WHEN A LINK IS LOST"); }
    HorizontalLayout {
        spacing: Theme.s1;
        for f in [{ id: "hold", label: @tr("HOLD") }, { id: "safe", label: @tr("SAFE SCENE") }, { id: "blackout", label: @tr("BLACKOUT") }]: PlateButton {
            accessible-label: "lighting.failsafe." + f.id; accessible-role: tab;
            compact: true; label: f.label; selected: Lighting.failsafe == f.id; horizontal-stretch: 1;
            clicked => { Lighting.set-failsafe(f.id); }
        }
    }
    Body {
        text: Lighting.failsafe == "hold" ? @tr("The whole rig keeps the last look until every link is back, then fades back to the show in one second.")
            : Lighting.failsafe == "safe" ? @tr("The whole rig fades to a calm warm wash at 30 % in two seconds: no strobe, no fog, no lasers.")
            : @tr("The whole rig goes dark at once and fades back in when every link is back.");
    }
    Body { text: @tr("The same choice applies when the show fails and when the app quits."); color: Theme.bone-3; }
}

component SafetyTab inherits VerticalLayout {
    spacing: Theme.s2;
    Caps { text: @tr("STROBE AND FLASH CAP"); }
    HorizontalLayout {
        spacing: Theme.s2;
        Stepper {
            accessible-label: "lighting.safety.strobe"; accessible-role: spinbox;
            accessible-value: self.value;
            a11y-prev: "lighting.safety.strobe.down"; a11y-next: "lighting.safety.strobe.up";
            value: Lighting.strobe-hz <= 0 ? @tr("NO STROBE") : @tr("{} PER SECOND", Lighting.strobe-hz);
            template: "00 PER SECOND"; size: 26px; lit: true;
            tooltip: @tr("Most flashes per second any look may send");
            step(d) => { Lighting.step-strobe(d); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    Body { text: @tr("Fast flashing can trigger seizures in people with photosensitive epilepsy. 3 per second or less is the safe default; every look, button and cue is held to it."); }
    HLine { }
    Caps { text: @tr("LOCKOUT"); }
    HorizontalLayout {
        spacing: Theme.s2;
        PlateButton {
            accessible-label: "lighting.safety.fog"; accessible-role: button;
            accessible-checkable: true; accessible-checked: Lighting.fog-armed;
            label: Lighting.fog-armed ? @tr("FOG ARMED") : @tr("ARM FOG"); active: Lighting.fog-armed; tone: Theme.attention;
            horizontal-stretch: 1;
            tooltip: @tr("Fog machines stay off until armed. Arming ends when the app quits.");
            clicked => { Lighting.arm-fog(!Lighting.fog-armed); }
        }
        PlateButton {
            accessible-label: "lighting.safety.laser"; accessible-role: button;
            accessible-checkable: true; accessible-checked: Lighting.laser-armed;
            label: Lighting.laser-armed ? @tr("LASERS ARMED") : @tr("ARM LASERS"); active: Lighting.laser-armed; tone: Theme.fault;
            horizontal-stretch: 1;
            tooltip: @tr("Lasers stay dark until armed. Arming ends when the app quits.");
            clicked => { Lighting.arm-laser(!Lighting.laser-armed); }
        }
    }
    Body {
        color: Theme.bone-3;
        text: !Lighting.has-fog && !Lighting.has-laser ? @tr("No fog machine or laser is patched.")
            : @tr("Arming lasts until the app quits; each start begins locked.");
    }
    HLine { }
    Caps { text: @tr("LEVEL CAP PER GROUP"); }
    if Lighting.caps.length == 0: Body { text: @tr("Groups appear here once fixtures are patched."); color: Theme.bone-3; }
    for c[i] in Lighting.caps: HorizontalLayout {
        spacing: Theme.s2; height: 26px;
        Text { text: c.name; font-family: Theme.family; font-size: Theme.control; color: Theme.bone; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Stepper {
            accessible-label: "lighting.safety.cap" + i; accessible-role: spinbox;
            accessible-value: self.value;
            a11y-prev: "lighting.safety.cap" + i + ".down"; a11y-next: "lighting.safety.cap" + i + ".up";
            value: Math.round(c.cap * 100) + " %"; template: "100 %"; size: 26px; lit: c.cap < 1;
            tooltip: @tr("Highest level this group may reach");
            step(d) => { Lighting.step-cap(i, d); }
        }
    }
    HLine { }
    Caps { text: @tr("SETUP PIN"); }
    HorizontalLayout {
        spacing: Theme.s2;
        newpin := Field {
            accessible-label: "lighting.pin.new"; accessible-role: text-input;
            input-type: InputType.password; placeholder: Lighting.pin-set ? @tr("New PIN (empty clears it)") : @tr("4 to 8 digits");
            horizontal-stretch: 1;
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            PlateButton {
                accessible-label: "lighting.pin.set"; accessible-role: button;
                compact: true; label: Lighting.pin-set && newpin.text == "" ? @tr("CLEAR") : @tr("SET");
                tooltip: @tr("With a PIN, guests can play the show but not change the setup");
                clicked => { Lighting.set-pin(newpin.text); newpin.text = ""; }
            }
        }
    }
    if Lighting.pin-error != "": Text {
        text: Lighting.pin-error;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: Theme.fault;
    }
}

component SetupPanel inherits VerticalLayout {
    spacing: Theme.s2;
    padding: Theme.s3;
    HorizontalLayout {
        height: 26px;
        spacing: Theme.s1;
        for t in [{ id: "rig", label: @tr("RIG") }, { id: "output", label: @tr("OUTPUT") }, { id: "safety", label: @tr("SAFETY") }]: PlateButton {
            accessible-label: "lighting.setup." + t.id; accessible-role: tab;
            compact: true; label: t.label; selected: Lighting.setup-tab == t.id; horizontal-stretch: 1;
            clicked => { Lighting.setup-tab = t.id; }
        }
        if Lighting.pin-set && !Lighting.locked: PlateButton {
            accessible-label: "lighting.pin.lock"; accessible-role: button;
            compact: true; label: @tr("LOCK"); tooltip: @tr("Lock the setup with the PIN");
            clicked => { Lighting.lock(); }
        }
    }
    if Lighting.locked: LockedSetup { }
    if !Lighting.locked && Lighting.setup-tab == "rig": RigTab { }
    if !Lighting.locked && Lighting.setup-tab == "output": OutputTab { }
    if !Lighting.locked && Lighting.setup-tab == "safety": SafetyTab { }
    Rectangle { vertical-stretch: 1; }
}

// Patch table: every fixture with its place. Collisions are kept and shown
// (struck line, the reason in red) rather than refused, so a rig can be
// re-addressed step by step.
component PatchTable inherits VerticalLayout {
    spacing: 0;
    HorizontalLayout {
        height: 26px; spacing: Theme.s2; padding-left: Theme.s3; padding-right: Theme.s1;
        Caps { text: @tr("NAME"); horizontal-stretch: 1; vertical-alignment: center; }
        Caps { text: @tr("GROUP"); width: 90px; vertical-alignment: center; }
        Caps { text: @tr("UNIV"); width: 50px; vertical-alignment: center; }
        Caps { text: @tr("ADDRESS"); width: 62px; vertical-alignment: center; }
        Caps { text: @tr("MODE"); width: 120px; vertical-alignment: center; }
        Caps { text: @tr("CH"); width: 50px; vertical-alignment: center; }
        Caps { text: @tr("CHECK"); width: 130px; vertical-alignment: center; }
        Rectangle { width: 30px + 30px + Theme.s2; }
    }
    HLine { }
    if Lighting.patch-rows.length == 0: Body {
        text: @tr("No fixtures patched yet. Add your lights on the left.");
        color: Theme.bone-3; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 1;
    }
    if Lighting.patch-rows.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: rows.preferred-height;
        rows := VerticalLayout {
            width: parent.width;
            alignment: start;
            for r[i] in Lighting.patch-rows: Rectangle {
                accessible-label: "lighting.patch.row" + i; accessible-role: list-item;
                accessible-value: r.name + " " + r.universe + "." + r.address + " " + r.clash;
                height: 32px;
                background: ta.has-hover ? Theme.plate-raised.with-alpha(0.4) : transparent;
                ta := TouchArea { }
                HorizontalLayout {
                    spacing: Theme.s2; padding-right: Theme.s1;
                    VerticalLayout {
                        padding-top: Theme.s1; padding-bottom: Theme.s1; padding-left: Theme.s1; width: Theme.s3;
                        if r.clash != "": VLine { tone: Theme.bone-3; form: "struck"; }
                    }
                    Text { text: r.name; font-family: Theme.family; font-size: Theme.body; color: Theme.bone; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Text { text: r.group; width: 90px; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                    VerticalLayout {
                        alignment: center;
                        Field {
                            accessible-label: "lighting.patch.universe" + i; accessible-role: text-input;
                            width: 50px; height: 26px; text: r.universe; enabled: !Lighting.locked;
                            accepted(t) => { Lighting.patch-universe(i, t); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Field {
                            accessible-label: "lighting.patch.address" + i; accessible-role: text-input;
                            width: 62px; height: 26px; text: r.address; enabled: !Lighting.locked;
                            accepted(t) => { Lighting.patch-address(i, t); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Stepper {
                            accessible-label: "lighting.patch.mode" + i; accessible-role: spinbox; accessible-value: r.mode;
                            a11y-prev: "lighting.patch.mode" + i + ".prev"; a11y-next: "lighting.patch.mode" + i + ".next";
                            width: 120px; size: 26px; value: r.mode; template: "Custom"; enabled: !Lighting.locked;
                            tooltip: @tr("DMX mode of the fixture");
                            step(d) => { Lighting.patch-mode(i, d); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Field {
                            accessible-label: "lighting.patch.channels" + i; accessible-role: text-input;
                            width: 50px; height: 26px; text: r.channels; enabled: !Lighting.locked;
                            accepted(t) => { Lighting.patch-channels(i, t); }
                        }
                    }
                    Text {
                        accessible-label: "lighting.patch.clash" + i; accessible-role: text; accessible-value: self.text;
                        width: 130px; text: r.clash != "" ? r.clash : r.hazard == "fog" ? @tr("FOG · LOCKOUT") : r.hazard == "laser" ? @tr("LASER · LOCKOUT") : "";
                        font-family: Theme.family; font-size: Theme.label; font-weight: Theme.weight-semi; letter-spacing: Theme.tracking-index;
                        color: r.clash != "" ? Theme.fault : Theme.bone-3; vertical-alignment: center; overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        PlateButton {
                            accessible-label: "lighting.patch.identify" + i; accessible-role: button;
                            accessible-checkable: true; accessible-checked: r.identify;
                            compact: true; label: "ID"; width: 30px; active: r.identify; tone: Theme.attention;
                            tooltip: @tr("Identify: blink this fixture");
                            clicked => { Lighting.identify(i); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        PlateButton {
                            accessible-label: "lighting.patch.remove" + i; accessible-role: button;
                            compact: true; glyph: "close"; width: 30px; enabled: !Lighting.locked;
                            tooltip: @tr("Remove this fixture");
                            clicked => { Lighting.remove-fixture(i); }
                        }
                    }
                }
            }
        }
    }
    Body { text: @tr("Type a value and press Enter to apply it."); color: Theme.bone-3; height: 24px; vertical-alignment: center; }
}

// What leaves the computer: 512 channels of one universe after the safety
// limits, 32 to a row.
component ChannelGrid inherits VerticalLayout {
    spacing: Theme.s2;
    HorizontalLayout {
        spacing: Theme.s1; height: 26px;
        for u[i] in Lighting.universes: PlateButton {
            accessible-label: "lighting.channels.universe" + i; accessible-role: tab;
            compact: true; label: u; selected: Lighting.channel-universe == i;
            clicked => { Lighting.choose-universe(i); }
        }
        Rectangle { horizontal-stretch: 1; }
        Caps { text: @tr("AS SENT, AFTER THE SAFETY LIMITS"); vertical-alignment: center; }
    }
    if Lighting.universes.length == 0: Body { text: @tr("No fixtures patched yet. Add your lights on the left."); color: Theme.bone-3; }
    grid := Rectangle {
        vertical-stretch: 1;
        accessible-label: "lighting.channels"; accessible-role: table;
        property <length> label-w: 30px;
        property <length> cw: (self.width - self.label-w) / 32;
        property <length> ch: min(self.height / 16, 34px);
        for r in 16: Text {
            x: 0; y: r * grid.ch; width: grid.label-w - 4px; height: grid.ch;
            text: r * 32 + 1;
            font-family: Theme.family; font-size: Theme.label; color: Theme.bone-3;
            horizontal-alignment: right; vertical-alignment: center;
        }
        for v[i] in Lighting.channels: Rectangle {
            x: grid.label-w + Math.mod(i, 32) * grid.cw;
            y: Math.floor(i / 32) * grid.ch;
            width: grid.cw - 1px; height: grid.ch - 1px;
            background: Theme.plate;
            Rectangle {
                y: parent.height - self.height; height: parent.height * v / 255;
                background: Theme.bone-3.with-alpha(0.45);
            }
            Text {
                text: v; font-family: Theme.family; font-size: Theme.label;
                color: v > 0 ? Theme.bone : Theme.bone-3;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}

component ShowPanel inherits VerticalLayout {
    property <string> cue-name;
    spacing: Theme.s2;
    padding: Theme.s3;

    HorizontalLayout {
        spacing: Theme.s2;
        SectionTitle { text: @tr("SHOW"); horizontal-stretch: 1; }
        LineToggle {
            accessible-label: "lighting.enable"; accessible-role: checkbox;
            label: @tr("DMX OUT"); checked: Lighting.enabled; tone: Theme.live;
            tooltip: @tr("Send the show to the outputs");
            toggled(on) => { Lighting.set-enabled(on); }
        }
    }
    HorizontalLayout {
        spacing: Theme.s1;
        for m in [{ id: "auto", label: "AUTO" }, { id: "easy", label: "EASY" }, { id: "pro", label: "PRO" }]: PlateButton {
            accessible-label: "lighting.mode." + m.id; accessible-role: tab;
            label: m.label; selected: Lighting.mode == m.id; horizontal-stretch: 1;
            tooltip: m.id == "auto" ? @tr("The show follows phrases, beat and the mix")
                : m.id == "easy" ? @tr("One look for the whole rig, locked to the beat")
                : @tr("Programs and colours per group, cue stack");
            clicked => { Lighting.set-mode(m.id); }
        }
    }
    HorizontalLayout {
        spacing: Theme.s3;
        height: 150px;
        VerticalLayout {
            spacing: Theme.key-gap;
            // The fader centred over its caption.
            HorizontalLayout {
                alignment: center; vertical-stretch: 1;
                Fader {
                    accessible-label: "lighting.master"; accessible-role: slider; accessible-value: Math.round(Lighting.master * 100) + " %";
                    value: Lighting.master; tone: Theme.attention; vertical-stretch: 1;
                    tooltip: @tr("Master dimmer");
                    changed(v) => { Lighting.set-master(v); }
                }
            }
            Caps { text: @tr("MASTER"); horizontal-alignment: center; }
        }
        VerticalLayout {
            spacing: Theme.s2; horizontal-stretch: 1;
            PlateButton {
                accessible-label: "lighting.blackout"; accessible-role: button;
                label: @tr("BLACKOUT"); active: Lighting.blackout; tone: Theme.fault;
                tooltip: @tr("All lights off");
                clicked => { Lighting.set-blackout(!Lighting.blackout); }
            }
            HoldButton {
                accessible-label: "lighting.flash"; accessible-role: button;
                label: @tr("FLASH"); on: Lighting.flash; size: 34px; tone: Theme.bone;
                tooltip: @tr("Full white while held");
                pressed => { Lighting.flash-held(true); }
                released => { Lighting.flash-held(false); }
            }
            HoldButton {
                accessible-label: "lighting.strobe"; accessible-role: button;
                label: @tr("STROBE"); on: Lighting.strobe; size: 34px;
                tooltip: @tr("Strobe while held");
                pressed => { Lighting.strobe-held(true); }
                released => { Lighting.strobe-held(false); }
            }
            HorizontalLayout {
                spacing: Theme.s2;
                HoldButton {
                    accessible-label: "lighting.fog"; accessible-role: button;
                    label: @tr("FOG"); on: Lighting.fog; size: 30px; tone: Theme.attention; horizontal-stretch: 1;
                    tooltip: Lighting.fog-armed ? @tr("Fog machines on while held") : @tr("Fog is locked out: arm it under SAFETY");
                    pressed => { Lighting.fog-held(true); }
                    released => { Lighting.fog-held(false); }
                }
                PlateButton {
                    accessible-label: "lighting.tap"; accessible-role: button;
                    label: Lighting.tap-bpm == "" ? @tr("TAP") : "TAP " + Lighting.tap-bpm; horizontal-stretch: 1;
                    tooltip: @tr("Tap the tempo for the lights when no deck plays");
                    clicked => { Lighting.tap(); }
                }
            }
        }
    }
    HLine { }
    if Lighting.mode == "auto": VerticalLayout {
        spacing: Theme.s2;
        Caps { text: @tr("AUTOMATIC"); }
        Text {
            text: @tr("Intros breathe, build-ups chase faster and end in a strobe, choruses sweep the movers on the beat, breakdowns calm down, outros fade. During a mix both tracks' looks blend by how loud each is.");
            wrap: word-wrap; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2;
        }
    }
    if Lighting.mode == "easy": VerticalLayout {
        spacing: Theme.s2;
        Caps { text: @tr("LOOK"); }
        ChoiceList {
            accessible-label: "lighting.easy.program"; accessible-role: list;
            items: Lighting.programs; current: Lighting.easy-program; columns: 2; cell-w: 140px;
            chosen(i) => { Lighting.choose-easy-program(i); }
        }
        Caps { text: @tr("COLOUR"); }
        Swatches { current: Lighting.easy-color; chosen(i) => { Lighting.choose-easy-color(i); } }
    }
    if Lighting.mode == "pro": VerticalLayout {
        spacing: Theme.s2;
        Caps { text: @tr("GROUPS"); }
        for g[gi] in Lighting.groups: VerticalLayout {
            spacing: Theme.key-gap;
            Text { text: g.name; font-family: Theme.family; font-size: Theme.control; color: Theme.bone; }
            HorizontalLayout {
                spacing: Theme.key-gap;
                PlateButton {
                    accessible-label: "lighting.pro.group" + gi + ".follow"; accessible-role: button;
                    compact: true; label: @tr("MUSIC"); selected: g.program < 0;
                    tooltip: @tr("Follow the music");
                    clicked => { Lighting.group-program(gi, -1); }
                }
                for p[pi] in Lighting.programs: PlateButton {
                    accessible-label: "lighting.pro.group" + gi + ".program" + pi; accessible-role: button;
                    compact: true; label: p; selected: g.program == pi;
                    clicked => { Lighting.group-program(gi, pi); }
                }
            }
            Swatches { current: g.color; chosen(i) => { Lighting.group-color(gi, i); } }
            HorizontalLayout {
                spacing: Theme.s2;
                PlateButton {
                    accessible-label: "lighting.pro.group" + gi + ".effect"; accessible-role: button;
                    compact: true; horizontal-stretch: 1;
                    label: "FX: " + Lighting.effects[g.effect];
                    tooltip: @tr("Attribute effect: click for the next one");
                    clicked => { Lighting.group-effect(gi, Math.mod(g.effect + 1, Lighting.effects.length)); }
                }
                // Pan / tilt programmer: drag in the square; double-click frees it.
                if g.has-movers: Rectangle {
                    accessible-label: "lighting.pro.group" + gi + ".xy"; accessible-role: slider;
                    width: 54px; height: 54px;
                    background: Theme.plate; border-width: 1px; border-color: Theme.rule;
                    Rectangle { x: parent.width / 2; width: 1px; background: Theme.rule; }
                    Rectangle { y: parent.height / 2; height: 1px; background: Theme.rule; }
                    if g.pan >= 0: Rectangle {
                        x: g.pan * (parent.width - 8px); y: (1 - g.tilt) * (parent.height - 8px);
                        width: 8px; height: 8px; border-radius: 4px; background: Theme.attention;
                    }
                    xy := TouchArea {
                        mouse-cursor: crosshair;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down) {
                                Lighting.group-position(gi, clamp(self.mouse-x / self.width, 0, 1), clamp(1 - self.mouse-y / self.height, 0, 1));
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                Lighting.group-position(gi, clamp(self.mouse-x / self.width, 0, 1), clamp(1 - self.mouse-y / self.height, 0, 1));
                            }
                        }
                        double-clicked => { Lighting.group-position-clear(gi); }
                    }
                }
            }
        }
        HLine { }
        Caps { text: @tr("TRACK CUES"); }
        Text { text: Lighting.timeline-title == "" ? @tr("Play a track to store lighting cues with it.") : Lighting.timeline-title; font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; overflow: elide; }
        for t[ti] in Lighting.timeline: Rectangle {
            accessible-label: "lighting.timeline" + ti; accessible-role: list-item; accessible-value: t;
            height: 22px;
            HorizontalLayout {
                padding-left: Theme.s2; spacing: Theme.s2;
                Text { text: t; font-family: Theme.family; font-size: Theme.control; color: Theme.bone; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                PlateButton { accessible-label: "lighting.timeline" + ti + ".delete"; accessible-role: button; compact: true; glyph: "close"; width: 30px; tooltip: @tr("Remove this track cue"); clicked => { Lighting.timeline-delete(ti); } }
            }
        }
        PlateButton {
            accessible-label: "lighting.timeline.add"; accessible-role: button;
            compact: true; label: @tr("CUE AT PLAYHEAD"); enabled: Lighting.timeline-title != "" && Lighting.cues.length > 0;
            tooltip: @tr("The current cue starts at this bar whenever the track plays");
            clicked => { Lighting.timeline-add(); }
        }
        HLine { }
        Caps { text: @tr("CUE STACK"); }
        for c[ci] in Lighting.cues: Rectangle {
            accessible-label: "lighting.cue" + ci; accessible-role: list-item; accessible-value: c;
            height: 24px;
            background: transparent;
            Rectangle { x: 0; width: 2px; background: ci == Lighting.active-cue ? Theme.attention : transparent; }
            HorizontalLayout {
                padding-left: Theme.s2; spacing: Theme.s2;
                Text { text: (ci + 1) + "  " + c; font-family: Theme.family; font-size: Theme.control; color: Theme.bone; vertical-alignment: center; horizontal-stretch: 1; }
                PlateButton { accessible-label: "lighting.cue" + ci + ".delete"; accessible-role: button; compact: true; glyph: "close"; tooltip: @tr("Delete this cue"); clicked => { Lighting.cue-delete(ci); } }
            }
        }
        HorizontalLayout {
            spacing: Theme.s1;
            PlateButton { accessible-label: "lighting.cue.back"; accessible-role: button; label: @tr("BACK"); horizontal-stretch: 1; tooltip: @tr("Previous cue"); clicked => { Lighting.cue-back(); } }
            PlateButton { accessible-label: "lighting.cue.go"; accessible-role: button; label: @tr("GO"); tone: Theme.live; horizontal-stretch: 1; tooltip: @tr("Next cue"); clicked => { Lighting.cue-go(); } }
        }
        HorizontalLayout {
            spacing: Theme.s2;
            cue := Field { accessible-label: "lighting.cue.name"; accessible-role: text-input; placeholder: @tr("Cue name"); horizontal-stretch: 1; }
            PlateButton {
                accessible-label: "lighting.cue.store"; accessible-role: button;
                compact: true; label: @tr("STORE"); tooltip: @tr("Store the group settings as a new cue");
                clicked => { Lighting.cue-store(cue.text); cue.text = ""; }
            }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

export component LightingView inherits Rectangle {
    in property <bool> detachable: true;
    accessible-label: "lighting.view"; accessible-role: groupbox;
    background: Theme.ground-band; border-radius: Theme.r-panel;
    HorizontalLayout {
        SetupPanel { width: 340px; }
        VLine { }
        VerticalLayout {
            horizontal-stretch: 1;
            padding: Theme.s3; spacing: Theme.s2;
            HorizontalLayout {
                height: 26px;
                spacing: Theme.s2;
                HorizontalLayout {
                    spacing: Theme.s1;
                    for c in [{ id: "stage", label: @tr("STAGE") }, { id: "patch", label: @tr("PATCH") }, { id: "channels", label: @tr("CHANNELS") }]: PlateButton {
                        accessible-label: "lighting.centre." + c.id; accessible-role: tab;
                        compact: true; label: c.label; selected: Lighting.centre == c.id;
                        clicked => { Lighting.centre = c.id; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.detachable: PlateButton {
                    accessible-label: "lighting.detach"; accessible-role: button;
                    compact: true; label: @tr("WINDOW"); tooltip: @tr("Open the lighting in its own window (second screen)");
                    clicked => { Lighting.detach(); }
                }
                Caps {
                    accessible-label: "lighting.status"; accessible-role: text; accessible-value: self.text;
                    text: Lighting.status; color: Theme.attention; vertical-alignment: center;
                }
            }
            if Lighting.centre == "stage": Stage { vertical-stretch: 1; accessible-label: "lighting.stage"; accessible-role: image; }
            if Lighting.centre == "patch": PatchTable { vertical-stretch: 1; }
            if Lighting.centre == "channels": ChannelGrid { vertical-stretch: 1; }
        }
        VLine { }
        ShowPanel { width: 340px; }
    }
}

// Compact output state: line, DMX, and what is wrong (Perform strip and top bar).
export component LinkStatus inherits HorizontalLayout {
    accessible-label: "lighting.link"; accessible-role: text;
    accessible-value: Lighting.link + " " + Lighting.link-text;
    spacing: Theme.s2;
    VerticalLayout { padding-top: Theme.s1; padding-bottom: Theme.s1; LinkLine { state: Lighting.link == "fault" ? "lost" : Lighting.link; } }
    Caps { text: "DMX"; vertical-alignment: center; }
    Text {
        text: Lighting.link-text; overflow: elide;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
        color: Lighting.link == "lost" || Lighting.link == "fault" ? Theme.fault : Theme.bone-2;
        vertical-alignment: center;
    }
}

// Lighting inside Perform: stage preview beside the live controls.
export component LightingStrip inherits Rectangle {
    accessible-label: "lighting.strip"; accessible-role: groupbox;
    height: 118px;
    background: Theme.ground-band; border-radius: Theme.r-panel;
    HorizontalLayout {
        padding: Theme.s2; spacing: Theme.s3;
        Stage { compact: true; horizontal-stretch: 1; accessible-label: "lighting.strip.stage"; accessible-role: image; }
        VerticalLayout {
            width: 300px; spacing: Theme.s2;
            HorizontalLayout {
                spacing: Theme.s1;
                for m in [{ id: "auto", label: "AUTO" }, { id: "easy", label: "EASY" }, { id: "pro", label: "PRO" }]: PlateButton {
                    accessible-label: "lighting.strip.mode." + m.id; accessible-role: tab;
                    compact: true; label: m.label; selected: Lighting.mode == m.id; horizontal-stretch: 1;
                    clicked => { Lighting.set-mode(m.id); }
                }
                LineToggle {
                    accessible-label: "lighting.strip.enable"; accessible-role: checkbox;
                    label: @tr("DMX OUT"); checked: Lighting.enabled; tone: Theme.live;
                    toggled(on) => { Lighting.set-enabled(on); }
                }
            }
            HorizontalLayout {
                spacing: Theme.s3; height: 18px;
                // A lost link takes the whole line: it is what needs you.
                LinkStatus { horizontal-stretch: Lighting.link == "lost" || Lighting.link == "fault" ? 1 : 0; }
                if Lighting.link != "lost" && Lighting.link != "fault": Caps { text: Lighting.status; color: Theme.attention; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: Theme.s1;
                PlateButton {
                    accessible-label: "lighting.strip.blackout"; accessible-role: button;
                    compact: true; label: @tr("BLACKOUT"); active: Lighting.blackout; tone: Theme.fault; horizontal-stretch: 1;
                    clicked => { Lighting.set-blackout(!Lighting.blackout); }
                }
                HoldButton {
                    accessible-label: "lighting.strip.flash"; accessible-role: button;
                    label: @tr("FLASH"); on: Lighting.flash; size: 28px; tone: Theme.bone; horizontal-stretch: 1;
                    pressed => { Lighting.flash-held(true); } released => { Lighting.flash-held(false); }
                }
                HoldButton {
                    accessible-label: "lighting.strip.strobe"; accessible-role: button;
                    label: @tr("STROBE"); on: Lighting.strobe; size: 28px; horizontal-stretch: 1;
                    pressed => { Lighting.strobe-held(true); } released => { Lighting.strobe-held(false); }
                }
            }
        }
    }
}

// The LIGHTING view on its own (detached window, second screen).
export component LightingWindow inherits Window {
    default-font-family: Theme.family;
    default-font-weight: Theme.weight-medium;
    title: "OpenDJDecks — Lighting";
    // Window / taskbar icon (X11 and Windows; Wayland and macOS take it
    // from the .desktop file / the bundle).
    icon: @image-url("../../../packaging/assets/icon-256.png");
    preferred-width: 1280px;
    preferred-height: 720px;
    background: Theme.ground;
    LightingView { detachable: false; }
}
