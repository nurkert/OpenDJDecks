// The booth view (roadmap [58]): the decks drawn large enough to read from
// a few metres, in its own window like the detached LIGHTING view, for a
// second screen or full screen on the laptop. It uses the type ranks of
// the deck (hero for BPM and remaining time, heading for key and phrase),
// all multiplied by one zoom that fills the window: a 640 × 360 canvas
// scaled up, so 1080p gives hero figures of about 96 px.

import { Theme } from "tokens.slint";
import { Caps, KeyFocus, TooltipState } from "controls.slint";
import { VLine } from "lines.slint";
import { DeckView, LaneMotion } from "structs.slint";
import { WaveLane } from "wave.slint";

export global Booth {
    callback toggle-full-screen();
}

// A caption over its value.
component Reading inherits VerticalLayout {
    in property <string> caption;
    in property <string> value;
    in property <length> size;
    in property <color> tone: Theme.bone;
    in property <float> zoom;
    in property <TextHorizontalAlignment> align: left;
    spacing: 0px;
    Caps { text: root.caption; font-size: Theme.label * root.zoom; letter-spacing: Theme.tracking-index * root.zoom; horizontal-alignment: root.align; }
    Text {
        text: root.value == "" ? "—" : root.value;
        font-family: Theme.family; font-size: root.size; font-weight: Theme.weight-semi;
        color: root.tone; horizontal-alignment: root.align; overflow: elide;
    }
}

component BoothDeck inherits Rectangle {
    in property <DeckView> deck;
    in property <LaneMotion> motion;
    in property <float> zoom;
    property <color> tone: Theme.deck-color(root.deck.deck);
    accessible-role: groupbox;
    accessible-id: "booth.deck\{root.deck.deck}";
    accessible-value: root.deck.loaded ? root.deck.title : "";
    background: Theme.ground-band; border-radius: Theme.r-panel;
    // The deck's line, doubled while it is the master.
    VLine {
        x: 0; y: Theme.s2 * root.zoom; height: parent.height - Theme.s4 * root.zoom;
        weight: Theme.line * root.zoom; tone: root.tone; form: root.deck.master ? "double" : "solid";
    }
    HorizontalLayout {
        padding-left: Theme.s4 * root.zoom; padding-right: Theme.s3 * root.zoom;
        padding-top: Theme.s2 * root.zoom; padding-bottom: Theme.s2 * root.zoom;
        spacing: Theme.s4 * root.zoom;
        // Who: numeral, title; tempo and key.
        VerticalLayout {
            width: 200px * root.zoom;
            spacing: Theme.s1 * root.zoom;
            HorizontalLayout {
                spacing: Theme.s2 * root.zoom;
                Text {
                    text: root.deck.deck;
                    font-family: Theme.family; font-size: Theme.hero * root.zoom; font-weight: Theme.weight-semi;
                    color: root.tone; vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.deck.loaded ? root.deck.title : @tr("Not loaded");
                        font-family: Theme.family; font-size: Theme.body * root.zoom; font-weight: Theme.weight-semi;
                        color: root.deck.loaded ? Theme.bone : Theme.bone-3; overflow: elide;
                    }
                    Text {
                        text: root.deck.artist;
                        font-family: Theme.family; font-size: Theme.label * root.zoom; font-weight: Theme.weight-medium;
                        color: Theme.bone-2; overflow: elide;
                    }
                }
            }
            Reading {
                accessible-role: text; accessible-id: "booth.deck\{root.deck.deck}.bpm"; accessible-value: root.deck.bpm;
                zoom: root.zoom; caption: "BPM"; value: root.deck.bpm; size: Theme.hero * root.zoom;
            }
            Reading {
                accessible-role: text; accessible-id: "booth.deck\{root.deck.deck}.key"; accessible-value: root.deck.key;
                zoom: root.zoom; caption: @tr("KEY"); value: root.deck.key; size: Theme.heading * root.zoom;
            }
        }
        // Where: the waveform, then the time left and the phrase.
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.s2 * root.zoom;
            WaveLane {
                vertical-stretch: 1;
                min-height: 40px * root.zoom;
                deck: root.deck; motion: root.motion;
            }
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.s5 * root.zoom;
                Reading {
                    accessible-role: text; accessible-id: "booth.deck\{root.deck.deck}.remaining"; accessible-value: root.deck.remaining-real;
                    zoom: root.zoom; caption: @tr("REMAINING"); value: root.deck.remaining-real; size: Theme.hero * root.zoom;
                    // The last tenth of the track needs you: sodium.
                    tone: root.deck.loaded && root.deck.playing && root.deck.progress > 0.9 ? Theme.attention : Theme.bone;
                }
                Reading {
                    accessible-role: text; accessible-id: "booth.deck\{root.deck.deck}.phrase"; accessible-value: root.deck.phrase;
                    horizontal-stretch: 1;
                    zoom: root.zoom; caption: @tr("PHRASE · TO THE NEXT"); value: root.deck.phrase; size: Theme.heading * root.zoom;
                    align: right;
                }
            }
        }
    }
}

export component BoothView inherits Rectangle {
    in property <[DeckView]> decks;
    in property <[LaneMotion]> lane-motion;
    // One factor for everything: the 640 × 360 canvas fills the window.
    // Four decks on a wide screen: two columns. Each deck scales with the
    // box it gets (two decks: 640 × 180 at 1×); four never go below ½.
    property <int> cols: root.decks.length > 2 && self.width > 1.2 * self.height ? 2 : 1;
    property <int> rows: Math.ceil(root.decks.length / root.cols);
    property <float> zoom: max(root.decks.length > 2 ? 0.5 : 1, min(self.width / root.cols / 640px, self.height / root.rows / 180px));
    background: Theme.ground;
    accessible-role: groupbox;
    accessible-id: "booth.view";
    TouchArea { double-clicked => { Booth.toggle-full-screen(); } }
    if root.cols == 1: VerticalLayout {
        padding: Theme.s2 * root.zoom;
        spacing: Theme.s2 * root.zoom;
        for d in root.decks: BoothDeck {
            vertical-stretch: 1;
            deck: d; zoom: root.zoom;
            motion: root.lane-motion[d.deck - 1];
        }
    }
    if root.cols == 2: GridLayout {
        padding: Theme.s2 * root.zoom;
        spacing: Theme.s2 * root.zoom;
        for d[i] in root.decks: BoothDeck {
            row: Math.floor(i / 2); col: Math.mod(i, 2);
            deck: d; zoom: root.zoom;
            motion: root.lane-motion[d.deck - 1];
        }
    }
}

// The booth view on its own (second screen, or full screen).
export component BoothWindow inherits Window {
    default-font-family: Theme.family;
    default-font-weight: Theme.weight-medium;
    title: "OpenDJDecks — Booth";
    icon: @image-url("../../../packaging/assets/icon-256.png");
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 360px;
    background: Theme.ground;
    in property <[DeckView]> decks;
    in property <[LaneMotion]> lane-motion;
    BoothView { decks: root.decks; lane-motion: root.lane-motion; }
}
