// Global header in zones: brand and work modes, then what the mode shows (view
// and panel switches), then live status (master tempo, recording, controller,
// master out, clock), with app tools beside it. Live values keep a fixed width.

import { Theme } from "tokens.slint";
import { VLine, HLine } from "lines.slint";
import { Help } from "help.slint";
import { Caps, PlateButton, Glyph, TipArea, TooltipState, Knob, PopupPlace, GuideMark, Field, KeyFocus } from "controls.slint";
import { Club } from "club.slint";
import { Lighting, LinkStatus } from "lighting.slint";
import { PerformLayout, DeckLayout } from "perform.slint";
import { GigCheck, LockKey, PerformLock } from "safety.slint";

component ModeTab inherits Rectangle {
    // The spoken name (readable, translated; the test id is `accessible-id`).
    accessible-role: tab;
    accessible-label: TooltipState.name-for(self.accessible-id, root.label, root.tooltip);
    accessible-description: TooltipState.describe(root.tooltip, root.command);
    in property <bool> narrow;
    in property <string> label;
    in property <bool> current;
    in property <string> tooltip;
    in property <string> command;
    in property <string> guide;
    callback clicked();
    min-width: t.preferred-width + (root.narrow ? 18px : 32px);
    // One segmented control: the current mode is the filled segment.
    Rectangle {
        y: Theme.s2; height: parent.height - 2 * Theme.s2;
        border-radius: Theme.r-control;
        background: root.current ? Theme.bone : touch.pressed || touch.has-hover ? Theme.plate-raised : Theme.plate;
        // Mode change: the filled segment moves to the new mode.
        animate background { duration: Theme.t-mode; easing: Theme.ease; }
    }
    t := Text {
        text: root.label;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; letter-spacing: root.narrow ? 1.2px : 2.4px;
        color: root.current ? Theme.ground : touch.has-hover ? Theme.bone : Theme.bone-2;
        vertical-alignment: center;
    }
    GuideMark { y: Theme.s2; width: parent.width; height: parent.height - 2 * Theme.s2; id: root.guide; }
    touch := TipArea { tooltip: root.tooltip; command: root.command; mouse-cursor: pointer; clicked => { root.clicked(); } }
    KeyFocus { activate => { root.clicked(); } }
}

// Panel switch in the bar: an ash plate, filled while the panel is open, in
// red while recording. The legend stays.
component PanelToggle inherits Rectangle {
    // The spoken name (readable, translated; the test id is `accessible-id`).
    accessible-role: button;
    accessible-label: TooltipState.name-for(self.accessible-id, root.label, root.tooltip);
    accessible-enabled: root.enabled;
    accessible-description: TooltipState.describe(root.tooltip, root.command);
    in property <bool> narrow;
    in property <string> label;
    in property <bool> on;
    in property <bool> running;
    in property <string> tooltip;
    in property <string> command;
    // Smallest width (44 px touch keys in the kiosk) and availability.
    in property <length> min-w: 0px;
    in property <bool> enabled: true;
    callback clicked();
    width: max(root.min-w, Theme.touch-min, t.preferred-width + (root.narrow ? 12px : 22px));
    // A step below the modes: panels are not a place to be.
    Rectangle {
        y: 9px; height: parent.height - 18px;
        border-radius: Theme.r-control;
        background: Theme.face(root.enabled, touch.pressed, touch.has-hover, false, root.on || root.running, root.running ? Theme.fault : Theme.setup-on);
        animate background { duration: Theme.t-press; easing: Theme.ease; }
    }
    t := Text {
        text: root.label;
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; letter-spacing: root.narrow ? 0.6px : 1.6px;
        color: Theme.ink(root.enabled, touch.pressed, touch.has-hover, false, root.on || root.running);
        horizontal-alignment: center; vertical-alignment: center;
    }
    touch := TipArea { tooltip: root.tooltip; command: root.command; enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
    KeyFocus { enabled: root.enabled; activate => { root.clicked(); } }
}

// Recording in the status zone: the action (a red fill and the running time
// while recording, a plain plate with a dot otherwise) and, joined to it, the
// switch for the recording section (a panel like MIXER).
component RecordKey inherits HorizontalLayout {
    in property <bool> narrow;
    in property <bool> recording;
    in property <string> recording-time;
    in property <bool> panel-open;
    callback toggle-recording();
    callback toggle-panel();
    spacing: Theme.key-gap;
    // Wide enough for the longest time: the zone stays put when it starts.
    action := Rectangle {
        accessible-id: "topbar.record"; accessible-role: button;
        accessible-label: TooltipState.name-for(self.accessible-id, @tr("RECORD"), rk.tooltip);
        KeyFocus { activate => { root.toggle-recording(); } }
        accessible-checkable: true; accessible-checked: root.recording;
        accessible-value: root.recording ? root.recording-time : "";
        width: max(probe-time.preferred-width, probe-rest.preferred-width) + 34px;
        Rectangle {
            y: Theme.s2; height: parent.height - 2 * Theme.s2;
            border-radius: Theme.r-control;
            background: Theme.face(true, rk.pressed, rk.has-hover, false, root.recording, Theme.fault);
            animate background { duration: Theme.t-press; easing: Theme.ease; }
        }
        Rectangle {
            x: 12px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 4px;
            background: Theme.ink(true, rk.pressed, rk.has-hover, false, root.recording);
        }
        probe-time := Text { visible: false; text: @tr("REC {}", "00:00.0"); font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; letter-spacing: 1px; }
        probe-rest := Text { visible: false; text: @tr("RECORD"); font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; letter-spacing: 1px; }
        Text {
            x: 26px; height: parent.height;
            text: root.recording ? @tr("REC {}", root.recording-time) : @tr("RECORD");
            font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; letter-spacing: 1px;
            color: Theme.ink(true, rk.pressed, rk.has-hover, false, root.recording);
            vertical-alignment: center;
        }
        rk := TipArea { tooltip: root.recording ? @tr("Stop recording") : @tr("Record the master output"); command: "record.toggle"; mouse-cursor: pointer; clicked => { root.toggle-recording(); } }
    }
    Rectangle {
        accessible-id: "topbar.toggle.rec"; accessible-role: button;
        accessible-label: TooltipState.name-for(self.accessible-id, "", pt.tooltip);
        KeyFocus { activate => { root.toggle-panel(); } }
        accessible-checkable: true; accessible-checked: root.panel-open;
        accessible-value: root.recording ? root.recording-time : "";
        width: max(24px, Theme.touch-min);
        Rectangle {
            y: 9px; height: parent.height - 18px;
            border-radius: Theme.r-control;
            background: Theme.face(true, pt.pressed, pt.has-hover, false, root.panel-open, Theme.setup-on);
        }
        Text {
            text: "▾"; font-size: Theme.label; vertical-alignment: center; horizontal-alignment: center;
            color: Theme.ink(true, pt.pressed, pt.has-hover, false, root.panel-open);
        }
        pt := TipArea { tooltip: root.panel-open ? @tr("Hide the recording section") : @tr("Show the recording section: level, meter and the record button"); command: "view.panel.rec"; mouse-cursor: pointer; clicked => { root.toggle-panel(); } }
    }
}

// The gig preset: high contrast, colour-blind palette and interface scale in
// one step (set from Rust).
export global Gig {
    in property <bool> active;
    in property <bool> contrast;
    in property <bool> colorblind;
    // Index into 100, 125, 150 %; -1 = another stored scale.
    in property <int> scale: 0;
    // Opens the menu (documentation screenshots, `DEMO_PROOF=gig-menu`).
    in property <bool> show-menu;
    callback act(string);
}

// GIG in the bar: a click switches the preset, the arrow opens its parts.
component GigKey inherits Rectangle {
    in property <bool> narrow;
    // Touch: the arrow is a 44 px key of its own.
    property <length> arrow-w: Theme.touch-mode ? 44px : 18px;
    width: Theme.touch-mode ? max(44px, l.preferred-width + 24px) + 44px : l.preferred-width + (root.narrow ? 26px : 32px);
    Rectangle {
        y: Theme.s2; height: parent.height - 2 * Theme.s2;
        border-radius: Theme.r-control;
        background: Theme.face(true, tog.pressed, tog.has-hover || open.has-hover, false, Gig.active, Theme.setup-on);
    }
    l := Text {
        x: root.narrow ? 6px : 10px; height: parent.height;
        text: @tr("GIG");
        font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; letter-spacing: 1px;
        color: Theme.ink(true, tog.pressed, tog.has-hover, false, Gig.active);
        vertical-alignment: center;
    }
    Text {
        x: parent.width - root.arrow-w / 2 - 4px; height: parent.height; text: "▾"; font-size: Theme.label; vertical-alignment: center;
        color: Theme.ink(true, open.pressed, open.has-hover, false, Gig.active);
    }
    tog := TipArea {
        accessible-role: button; accessible-id: "topbar.gig"; accessible-checkable: true; accessible-checked: Gig.active;
        accessible-label: TooltipState.name-for(self.accessible-id, @tr("GIG"), self.tooltip);
        KeyFocus { activate => { Gig.act("toggle"); } }
        width: parent.width - root.arrow-w; x: 0;
        tooltip: Gig.active ? @tr("Gig preset on: click to go back to your settings") : @tr("Gig preset: high contrast, colour-blind palette and a larger interface in one click");
        mouse-cursor: pointer;
        clicked => { Gig.act("toggle"); }
    }
    open := TipArea {
        accessible-role: button; accessible-id: "topbar.gig.menu";
        accessible-label: TooltipState.name-for(self.accessible-id, "", self.tooltip);
        KeyFocus { activate => { pop.show(); } }
        x: parent.width - root.arrow-w; width: root.arrow-w;
        tooltip: @tr("Gig preset: contrast, palette and interface scale");
        mouse-cursor: pointer;
        clicked => { pop.show(); }
    }
    property <bool> want-menu: Gig.show-menu;
    changed want-menu => { if (self.want-menu) { pop.show(); } }
    pop := PopupWindow {
        // As wide as its widest row of keys (longer in German), never under 240 px.
        property <length> w: max(240px, pop-body.min-width);
        x: PopupPlace.x(root.absolute-position.x, 0, self.w);
        y: PopupPlace.y(root.absolute-position.y, root.height + 2px, -pop-body.preferred-height - 2px, pop-body.preferred-height);
        width: self.w; height: pop-body.preferred-height;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.plate; border-radius: Theme.r-overlay;
            pop-body := VerticalLayout {
                padding: Theme.s3; spacing: Theme.s2;
                Text {
                    text: @tr("Gig preset");
                    font-family: Theme.family; font-size: Theme.body; font-weight: Theme.weight-semi; color: Theme.bone;
                }
                Text {
                    text: @tr("High contrast, the colour-blind palette and a larger interface, in one step.");
                    font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; wrap: word-wrap;
                }
                PlateButton {
                    accessible-role: button; accessible-id: "topbar.gig.toggle"; accessible-checkable: true; accessible-checked: Gig.active;
                    label: Gig.active ? @tr("TURN GIG PRESET OFF") : @tr("TURN GIG PRESET ON");
                    selected: Gig.active;
                    clicked => { Gig.act("toggle"); }
                }
                HorizontalLayout {
                    spacing: Theme.key-gap;
                    PlateButton { accessible-role: checkbox; accessible-id: "topbar.gig.contrast"; accessible-checkable: true; accessible-checked: Gig.contrast; horizontal-stretch: 1; compact: true; label: @tr("HIGH CONTRAST"); selected: Gig.contrast; clicked => { Gig.act("contrast"); } }
                    PlateButton { accessible-role: checkbox; accessible-id: "topbar.gig.colorblind"; accessible-checkable: true; accessible-checked: Gig.colorblind; horizontal-stretch: 1; compact: true; label: @tr("COLOUR-BLIND"); selected: Gig.colorblind; clicked => { Gig.act("colorblind"); } }
                }
                HorizontalLayout {
                    spacing: Theme.key-gap;
                    Caps { text: @tr("SCALE"); vertical-alignment: center; }
                    Rectangle { width: Theme.s2; }
                    for s[i] in ["100%", "125%", "150%"]: PlateButton {
                        accessible-role: button; accessible-id: "topbar.gig.scale." + i; compact: true; horizontal-stretch: 1;
                        label: s; selected: Gig.scale == i;
                        clicked => { Gig.act("scale:" + i); }
                    }
                }
                Rectangle { height: Theme.hair; background: Theme.rule; }
                Text {
                    text: @tr("Before the set: outputs, controller, space for the recording and missing track files.");
                    font-family: Theme.family; font-size: Theme.control; color: Theme.bone-2; wrap: word-wrap;
                }
                PlateButton {
                    accessible-role: button; accessible-id: "topbar.gig.check";
                    label: @tr("RUN GIG CHECK"); command: "gig.check";
                    clicked => { pop.close(); GigCheck.run(); }
                }
            }
        }
    }
}

// Picture of a Perform view in the layout menu: deck lanes as bars
// (horizontal) or posts (vertical), Browse as a framed list.
component ViewIcon inherits Rectangle {
    in property <string> view;
    in property <color> tone;
    width: 22px; height: 16px;
    property <int> n: root.view == "4h" || root.view == "4v" ? 4 : 2;
    if root.view == "2h" || root.view == "4h": VerticalLayout {
        alignment: center; spacing: root.n == 4 ? Theme.key-gap : Theme.s1;
        for i in root.n: Rectangle { height: 2px; background: root.tone; }
    }
    if root.view == "2v" || root.view == "4v": HorizontalLayout {
        alignment: center; spacing: root.n == 4 ? Theme.key-gap : Theme.s2;
        for i in root.n: Rectangle { width: 2px; background: root.tone; }
    }
    if root.view == "browse": Rectangle {
        border-width: 1.5px; border-color: root.tone;
        Rectangle { y: 4px; height: 1.5px; background: root.tone; }
    }
}

// Perform view switch: deck count and waveform direction in one menu
// (2 or 4 decks, horizontal or vertical lanes, or Browse).
component ViewMenu inherits Rectangle {
    in property <bool> narrow;
    in property <int> deck-count;
    in property <string> layout;
    // The mixer column is shown (its group key in the menu).
    in property <bool> mixer-on;
    callback chose(string);
    property <string> current: root.layout == "browse" ? "browse" : (root.deck-count >= 4 ? "4" : "2") + (root.layout == "vertical" ? "v" : "h");
    width: max(root.narrow ? 52px : 64px, row.preferred-width + (root.narrow ? 14px : 22px));
    Rectangle {
        y: Theme.s2; height: parent.height - 2 * Theme.s2;
        border-radius: Theme.r-control;
        background: touch.has-hover ? Theme.plate-raised : Theme.plate;
        row := HorizontalLayout {
            alignment: center; spacing: Theme.s2;
            VerticalLayout { alignment: center; ViewIcon { view: root.current; tone: Theme.bone; } }
            Text { text: "▾"; font-size: Theme.label; color: Theme.bone-2; vertical-alignment: center; }
        }
    }
    touch := TipArea {
        accessible-role: combobox; accessible-id: "topbar.layout"; accessible-value: root.current;
        accessible-label: TooltipState.name-for(self.accessible-id, "", self.tooltip);
        KeyFocus { activate => { pop.show(); } }
        tooltip: @tr("Perform view: 2 or 4 decks, horizontal or vertical waveforms, Browse");
        mouse-cursor: pointer;
        clicked => { pop.show(); }
    }
    // The menu: the view (deck count, lane direction, Browse), then the deck
    // layout (Simple / Standard / Full), the groups it shows and the saved
    // layouts. A click inside keeps it open, except on a view.
    property <length> pop-w: 300px;
    property <bool> want-menu: DeckLayout.show-menu;
    changed want-menu => { if (self.want-menu) { pop.show(); } }
    property <length> pop-h: 5 * 36px + 2px + 238px + DeckLayout.saved.length * 30px;
    pop := PopupWindow {
        x: PopupPlace.x(root.absolute-position.x, 0, root.pop-w);
        y: PopupPlace.y(root.absolute-position.y, root.height - 6px, -root.pop-h, root.pop-h);
        width: root.pop-w; height: root.pop-h;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.plate; border-radius: Theme.r-control;
            VerticalLayout {
                padding: Theme.key-gap;
                alignment: start;
                for v in [
                    { id: "2h", label: @tr("2 Decks · horizontal") },
                    { id: "2v", label: @tr("2 Decks · vertical") },
                    { id: "4h", label: @tr("4 Decks · horizontal") },
                    { id: "4v", label: @tr("4 Decks · vertical") },
                    { id: "browse", label: @tr("Browse") },
                ]: Rectangle {
                    accessible-role: button; accessible-id: "topbar.layout.\{v.id}";
                    accessible-checked: root.current == v.id;
                    height: 36px;
                    background: vi.has-hover ? Theme.plate-raised : transparent;
                    HorizontalLayout {
                        padding-left: Theme.s3; padding-right: Theme.s3; spacing: Theme.s3;
                        Text { width: 12px; text: root.current == v.id ? "✓" : ""; font-size: Theme.control; color: Theme.attention; vertical-alignment: center; }
                        VerticalLayout { alignment: center; ViewIcon { view: v.id; tone: root.current == v.id ? Theme.attention : Theme.bone-2; } }
                        Text {
                            text: v.label; font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
                            color: root.current == v.id ? Theme.bone : Theme.bone-2; vertical-alignment: center;
                        }
                    }
                    vi := TouchArea { mouse-cursor: pointer; clicked => { root.chose(v.id); pop.close(); } }
                }
                Rectangle { height: Theme.s1; }
                Rectangle { height: Theme.hair; background: Theme.rule-strong; }
                // Deck layout: one segmented choice.
                HorizontalLayout {
                    padding-left: Theme.s3; padding-right: Theme.s3; padding-top: Theme.s2;
                    height: 26px;
                    Caps { text: @tr("DECK LAYOUT"); vertical-alignment: center; }
                }
                HorizontalLayout {
                    padding-left: Theme.s2; padding-right: Theme.s2;
                    spacing: Theme.key-gap;
                    for l in [{ id: "simple", label: @tr("SIMPLE") }, { id: "standard", label: @tr("STANDARD") }, { id: "full", label: @tr("FULL") }]: PlateButton {
                        accessible-role: button; accessible-id: "topbar.layout.level.\{l.id}";
                        accessible-checkable: true; accessible-checked: DeckLayout.level == l.id;
                        compact: true; horizontal-stretch: 1;
                        label: l.label; selected: DeckLayout.level == l.id;
                        tooltip: l.id == "simple" ? @tr("Simple: about 25 large controls per deck") : l.id == "full" ? @tr("Full: everything, with the Tempo FX panel open") : @tr("Standard: the usual deck");
                        clicked => { DeckLayout.set-level(l.id); }
                    }
                }
                // Groups: on keys, a press hides or shows the whole group.
                HorizontalLayout {
                    padding-left: Theme.s3; padding-right: Theme.s3; padding-top: Theme.s2;
                    height: 26px;
                    Caps { text: @tr("SHOW"); vertical-alignment: center; }
                }
                for group-row in [
                    [{ id: "pads", label: @tr("PADS"), on: DeckLayout.pads }, { id: "loops", label: @tr("LOOPS"), on: DeckLayout.loops }, { id: "stems", label: @tr("STEMS"), on: DeckLayout.stems }, { id: "fx", label: "FX", on: DeckLayout.fx }],
                    [{ id: "mixer", label: @tr("MIXER"), on: root.mixer-on }, { id: "phase", label: @tr("PHASE"), on: DeckLayout.phase }],
                    [{ id: "setup", label: @tr("SETUP KEYS"), on: DeckLayout.setup }, { id: "platter", label: @tr("PLATTER"), on: DeckLayout.platter }],
                ]: HorizontalLayout {
                    padding-left: Theme.s2; padding-right: Theme.s2; padding-bottom: Theme.key-gap;
                    spacing: Theme.key-gap;
                    for g in group-row: PlateButton {
                        accessible-role: checkbox; accessible-id: "topbar.layout.group.\{g.id}";
                        accessible-checkable: true; accessible-checked: g.on;
                        compact: true; horizontal-stretch: 1;
                        label: g.label; active: g.on;
                        tooltip: g.on ? @tr("Shown: press to hide the whole group") : @tr("Hidden: press to show the group");
                        clicked => { DeckLayout.toggle(g.id); }
                    }
                }
                // Saved layouts: a press uses one, × deletes it.
                HorizontalLayout {
                    padding-left: Theme.s3; padding-right: Theme.s3; padding-top: Theme.s1;
                    height: 26px;
                    Caps { text: @tr("SAVED LAYOUTS"); vertical-alignment: center; }
                }
                for name[i] in DeckLayout.saved: HorizontalLayout {
                    height: 30px;
                    padding-left: Theme.s2; padding-right: Theme.s2;
                    spacing: Theme.key-gap;
                    Rectangle {
                        accessible-role: button; accessible-id: "topbar.layout.saved.slot\{i + 1}";
                        accessible-value: name; accessible-checked: DeckLayout.current == name;
                        horizontal-stretch: 1;
                        background: si.has-hover ? Theme.plate-raised : transparent;
                        border-radius: Theme.r-control;
                        HorizontalLayout {
                            padding-left: Theme.s1; spacing: Theme.s2;
                            Text { width: 10px; text: DeckLayout.current == name ? "✓" : ""; font-size: Theme.control; color: Theme.attention; vertical-alignment: center; }
                            Text { text: name; font-family: Theme.family; font-size: Theme.body; color: DeckLayout.current == name ? Theme.bone : Theme.bone-2; vertical-alignment: center; overflow: elide; }
                        }
                        si := TipArea { tooltip: @tr("Use this layout"); mouse-cursor: pointer; clicked => { DeckLayout.apply(name); } }
                    }
                    Rectangle {
                        accessible-role: button; accessible-id: "topbar.layout.saved.slot\{i + 1}.delete";
                        width: 26px;
                        background: sd.has-hover ? Theme.fault : transparent;
                        border-radius: Theme.r-control;
                        Glyph { x: (parent.width - 10px) / 2; y: (parent.height - 10px) / 2; width: 10px; height: 10px; kind: "close"; tone: sd.has-hover ? Theme.ink-on : Theme.bone-3; }
                        sd := TipArea { tooltip: @tr("Delete this saved layout"); mouse-cursor: pointer; clicked => { DeckLayout.remove(name); } }
                    }
                }
                HorizontalLayout {
                    padding-left: Theme.s2; padding-right: Theme.s2; padding-top: Theme.key-gap;
                    spacing: Theme.key-gap;
                    name-field := Field {
                        accessible-role: text-input; accessible-id: "topbar.layout.save-name";
                        horizontal-stretch: 1;
                        placeholder: @tr("NAME");
                        accepted(t) => { if (t != "") { DeckLayout.save(t); self.text = ""; } }
                    }
                    PlateButton {
                        accessible-role: button; accessible-id: "topbar.layout.save";
                        label: @tr("SAVE"); tone: Theme.live;
                        enabled: name-field.text != "";
                        tooltip: @tr("Save the deck layout and the groups shown under this name");
                        clicked => { DeckLayout.save(name-field.text); name-field.text = ""; }
                    }
                }
            }
        }
    }
}

export component TopBar inherits Rectangle {
    in property <string> mode;
    in property <string> status;
    in property <bool> recording;
    in property <string> recording-time;
    in property <string> undo-label;
    in property <bool> kiosk;
    // Narrow window (below 1500 px): tighter tabs and toggles, shorter brand.
    in property <bool> narrow;
    // Prepare layout ("player" or "browser") and its switch.
    in property <string> prepare-layout: "player";
    callback cycle-layout();
    // Perform view menu: decks shown and the chosen view ("2h", "4v", "browse" …).
    in property <int> deck-count: 2;
    callback set-perform-view(string);
    // Perform panel switches (shown in Perform only).
    in property <bool> show-panels;
    in property <bool> fx-panel;
    in property <bool> sampler-panel;
    callback toggle-fx-panel();
    callback toggle-sampler-panel();
    // Mixer column, Mix Preview panel (Perform) and the recording
    // section / bar (both modes).
    in property <bool> mixer-panel: true;
    in property <bool> mix-preview-panel;
    in property <bool> rec-panel: true;
    callback toggle-mixer-panel();
    callback toggle-mix-preview-panel();
    callback toggle-rec-panel();
    callback set-mode(string);
    callback toggle-recording();
    callback undo();
    callback open-preferences();
    callback cycle-appearance();
    // Connected controller ("" = none), master out level / meter, wall clock.
    in property <string> midi-device;
    in property <float> master-level: 1;
    in property <float> master-meter;
    in property <float> master-hold;
    in property <bool> master-clip;
    in property <string> clock;
    callback set-master-level(float);
    // macOS: room for the window buttons at the left; the bar's empty space
    // moves the window, a double-click there zooms it.
    in property <length> chrome-inset;
    callback window-drag();
    callback window-zoom();
    // Both groups side by side, or the live group on a second row.
    out property <bool> two-rows: !root.kiosk && modes-row.preferred-width + live-row.min-width > root.width;
    height: root.two-rows ? 88px : 44px;
    // Space between zones, always more than inside them.
    property <length> zone: root.narrow ? Theme.s3 : Theme.s5;
    // Below this width the brand is its rail mark, so live values keep room.
    property <bool> brand-short: root.width < 1360px;

    // Under everything else: the bar's own background takes the window
    // drag (the keys on top keep their clicks).
    if root.chrome-inset > 0: TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) { root.window-drag(); }
        }
        double-clicked => { root.window-zoom(); }
    }
    Rectangle {
        visible: !root.kiosk;
        // Test / accessibility hook: the work-mode tab group (no visuals, no
        // input; it only spans the tabs).
        Rectangle {
            accessible-id: "topbar.mode"; accessible-role: tab-list;
            accessible-value: root.mode;
            x: prep.x; y: prep.y;
            width: light.x + light.width - prep.x; height: prep.height;
        }

        // The bar is two groups: the modes and what they show, then what
        // is live. When both do not fit side by side (a small window or a
        // large interface scale), the live group moves to a second row.
        modes-row := HorizontalLayout {
            x: 0; y: 0; height: 44px;
            width: root.two-rows ? root.width : self.preferred-width;
            padding-left: Theme.s4 + root.chrome-inset;
            spacing: 0px;
            // Brand on the rail.
            Rectangle {
                width: root.brand-short ? 24px : root.narrow ? 132px : 196px;
                VLine { x: 12px; y: 10px; height: parent.height - 20px; weight: 1px; tone: Theme.rule-strong; }
                Rectangle { x: 9px; y: 6px; width: 7px; height: 7px; border-radius: 3.5px; border-width: 1px; border-color: Theme.bone-3; }
                if !root.brand-short: Text {
                    x: 28px; height: parent.height;
                    text: "OPENDJDECKS";
                    font-family: Theme.family; font-size: root.narrow ? Theme.control : Theme.body; font-weight: Theme.weight-semi; letter-spacing: root.narrow ? 0.4px : 2.2px;
                    color: Theme.bone; vertical-alignment: center;
                }
            }
            prep := ModeTab {
                narrow: root.narrow;
                accessible-id: "topbar.mode.prepare"; accessible-role: tab;
                accessible-item-selectable: true; accessible-item-selected: self.current;
                label: @tr("PREPARE"); guide: "topbar.mode.prepare"; tooltip: @tr("Prepare: library, beatgrids, cues and sticks"); command: "mode.prepare"; current: root.mode == "prepare"; clicked => { root.set-mode("prepare"); } }
            perf := ModeTab {
                narrow: root.narrow;
                accessible-id: "topbar.mode.perform"; accessible-role: tab;
                accessible-item-selectable: true; accessible-item-selected: self.current;
                label: @tr("PERFORM"); guide: "topbar.mode.perform"; tooltip: @tr("Perform: decks and mixer"); command: "mode.perform"; current: root.mode == "perform"; clicked => { root.set-mode("perform"); } }
            light := ModeTab {
                narrow: root.narrow;
                accessible-id: "topbar.mode.lighting"; accessible-role: tab;
                accessible-item-selectable: true; accessible-item-selected: self.current;
                label: @tr("LIGHTING"); tooltip: @tr("Lighting: DMX rig and light show"); command: "mode.lighting"; current: root.mode == "lighting"; clicked => { root.set-mode("lighting"); } }
            // ── Second zone: what this mode shows ──
            Rectangle { width: root.zone; }
            if root.mode == "perform" && !root.kiosk: ViewMenu {
                narrow: root.narrow;
                deck-count: root.deck-count; layout: PerformLayout.layout; mixer-on: root.mixer-panel;
                chose(v) => { root.set-perform-view(v); }
            }
            if root.mode == "perform" && !root.kiosk: Rectangle { width: Theme.s2; }
            if root.mode == "prepare" && !root.kiosk: PanelToggle {
                narrow: root.narrow;
                accessible-id: "topbar.layout"; accessible-role: button;
                accessible-value: root.prepare-layout;
                label: root.prepare-layout == "browser" ? @tr("FULL BROWSER") : root.prepare-layout == "two" ? @tr("2 PLAYERS") : root.prepare-layout == "dual" ? @tr("DUAL") : root.prepare-layout == "simple" ? @tr("SIMPLE") : @tr("PLAYER");
                on: root.prepare-layout != "player";
                tooltip: @tr("Next Prepare layout: player, 2 players, dual, simple, full browser");
                clicked => { root.cycle-layout(); }
            }
            if root.show-panels: PanelToggle {
                narrow: root.narrow;
                accessible-id: "topbar.club"; accessible-role: button;
                accessible-checkable: true; accessible-checked: self.on;
                label: "CLUB"; on: Club.enabled;
                tooltip: Club.enabled ? @tr("Back to the full deck controls") : @tr("Club mode: player screens and the club workflow");
                command: "perform.club";
                clicked => { Club.set-enabled(!Club.enabled); }
            }
            if root.show-panels: Rectangle { width: Theme.key-gap; }
            if root.show-panels: PanelToggle {
                narrow: root.narrow;
                accessible-id: "topbar.toggle.light"; accessible-role: button;
                accessible-checkable: true; accessible-checked: self.on;
                label: root.narrow ? @tr("STRIP") : @tr("LIGHT STRIP"); on: Lighting.panel;
                tooltip: Lighting.panel ? @tr("Hide the lighting strip") : @tr("Show the lighting strip");
                command: "perform.light.panel";
                clicked => { Lighting.panel = !Lighting.panel; }
            }
            // A lost DMX link shows here too, even with the strip hidden.
            if root.show-panels && !Lighting.panel && (Lighting.link == "lost" || Lighting.link == "fault"): HorizontalLayout {
                padding-left: Theme.s2; padding-right: Theme.s1;
                LinkStatus { }
            }
            if root.show-panels: Rectangle { width: Theme.key-gap; }
            if root.show-panels && DeckLayout.fx: PanelToggle {
                narrow: root.narrow;
                accessible-id: "topbar.toggle.fx"; accessible-role: button;
                accessible-checkable: true; accessible-checked: self.on;
                label: "FX"; on: root.fx-panel;
                tooltip: root.fx-panel ? @tr("Hide the Tempo FX panel") : @tr("Show the Tempo FX panel");
                command: "perform.fx.panel";
                clicked => { root.toggle-fx-panel(); }
            }
            if root.show-panels && DeckLayout.fx: Rectangle { width: Theme.key-gap; }
            if root.show-panels: PanelToggle {
                narrow: root.narrow;
                accessible-id: "topbar.toggle.mix-preview"; accessible-role: button;
                accessible-checkable: true; accessible-checked: self.on;
                label: @tr("PREVIEW"); on: root.mix-preview-panel;
                tooltip: root.mix-preview-panel ? @tr("Hide Mix Preview") : @tr("Mix Preview: set where the next track comes in and the current one goes out");
                command: "perform.mix-preview.panel";
                clicked => { root.toggle-mix-preview-panel(); }
            }
            if root.show-panels: Rectangle { width: Theme.key-gap; }
            if root.show-panels: PanelToggle {
                narrow: root.narrow;
                accessible-id: "topbar.toggle.sampler"; accessible-role: button;
                accessible-checkable: true; accessible-checked: self.on;
                label: @tr("SAMPLER"); on: root.sampler-panel;
                tooltip: root.sampler-panel ? @tr("Hide the sampler panel") : @tr("Show the sampler panel");
                command: "perform.sampler.panel";
                clicked => { root.toggle-sampler-panel(); }
            }
            if root.show-panels: Rectangle { width: Theme.key-gap; }
            if root.show-panels: PanelToggle {
                narrow: root.narrow;
                accessible-id: "topbar.toggle.mixer"; accessible-role: button;
                accessible-checkable: true; accessible-checked: self.on;
                label: @tr("MIXER"); on: root.mixer-panel;
                tooltip: root.mixer-panel ? @tr("Hide the mixer: the decks meet in the centre") : @tr("Show the mixer between the decks");
                command: "perform.mixer.panel";
                clicked => { root.toggle-mixer-panel(); }
            }
            // The first row ends here when the bar wraps.
            Rectangle { horizontal-stretch: 1; }
        }
        live-row := HorizontalLayout {
            // On its own row it starts where the first row does.
            x: root.two-rows ? Theme.s4 - root.zone : modes-row.width;
            y: root.two-rows ? 44px : 0px;
            height: 44px;
            width: root.width - self.x;
            padding-right: Theme.s3;
            spacing: 0px;
            // ── Third zone: what is live now ──
            Rectangle { width: root.zone; }
            Rectangle {
                // The master tempo is a live value: as wide as it can get, so
                // it is never cut off; anything longer shares what is left.
                horizontal-stretch: 1;
                min-width: root.mode == "perform" ? status-probe.preferred-width : 0px;
                status-probe := Caps { visible: false; text: @tr("MASTER {} BPM", "000.0"); }
                status-text := Caps {
                    accessible-id: "topbar.status"; accessible-role: text; accessible-value: root.status;
                    width: parent.width; height: parent.height;
                    text: root.status; vertical-alignment: center; overflow: elide;
                }
                TipArea { tooltip: root.status; }
            }
            Rectangle { width: root.narrow ? Theme.s2 : Theme.s3; }
            RecordKey {
                narrow: root.narrow;
                recording: root.recording;
                recording-time: root.recording-time;
                panel-open: root.rec-panel;
                toggle-recording => { root.toggle-recording(); }
                toggle-panel => { root.toggle-rec-panel(); }
            }
            // Controller state: a dot that lights while a MIDI controller is connected.
            Rectangle {
                accessible-id: "topbar.status.midi"; accessible-role: text;
                accessible-value: root.midi-device == "" ? "none" : root.midi-device;
                width: root.narrow ? 20px : 66px;
                Rectangle {
                    x: 8px; y: (parent.height - 6px) / 2; width: 6px; height: 6px; border-radius: 3px;
                    background: root.midi-device != "" ? Theme.live : transparent;
                    border-width: 1px; border-color: root.midi-device != "" ? Theme.live : Theme.bone-3;
                }
                if !root.narrow: Caps { x: 20px; height: parent.height; text: "MIDI"; vertical-alignment: center; color: root.midi-device != "" ? Theme.bone : Theme.bone-3; }
                TipArea { tooltip: root.midi-device != "" ? @tr("Controller connected: {}", root.midi-device) : @tr("No controller connected"); }
            }
            LockKey { narrow: root.narrow; }
            Rectangle { width: root.narrow ? Theme.key-gap : Theme.s2; }
            // App tools.
            GigKey { narrow: root.narrow; }
            Rectangle { width: root.narrow ? Theme.s1 : Theme.s2; }
            // Appearance: moon (dark), sun (light), half disc (follow system);
            // a click moves on to the next mode.
            Rectangle {
                accessible-id: "topbar.appearance"; accessible-role: button;
                accessible-label: TooltipState.name-for(self.accessible-id, "", at.tooltip);
                KeyFocus { activate => { root.cycle-appearance(); } }
                width: max(Theme.touch-min, root.narrow ? 28px : 36px);
                Rectangle {
                    y: 8px; height: parent.height - 16px;
                    background: at.has-hover ? Theme.plate : transparent;
                }
                Glyph {
                    x: (parent.width - 10px) / 2; y: (parent.height - 10px) / 2;
                    kind: Theme.appearance == "light" ? "sun" : Theme.appearance == "system" ? "auto" : "moon";
                    tone: at.has-hover ? Theme.bone : Theme.bone-2;
                }
                at := TipArea {
                    tooltip: Theme.appearance == "light" ? @tr("Appearance: light — click for system") : Theme.appearance == "system" ? @tr("Appearance: follows the system — click for dark") : @tr("Appearance: dark — click for light");
                    mouse-cursor: pointer;
                    clicked => { root.cycle-appearance(); }
                }
            }
            // Preferences (⌘, / Ctrl+,).
            Rectangle {
                accessible-id: "topbar.settings"; accessible-role: button;
                accessible-label: TooltipState.name-for(self.accessible-id, "", gt.tooltip);
                KeyFocus { activate => { root.open-preferences(); } }
                width: max(Theme.touch-min, root.narrow ? 28px : 36px);
                Rectangle {
                    y: 8px; height: parent.height - 16px;
                    background: gt.has-hover ? Theme.plate : transparent;
                }
                Glyph { x: (parent.width - 10px) / 2; y: (parent.height - 10px) / 2; kind: "gear"; tone: gt.has-hover ? Theme.bone : Theme.bone-2; }
                gt := TipArea { tooltip: @tr("Preferences"); command: "prefs.open"; mouse-cursor: pointer; clicked => { root.open-preferences(); } }
            }
            // Help: names every control on screen (F12 or ?).
            Rectangle {
                accessible-id: "topbar.help"; accessible-role: button;
                accessible-label: TooltipState.name-for(self.accessible-id, "", ht.tooltip);
                accessible-checkable: true; accessible-checked: Help.on;
                KeyFocus { activate => { Help.toggle(); } }
                width: max(Theme.touch-min, root.narrow ? 28px : 36px);
                Rectangle {
                    y: 8px; height: parent.height - 16px;
                    background: Help.on ? Theme.bone : ht.has-hover ? Theme.plate : transparent;
                    border-radius: Theme.r-control;
                }
                Text {
                    text: "?"; font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
                    color: Help.on ? Theme.ground : ht.has-hover ? Theme.bone : Theme.bone-2;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                ht := TipArea { tooltip: @tr("Help: name every control on screen"); command: "help.overlay"; mouse-cursor: pointer; clicked => { Help.toggle(); } }
            }
            Rectangle { width: Theme.s1; }
            // Editing happens in Prepare: nothing to undo elsewhere.
            if root.undo-label != "" && root.mode == "prepare": Rectangle {
                accessible-id: "topbar.undo"; accessible-role: button; accessible-value: root.undo-label;
                accessible-label: TooltipState.name-for(self.accessible-id, @tr("UNDO"), @tr("Undo the last change"));
                KeyFocus { activate => { root.undo(); } }
                width: u.preferred-width + 24px;
                u := Caps { text: root.narrow ? @tr("UNDO") : @tr("UNDO  {}  ⌘Z", root.undo-label); vertical-alignment: center; height: parent.height; }
                TipArea { tooltip: @tr("Undo the last change"); command: "library.undo"; mouse-cursor: pointer; clicked => { root.undo(); } }
            }
            Rectangle { width: Theme.s2; }
            // Master out: level meter, volume and the time of day.
            if !root.kiosk: Rectangle {
                accessible-id: "topbar.master-meter"; accessible-role: progress-indicator;
                accessible-value: Math.round(clamp(root.master-meter, 0, 1) * 100) + "%";
                width: 46px;
                Rectangle { x: 0; y: (parent.height - 4px) / 2; width: parent.width; height: 4px; background: Theme.plate; }
                Rectangle {
                    x: 0; y: (parent.height - 4px) / 2; height: 4px;
                    width: parent.width * clamp(root.master-meter, 0, 1);
                    background: root.master-clip ? Theme.fault : root.master-meter > 0.8 ? Theme.attention : Theme.live;
                }
                // Peak hold: a 2px tick at the highest recent peak.
                if root.master-hold > 0.01: Rectangle {
                    accessible-role: image; accessible-id: "topbar.master-hold"; accessible-value: Math.round(clamp(root.master-hold, 0, 1) * 100);
                    x: (parent.width - 2px) * clamp(root.master-hold, 0, 1); y: (parent.height - 8px) / 2; width: 2px; height: 8px;
                    background: root.master-clip || root.master-hold > 0.99 ? Theme.fault : root.master-hold > 0.8 ? Theme.attention : Theme.bone;
                }
                Caps { y: parent.height / 2 + 4px; text: @tr("MASTER"); font-size: Theme.label; }
            }
            if !root.kiosk: Rectangle { width: Theme.s2; }
            if !root.kiosk: VerticalLayout {
                alignment: center;
                Knob {
                    accessible-id: "topbar.master-volume"; accessible-role: slider;
                    accessible-value: Math.round(root.master-level * 100) + "%";
                    label: ""; size: 24px; minimum: 0; maximum: 1; default-value: 1;
                    value: root.master-level; tone: Theme.attention;
                    tooltip: @tr("Master out level (double-click resets)");
                    changed(v) => { root.set-master-level(v); }
                }
            }
            if !root.kiosk: Rectangle { width: Theme.s3; }
            Text {
                accessible-id: "topbar.clock"; accessible-role: text; accessible-value: self.text;
                text: root.clock;
                font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; letter-spacing: 1px;
                color: Theme.bone-2; vertical-alignment: center;
            }
            Rectangle { width: Theme.s1; }
        }
    }
    // ── Kiosk (800 × 480, controller first): 44 px keys, the rest in ⋯ ──
    if root.kiosk: HorizontalLayout {
        padding-left: Theme.s2; padding-right: Theme.s2;
        spacing: Theme.s1;
        // Work mode: one key; the list opens below it.
        Rectangle {
            accessible-id: "topbar.mode"; accessible-role: combobox; accessible-value: root.mode;
            width: max(84px, mk.preferred-width + 20px);
            background: Theme.bone;
            mk := Text { text: root.mode == "prepare" ? @tr("PREPARE") : root.mode == "lighting" ? @tr("LIGHTING") : @tr("PERFORM"); font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; letter-spacing: 1.2px; color: Theme.ground; }
            kmode := TipArea { tooltip: @tr("Work mode"); mouse-cursor: pointer; clicked => { modes.show(); } }
            modes := PopupWindow {
                x: PopupPlace.x(parent.absolute-position.x, 0, 140px);
                y: PopupPlace.y(parent.absolute-position.y, parent.height, -3 * 44px, 3 * 44px);
                width: 140px; height: 3 * 44px;
                Rectangle {
                    background: Theme.plate; border-radius: Theme.r-control;
                    VerticalLayout {
                        width: 140px;
                        for m[i] in [{ id: "prepare", label: @tr("PREPARE") }, { id: "perform", label: @tr("PERFORM") }, { id: "lighting", label: @tr("LIGHTING") }]: Rectangle {
                            height: 44px;
                            background: mi.has-hover ? Theme.plate-raised : transparent;
                            Text { x: 12px; text: m.label; font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi; color: root.mode == m.id ? Theme.bone : Theme.bone-2; vertical-alignment: center; height: parent.height; }
                            mi := TouchArea { clicked => { root.set-mode(m.id); modes.close(); } }
                        }
                    }
                }
            }
        }
        if root.mode == "perform": ViewMenu {
            narrow: true;
            deck-count: root.deck-count; layout: PerformLayout.layout; mixer-on: root.mixer-panel;
            chose(v) => { root.set-perform-view(v); }
        }
        if root.show-panels: PanelToggle {
            accessible-id: "topbar.toggle.fx"; accessible-role: button;
            accessible-checkable: true; accessible-checked: self.on;
            narrow: true; min-w: 44px;
            label: "FX"; on: root.fx-panel;
            tooltip: root.fx-panel ? @tr("Hide the Tempo FX panel") : @tr("Show the Tempo FX panel");
            clicked => { root.toggle-fx-panel(); }
        }
        if root.show-panels: PanelToggle {
            accessible-id: "topbar.toggle.mix-preview"; accessible-role: button;
            accessible-checkable: true; accessible-checked: self.on;
            narrow: true; min-w: 44px;
            label: "PREV"; on: root.mix-preview-panel;
            tooltip: root.mix-preview-panel ? @tr("Hide Mix Preview") : @tr("Mix Preview: set where the next track comes in and the current one goes out");
            clicked => { root.toggle-mix-preview-panel(); }
        }
        if root.show-panels: PanelToggle {
            accessible-id: "topbar.toggle.sampler"; accessible-role: button;
            accessible-checkable: true; accessible-checked: self.on;
            narrow: true; min-w: 44px;
            label: "SMPL"; on: root.sampler-panel;
            tooltip: root.sampler-panel ? @tr("Hide the sampler panel") : @tr("Show the sampler panel");
            clicked => { root.toggle-sampler-panel(); }
        }
        // The mixer is on the controller: the switch stays, dimmed.
        if root.show-panels: PanelToggle {
            accessible-id: "topbar.toggle.mixer"; accessible-role: button;
            accessible-checkable: true; accessible-checked: self.on;
            narrow: true; min-w: 44px;
            label: "MIX"; on: false; enabled: false;
            tooltip: @tr("The mixer is on the controller");
        }
        PanelToggle {
            accessible-id: "topbar.toggle.rec"; accessible-role: button;
            accessible-checkable: true; accessible-checked: self.on;
            accessible-value: root.recording ? root.recording-time : "";
            narrow: true; min-w: 44px;
            label: root.recording ? @tr("REC {}", root.recording-time) : "REC";
            on: root.rec-panel;
            running: root.recording;
            tooltip: root.rec-panel ? @tr("Hide the recording section") : @tr("Show the recording section: level, meter and the record button");
            clicked => { root.toggle-rec-panel(); }
        }
        Rectangle {
            accessible-id: "topbar.status.midi"; accessible-role: text;
            accessible-value: root.midi-device == "" ? "none" : root.midi-device;
            width: kmt.preferred-width + 22px;
            Rectangle {
                x: 4px; y: (parent.height - 6px) / 2; width: 6px; height: 6px; border-radius: 3px;
                background: root.midi-device != "" ? Theme.live : transparent;
                border-width: 1px; border-color: root.midi-device != "" ? Theme.live : Theme.bone-3;
            }
            kmt := Caps { x: 14px; height: parent.height; text: "MIDI"; vertical-alignment: center; color: root.midi-device != "" ? Theme.bone : Theme.bone-3; }
        }
        Caps { text: root.status; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
        Rectangle {
            accessible-id: "topbar.settings"; accessible-role: button;
            accessible-label: TooltipState.name-for(self.accessible-id, "", kg.tooltip);
            KeyFocus { activate => { root.open-preferences(); } }
            width: 44px;
            background: kg.has-hover ? Theme.plate : transparent;
            Glyph { x: (parent.width - 10px) / 2; y: (parent.height - 10px) / 2; kind: "gear"; tone: kg.has-hover ? Theme.bone : Theme.bone-2; }
            kg := TipArea { tooltip: @tr("Preferences"); mouse-cursor: pointer; clicked => { root.open-preferences(); } }
        }
        Rectangle {
            accessible-id: "topbar.help"; accessible-role: button;
            accessible-label: TooltipState.name-for(self.accessible-id, "", kh.tooltip);
            accessible-checkable: true; accessible-checked: Help.on;
            KeyFocus { activate => { Help.toggle(); } }
            width: 44px;
            background: Help.on ? Theme.bone : kh.has-hover ? Theme.plate : transparent;
            Text {
                text: "?"; font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
                color: Help.on ? Theme.ground : kh.has-hover ? Theme.bone : Theme.bone-2;
                horizontal-alignment: center; vertical-alignment: center;
            }
            kh := TipArea { tooltip: @tr("Help: name every control on screen"); mouse-cursor: pointer; clicked => { Help.toggle(); } }
        }
        Rectangle {
            accessible-id: "topbar.master-meter"; accessible-role: progress-indicator;
            accessible-value: Math.round(clamp(root.master-meter, 0, 1) * 100) + "%";
            width: 40px;
            Rectangle { x: 0; y: (parent.height - 4px) / 2; width: parent.width; height: 4px; background: Theme.plate; }
            Rectangle {
                x: 0; y: (parent.height - 4px) / 2; height: 4px;
                width: parent.width * clamp(root.master-meter, 0, 1);
                background: root.master-clip ? Theme.fault : root.master-meter > 0.8 ? Theme.attention : Theme.live;
            }
            // Peak hold: a 2px tick at the highest recent peak.
            if root.master-hold > 0.01: Rectangle {
                accessible-role: image; accessible-id: "topbar.master-hold"; accessible-value: Math.round(clamp(root.master-hold, 0, 1) * 100);
                x: (parent.width - 2px) * clamp(root.master-hold, 0, 1); y: (parent.height - 8px) / 2; width: 2px; height: 8px;
                background: root.master-clip || root.master-hold > 0.99 ? Theme.fault : root.master-hold > 0.8 ? Theme.attention : Theme.bone;
            }
        }
        Text {
            accessible-id: "topbar.clock"; accessible-role: text; accessible-value: self.text;
            text: root.clock;
            font-family: Theme.family; font-size: Theme.control; font-weight: Theme.weight-semi;
            color: Theme.bone-2; vertical-alignment: center;
        }
        // Everything else of the bar: Club mode, lighting strip,
        // appearance, undo, recording.
        more := ContextMenuArea {
            width: 44px;
            Menu {
                MenuItem { title: Club.enabled ? @tr("Back to the full deck controls") : @tr("Club mode"); enabled: root.show-panels; activated => { Club.set-enabled(!Club.enabled); } }
                MenuItem { title: Lighting.panel ? @tr("Hide the lighting strip") : @tr("Show the lighting strip"); enabled: root.show-panels; activated => { Lighting.panel = !Lighting.panel; } }
                MenuItem { title: PerformLock.locked ? @tr("Unlock") : @tr("Lock for the set"); activated => { PerformLock.toggle(); } }
                MenuItem { title: Gig.active ? @tr("Gig preset: off") : @tr("Gig preset: on"); activated => { Gig.act("toggle"); } }
                MenuItem { title: @tr("Appearance: dark, light or system"); activated => { root.cycle-appearance(); } }
                MenuItem { title: @tr("Undo the last change"); enabled: root.undo-label != "" && root.mode == "prepare"; activated => { root.undo(); } }
                MenuItem { title: root.recording ? @tr("Stop recording") : @tr("Record the master output"); activated => { root.toggle-recording(); } }
            }
            Rectangle {
                accessible-id: "topbar.more"; accessible-role: button;
                background: km.has-hover ? Theme.plate : transparent;
                Text { text: "⋯"; font-family: Theme.family; font-size: Theme.heading; font-weight: Theme.weight-semi; color: Theme.bone-2; }
                km := TipArea { tooltip: @tr("More"); mouse-cursor: pointer; clicked => { more.show({ x: 0, y: self.height }); } }
            }
        }
    }
}
