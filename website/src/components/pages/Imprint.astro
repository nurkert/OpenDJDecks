---
import Base from '../../layouts/Base.astro';
import { ui, type Lang } from '../../i18n/ui';
import { loadImprint } from '../../lib/imprint';
import '../../styles/prose.css';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
// The imprint itself is in German, as the law requires; it is fetched once per build.
const imprint = await loadImprint();
---

<Base lang={lang} page="imprint" title={`${t.legal.imprintTitle} · OpenDJDecks`} description={t.legal.imprintTitle}>
  <main id="main" class="page">
    <article class="container prose legal" lang="de">
      <h1 class="page-title">{t.legal.imprintTitle}</h1>
      {
        imprint ? (
          <Fragment set:html={imprint.html} />
        ) : (
          <>
            <p lang={lang}>{t.legal.forkNote}</p>
            <p lang={lang}>
              <a href="https://nurkert.de/impressum">nurkert.de/impressum</a>
            </p>
          </>
        )
      }
    </article>
  </main>
</Base>

<style>
  .legal {
    max-width: var(--prose);
  }
</style>
