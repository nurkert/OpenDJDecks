---
// The download page: the visitor's system first and alone, with one button and its install
// steps; the other systems sit behind quiet tabs. Version and download count are read from
// GitHub at build time. Without JavaScript every system is shown, one below the other.
import { existsSync } from 'node:fs';
import { Picture } from 'astro:assets';

import '../../styles/download.css';

import Base from '../../layouts/Base.astro';
import StepArt from '../StepArt.astro';
import { releasesUrl, ui, type Lang } from '../../i18n/ui';
import { guideHref } from '../../lib/docs-catalog.mjs';
import { loadRelease, type Asset, type Kind, type Platform } from '../../lib/releases';

import perform from '../../../../docs/assets/screenshots/perform.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const d = t.download;
const release = await loadRelease();
const locale = lang === 'de' ? 'de-DE' : 'en-GB';

// The real macOS screenshots replace the placeholders under src/assets/install; if one is
// absent the page shows a drawn plate instead.
const installImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/install/mac-*.png', { eager: true });
const macImage = (n: number) => {
  const names = ['1-drag', '2-blocked', '3-settings', '4-open-anyway', '5-confirm'];
  const key = Object.keys(installImages).find((file) => file.endsWith(`/mac-${names[n]}.png`));
  return key ? installImages[key].default : undefined;
};

const number = (value: number) => value.toLocaleString(locale);
const date = release ? new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(release.publishedAt) : '';
const sizeLabel = (asset: Asset) => `${asset.sizeMb.toLocaleString(locale)} ${d.size}`;
const altFor = (n: number, title: string) => d.stepImageAlt.replace('{n}', String(n)).replace('{title}', title);

// What a visitor gets as a big button; everything else waits under "Other versions".
const primary: Record<Platform, Kind[]> = {
  macos: ['dmgArm', 'dmgIntel'],
  windows: ['zip'],
  linux: ['debAmd', 'appimageX86'],
  pi: ['pi'],
};
const reqs: Record<Platform, string> = { macos: d.reqs.macos, windows: d.reqs.windows, linux: d.linuxIntro, pi: d.piIntro };
const order: Platform[] = ['macos', 'windows', 'linux', 'pi'];
const panels = order.map((id) => {
  const files = release?.assets.filter((asset) => asset.platform === id) ?? [];
  const main = primary[id].flatMap((kind) => files.filter((asset) => asset.kind === kind));
  // On a Mac the button shows one of the two versions, so the list offers both.
  const more = id === 'macos' ? main : files.filter((asset) => !main.includes(asset));
  return { id, main, more };
});

// Only reference the video once its files exist, so no visitor ever requests a missing file.
const publicDir = new URL('../../../public/media/', import.meta.url);
const hasVideo = existsSync(new URL('perform.webm', publicDir)) && existsSync(new URL('perform.mp4', publicDir));

const counts = release ? order.map((id) => ({ id, name: d.platforms[id], count: release.downloads[id] })).filter((p) => p.count > 0) : [];
const total = counts.reduce((sum, p) => sum + p.count, 0);
---

<Base lang={lang} page="download" title={d.metaTitle} description={d.metaDescription}>
  <main id="main" class="page">
    <div class="container dl" data-dl>
      <div class="dl__top">
        <div class="dl__left">
          <p class="dl__unknown" data-unknown hidden>{d.unknownOs}</p>
          <nav class="tabs" aria-label={d.systems} data-tabs>
            {
              order.map((id) => (
                <a class="tabs__tab" href={`#${id}`} data-tab={id}>
                  {d.platforms[id]}
                </a>
              ))
            }
            <span class="tabs__glider" aria-hidden="true"></span>
          </nav>

          {
            panels.map(({ id, main, more }) => (
              <section class="get" id={id} data-panel={id}>
                <h1 class="get__title">{d.heads[id]}</h1>
                <p class="get__req">{reqs[id]}</p>
                <div class="get__actions">
                  {main.map((asset, i) => (
                    <a class={`plate-btn get__btn ${i === 0 || id === 'macos' ? 'plate-btn--primary' : ''}`} href={asset.url} data-kind={asset.kind}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 4v11M7 11l5 5 5-5M5 20h14" />
                      </svg>
                      <span class="get__word">{d.get}</span>
                      <span class="get__meta">
                        {d.kinds[asset.kind]} · {sizeLabel(asset)}
                      </span>
                    </a>
                  ))}
                  {main.length === 0 && (
                    <a class="plate-btn plate-btn--primary get__btn" href={releasesUrl}>
                      {d.toReleases}
                    </a>
                  )}
                </div>
                {id === 'macos' && main.length > 1 && (
                  <p class="get__hint" data-chip>
                    {d.bothChips}
                  </p>
                )}
                {id === 'pi' && (
                  <a class="plate-btn" href={guideHref('raspberry-pi', lang)}>
                    {d.piLink}
                  </a>
                )}
                {more.length > 0 && (
                  <details class="more" data-more={id} hidden={id === 'macos'}>
                    <summary>{d.more}</summary>
                    <ul class="more__list">
                      {more.map((asset) => (
                        <li>
                          <a href={asset.url}>
                            <span class="more__kind">{d.kinds[asset.kind]}</span>
                            <span class="more__size">{sizeLabel(asset)}</span>
                            <span class="more__name">{asset.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
              </section>
            ))
          }

          {
            release ? (
              <dl class="tally">
                <div class="tally__cell">
                  <dt class="caps">{d.version}</dt>
                  <dd class="tally__big">{release.version}</dd>
                  <dd class="tally__meta">
                    {date} · <a href={release.url}>{d.whatsNew}</a>
                  </dd>
                </div>
                {total > 0 && (
                  <div class="tally__cell">
                    <dt class="caps">{d.downloads}</dt>
                    <dd class="tally__big">{number(total)}</dd>
                    <dd class="split" aria-hidden="true">
                      {counts.map((p) => (
                        <span class={`split__bar split__bar--${p.id}`} style={`--share: ${p.count / total}`} />
                      ))}
                    </dd>
                    <dd class="split__legend">
                      {counts.map((p) => (
                        <span>
                          <i class={`split__dot split__bar--${p.id}`} />
                          {p.name} <strong>{number(p.count)}</strong>
                        </span>
                      ))}
                    </dd>
                  </div>
                )}
              </dl>
            ) : (
              <p class="dl__note">{d.latestFailed}</p>
            )
          }
          {total > 0 && <p class="dl__note">{d.downloadsNote}</p>}
        </div>

        <figure class="dl__win">
          <Picture src={perform} alt={t.stage.windowPerform} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1280]} sizes="(max-width: 56rem) 92vw, 52vw" loading="eager" decoding="async" />
          {
            hasVideo && (
              <video class="win__video" data-stage-video data-webm="/media/perform.webm" data-mp4="/media/perform.mp4" muted loop playsinline preload="none" aria-label={t.stage.videoAlt} />
            )
          }
        </figure>
      </div>

      <section class="install" data-panel="macos" aria-labelledby="macos-steps">
        <h2 class="install__title" id="macos-steps">{d.macTitle}</h2>
        <p class="steps__intro">{d.macIntro}</p>
        <ol class="steps">
          {
            d.macSteps.map((step, i) => {
              const image = macImage(i);
              return (
                <li class="step">
                  <div class="step__media">
                    {image ? (
                      <Picture src={image} alt={altFor(i + 1, step.title)} formats={['avif', 'webp']} fallbackFormat="webp" widths={[400, 700]} sizes="(max-width: 48rem) 92vw, 22rem" loading="lazy" decoding="async" />
                    ) : (
                      <StepArt kind="start" alt={altFor(i + 1, step.title)} />
                    )}
                  </div>
                  <h3 class="step__title">{step.title}</h3>
                  <p class="step__text" set:html={step.text} />
                </li>
              );
            })
          }
        </ol>
        <details class="term">
          <summary>{d.macTerminalSummary}</summary>
          <div>
            <p>{d.macTerminalIntro}</p>
            <code>xattr -dr com.apple.quarantine "/Applications/OpenDJDecks.app"</code>
          </div>
        </details>
      </section>

      <section class="install" data-panel="windows" aria-labelledby="windows-steps">
        <h2 class="install__title" id="windows-steps">{d.windowsTitle}</h2>
        <p class="steps__intro">{d.windowsIntro}</p>
        <ol class="steps">
          {
            d.windowsSteps.map((step, i) => (
              <li class="step">
                <div class="step__media">
                  <StepArt kind={['unzip', 'run', 'smartscreen'][i]} alt={altFor(i + 1, step.title)} />
                </div>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__text" set:html={step.text} />
              </li>
            ))
          }
        </ol>
      </section>

      <section class="install" data-panel="linux" aria-labelledby="linux-steps">
        <h2 class="install__title" id="linux-steps">{d.linuxTitle}</h2>
        <h3 class="install__sub">{d.linuxDeb.title}</h3>
        <ol class="steps">
          {
            d.linuxDeb.steps.map((step, i) => (
              <li class="step">
                <div class="step__media">
                  <StepArt kind={['deb', 'install'][i]} alt={altFor(i + 1, step.title)} />
                </div>
                <h4 class="step__title">{step.title}</h4>
                <p class="step__text" set:html={step.text} />
              </li>
            ))
          }
        </ol>
        <h3 class="install__sub">{d.linuxAppImage.title}</h3>
        <ol class="steps">
          {
            d.linuxAppImage.steps.map((step, i) => (
              <li class="step">
                <div class="step__media">
                  <StepArt kind={['exec', 'run'][i]} alt={altFor(i + 1, step.title)} />
                </div>
                <h4 class="step__title">{step.title}</h4>
                <p class="step__text" set:html={step.text} />
              </li>
            ))
          }
        </ol>
      </section>

      <div class="dl__after">
        <div>
          <strong>{d.after}</strong>
          <p>{d.afterText}</p>
        </div>
        <a class="plate-btn" href={guideHref('getting-started', lang)}>{d.afterStart}</a>
        <a class="plate-btn" href={guideHref('importing-your-library', lang)}>{d.afterMigrate}</a>
      </div>

      {
        release && (
          <p class="dl__foot">
            <a href={releasesUrl}>{d.allReleases}</a>
            {release.checksumsUrl && <a href={release.checksumsUrl}>{d.checksums}</a>}
          </p>
        )
      }
    </div>
  </main>
</Base>

<script>
  import '../../scripts/download';
  import '../../scripts/stage-video';
</script>
