---
// The landing page: the pinned stage with the app windows and the animated front window, then
// the teasers from the locale files, then the closing call.
import { existsSync } from 'node:fs';
import { Picture } from 'astro:assets';

import '../../styles/home.css';

import Base from '../../layouts/Base.astro';
import TeaserArt from '../home/TeaserArt.astro';
import { path, repoUrl, ui, type Lang } from '../../i18n/ui';
import { wikiHome, guideHref } from '../../lib/docs-catalog.mjs';

import perform from '../../assets/stage/perform.png';
import prepare from '../../assets/stage/prepare.png';
import clubMode from '../../assets/stage/club.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const s = t.stage;

// The teaser pictures live with the guides that show the same thing in docs/guide/img.
const guideImages = import.meta.glob<{ default: ImageMetadata }>('../../../../docs/guide/img/*.{png,jpg}', { eager: true });
const teaserImage = (name: string) => {
  const key = Object.keys(guideImages).find((file) => file.endsWith(`/${name}.png`) || file.endsWith(`/${name}.jpg`));
  return key ? guideImages[key].default : undefined;
};
const teaserArt: Record<string, string> = {
  library: 'library',
  sync: 'usb',
  beatgrid: 'beatgrid',
  stems: 'stems',
  fx: 'teaser-fx',
  recording: 'recording',
  lights: 'lighting',
};
// Teasers that also have a short clip of the app (public/media/clips).
const teaserClip: Record<string, string> = { beatgrid: 'beatgrid', stems: 'stems', fx: 'teaser-fx', lights: 'lighting' };
const teasers = t.teasers.map((teaser) => ({
  ...teaser,
  image: teaserArt[teaser.id] ? teaserImage(teaserArt[teaser.id]) : undefined,
}));

// Only reference the video once its files exist, so no visitor ever requests a missing file.
const publicDir = new URL('../../../public/media/', import.meta.url);
const hasVideo = existsSync(new URL('perform.webm', publicDir)) && existsSync(new URL('perform.mp4', publicDir));
const formats = ['avif', 'webp'] as const;

// The background: a spectrum of emission lines that breathes in a seamless loop, drawn by CSS,
// so it stays sharp on any screen and costs no download. The numbers are fixed for a stable build.
const lineTones = ['--blue', '--violet', '--sodium', '--orange', '--green'];
const skyLines = Array.from({ length: 72 }, (_, i) => {
  const wobble = (Math.sin(i * 12.9898) * 43758.5453) % 1;
  const shape = Math.abs(Math.sin(i * 0.31)) * 0.55 + Math.abs(wobble) * 0.45;
  return {
    height: Math.round(18 + shape * 74),
    delay: -(Math.abs(wobble) * 4).toFixed(2),
    period: (1.94 * (1 + (i % 3))).toFixed(2),
    tone: lineTones[i % 5 === 0 ? 2 : Math.abs(Math.round(wobble * 10)) % 5],
  };
});
---

<Base lang={lang} page="home" title={t.meta.title} description={t.meta.description}>
  <main id="main">
    <section class="scene" data-scene aria-labelledby="stage-title">
      <div class="scene__sticky">
        <div class="sky" aria-hidden="true">
          <div class="sky__glow" data-glow></div>
          <div class="sky__loop">
            {skyLines.map((line) => <i style={`--h: ${line.height}%; --d: ${line.delay}s; --t: ${line.period}s; --c: var(${line.tone})`} />)}
          </div>
          <div class="sky__line"></div>
        </div>

        <header class="hero" data-hero>
          <h1 class="hero__title" id="stage-title">
            {s.title.map((line) => <span>{line}</span>)}
          </h1>
          <p class="hero__lede">{s.lede}</p>
          <div class="hero__actions">
            <a
              class="plate-btn plate-btn--primary hero__cta"
              href={path('download', lang)}
              data-smart-download
              data-label-macos={s.ctaForMac}
              data-label-windows={s.ctaForWindows}
              data-label-linux={s.ctaForLinux}
            >
              {s.cta} <span class="hero__for" data-smart-label>{s.ctaFor}</span>
            </a>
            <a class="plate-btn" href={wikiHome(lang)}>{s.wiki}</a>
          </div>
          <p class="caps hero__platforms">{s.platforms}</p>
        </header>

        <div class="world" data-world>
          <div class="rig">
            <figure class="win win--prepare" data-win="prepare">
              <Picture src={prepare} alt={s.windowPrepare} formats={formats} fallbackFormat="webp" widths={[640, 1024, 1600]} sizes="(max-width: 55rem) 60vw, 60vw" loading="eager" decoding="async" />
            </figure>
            <figure class="win win--club" data-win="club">
              <Picture src={clubMode} alt={s.windowClub} formats={formats} fallbackFormat="webp" widths={[640, 1024, 1600]} sizes="(max-width: 55rem) 60vw, 60vw" loading="eager" decoding="async" />
            </figure>
            <figure class="win win--perform" data-win="perform">
              <Picture src={perform} alt={s.windowPerform} formats={formats} fallbackFormat="webp" widths={[640, 960, 1280, 1800, 2560]} sizes="(max-width: 55rem) 92vw, 70vw" loading="eager" fetchpriority="high" decoding="async" />
              {
                hasVideo && (
                  <video
                    class="win__video"
                    data-stage-video
                    data-webm="/media/perform.webm"
                    data-mp4="/media/perform.mp4"
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-label={s.videoAlt}
                  />
                )
              }
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="teasers" aria-labelledby="teaser-head">
      <div class="container">
        <header class="teasers__head">
          <div class="rail" aria-hidden="true"></div>
          <h2 class="teasers__title" id="teaser-head">{t.teaserHead}</h2>
          <p class="teasers__lede">{t.teaserLede}</p>
        </header>
        <div class="teasers__list">
          {
            teasers.map((teaser, index) => (
              <article class={`teaser ${index % 2 ? 'teaser--flip' : ''}`}>
                <div class="teaser__text">
                  <h3 class="teaser__title">{teaser.title}</h3>
                  <p class="teaser__body">{teaser.text}</p>
                  <a class="teaser__link" href={guideHref(teaser.slug, lang)}>
                    {t.teaserMore}: {teaser.link}
                    <span aria-hidden="true">›</span>
                  </a>
                </div>
                <div class="teaser__media">
                  {teaser.image ? (
                    <Picture src={teaser.image} alt={teaser.title} formats={formats} fallbackFormat="webp" widths={[480, 720, 1080]} sizes="(max-width: 56rem) 92vw, 50vw" loading="lazy" decoding="async" />
                  ) : (
                    <TeaserArt kind={teaser.id} title={teaser.title} />
                  )}
                  {teaserClip[teaser.id] && (
                    <video
                      class="win__video"
                      data-stage-video
                      data-webm={`/media/clips/${teaserClip[teaser.id]}.webm`}
                      data-mp4={`/media/clips/${teaserClip[teaser.id]}.mp4`}
                      muted
                      loop
                      playsinline
                      preload="none"
                      aria-label={teaser.title}
                    />
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="container closing__inner">
        <h2 id="closing-title" class="closing__title">{t.closing.title}</h2>
        <p class="closing__text">{t.closing.text}</p>
        <div class="hero__actions closing__actions">
          <a class="plate-btn plate-btn--primary closing__cta" href={path('download', lang)}>{t.closing.cta}</a>
          <a class="plate-btn" href={repoUrl}>{t.closing.source}</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import '../../scripts/smart-download';
  import '../../scripts/stage';
  import '../../scripts/stage-video';
</script>
