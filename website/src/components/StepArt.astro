---
// Schematic step pictures for the install guides, in the site's thin-line style. Deliberately
// not fake screenshots of any operating system.
interface Props {
  kind: string;
  alt: string;
}
const { kind, alt } = Astro.props;
const w = 480;
const h = 270;
---

<svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label={alt} fill="none" stroke="#4b4a46">
  <rect x="0.5" y="0.5" width={w - 1} height={h - 1} fill="#1a1a19" />
  <rect x="40" y="34" width={w - 80} height={h - 68} fill="#151514" stroke="#33322f" />
  <path d={`M40 62h${w - 80}`} stroke="#33322f" />
  <rect x="52" y="44" width="8" height="8" fill="#33322f" stroke="none" />
  <rect x="66" y="44" width="8" height="8" fill="#33322f" stroke="none" />
  {
    kind === 'unzip' && (
      <>
        <rect x="120" y="95" width="80" height="100" stroke="#e6e0d2" />
        <path d="M160 95v30M153 103h14M153 113h14" stroke="#e6e0d2" />
        <path d="M222 145h52" stroke="#f5ce4a" stroke-width="2" />
        <path d="M266 137l10 8-10 8" stroke="#f5ce4a" stroke-width="2" />
        <rect x="290" y="115" width="90" height="70" stroke="#b7b1a4" />
        <path d="M290 128h35l8-13h47" stroke="#b7b1a4" />
      </>
    )
  }
  {
    kind === 'run' && (
      <>
        <rect x="175" y="95" width="130" height="90" stroke="#b7b1a4" />
        <path d="M175 113h130" stroke="#b7b1a4" />
        <path d="M200 150h80" stroke="#f5ce4a" stroke-width="2" />
        <path d="M290 195l14 40 8-14 16-3z" fill="#e6e0d2" stroke="none" />
      </>
    )
  }
  {
    kind === 'smartscreen' && (
      <>
        <rect x="80" y="80" width="320" height="130" fill="#21211f" stroke="#4fb8f0" />
        <path d="M104 106h150" stroke="#e6e0d2" stroke-width="3" />
        <path d="M104 126h210M104 140h190" stroke="#8b867b" />
        <rect x="104" y="166" width="96" height="28" stroke="#b7b1a4" />
        <rect x="260" y="166" width="118" height="28" fill="#f5ce4a" stroke="#f5ce4a" />
        <path d="M385 200l12 34 7-12 14-3z" fill="#e6e0d2" stroke="none" />
      </>
    )
  }
  {
    kind === 'deb' && (
      <>
        <rect x="190" y="88" width="100" height="112" stroke="#e6e0d2" />
        <path d="M190 112h100" stroke="#e6e0d2" />
        <path d="M212 140h56M212 156h56M212 172h36" stroke="#8b867b" />
        <path d="M296 205l13 37 7-13 15-3z" fill="#e6e0d2" stroke="none" />
      </>
    )
  }
  {
    kind === 'install' && (
      <>
        <rect x="100" y="86" width="280" height="118" fill="#21211f" stroke="#33322f" />
        <rect x="118" y="104" width="50" height="50" stroke="#b7b1a4" />
        <path d="M184 112h170M184 128h120" stroke="#8b867b" />
        <rect x="118" y="166" width="124" height="28" fill="#f5ce4a" stroke="#f5ce4a" />
      </>
    )
  }
  {
    kind === 'exec' && (
      <>
        <rect x="120" y="88" width="240" height="118" fill="#21211f" stroke="#33322f" />
        <rect x="142" y="116" width="26" height="26" fill="#f5ce4a" stroke="#f5ce4a" />
        <path d="M149 129l6 7 11-14" stroke="#151514" stroke-width="3" />
        <path d="M184 123h150M184 140h110" stroke="#8b867b" />
        <path d="M142 170h196" stroke="#33322f" />
      </>
    )
  }
  {
    kind === 'start' && (
      <>
        <path d="M100 150h100l10-14h170" stroke="#f5ce4a" stroke-width="2" />
        <path d="M100 196h100l10-14h170" stroke="#4fb8f0" stroke-width="2" />
        <path d="M100 104h100l10-14h170" stroke="#9b7bff" stroke-width="2" />
        <path d="M300 74v150" stroke="#e6e0d2" stroke-width="3" />
      </>
    )
  }
</svg>
