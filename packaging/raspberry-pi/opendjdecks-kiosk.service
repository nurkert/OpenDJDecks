[Unit]
Description=OpenDJDecks (kiosk)
After=systemd-user-sessions.service sound.target
Conflicts=getty@tty1.service

[Service]
User=@USER@
SupplementaryGroups=audio video input render plugdev
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
Environment=SLINT_BACKEND=linuxkms-femtovg
Environment=OPENDJDECKS_MAPPINGS=/opt/opendjdecks/mappings
Environment=RUST_LOG=info
ExecStart=/opt/opendjdecks/opendjdecks --kiosk --profile lite
Restart=always
RestartSec=2
LimitRTPRIO=95
LimitMEMLOCK=infinity
Nice=-10

[Install]
WantedBy=multi-user.target
